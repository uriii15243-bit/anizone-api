{"id":6880,"mal_id":6880,"anizone_id":6880,"url":"https://anizone.co.il/anime/6880/Deadman-Wonderland","slug":"Deadman-Wonderland","titles":{"hebrew":"דדמן וונדרלנד","english":"Deadman Wonderland","romaji":"Deadman Wonderland","japanese":"デッドマン・ワンダーランド","synonyms":["DEADMAN WONDERLAND"],"community":["ארץ פלאות המתים"],"known":["Deadman Wonderland","デッドマン・ワンダーランド","DEADMAN WONDERLAND"]},"synopsis_hebrew":"גנטה איגראשי (Ganta Igarashi) הורשע בפשע שאיננו ביצע - רצח כיתתו. הוא נשלח לכלא פרטי חדש, בכלא הזה הכלואים הם אטרקצית תיירות, הם בעצם מופע שעשועים - קרבות גלידאטורים מהעידן המודרני. תוסיפו לסיטואציה ילדה קטנה ומוזרה, כוחות על חדשים שגנטה מגלה, קונספיראציה והגעתם לארץ הפלאות לאנשים מתים.","background_hebrew":"דדמן וונדרלנד מעבד את חמשת הכרכים הראשונים של סדרת המנגה מאת קזומה קונדו וג'ינסי קאטאוקה באותו שם. חלק מהדמויות מהמנגה לא הופיעו באנימה, במיוחד הדמות המשנית אזאמי מידו והדמות הגאה המתלבשת בבגדי נשים, מסארו סוקגאווה.","type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2011-04-17","season":{"label":"אביב 2011","year":2011,"season":"spring"},"broadcast":{"label":"ראשון 01:00","day":"sunday","time":"01:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Sci-Fi","he":"מדע בדיוני"},{"en":"Supernatural","he":"על טבעי"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Gore","he":"גור"},{"en":"High Stakes Game","he":"משחקי מזל"},{"en":"Survival","he":"הישרדות"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Sci-Fi","Supernatural","Suspense"],"studios":["Manglobe"],"producers":["Kadokawa Shoten","Kadokawa Pictures Japan","KlockWorx","AMG MUSIC"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.13,"mal_scored_by":724939,"israel":7.14,"israel_scored_by":7,"rank":4213,"popularity":122,"members":1333175,"favorites":7197},"community_reviews":{"ratings":7,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/9/75299l.webp"},"trailer":{"youtube_id":