{"id":267,"mal_id":267,"anizone_id":267,"url":"https://anizone.co.il/anime/267/Gungrave","slug":"Gungrave","titles":{"hebrew":"גאנגרייב","english":"Gungrave","romaji":"Gungrave","japanese":"ガングレイヴ","synonyms":[],"community":[],"known":["Gungrave","ガングレイヴ"]},"synopsis_hebrew":"ברנדון היט והארי מקדואל, שני חברים כל כך קרובים שאפשר לקרוא להם אחים, מקבלים תזכורת פתאומית ואלימה ביום גורלי אחד עד כמה העולם סביבם יכול להיות אכזרי וחסר רחמים. כל חייהם עד אז היו פשוטים ורגועים, וכללו בעיקר קטטות מקומיות, פיתוי נשים וגניבות קטנות כדי להתפרנס ולהעביר את הזמן. מה שהם לא הבינו הוא שבעולם האכזר הזה, האושר הוא חולף והשינוי הוא בלתי נמנע.\n\nכאן נכנסת לתמונה מילניון, הסינדיקט המאפיה הגדול והידוע לשמצה באזור, שמקבל את ברנדון והארי לשורותיו ומתחיל אותם בתחתית שרשרת המזון. להארי יש שאיפות לעלות בדרגות וביום מן הימים להחליף את ביג דאדי כמנהיג העליון של מילניון, בעוד שברנדון רק רוצה לתמוך בחברו ולרצות את ביג דאדי שלקח תחת חסותו את האישה שברנדון אוהב.\n\nמבוסס על משחק הווידאו בגוף שלישי באותו שם, Gungrave הוא סיפור אפי של חברות, בגידה ותאוות בצע המשתרע על פני מספר שנים, ובסופו של דבר חוזר לפרק הראשון המרתק והמאיים, תוך כדי בניית הסיום המרגש של הסיפור.\n\nנכתב על ידי MAL Rewrite.","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":24,"status":"הסתיים","aired_from":"2003-10-07","season":{"label":"סתיו 2003","year":2003,"season":"fall"},"broadcast":{"label":"שלישי 01:30","day":"tuesday","time":"01:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Gore","he":"גור"},{"en":"Organized Crime","he":"פשע מאורגן"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":null,"genres":["Action","Drama","Sci-Fi"],"studios":["Madhouse"],"producers":["Victor Entertainment","Tohokushinsha Film Corporation","Arts Pro"],"licensors":["Funimation","Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":7.82,"mal_scored_by":86211