{"id":790,"mal_id":790,"anizone_id":790,"url":"https://anizone.co.il/anime/790/Ergo-Proxy","slug":"Ergo-Proxy","titles":{"hebrew":"ארגו פרוקסי","english":"Ergo Proxy","romaji":"Ergo Proxy","japanese":"エルゴプラクシー","synonyms":[],"community":[],"known":["Ergo Proxy","エルゴプラクシー"]},"synopsis_hebrew":"לאחר פיצוץ שכבת מתאן ההידראט, חברי האנושות הנותרים נאלצים לחיות בערי כיפה מבודדים הפזורות ברחבי כדור הארץ הצחיח והעוין. הם חיים בחברה מבוקרת ונעזרים בחיי היומיום ברובוטים אוטונומיים הנקראים אוטורייבס. באחת מערים אלו, רומדו, המפקחת ליל מאייר, נכדתו של יורש העצר, מובילה חקירה העוסקת באוטורייבים שנעשו משוגעים לאחר שנדבקו בנגיף הקוגיטו. במהלך העניין, היא באה במגע עם מפלצת בשם פרוקסי. במקום אחר בעיר, וינסנט לאו נמצא במנוסה לאחר שהופלל בהשתתפותו בכמה מקרי קוגיטו. וביחד, עם אוטורייבית מסוג ילדה בשם פינו, הם יוצאים למסע אל עיר הכיפה מוסק כדי לפתור את התעלומה הנקראת פרוקסים.","background_hebrew":null,"type":"TV","episodes":23,"duration_minutes":25,"status":"הסתיים","aired_from":"2006-02-25","season":{"label":"חורף 2006","year":2006,"season":"winter"},"broadcast":{"label":"שבת 19:00","day":"saturday","time":"19:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Mystery","he":"מסתורין"},{"en":"Sci-Fi","he":"מדע בדיוני"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Psychological","he":"פסיכולוגיה"}],"demographic":null,"genres":["Mystery","Sci-Fi","Suspense"],"studios":["Manglobe"],"producers":["WOWOW","Rondo Robe","Geneon Entertainment USA","Geneon Entertainment"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.9,"mal_scored_by":262680,"israel":8.75,"israel_scored_by":4,"rank":944,"popularity":328,"members":733057,"favorites":15195},"community_reviews":{"ratings":4,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1183/136187l.webp"},"trailer":null,"characters":[{"name":"Mayer, Re-l","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/3/325688.webp?s=4ccd73bf85fcc0ce5da