{"id":37521,"mal_id":37521,"anizone_id":37521,"url":"https://anizone.co.il/anime/37521/Vinland-Saga","slug":"Vinland-Saga","titles":{"hebrew":"סאגת וינלנד","english":"Vinland Saga","romaji":"Vinland Saga","japanese":"ヴィンランド・サガ","synonyms":[],"community":["וינלנד סאגה"],"known":["Vinland Saga","ヴィンランド・サガ"]},"synopsis_hebrew":"ת'ורפין הצעיר גדל כשהוא מאזין לסיפורים של מלחים ותיקים שנסעו באוקיינוס והגיעו למקום האגדי, וינלנד. אומרים שזה מקום חם ופורה, מקום שבו לא יהיה צורך להילחם—שונה לחלוטין מהכפר הקפוא באיסלנד שבו נולד, ובוודאי לא כמו חייו הנוכחיים כשכיר חרב. המלחמה היא ביתו כעת. למרות שאביו אמר לו פעם, \"אין לך אויבים, לאף אחד אין. אין אף אחד שמותר לפגוע בו,\" ככל שגדל, ת'ורפין הבין שאין דבר רחוק יותר מהאמת.\n\nהמלחמה בין אנגליה לדנים מחמירה עם כל שנה שעוברת. המוות הפך לשגרה, ושכירי החרב הוויקינגים נהנים מכל רגע. ברית עם אחד הצדדים תגרום לשינוי עצום במאזן הכוחות, והוויקינגים שמחים לעשות לעצמם שם ולקחת כל שלל שהם מרוויחים בדרך. בתוך הכאוס, ת'ורפין חייב לנקום ולהרוג את אסקלאד, האיש שרצח את אביו. נראה כי גן העדן היחיד עבור הוויקינגים הוא עידן המלחמה והמוות המשתולל.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":24,"duration_minutes":24,"status":"הסתיים","aired_from":"2019-07-08","season":{"label":"קיץ 2019","year":2019,"season":"summer"},"broadcast":{"label":"שני 00:10","day":"monday","time":"00:10","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Gore","he":"גור"},{"en":"Historical","he":"היסטורי"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Adventure","Drama"],"studios":["Wit Studio"],"producers":["Production I.G","Dentsu","Kodansha","Twin Engine"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":8.78,"mal_scored_by":1104461,"israel":8.69,"israel_scored_by":16,"rank":46,"popularity":59,"members":1888890,"favorites":59322},"community_reviews":{"ratings":16,"written_reviews":4},"images":{"poster