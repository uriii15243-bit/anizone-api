{"id":101,"mal_id":101,"anizone_id":101,"url":"https://anizone.co.il/anime/101/Air","slug":"Air","titles":{"hebrew":"אוויר","english":"Air","romaji":"Air","japanese":"AIR","synonyms":[],"community":[],"known":["Air","AIR"]},"synopsis_hebrew":"יוקיטו קוניסאקי יוצא למסע בחיפוש אחר הנערה המכונפת, שנכלאה בשמיים לפני מאות שנים, לאחר ששמע סיפור ילדות ישן מאמו. תוך כדי שהוא מציג את מופע הבובות שלו לאנשים בניסיון להרוויח קצת כסף, הוא מוצא את עצמו בעיירה קטנה שבה לא ציפה להישאר זמן רב. עם זאת, כאשר הוא פוגש נערה יוצאת דופן בשם מיסוזו, הדברים מקבלים תפנית דרסטית כאשר הוא מוזמן להישאר איתה.\nבמהלך שהותו בעיירה הקסומה, יוקיטו מתיידד במהירות עם המקומיים. ככל שהוא מכיר אותם טוב יותר, הוא לומד על הבעיות שלהם ומחליט לעזור, שם את החיפוש שלו אחר הנערה המכונפת בהמתנה. עם החיפוש שלו בהמתנה, והקשר הגובר שלו עם מיסוזו והעיירה הקטנה, האם יוקיטו אי פעם ימצא את הנערה המכונפת, או שהיא קרובה יותר ממה שהוא חשב?","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2005-01-07","season":{"label":"חורף 2005","year":2005,"season":"winter"},"broadcast":{"label":"שישי 00:30","day":"friday","time":"00:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[],"demographic":null,"genres":["Drama","Romance","Supernatural"],"studios":["Kyoto Animation"],"producers":["Pony Canyon","TBS","Movic"],"licensors":["ADV Films","Funimation"],"source":null,"rating":null,"scores":{"mal":7.27,"mal_scored_by":160170,"israel":6.0,"israel_scored_by":null,"rank":3348,"popularity":913,"members":317082,"favorites":2827},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1825/146531l.webp"},"trailer":{"youtube_id":"9oTsWYOUZHU","url":"https://www.youtube.com/watch?v=9oTsWYOUZHU","embed_url":"https://www.youtube.com/embed/9oTsWYOUZHU"},"characters":[{"name":"Kamio, Misuzu","role":"ראשי","image":"https://cdn.my