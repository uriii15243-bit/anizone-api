{"id":1775,"mal_id":1775,"anizone_id":1775,"url":"https://anizone.co.il/anime/1775/Dimension-Movement-of-Nazca","slug":"Dimension-Movement-of-Nazca","titles":{"hebrew":"תנועת המימד של נאזקה","english":"Dimension Movement of Nazca","romaji":"Jikuu Tenshou Nazca","japanese":"時空転抄ナスカ","synonyms":[],"community":[],"known":["Jikuu Tenshou Nazca","Dimension Movement of Nazca","時空転抄ナスカ"]},"synopsis_hebrew":"מיורה קיוג'י, תלמיד קנדו מסור, מגלה כי השישו (מאסטר) שלו, טאטה מסאנארי, הוא לוחם אינקה שהתגלגל מחדש בשם יאווארו, השואף להשמיד את העולם כדי לטהר אותו. קיוג'י עצמו הוא הלוחם בילקה, שסיכל את תוכניותיו של יאווארו בחייהם הקודמים. יאווארו אוסף רוחות נוספות שהתעוררו כדי לשחרר את כוחות הטבע. כעת, קיוג'י חייב להתמודד עם גורלו ולהחליט אם הוא רק כלי לנשמה שהתגלגלה מחדש או אם הוא באמת מיורה קיוג'י, ומי מהם יוכל להציל את העולם ואת העתיד כפי שהוא מכיר אותו.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"1998-04-06","season":{"label":"אביב 1998","year":1998,"season":"spring"},"broadcast":{"label":"שלישי 01:15","day":"tuesday","time":"01:15","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Reincarnation","he":"חזר לחיים"}],"demographic":null,"genres":["Action","Adventure","Drama","Fantasy"],"studios":["Genco","Radix"],"producers":["Kadokawa Shoten","Pioneer LDC"],"licensors":["Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":5.55,"mal_scored_by":1875,"israel":null,"israel_scored_by":null,"rank":13349,"popularity":7532,"members":9820,"favorites":15},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1244/150827l.webp"},"trailer":null,"characters":[{"name":"Shiogami, Shinri","role":"משני","image":"https://cdn.myanimelist.net/images/characters/13/106747.webp?s=b00d6f040657aaf4cf055160bbf29696","voice_actors":[{"name":"Suyama, Ak