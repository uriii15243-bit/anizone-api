{"id":8206,"mal_id":8206,"anizone_id":8206,"url":"https://anizone.co.il/anime/8206/Spellbound-Magical-Princess-Lilpri","slug":"Spellbound-Magical-Princess-Lilpri","titles":{"hebrew":"מכושפת! הנסיכה הקסומה לילפרי","english":"Spellbound! Magical Princess Lilpri","romaji":"Hime Chen! Otogi Chikku Idol Lilpri","japanese":"ひめチェン! おとぎちっくアイドル リルぷりっ","synonyms":["Himechan! Otogitic Idol Lil'Pri"],"community":[],"known":["Hime Chen! Otogi Chikku Idol Lilpri","Spellbound! Magical Princess Lilpri","ひめチェン! おとぎちっくアイドル リルぷりっ","Himechan! Otogitic Idol Lil'Pri"]},"synopsis_hebrew":"עולם האגדות בצרה. הנסיכות והעולמות שלהן נעלמים, מה שגורם לאפקט דומינו בעולם האנושי שבו הסיפורים שלהן פופולריים. כדי להציל את עולם האגדות, המלכה שולחת שלושה חיות קסם, סיי, דאי וריוקו, לעולם האנושי עם אבני חן קסומות כדי למצוא שלוש בנות שיכולות להפוך ל\"סופר מירקל איידולס\", הנסיכות שלגיה, סינדרלה וקאגויה-הימה. אותן \"נסיכות\" מתגלות כשלוש ילדות קטנות: יוקימורי רינגו, טקאשירו ליילה וסאסהארה נאצוקי. אבל האבנים הופכות אותן לכוכבות זמר מבוגרות, ולאחר הופעת הבכורה המקרית שלהן בקונצרט של הזמר וויש, הן הופכות למוכרות כ\"נסיכות קטנות\", או \"לילפרי\". כעת הן חייבות לאסוף טונים של אושר מבני האדם כדי לשקם את עולם האגדות.","background_hebrew":null,"type":"TV","episodes":51,"duration_minutes":24,"status":"הסתיים","aired_from":"2010-04-04","season":{"label":"אביב 2010","year":2010,"season":"spring"},"broadcast":{"label":"ראשון 09:00","day":"sunday","time":"09:00","timezone":"Asia/Jerusalem"},"categories":[],"subcategories":[{"en":"Mahou Shoujo","he":"ילדות קסומות"}],"demographic":null,"genres":[],"studios":["TMS Entertainment"],"producers":["TV Tokyo","Shogakukan-Shueisha Productions","Half H.P Studio"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.01,"mal_scored_by":4250,"israel":null,"israel_scored_by":null,"rank":4887,"popularity":6921,"members":12096,"favorites":54},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/22007l.webp"},"trailer":null,"characters":[{"nam