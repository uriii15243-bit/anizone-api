{"id":15823,"mal_id":15823,"anizone_id":15823,"url":"https://anizone.co.il/anime/15823/Shin-Takarajima","slug":"Shin-Takarajima","titles":{"hebrew":"שין טקאראג'ימה","english":"Shin Takarajima","romaji":"Shin Takarajima","japanese":"新宝島","synonyms":[],"community":[],"known":["Shin Takarajima","新宝島"]},"synopsis_hebrew":"זה היה הפרק הראשון של \"מושי פרו לנד\", סדרה ייחודית של תוכניות אנימציה באורך 60 דקות. זו הייתה גם תוכנית האנימציה הראשונה בטלוויזיה ביפן באורך 60 דקות. עם זאת, הסדרה מעולם לא התממשה ורק הפרק הזה שודר בפועל. הסיפור עוקב אחר \"אי המטמון\" של סטיבנסון, עם דמויות בצורת בעלי חיים. לדוגמה, הפיראט סילבר מוצג כזאב, בעוד שהדמות הראשית ג'ים הופכת לארנב. לכן, אין לזה שום קשר ל\"אי המטמון החדש\", יצירת המופת של טזוקה במנגה.\n\n(מקור: AniDB)","background_hebrew":null,"type":"TV Special","episodes":1,"duration_minutes":52,"status":"הסתיים","aired_from":"1965-01-03","season":{"label":"חורף 1965","year":1965,"season":"winter"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"}],"subcategories":[],"demographic":{"en":"Kids","he":"Kids"},"genres":["Adventure"],"studios":["Mushi Production"],"producers":["Fuji TV"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.16,"mal_scored_by":440,"israel":null,"israel_scored_by":null,"rank":10216,"popularity":15364,"members":1083,"favorites":0},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1315/119255l.webp"},"trailer":null,"characters":[],"staff":[{"name":"Tezuka, Osamu","role":"במאי, תסריטאי","roles":["במאי","תסריטאי"],"image":"https://cdn.myanimelist.net/images/voiceactors/2/42193.jpg"},{"name":"Stevenson, Robert Louis","role":"יוצר מקורי","roles":["יוצר מקורי"],"image":"https://cdn.myanimelist.net/images/voiceactors/1/18901.jpg"},{"name":"Bessho, Takaharu","role":"מפיק","roles":["מפיק"],"image":null}],"external_links":{"myanimelist":"https://myanimelist.net/anime/15823","other":["https://anidb.net/p