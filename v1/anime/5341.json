{"id":5341,"mal_id":5341,"anizone_id":5341,"url":"https://anizone.co.il/anime/5341/Spice-and-Wolf-II","slug":"Spice-and-Wolf-II","titles":{"hebrew":"זאבה ותבלין עונה 2","english":"Spice and Wolf II","romaji":"Ookami to Koushinryou II","japanese":"狼と香辛料II","synonyms":["Ookami to Koushinryou 2nd Season","Spice and Wolf 2nd Season","Ookami to Koushinryou 2nd Season, Spice and Wolf 2nd Season"],"community":[],"known":["Ookami to Koushinryou II","Spice and Wolf II","狼と香辛料II","Ookami to Koushinryou 2nd Season","Spice and Wolf 2nd Season"]},"synopsis_hebrew":"הסוחר הנודד קראפט לורנס ממשיך במסעו צפונה עם אלת הזאבים הלו, בחיפוש אחר ביתה האבוד יואיטסו. לורנס ושותפתו החכמה ממשיכים להרוויח רווחים קטנים לאורך הדרך, תוך כדי שהם מגלים יותר מידע על עיר הולדתה של הלו. עם זאת, הדרך ליואיטסו מלאה במכשולים רבים—לורנס נתקל בסוחר צעיר ומקסים שמכוון את עיניו אל שותפתו הזאבה, והוא מתחיל לפקפק אם הלו תישאר לצידו; הוא והאלה יצטרכו גם לשקול עסקאות מסוכנות ומסוכנות כאשר לורנס שואף להגשים את חלומו להפוך לבעל חנות. כל הזמן הזה, עם נחישותו הנבחנת בכל פנייה במסעו, לורנס חייב לשאול את עצמו על הקשר שלו עם הלו, לקחת על עצמו יוזמות עסקיות, ולשאול את עצמו האם הגיע הזמן לו ולהלו להיפרד לדרכים נפרדות.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2009-07-09","season":{"label":"קיץ 2009","year":2009,"season":"summer"},"broadcast":{"label":"חמישי 01:15","day":"thursday","time":"01:15","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"}],"demographic":null,"genres":["Adventure","Drama","Romance","Supernatural"],"studios":["Brain's Base","Marvy Jack"],"producers":["Imagin","Pony Canyon","Movic","Kadokawa Pictures Japan","flying DOG","ASCII Media Works"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":8.3,"mal_scored_by":292124,"israel":