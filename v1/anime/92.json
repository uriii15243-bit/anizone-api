{"id":92,"mal_id":92,"anizone_id":92,"url":"https://anizone.co.il/anime/92/After-War-Gundam-X","slug":"After-War-Gundam-X","titles":{"hebrew":"אחרי המלחמה גנדאם X","english":"After War Gundam X","romaji":"Kidou Shinseiki Gundam X","japanese":"機動新世紀ガンダムX","synonyms":["After War Gundam X","Mobile New Century Gundam X","After War Gundam X, Mobile New Century Gundam X"],"community":[],"known":["Kidou Shinseiki Gundam X","After War Gundam X","機動新世紀ガンダムX","Mobile New Century Gundam X"]},"synopsis_hebrew":"כאשר אחת ממושבות החלל הכריזה על עצמאותה מהפדרציה של כדור הארץ, פרצה מלחמת החלל השביעית ההרסנית, מלחמה כוללת בין כדור הארץ לחלל. הפדרציה הגיבה לצבא המהפכה החללי עם חליפות ניידות, שנקראו גנדאמים. עם זאת, כוחות המהפכה החלליים שיחקו את הקלף המנצח שלהם והפילו מאות מושבות חלל על כדור הארץ, מה שהוביל את הכוכב לחורף גרעיני שנמשך שבע שנים. הפדרציה קרסה, אך צבא המהפכה החללי לא הצליח לפלוש לכדור הארץ בעקבות נפילת המושבות.\n\nחמש עשרה שנים חלפו. השנה היא כעת אחרי המלחמה 0015, ופדרציה חדשה קמה על כדור הארץ כדי להשיב את הסדר. בחלל, מנהיגי המושבות בונים מחדש את כוחותיהם. במקרה, גארוד רן בן החמש עשרה גילה חליפת ניידת ישנה של הפדרציה, הגנדאם X, וכעת הוא משתמש בה כדי לעזור לספינת הוולצ'ר פרידן במאבקה למנוע מהכוחות השולטים לחזור על טעויות העבר.","background_hebrew":null,"type":"TV","episodes":39,"duration_minutes":24,"status":"הסתיים","aired_from":"1996-04-05","season":{"label":"אביב 1996","year":1996,"season":"spring"},"broadcast":{"label":"שישי 17:00","day":"friday","time":"17:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mecha","he":"רובוטים"},{"en":"Space","he":"חלל"}],"demographic":null,"genres":["Adventure","Drama","Sci-Fi"],"studios":["Sunrise"],"producers":["TV Asahi","Sotsu"],"licensors":["Nozomi Entertainment"],"source":null,"rating":null,"scores":{"mal":7.39,"mal_scored_by":18058,"israel":null,"israel_scored_by":null,"rank":2738,"popularity":4140,"members":41