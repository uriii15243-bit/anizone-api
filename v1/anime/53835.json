{"id":53835,"mal_id":53835,"anizone_id":53835,"url":"https://anizone.co.il/anime/53835/Unnamed-Memory","slug":"Unnamed-Memory","titles":{"hebrew":"זיכרון ללא שם","english":"Unnamed Memory","romaji":"Unnamed Memory","japanese":"Unnamed Memory","synonyms":[],"community":[],"known":["Unnamed Memory"]},"synopsis_hebrew":"\"המשאלה שלי כאלוף היא שתרדי מהמגדל ותהפכי לאשתי\".\nבטיפוס על מגדל מוות, אוסקר מחפש את כוחה של המאסטר שלו, מכשפת הירח התכול.\nהוא מקווה שהקסם שלה ישבור את הקללה שהורגת כל בחורה שהוא לוקח לאישה.\nכאשר הוא נשבע ביופיה, עולה במוחו רעיון טוב יותר - מכיוון שהמאסטר שלו מספיק חזקה, היא בוודאי תוכל לשרוד את הקללה - והוא צריך להינשא לה במקום!\nטינשה לא מתלהבת מהרעיון, אבל כן מסכימה לחיות עם אוסקר בטירה המלכותית למשך שנה אחת תוך כדי שהיא חוקרת את הקללה שהוטלה על הנסיך.\nפניה היפות של המכשפה מסתירות תקופות וסודות אפלים מחייה.\nעם זאת, ככל שחולף הזמן - הסודות מתחילים לצוף מחדש.","background_hebrew":"\"Unnamed Memory\" תוכנן במקור לשידור בשנת 2023, אך נדחה מסיבות הפקה. הסדרה יצאה בפורמט Blu-ray ו-DVD בשני מארזים בין ה-28 באוגוסט 2024 ל-25 בספטמבר 2024.","type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2024-04-09","season":{"label":"אביב 2024","year":2024,"season":"spring"},"broadcast":{"label":"שלישי 23:30","day":"tuesday","time":"23:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[],"demographic":null,"genres":["Adventure","Fantasy","Romance"],"studios":["ENGI"],"producers":["AT-X","Glovision","Sammy","Tencent Japan","Kadokawa","Heart Company","Bandai Namco Music Live"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.82,"mal_scored_by":61097,"israel":7.0,"israel_scored_by":null,"rank":6012,"popularity":1693,"members":164840,"favorites":766},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1143/142439l.webp"},"trailer":{"youtube_id":"jKNscVwATwI","