{"id":14713,"mal_id":14713,"anizone_id":14713,"url":"https://anizone.co.il/anime/14713/Kamisama-Kiss","slug":"Kamisama-Kiss","titles":{"hebrew":"התחלתי להיות אלה","english":"Kamisama Kiss","romaji":"Kamisama Hajimemashita","japanese":"神様はじめました","synonyms":[],"community":[],"known":["Kamisama Hajimemashita","Kamisama Kiss","神様はじめました"]},"synopsis_hebrew":"לאחר שאביה ברח מביתם בגלל חובות שצבר כתוצאה מהימוריו, נאנאמי מומוזונו פונתה מביתה, ונאלצת כעת להסתדר בכוחות עצמה. בעודה משוטטת כחסרת בית ברחובות, היא פוגשת במקרה את מיקאגה, אדם מוזר שמפחד מכלבים. נאנאמי “מצילה” את מיקאגה מכלב מזדמן, ולאחר מכן מספרת לו את סיפורה. לאות תודה, מיקאגה מחליט לתת לנאנאמי להתגורר בביתו, ונאנאמי, שאין לה מקום אחר לפנות אליו, מקבלת את ההצעה.\nכשנאנאמי מגיעה אל הכתובת שמיקאגה נתן לה, היא מופתעת לגלות שזהו מקדש שדים נטוש. טומואה, שד שועל, הנמצא במקדש כבר 20 שנה, ציפה שמיקאגה יחזור לאחר שעזב את המקדש. הוא מופתע לגלות שהנערה הצעירה שהגיעה למקדשו מונתה על ידי מיקאגה למלא את מקומו כאלת כדור הארץ.","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2012-10-02","season":{"label":"סתיו 2012","year":2012,"season":"fall"},"broadcast":{"label":"שלישי 02:05","day":"tuesday","time":"02:05","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Mythology","he":"מיתולוגיה"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Comedy","Romance","Supernatural"],"studios":["TMS Entertainment"],"producers":["TV Tokyo","Dentsu","Sotsu","Pony Canyon","Hakusensha","DAX Production"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":8.13,"mal_scored_by":382482,"israel":9.0,"israel_scored_by":3,"rank":562,"popularity":319,"members":746829,"favorites":17882},"community_reviews":{"ratings":3,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/85429l.webp"},"trailer":{"youtube_id":"1XfNOoTrGZQ","url":"https:/