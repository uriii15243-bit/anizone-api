{"id":1818,"mal_id":1818,"anizone_id":1818,"url":"https://anizone.co.il/anime/1818/Claymore","slug":"Claymore","titles":{"hebrew":"קליימור","english":"Claymore","romaji":"Claymore","japanese":"クレイモア","synonyms":[],"community":[],"known":["Claymore","クレイモア"]},"synopsis_hebrew":"הסיפור מתרחש בעולם דימיוני בתקופת ימי הביניים בו בני אדם מתקיימים לצד שדים הנקראים יומה. מפלצות אלו, אשר ניזונות מבני אדם, מסוגלות להשתלט על הזכרונות ועל המראה של טרפן, ובכך מצליחות להסתוות בתוך החברה האנושית עד הרגע בו הן תוקפות.\nקבוצת לוחמות המשתייכות לארגון חסר-שם יוצאות להילחם ולהשמיד את היומה. הלוחמות מכונות בפי העם \"קליימור\", על שם חרבותיהן הגדולות אותן הן נושאות. ארגון זה מצא דרך לערבב את דמן ובשרן עם דמם ובשרם של היומה ולהפוך אותן, לא תמיד בהסכמה, ליצורי-כלאיים: חצי-יומה, חצי-בנות-אדם.\nהסיפור מתמקד בהרפתקאותיה של הקליימור קלייר, הנלחמת ביומה תוך שהיא מנסה לשמור על אנושיותה.","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":23,"status":"הסתיים","aired_from":"2007-04-04","season":{"label":"אביב 2007","year":2007,"season":"spring"},"broadcast":{"label":"רביעי 01:26","day":"wednesday","time":"01:26","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Gore","he":"גור"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Fantasy"],"studios":["Madhouse"],"producers":["VAP","Avex Entertainment","Nippon Television Network","D.N. Dream Partners","Arts Pro"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.73,"mal_scored_by":349785,"israel":7.0,"israel_scored_by":3,"rank":1385,"popularity":326,"members":735287,"favorites":9133},"community_reviews":{"ratings":3,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/21834l.webp"},"trailer":{"youtube_id":"c5DDD0ofspk","url":"https://www.youtube.com/watch?v=c5DDD0ofspk","embed_url":"https://www.youtube.com/embed/c5DDD0ofspk"},"characters":[{"n