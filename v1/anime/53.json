{"id":53,"mal_id":53,"anizone_id":53,"url":"https://anizone.co.il/anime/53/Ai-Yori-Aoshi","slug":"Ai-Yori-Aoshi","titles":{"hebrew":"איי יורי אאושי","english":"Ai Yori Aoshi","romaji":"Ai Yori Aoshi","japanese":"藍より青し","synonyms":["Bluer Than Indigo"],"community":[],"known":["Ai Yori Aoshi","藍より青し","Bluer Than Indigo"]},"synopsis_hebrew":"קאורו האנאבישי, סטודנט במכללה שחי לבד, פגש בתחנת רכבת נערה יפה אך מבולבלת לבושה בקימונו. הוא התנדב להדריך אותה לכתובת שחיפשה, שהתבררה כקרובה לשכונתו, אך התגלה שהיא מגרש ריק. לא יודע מה לעשות הלאה, קאורו הזמין את הנערה המיואשת לדירתו וביקש ממנה רמזים נוספים על יעדה. היא סיפקה לו תמונה של שני ילדים שקאורו זיהה מיד כעצמו וכאוי סאקוראבה, חברתו מילדות. התברר שהנערה מולו היא אוי סאקוראבה בעצמה, ארוסתו המיועדת שהגיעה כל הדרך לטוקיו כדי להינשא לו. הגילוי שלה לא רק שהפתיע אותו, אלא גם הזכיר לקאורו את הסיבה העמוקה ביותר לעזיבתו את משפחת האנאבישי מלכתחילה.","background_hebrew":null,"type":"TV","episodes":24,"duration_minutes":23,"status":"הסתיים","aired_from":"2002-04-11","season":{"label":"אביב 2002","year":2002,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Harem","he":"הרמון (נשים)"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Comedy","Drama","Romance"],"studios":["J.C.Staff"],"producers":["Movic","Fuji TV","Pioneer LDC","Cosmic Ray"],"licensors":["Funimation","Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":7.1,"mal_scored_by":55892,"israel":null,"israel_scored_by":null,"rank":4385,"popularity":2202,"members":118210,"favorites":480},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1311/154076l.webp"},"trailer":{"youtube_id":"4wyQ6ZAojI8","url":"https://www.youtube.com/watch?v=4wyQ6ZAojI8","embed_url":"https://www.youtube.com/embed/4wyQ6ZAojI8"},"characters":[{"name":"Sakuraba, Aoi","role":