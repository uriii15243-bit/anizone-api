{"id":21353,"mal_id":21353,"anizone_id":21353,"url":"https://anizone.co.il/anime/21353/Tokyo-ESP","slug":"Tokyo-ESP","titles":{"hebrew":"טוקיו ESP","english":"Tokyo ESP","romaji":"Tokyo ESP","japanese":"東京ESP","synonyms":[],"community":[],"known":["Tokyo ESP","東京ESP"]},"synopsis_hebrew":"רינקה אורושיבה עובדת במשרה חלקית כמלצרית כדי לעזור לאביה המובטל. על פי כל הדיווחים, חייה בטוקיו הם יחסית נורמליים—אך תחושת הנורמליות שלה מתחילה להתפוגג כאשר היא רואה יום אחד פינגווין מעופף ללא הסבר. כשהיא רודפת אחריו עד לראש בניין, היא נתקלת בהפתעות נוספות, כולל דגי זהב מעופפים ואדם נוסף—חבר לכיתה בשם קיוטארו אזומה—שגם הוא יכול לראות את הדברים המוזרים הללו. לאחר שרינקה מתעלפת כשדג זהב עובר דרכה, היא מתעוררת כאספרית עם היכולת להעביר את גופה דרך חומר מוצק.\n\nעם זאת, היכולת החדשה שלה אינה הדבר המוזר היחיד בה: כאשר היא משתמשת בכוחותיה, שיערה הופך ללבן. לאחר שהיא מחליטה בחוסר רצון להשתמש במתנה החדשה הזו כדי לעזור לעיר, היא הופכת לגיבורה החדשה של טוקיו, המכונה \"הנערה הלבנה\". יחד עם קיוטארו, שזכה בכוח הטלפורטציה, רינקה מתחילה לתקן את העוולות בעיר תוך כדי מאבק באספרים אחרים שיש להם כוונות הרבה פחות אצילות.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2014-07-12","season":{"label":"קיץ 2014","year":2014,"season":"summer"},"broadcast":{"label":"שבת 01:35","day":"saturday","time":"01:35","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Sci-Fi"],"studios":["Xebec"],"producers":["Lantis","Kadokawa Shoten","Rakuonsha","KlockWorx","Tokyo MX"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.55,"mal_scored_by":75118,"israel":null,"israel_scored_by":null,"rank":7813,"popularity":1614,"members":175587,"favorites":190},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/10/64587l.webp"},"t