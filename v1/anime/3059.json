{"id":3059,"mal_id":3059,"anizone_id":3059,"url":"https://anizone.co.il/anime/3059/Ninja-Robots","slug":"Ninja-Robots","titles":{"hebrew":"רובוטי נינג'ה","english":"Ninja Robots","romaji":"Ninja Senshi Tobikage","japanese":"忍者戦士飛影","synonyms":[],"community":[],"known":["Ninja Senshi Tobikage","Ninja Robots","忍者戦士飛影"]},"synopsis_hebrew":"נינג'ה סנשי טוביקאגה מספר את סיפורו של נער בשם ג'ו מאיה. יום אחד, ג'ו, שחי על מאדים, עד לקרב בין חייזרים. אלו מכוכב זאבום תוקפים את הנסיכה מכוכב רדוריוס, שברחה מהקיסר של זאבום שמתכנן לכבוש את היקום ונחתה נחיתת חירום על מאדים.\n\nג'ו מוצא את עצמו על סיפון ספינתה של הנסיכה, מה שמתחיל שרשרת אירועים שתשנה את חייהם. ג'ו וחבריו מפעילים שלושה חיות מכניות עוצמתיות נגד הקיסר של זאבום וכוחותיו, אך הסיכויים נגדם. כאשר כל התקווה נראית אבודה, רובוט נינג'ה מסתורי בשם טוביקאגה מופיע כאילו משום מקום כדי לספק עזרה. היכולת שלו להתמזג עם שלוש החיות המכניות מעניקה לטוביקאגה כוח שאין שני לו, ובעזרתו ג'ו נלחם בכוחות זאבום...\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":43,"duration_minutes":24,"status":"הסתיים","aired_from":"1985-10-06","season":{"label":"סתיו 1985","year":1985,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mecha","he":"רובוטים"},{"en":"Space","he":"חלל"}],"demographic":null,"genres":["Adventure","Sci-Fi"],"studios":["Studio Pierrot"],"producers":[],"licensors":["Discotek Media"],"source":null,"rating":null,"scores":{"mal":7.01,"mal_scored_by":1789,"israel":null,"israel_scored_by":null,"rank":4906,"popularity":9187,"members":5993,"favorites":23},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/7/20897l.webp"},"trailer":{"youtube_id":"qd0BpcpahZI","url":"https://www.youtube.com/watch?v=qd0BpcpahZI","embed_url":"https://www.youtube.com/embed/qd0BpcpahZI"},"characters":[{"name":"Maya, Joe","role":"ראשי","image":"https://cdn.myanime