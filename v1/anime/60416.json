{"id":60416,"mal_id":60416,"anizone_id":60416,"url":"https://anizone.co.il/anime/60416/Martial-Peak","slug":"Martial-Peak","titles":{"hebrew":"פסגת הלחימה","english":"Martial Peak","romaji":"Wu Lian Dianfeng","japanese":"武炼巅峰","synonyms":[],"community":[],"known":["Wu Lian Dianfeng","Martial Peak","武炼巅峰"]},"synopsis_hebrew":"יאנג קאי, תלמיד ניסיון ומנקה רצפות בפביליון לינגשיאו בז'ונגדו, הורד לדרגת תלמיד ניסיון בשל כישוריו הנמוכים. אם לא יצליח להשיג דבר בתוך שלוש שנים, הוא יגורש מהכת. יאנג קאי במקרה השיג כרית אבן מסתורית, שפתחה בפניו כישורים מסתוריים כמו הגוף הזהוב הגאה. לאחר מכן, הוא המשיך להתאמן, שובר את גבולותיו בעזרת אופיו העקשן כצעיר, ולבסוף עמד בראש מערת הירושה. יאנג קאי וסו יאן ירשו יחד את הכישורים המסתוריים, והמשיכו להתחיל את סיפורו של יאנג קאי להפוך לאגדה ולהגיע לשיא אמנויות הלחימה.\n\n(מקור: Tencent, תורגם)","background_hebrew":"עיבוד לרומן הרשת בעל אותו השם מאת מו מו (莫默).","type":"ONA","episodes":48,"duration_minutes":13,"status":"הסתיים","aired_from":"2024-12-05","season":{"label":"סתיו 2024","year":2024,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Martial Arts","he":"אומנויות לחימה"}],"demographic":null,"genres":["Action","Adventure","Fantasy"],"studios":["CG Year"],"producers":["Tencent Animation & Comics","Tencent Video","China Literature Limited"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.2,"mal_scored_by":444,"israel":null,"israel_scored_by":null,"rank":3855,"popularity":14310,"members":1392,"favorites":12},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1447/146747l.webp"},"trailer":{"youtube_id":"CKrSHKJnOR8","url":"https://www.youtube.com/watch?v=CKrSHKJnOR8","embed_url":"https://www.youtube.com/embed/CKrSHKJnOR8"},"characters":[{"name":"Kai, Yang","role":"ראשי","image":"htt