{"id":63640,"mal_id":63640,"anizone_id":63640,"url":"https://anizone.co.il/anime/63640/Bless","slug":"Bless","titles":{"hebrew":"ברכה","english":"Bless","romaji":"Bless","japanese":"ブレス","synonyms":[],"community":["בליס"],"known":["Bless","ブレス"]},"synopsis_hebrew":"בכיתה רועשת, מחשבותיו של אאיה אודאגאווה בן ה-15 רחוקות מאוד מהנושא הנדון. בעוד חבריו לכיתה בוחרים בו כדוגמן לתחרות האמנים של פסטיבל אאוי בזכות ניסיונו הקודם בדוגמנות, אודאגאווה מתבונן בג'ון סומיסאקי, נערה גבוהה ומגושמת שנראית נבוכה מהנמשים הייחודיים שלה ומגובהה המרשים. השניים מצוותים כדוגמנית ומעצב אופנה — אך אודאגאווה מתאבל בייאוש על חלומו הנטוש להפוך למאפר.\n\nאודאגאווה שכנע את עצמו מזמן שאין לו כישרון, ולסומיסאקי חסר הביטחון להרים את ראשה ולהשוויץ בתווי פניה המדהימים. למרות זאת, סומיסאקי מציעה שיחליפו תפקידים: לאודאגאווה יהיה חופש יצירתי מלא, והיא תצעד באומץ על המסלול כפי שאמה לימדה אותה פעם. דמויות בולטות מתעשיית הזוהר יצפו בהם, אך ייתכן שזה יהיה הדחף שאודאגאווה זקוק לו כדי לחזור לעולם האופנה והיופי ולכבוש אותו לצד הדוגמנית האהובה עליו.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":"ברכה שודרה ברצועת noitaminA של Fuji TV.","type":"TV","episodes":null,"duration_minutes":0,"status":"עדיין לא שודר","aired_from":"2027-01-08","season":{"label":"חורף 2027","year":2027,"season":"winter"},"broadcast":{"label":"שישי 23:30","day":"friday","time":"23:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Visual Arts","he":"אומנות חזותית"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Drama"],"studios":["A-1 Pictures"],"producers":["Aniplex"],"licensors":[],"source":null,"rating":null,"scores":{"mal":0.0,"mal_scored_by":7,"israel":null,"israel_scored_by":null,"rank":null,"popularity":6993,"members":11803,"favorites":28},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1122/160916l.webp"},"trailer":{"youtube_id":"1IcjukAV03Q","url":"https://www.youtube.com/watch?v=1IcjukAV03Q","embed_url":"https://www.youtube.com/embed/1IcjukA