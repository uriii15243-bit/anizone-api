{"id":1450,"mal_id":1450,"anizone_id":1450,"url":"https://anizone.co.il/anime/1450/Brigadoon","slug":"Brigadoon","titles":{"hebrew":"בריגדון","english":"Brigadoon","romaji":"Brigadoon: Marin to Melan","japanese":"ブリガドーン まりんとメラン","synonyms":["Brigadoon Marin and Melan","MariMera","Brigadoon Marin and Melan, MariMera"],"community":[],"known":["Brigadoon: Marin to Melan","Brigadoon","ブリガドーン まりんとメラン","Brigadoon Marin and Melan","MariMera"]},"synopsis_hebrew":"מרין היא נערה טיפוסית בחטיבת הביניים עם אופי שמח ומשפחה מאמצת אוהבת. חייה משתנים באופן דרסטי כאשר מיראז' מסתורי מופיע בשמיים מעל כל כדור הארץ. אנדרואידים קטלניים בשם מונומאקיה יורדים לכדור הארץ מהתצורה בשמיים הנקראת בריגדון ומתחילים לצוד את מרין הקטנה. היא מגלה בקבוק כחול במקדש בזמן שהיא מחפשת מפלט, ומהבקבוק יוצא מגן, חייזר נושא חרב ואקדח בשם מלן בלו. יחד הם חייבים להציל את כדור הארץ ולהתמודד עם משברים משפחתיים, דעות קדומות בבית הספר והמשטרה, ולהבין את עברה של מרין ואת משימתו הבלתי מוסברת של מלן, כמו גם ללמוד לסמוך אחד על השני. העלילה מתרחשת ביפן של שנת 1969 עם צוות צבעוני של חברים ואויבים.\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":24,"status":"הסתיים","aired_from":"2000-07-21","season":{"label":"קיץ 2000","year":2000,"season":"summer"},"broadcast":{"label":"שישי 19:30","day":"friday","time":"19:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mecha","he":"רובוטים"}],"demographic":null,"genres":["Adventure","Comedy","Drama","Sci-Fi"],"studios":["Sunrise"],"producers":["Bandai Visual"],"licensors":["Tokyopop"],"source":null,"rating":null,"scores":{"mal":7.35,"mal_scored_by":4079,"israel":null,"israel_scored_by":null,"rank":2916,"popularity":6132,"members":16314,"favorites":171},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/7/75820l.webp"},"trailer":{"youtube_id":"LIBnpOhpbT4","url":"https://