{"id":30382,"mal_id":30382,"anizone_id":30382,"url":"https://anizone.co.il/anime/30382/Aquarion-Logos","slug":"Aquarion-Logos","titles":{"hebrew":"אקווריון לוגוס","english":"Aquarion Logos","romaji":"Aquarion Logos","japanese":"アクエリオンロゴス","synonyms":[],"community":[],"known":["Aquarion Logos","アクエリオンロゴス"]},"synopsis_hebrew":"במשך אלפי שנים לאחר פיתוחה, השתמשה האנושות במילה הכתובה לתקשורת בין אנשים ודורות. ככל שהמילניום חלף והטכנולוגיה הפכה לנפוצה יותר, הכתיבה - וכך גם התקשורת בכללותה - הלכה ופחתה, עד שניתן היה למצוא אותה רק בטלפונים סלולריים ובמסכי מחשב. בראותו הזדמנות, המכשף סוגן קנזאקי מתחיל להדביק מילים בווירוס נסטה, שמחייה אותן והופך אותן למפלצות הנקראות MJBK (Menace of Japanese with Biological Kinetic energy).\n\nכדי להתמודד עם ההתקפה הזו נגד האנושות, ארגון הידוע בשם DEAVA (Division of EArth Verbalism Ability) מאגד קבוצת צעירים עם היכולת של \"ורבליזם\". הם צריכים להטיס את מכונות הווקטור, המשמשות ליצירת המכאות המכונות \"אקוואריונים\". הקלף הפראי במצב הזה הוא הצעיר שמכנה את עצמו \"המושיע\", שהוא קרוב משפחה ישיר של קליגרף מפורסם, בשם אקירה קייבוקי.","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":24,"status":"הסתיים","aired_from":"2015-07-03","season":{"label":"קיץ 2015","year":2015,"season":"summer"},"broadcast":{"label":"שישי 00:00","day":"friday","time":"00:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mecha","he":"רובוטים"}],"demographic":null,"genres":["Fantasy","Romance","Sci-Fi"],"studios":["Satelight"],"producers":["C2C"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":5.76,"mal_scored_by":7845,"israel":null,"israel_scored_by":null,"rank":12386,"popularity":5127,"members":25727,"favorites":22},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/74989l.webp"},"trailer":{"youtube_id":"flcYx70r4aE","url":"https://www.youtube.com/watch?v=flcYx70r4aE","embed_u