{"id":2216,"mal_id":2216,"anizone_id":2216,"url":"https://anizone.co.il/anime/2216/Shigurui-Death-Frenzy","slug":"Shigurui-Death-Frenzy","titles":{"hebrew":"שיגורוי: דת' פרנזי","english":"Shigurui: Death Frenzy","romaji":"Shigurui","japanese":"シグルイ","synonyms":["Crazy for Death"],"community":[],"known":["Shigurui","Shigurui: Death Frenzy","シグルイ","Shigurui : Furie Meurtrière","Crazy for Death"]},"synopsis_hebrew":"בתחילת תקופת אדו, כאשר אנשים נהנו מתקופה של שלום, הלורד טוקוגאווה טדאנאגה מקיים טורניר לחימה. בעבר, הקרבות נערכו עם חרבות עץ. הפעם, ישתמשו בחרבות אמיתיות.\n\nפוג'יקי גננוסוקה בעל היד האחת ואיראקו סייגן העיוור ילחמו זה בזה בקרב הזה. שניהם תלמידים של איוומוטו קוגן, הידוע כלוחם החרבות הגדול ביותר ביפן. כל אחד מהם נחוש להוכיח שהוא היורש של בית הספר של איוומוטו. עם זאת, יכול להיות רק אלוף אחד.\n\nכך מתחילה סיפור של גורלות משתלבים, קונפליקט וגורלות מוזרים.\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2007-07-19","season":{"label":"קיץ 2007","year":2007,"season":"summer"},"broadcast":{"label":"חמישי 23:30","day":"thursday","time":"23:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Drama","he":"דרמה"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Gore","he":"גור"},{"en":"Historical","he":"היסטורי"},{"en":"Martial Arts","he":"אומנויות לחימה"},{"en":"Psychological","he":"פסיכולוגיה"},{"en":"Samurai","he":"סמוראי"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Drama","Suspense"],"studios":["Madhouse"],"producers":["WOWOW","Akita Shoten","Artist Management Office","Geneon Entertainment"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.35,"mal_scored_by":40656,"israel":7.0,"israel_scored_by":null,"rank":2956,"popularity":1966,"members":137375,"favorites":1014},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1