{"id":1678,"mal_id":1678,"anizone_id":1678,"url":"https://anizone.co.il/anime/1678/Cyborg-009","slug":"Cyborg-009","titles":{"hebrew":"סייבורג 009","english":"Cyborg 009","romaji":"Cyborg 009: The Cyborg Soldier","japanese":"サイボーグ009 THE CYBORG SOLDIER","synonyms":[],"community":[],"known":["Cyborg 009: The Cyborg Soldier","Cyborg 009","サイボーグ009 THE CYBORG SOLDIER"]},"synopsis_hebrew":"סקאל, המנהיג המרושע של ארגון הטרור הידוע בשם בלאק גוסט, שולט בתשעה סייבורגים חזקים. אך ד\"ר אייזק גילמור, המדען של בלאק גוסט בתחום הסייברנטיקה, מחליט למרוד ולעזור לסייבורגים להתנגד לסקאל ולארגון המרושע שלו.\n\nבלאק גוסט שואף להתחיל את המלחמה העולמית הגדולה הבאה על ידי הצפת השוק בנשק להשמדה המונית. נראה שהתשעה הסייבורגים האמיצים עומדים בפני משימה קשה, שכן בלאק גוסט נחוש להפיל את אותם תשעה סייבורגים.","background_hebrew":"סייבורג 009: חייל הסייבורג הוא עיבוד מודרני של סדרת סייבורג 009 שמספר מחדש ארבעה מהעלילות המרכזיות שלה. 48 הפרקים הראשונים דומים מאוד לסדרה המקורית, בעוד שהפרקים 49-51 הם בלעדיים ל-OVA ומבוססים באופן רופף על הפרק האחרון הבלתי גמור של המנגה.","type":"TV","episodes":50,"duration_minutes":24,"status":"הסתיים","aired_from":"2001-10-14","season":{"label":"סתיו 2001","year":2001,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Sci-Fi"],"studios":["Japan Vistec"],"producers":["TV Tokyo","Shaft","Avex Entertainment","Brain's Base","Avex Mode"],"licensors":["Sony Pictures Entertainment","Discotek Media"],"source":null,"rating":null,"scores":{"mal":7.3,"mal_scored_by":13710,"israel":null,"israel_scored_by":null,"rank":3175,"popularity":4292,"members":38351,"favorites":211},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/5/21620l.webp"},"trailer":null,"characters":[{"name":"Shimamura, Joe","rol