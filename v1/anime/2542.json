{"id":2542,"mal_id":2542,"anizone_id":2542,"url":"https://anizone.co.il/anime/2542/Lady-Georgie","slug":"Lady-Georgie","titles":{"hebrew":"ליידי ג'ורג'י","english":"Lady Georgie","romaji":"Lady Georgie","japanese":"レディジョージィ","synonyms":["Joaninha"],"community":[],"known":["Lady Georgie","レディジョージィ","Georgie","Joaninha"]},"synopsis_hebrew":"חקלאי אוסטרלי חוזר הביתה מהיער עם תינוקת בשם ג'ורג'י. הילדה חיה מבלי לדעת את הסוד הנורא המסתתר בצמיד הזהב שעל ידה. \"אביה\" ו\"אחיה\", אבל וארתור, אוהבים אותה מאוד, אך \"אמה\" רואה בה פולשת ולא מצליחה לפתוח את ליבה אליה. ג'ורג'י גדלה והופכת לנערה יפהפייה, ושני \"אחיה\" מאוהבים בה עד עמקי נשמתם. מבלי לדעת את האמת, ג'ורג'י מתאהבת בנכדו הנאה של מושל בריטניה. כאשר האם סוף סוף מגלה לה את האמת ומגנה אותה על היותה בתו של גולה, ג'ורג'י עוזבת לבריטניה בחיפוש אחר הוריה האמיתיים - ואחר אהבתה, שגם הוא עזב את אוסטרליה. אבל וארתור עוקבים אחריה ושלושתם נזרקים אל תוך העולם האכזרי של האריסטוקרטיה הלונדונית, שקרים ותככים.","background_hebrew":null,"type":"TV","episodes":45,"duration_minutes":24,"status":"הסתיים","aired_from":"1983-04-09","season":{"label":"אביב 1983","year":1983,"season":"spring"},"broadcast":{"label":"שבת 19:00","day":"saturday","time":"19:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Historical","he":"היסטורי"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Drama","Romance"],"studios":["Tokyo Movie Shinsha"],"producers":["TV Asahi","Asatsu DK"],"licensors":["Discotek Media"],"source":null,"rating":null,"scores":{"mal":7.21,"mal_scored_by":4876,"israel":null,"israel_scored_by":null,"rank":3757,"popularity":6882,"members":12259,"favorites":77},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1271/92965l.webp"},"trailer":null,"characters":[{"name":"Buttman, Georgie","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/3/45383.webp?s=adbcaeb44a188f67127533d3b2f5c9e5","voice_actors":[{"name":