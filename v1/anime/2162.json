{"id":2162,"mal_id":2162,"anizone_id":2162,"url":"https://anizone.co.il/anime/2162/Koutetsu-Sangokushi","slug":"Koutetsu-Sangokushi","titles":{"hebrew":"קוטטסו סנגוקושי","english":"Koutetsu Sangokushi","romaji":"Koutetsu Sangokushi","japanese":"鋼鉄三国志","synonyms":[],"community":[],"known":["Koutetsu Sangokushi","鋼鉄三国志"]},"synopsis_hebrew":"חותם הקיסר עבר מדור לדור מאז ימי קדם. הוא מעניק כוח רב ללוחמים שהוא בוחר. זהו סיפורם של אותם לוחמים.\n\nזהו זמן של כאוס ומלחמת אזרחים. זהו זמן שבו צבאות גדולים מתנגשים בקרבות אדירים וגיבורים גדולים חורטים את שמותיהם בהיסטוריה. זהו גם זמן של מוות והרס, כאשר תושבי הארץ חיים בפחד מתמיד מהחרב. אל הבמה הזו נכנס ריקוסון (לו שון) המהסס, שמשפחתו הייתה שומרת חותם הקיסר עד שנגנב על ידי סונסאקו. בהוראת המנטור שלו, ריקוסון מציע את שירותיו לסונסאקו במטרה לאשר את רצון חותם הקיסר. עם זאת, מתנקשים מפילים את סונסאקו והחותם הקיסרי אובד. כך מתחיל מסעו של ריקוסון להשיב את חותם הקיסר ולגלות את ייעודו.\n\nמקור: AniDB","background_hebrew":null,"type":"TV","episodes":25,"duration_minutes":23,"status":"הסתיים","aired_from":"2007-04-06","season":{"label":"אביב 2007","year":2007,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"}],"subcategories":[{"en":"Historical","he":"היסטורי"}],"demographic":null,"genres":["Adventure"],"studios":["Picture Magic"],"producers":["Nihon Ad Systems"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.28,"mal_scored_by":2820,"israel":null,"israel_scored_by":null,"rank":9517,"popularity":7553,"members":9763,"favorites":14},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/75661l.webp"},"trailer":null,"characters":[{"name":"Shoukatsuryou, Koumei","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/15/52092.webp?s=a860d4446fb0b28001d362655b39ade1","voice_actors":[{"name":"Koyasu, Takehito","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/1/63375