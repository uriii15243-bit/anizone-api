{"id":31414,"mal_id":31414,"anizone_id":31414,"url":"https://anizone.co.il/anime/31414/Rainbow-Days","slug":"Rainbow-Days","titles":{"hebrew":"ימי קשת בענן","english":"Rainbow Days","romaji":"Nijiiro Days","japanese":"虹色デイズ","synonyms":["Nijiiro Days"],"community":[],"known":["Nijiiro Days","Rainbow Days","虹色デイズ"]},"synopsis_hebrew":"כשהחברה של נאטסוקי האשיבה נפרדת ממנו במפתיע בערב חג המולד, נאטסוקי נשבר ופורץ בבכי באמצע הרחוב עד שנערה בחליפת סנטה-קלאוס מציעה לו טישו. הוא מתאהב באותה הנערה מיד, ולמזלו, הוא והנערה, ששמה אנה קובאיאקאווה, לומדים באותו בית-ספר. נאטסוקי מנסה לחזר אחרי אנה עם קצת עזרה מהחברים שלו, שגם שואפים להתקדם במערכות היחסים שלהם.\n\nהאנימה סובבת סביב החיים הססגוניים ומערכות היחסים הרומנטיות של ארבעה תלמידי תיכון: נאטסוקי האשיבה, נער שאוהב לחלום ובעל הזיות אהבה; טומויה מאטסונאגה, נרקיסיסט שיוצא עם כמה בנות בו-זמנית; קאיצ'י קאטאקורה, סדיסט סוטה שתמיד נושא עמו שוט; וטסויושי נאואה, אוטאקו בעל חברה קוספליירית.","background_hebrew":"צוות המדבבים של תקליטור הדרמה, שיצא בשנת 2014 יחד עם הכרך השביעי של המנגה, לקח גם על עצמו את תפקידי הדמויות הראשיות בעיבוד האנימה.","type":"TV","episodes":24,"duration_minutes":13,"status":"הסתיים","aired_from":"2016-01-10","season":{"label":"חורף 2016","year":2016,"season":"winter"},"broadcast":{"label":"ראשון 22:00","day":"sunday","time":"22:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Comedy","Romance"],"studios":["Production Reed"],"producers":["Tokuma Japan","Shueisha","Kyoraku Industrial Holdings","Yomiuri TV Enterprise"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.26,"mal_scored_by":104196,"israel":7.0,"israel_scored_by":null,"rank":3463,"popularity":1170,"members":249043,"favorites":738},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/8/76691l.webp"},"trailer":{"y