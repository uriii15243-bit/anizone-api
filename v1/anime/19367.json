{"id":19367,"mal_id":19367,"anizone_id":19367,"url":"https://anizone.co.il/anime/19367/Galilei-Donna-Storia-di-tre-sorelle-a-caccia-di-un-mistero","slug":"Galilei-Donna-Storia-di-tre-sorelle-a-caccia-di-un-mistero","titles":{"hebrew":"גליליי דונה: סטוריה די טרה סורלה א קאצ'ה די און מיסטרו","english":"Galilei Donna: Storia di tre sorelle a caccia di un mistero","romaji":"Galilei Donna","japanese":"ガリレイドンナ","synonyms":["Galilei Donna: the story of three sisters in the search of a mystery"],"community":[],"known":["Galilei Donna","Galilei Donna: Storia di tre sorelle a caccia di un mistero","ガリレイドンナ","Galilei Donna: the story of three sisters in the search of a mystery"]},"synopsis_hebrew":"שלוש אחיות, הוזוקי, קזוקי והזוקי, הן צאצאיות של גלילאו ויש להן אישיות וטעמים שונים לחלוטין; הן אף פעם לא מסכימות זו עם זו. יום אחד, הבנות מותקפות לפתע על ידי ארגון מסתורי. הארגון חיפש את \"גלילאו טסורו\" שגלילאו גליליי נאמר כי גילה. עדיין לא מודעות למה שמתרחש, האחיות נמלטות על ספינת האוויר שהן בנו לאחר ההתקפה הפתאומית. אבל זה לא יהיה כל כך קל לשלוש האחיות הללו לעזור זו לזו במצבי חירום כשהן כל הזמן במחלוקת אחת עם השנייה. מהו הטסורו, ומה הארגון מחפש? ומה לגבי הקשר בין האחיות? זהו שילוב של בנות חמודות, פעולה ומסתורין!\n\nמקור: Fuji Creative","background_hebrew":null,"type":"TV","episodes":11,"duration_minutes":22,"status":"הסתיים","aired_from":"2013-10-11","season":{"label":"סתיו 2013","year":2013,"season":"fall"},"broadcast":{"label":"שישי 00:50","day":"friday","time":"00:50","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Action","Adventure","Sci-Fi"],"studios":["A-1 Pictures"],"producers":["Aniplex","Dentsu","Fuji TV","Asahi Production","Kyoraku Industrial Holdings"],"licensors":["Discotek Media","Crunchyroll"],"source":null,"rating":null,"scores":{"mal":6.43,"mal_scored_by":24222,"israel":null,"israel_scored_by":null,"rank":8558,"popularity":3527