{"id":38440,"mal_id":38440,"anizone_id":38440,"url":"https://anizone.co.il/anime/38440/Shikizakura","slug":"Shikizakura","titles":{"hebrew":"שיקיזאקורה","english":"Shikizakura","romaji":"Shikizakura","japanese":"シキザクラ","synonyms":[],"community":[],"known":["Shikizakura","シキザクラ"]},"synopsis_hebrew":"שיקיזאקורה: המקום שבו פריחת הדובדבן בשיאה בעוד העצים צבועים בעלים של סתיו. במקום המיוחד הזה, שבו העולם החולף פוגש את עולם הרוחות, טקס להצלת האנושות עומד להתחיל...\n\nתלמיד התיכון קקרו מיווה, בעקבות תפנית מוזרה של אירועים, מוצא את עצמו כחבר לא רגיל בצוות חליפות כוח המיועד להילחם באוני. האוני משתלטים על בני אדם ומנסים להיאחז בעולם החולף. רק חליפת הכוח, יורוי, שמשלבת סודות עתיקים עם הטכנולוגיה המתקדמת ביותר, יכולה להגן על אנשים מפני האוני. קקרו מחליט להפוך לגיבור שיילחם באוני ויגן על אוקה מיוג'ין, הכוהנת שנועדה להציל את העולם.\n\nעונת שיקיזאקורה. אוקה רוקדת ככוהנת בין עלי הסתיו ופריחת הדובדבן. פעולה הירואית—שבה העבר והעתיד, העולם החולף ועולם הרוחות, מחשבות ומשאלות, כולם מצטלבים—מתחילה כאן!\n\nמקור: MAL News","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2021-10-10","season":{"label":"סתיו 2021","year":2021,"season":"fall"},"broadcast":{"label":"ראשון 01:55","day":"sunday","time":"01:55","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Action","Drama","Sci-Fi"],"studios":["Sublimation"],"producers":["Chukyo TV Broadcasting"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":5.82,"mal_scored_by":3580,"israel":null,"israel_scored_by":null,"rank":12109,"popularity":5829,"members":18666,"favorites":50},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1175/116578l.webp"},"trailer":{"youtube_id":"apsCoPlfzIk","url":"https://www.youtube.com/watch?v=apsCoPlfzIk","embed_url":"https://www.youtube.com/embed/apsCoPlfzIk"},"characters":[