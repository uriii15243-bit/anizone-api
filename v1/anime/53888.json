{"id":53888,"mal_id":53888,"anizone_id":53888,"url":"https://anizone.co.il/anime/53888/Spy-x-Family-Code-White","slug":"Spy-x-Family-Code-White","titles":{"hebrew":"משפחה חשאית הסרט: קוד לבן ","english":"Spy x Family Code: White","romaji":"Spy x Family Movie: Code: White","japanese":"SPY×FAMILY CODE: White","synonyms":[],"community":[],"known":["Spy x Family Movie: Code: White","Spy x Family Code: White","SPY×FAMILY CODE: White"]},"synopsis_hebrew":"לויד פורג'ר, מרגל מובחר, מוזהר על ידי המפעיל שלו שהוא עשוי להיות מחדש ממשימתו המתמשכת, מבצע סטריקס. כדי לשמור על מעמדו, עליו להתקדם באופן משמעותי לעבר מטרות המבצע, אשר כרוך בכך שבתו המאמצת אניה תזכה במספיק כוכבי סטלה כדי להפוך למלגת אימפריאל באקדמיה של עדן. לאחר שנודע לו על תחרות בישול המעניקה לתלמיד הזוכה כוכב סטלה, לויד חוקר את הקינוח המועדף על השופט כדי לעזור להגדיל את הסיכויים של אניה. עם זאת, שחזור מושלם של מרמר האהוב של השופט דורש יותר מאשר רק בעקבות מתכון. לפיכך, משפחת פורג'ר יוצאת לחופשה באזור פריג'יס כדי לנסות מיזוג אותנטי. לא הכל הולך חלק בטיול, כמו משפחת פורג'ר בסופו של דבר שזור במזימה זדונית להצית מחדש מלחמה בין המדינות אוסטניה וווסטאליס.","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":110,"status":"הסתיים","aired_from":"2023-12-22","season":{"label":"סתיו 2023","year":2023,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"Childcare","he":"טיפול בילדים"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Comedy"],"studios":["Wit Studio","CloverWorks"],"producers":["TV Tokyo","Shogakukan-Shueisha Productions","TOHO animation","Shueisha"],"licensors":["Crunchyroll"],"source":null,"rating":null,"scores":{"mal":8.1,"mal_scored_by":129172,"israel":7.33,"israel_scored_by":3,"rank":615,"popularity":1102,"members":267355,"favorites":755},"community_reviews":{"ratings":3,"written_reviews":0},"images