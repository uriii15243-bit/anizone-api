{"id":1537,"mal_id":1537,"anizone_id":1537,"url":"https://anizone.co.il/anime/1537/Ryu-the-Primitive-Boy","slug":"Ryu-the-Primitive-Boy","titles":{"hebrew":"ריו הילד הפרימיטיבי","english":"Ryu the Primitive Boy","romaji":"Genshi Shounen Ryuu","japanese":"原始少年リュウ","synonyms":["Genshi Shonen Ryu"],"community":[],"known":["Genshi Shounen Ryuu","Ryu the Primitive Boy","原始少年リュウ","Genshi Shonen Ryu"]},"synopsis_hebrew":"כאשר ריו נולד, השבט שלו מנסה להקריב אותו לטירנוזאורוס בשם שיראנו בגלל צבע עורו. עם זאת, הוא ניצל על ידי קוף שמגדל אותו כבנה שלה. בינתיים, אמו של ריו עזבה את השבט ויצאה למסע כדי למצוא את ריו.\n\n16 שנים לאחר מכן, ריו פוגש נערה בשם רן שנמכרה לשבט שממנו ריו במקור הגיע. השבט לא שמח לראות את ריו בחיים ומנסה להקריב אותו שוב, הפעם על ידי שריפתו בחיים. לפני שהם מצליחים לבצע את המעשה, השבט נטבח יחד עם אמו המאמצת של ריו על ידי שיראנו. ריו יוצא אז למסע יחד עם רן כדי למצוא את אמו ואת אחיה של רן, דון.","background_hebrew":null,"type":"TV","episodes":22,"duration_minutes":25,"status":"הסתיים","aired_from":"1971-10-30","season":{"label":"סתיו 1971","year":1971,"season":"fall"},"broadcast":{"label":"שבת 19:00","day":"saturday","time":"19:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Sci-Fi"],"studios":["Toei Animation"],"producers":["TBS"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.51,"mal_scored_by":953,"israel":null,"israel_scored_by":null,"rank":8040,"popularity":11409,"members":3147,"favorites":8},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/6/26879l.webp"},"trailer":null,"characters":[{"name":"Karim","role":"משני","image":"https://cdn.myanimelist.net/images/characters/15/193663.webp?s=d3e86afa09d5edba7e1cc4d76ab41e4d","voice_actors":[{"name":"Mine, Eken","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceact