{"id":19769,"mal_id":19769,"anizone_id":19769,"url":"https://anizone.co.il/anime/19769/Magical-Warfare","slug":"Magical-Warfare","titles":{"hebrew":"לוחמה קסומה","english":"Magical Warfare","romaji":"Mahou Sensou","japanese":"魔法戦争","synonyms":["Mahosen"],"community":[],"known":["Mahou Sensou","Magical Warfare","魔法戦争","Mahosen"]},"synopsis_hebrew":"האנימה מספרת על טאקשי, תלמיד תיכון רגיל למדי עם עבר מעט אפל, שיום אחד נתקל בתלמידה שמעולם לא ראה מתמוטטת בבית הספר. אחרי שהתלמידה מתאוששת, היא מספרת לטאקשי שקוראים לה מואי, שהיא קוסמת ושהיא בטעות הפכה גם את טאקשי לאחד כזה.\nמואי חושפת בפני טאקשי ובפני שנים מחבריו עולם מקביל לעולמנו, עולם שנהרס לגמרי במלחמת קוסמים שעדיין מתרחשת. טאקשי וחבריו עומדים כעת בפני מכשולים רבים והמון דברים חדשים ללמוד, בתקווה שיוכלו לעזור ולהביא לסיומה של המלחמה.","background_hebrew":"\"Mahou Sensou\" מעבד את שבעת הרומנים הראשונים מסדרת הרומנים הקלים של היסאשי סוזוקי באותו שם.","type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2014-01-10","season":{"label":"חורף 2014","year":2014,"season":"winter"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Action","Fantasy"],"studios":["Madhouse"],"producers":["Media Factory","TBS","flying DOG"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":5.95,"mal_scored_by":120141,"israel":null,"israel_scored_by":null,"rank":11381,"popularity":1097,"members":268339,"favorites":346},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/58103l.webp"},"trailer":{"youtube_id":"oCbrgJoHuuw","url":"https://www.youtube.com/watch?v=oCbrgJoHuuw","embed_url":"https://www.youtube.com/embed/oCbrgJoHuuw"},"characters":[{"name":"Aiba, Mui","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/3/327482.webp?s=103e6d1f7615188f951cd84c8dcf9ce3",