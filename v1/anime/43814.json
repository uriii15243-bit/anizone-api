{"id":43814,"mal_id":43814,"anizone_id":43814,"url":"https://anizone.co.il/anime/43814/Battle-Game-in-5-Seconds","slug":"Battle-Game-in-5-Seconds","titles":{"hebrew":"משחק קרב ב-5 שניות","english":"Battle Game in 5 Seconds","romaji":"Deatte 5-byou de Battle","japanese":"出会って5秒でバトル","synonyms":["Dea5","Battle in 5 seconds after meeting.","Dea5, Battle in 5 seconds after meeting."],"community":[],"known":["Deatte 5-byou de Battle","Battle Game in 5 Seconds","出会って5秒でバトル","Dea5","Battle in 5 seconds after meeting."]},"synopsis_hebrew":"זה היה רק בוקר רגיל.\n\nאקירה שירויאנגי, תלמיד תיכון שאוהב משחקים וקונפייטו (ממתקים יפניים), נגרר פתאום לשדה קרב על ידי נערה מסתורית שקוראת לעצמה מיון. המשתתפים מקבלים הודעה שהם \"נמחקו מרישום המשפחה, מעורבים בניסוי, ורכשו כוחות מסוימים.\"\n\nאקירה נחוש לנצח במשחק עם כוחותיו החדשים ולהשמיד את הארגון. חמוש בכוח שאף אחד לא מצפה לו ובכישורי ה\"מוח\" שלו, מתחיל עידן חדש של קרב אינטלקטואלי!\n\n(מקור: MU, נערך)","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2021-07-13","season":{"label":"קיץ 2021","year":2021,"season":"summer"},"broadcast":{"label":"שלישי 00:00","day":"tuesday","time":"00:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"High Stakes Game","he":"משחקי מזל"},{"en":"Strategy Game","he":"משחק אסטרטגיה"},{"en":"Super Power","he":"כוחות מיוחדים"},{"en":"Survival","he":"הישרדות"}],"demographic":null,"genres":["Action","Suspense"],"studios":["SynergySP","Vega Entertainment"],"producers":["Shogakukan-Shueisha Productions","Pony Canyon","Bushiroad","Studio A-CAT","Tokyo MX","Fields","Kansai TV","BS11","Bandai Spirits"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.74,"mal_scored_by":116426,"israel":7.5,"israel_scored_by":2,"rank":6480,"popularity":1195,"members":246119,"favorites":985},"community_reviews":{"ratings":2,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/image