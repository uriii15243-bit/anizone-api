{"id":38740,"mal_id":38740,"anizone_id":38740,"url":"https://anizone.co.il/anime/38740/White-Snake","slug":"White-Snake","titles":{"hebrew":"נחש לבן","english":"White Snake","romaji":"Bai She: Yuanqi","japanese":"白蛇：缘起","synonyms":[],"community":[],"known":["Bai She: Yuanqi","White Snake","白蛇：缘起","La Serpiente Blanca: El Origen"]},"synopsis_hebrew":"שיאו-באי, שדה נחש לבנה, נשלחת למשימה להתנקש ביועץ הטאואיסטי של הקיסר, אשר הורג נחשים בהמוניהם כדי להשיג חיי נצח ולזכות בחסדיו של הקיסר. עם זאת, שיאו-באי מותקפת על ידי עוזריו של היועץ לפני שהיא מצליחה להגיע אליו, והיא מובסת. למרבה המזל, סיכת השיער הדמונית שקיבלה מאם הנחשים מצליחה להציל את חייה במחיר זיכרונותיה.\n\nשיאו-באי מתעוררת בכפר לוכדי הנחשים, מבלי לדעת שהיא למעשה שדה או שהיא מוקפת באויביה המושבעים. היא פוגשת את שו שואן, האיש שהציל אותה, ומתפתה אליו. השניים יוצאים למסע לגלות מי היא שיאו-באי וללמוד את סודה של סיכת השיער הדמונית שלה. השניים נרדפים על ידי שיאו-צ'ינג, אחותה של שיאו-באי, שנשבעה לאם הנחשים להחזיר את שיאו-באי תוך שלושה ימים או למות בניסיון. כאשר טאואיסטים, שדים ובני אדם מתנגשים, סיפור אהבה אסור מתגלה.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":98,"status":"הסתיים","aired_from":"2019-01-11","season":{"label":"חורף 2019","year":2019,"season":"winter"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Martial Arts","he":"אומנויות לחימה"},{"en":"Mythology","he":"מיתולוגיה"}],"demographic":null,"genres":["Action","Adventure","Drama","Fantasy","Romance"],"studios":["Light Chaser Animation Studios"],"producers":["Warner Bros. Pictures"],"licensors":["GKIDS"],"source":null,"rating":null,"scores":{"mal":7.49,"mal_scored_by":4945,"israel":null,"israel_scored_by":null,"rank":2254,"popularity":7208,"members":10