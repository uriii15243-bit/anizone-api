{"id":4651,"mal_id":4651,"anizone_id":4651,"url":"https://anizone.co.il/anime/4651/Crayon-Kingdom-of-Dreams","slug":"Crayon-Kingdom-of-Dreams","titles":{"hebrew":"ממלכת הקריון של החלומות","english":"Crayon Kingdom of Dreams","romaji":"Yume no Crayon Oukoku","japanese":"夢のクレヨン王国","synonyms":[],"community":[],"known":["Yume no Crayon Oukoku","Crayon Kingdom of Dreams","夢のクレヨン王国"]},"synopsis_hebrew":"תושבי ממלכת הקריון תמיד ראו את הנסיכה סילבר כילדה בת שתים עשרה עם חיוך יפה. עם זאת, מבלי שידעו, לנסיכה יש 12 הרגלים רעים. הדבר יצר מצוקה רבה לראש הממשלה הזיקית ולשרי הקריון, שכן זה יהיה מביך אם הדבר יתגלה. יום אחד נערכה מסיבה לחגוג את יום הולדתה השתים עשרה של הנסיכה סילבר. הנסיכה ניסתה למצוא את הנסיך המקסים שלה ושכחה לשים לב להרגלים הרעים שלה. אחד מהבנים במסיבה כעס כל כך עד שהפך את הוריה של סילבר, המלך והמלכה, לאבן. כדי לשבור את הקללה ולהציל את הוריה, סילבר החליטה לצאת למסע כדי לאתר את הבן. יחד עם חבריה, סילבר מתחילה את ההרפתקה שלה.","background_hebrew":null,"type":"TV","episodes":70,"duration_minutes":24,"status":"הסתיים","aired_from":"1997-09-07","season":{"label":"סתיו 1997","year":1997,"season":"fall"},"broadcast":{"label":"ראשון 08:30","day":"sunday","time":"08:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Adventure","Comedy","Fantasy"],"studios":["Toei Animation"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.47,"mal_scored_by":1361,"israel":null,"israel_scored_by":null,"rank":2377,"popularity":9409,"members":5624,"favorites":44},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/11/28591l.webp"},"trailer":null,"characters":[{"name":"Princess Silver","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/12/452758.webp?s=543970716e0c73e1ca59bf52e99a8937","voice_actors":[{"name":"Tokumitsu, Yuka","language":"יפנית","image":"https://cdn.myanimelis