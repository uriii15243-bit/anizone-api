{"id":16201,"mal_id":16201,"anizone_id":16201,"url":"https://anizone.co.il/anime/16201/Flowers-of-Evil","slug":"Flowers-of-Evil","titles":{"hebrew":"פרחי הרע","english":"Flowers of Evil","romaji":"Aku no Hana","japanese":"惡の華","synonyms":["Aku no Hana"],"community":[],"known":["Aku no Hana","Flowers of Evil","惡の華","Aku no Hana: Flowers of Evil"]},"synopsis_hebrew":"קאסוגה טאקאו הוא תלמיד יפני טיפוסי; יש לו קצת חברים מטומטמים, הורים דואגים ואפילו קראש על הבחורה הכי זוהרת בכיתה. למרות כל זה, קאסוגה מנסה לברוח מהמציאות ומהעיר המשעממת בה הוא חי באמצעות קריאת ספרים. אחד מהספרים שנפלו לידיו הוא \"פרחי הרע\", ספר שזעזע תרבותית רבים בעת הופעתו, מלא בארוטיקה ובסגידה לשטן. חייו של קאסוגה משתנים מהקצה אל הקצה בעוד תלמידה מהכיתה שלו, סאווה נאקמורה, שמזעזעת בהתנהגותה אחרים בדיוק כמו את קוראי הספר עצמו, מגלה על טעות שעשה ומחליטה לסחוט אותו בדרכים שונות שמטרתן להפגין לעולם את ה\"סוטה\" שבו.","background_hebrew":"\"אקו נו האנה\" נחשב לאנימה הראשונה שהשתמשה בהרחבה בטכניקת הרוטוסקופינג. האנימה מעבדת את 20 הפרקים הראשונים של המנגה. הסדרה יצאה ביפן על גבי Blu-ray ו-DVD מה-21 באוגוסט 2013 עד ה-25 בדצמבר 2013, ובצפון אמריקה על ידי Sentai Filmworks ב-8 ביולי 2014.","type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2013-04-05","season":{"label":"אביב 2013","year":2013,"season":"spring"},"broadcast":{"label":"שישי 22:00","day":"friday","time":"22:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Psychological","he":"פסיכולוגיה"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Drama","Romance","Suspense"],"studios":["Zexcs"],"producers":["Starchild Records","Animax","Kodansha","KlockWorx","GANSIS","Aquatone"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.16,"mal_scored_by":87146,"israel":null,"israel_scored_by":null,"rank":4037,"popularity":1154,"members":253240,"favorites":3436},"com