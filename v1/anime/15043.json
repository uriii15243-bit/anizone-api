{"id":15043,"mal_id":15043,"anizone_id":15043,"url":"https://anizone.co.il/anime/15043/Haitai-Nanafa","slug":"Haitai-Nanafa","titles":{"hebrew":"הייטאי נאנאפה","english":"Haitai Nanafa","romaji":"Haitai Nanafa","japanese":"はいたい七葉","synonyms":["Haitai Nana Fa"],"community":[],"known":["Haitai Nanafa","はいたい七葉","Haitai Nana Fa"]},"synopsis_hebrew":"נאנאפה קיאן גרה באוקינאווה עם סבתה שמנהלת את חנות הסובה \"קאמה סובה\", אחותה הגדולה והיפה נאו שלומדת בתיכון, ואחותה הצעירה קוקונה, שלומדת בבית ספר יסודי ויש לה יכולת חזקה לחוש את העל-טבעי.\n\nיום אחד, נאנאפה רואה חותם נופל מעץ פיקוס סיני, ושלושה רוחות שחיות בעץ הזה משתחררות. הרוחות כוללות את נינה ורנה, שהן רוחות \"ג'ימונאה\". הרוח השלישית היא איאנה, שהיא התגלמות של פסל אריה אוקינאווי. כאשר רוחות מתחילות להופיע אחת אחרי השנייה, החיים השקטים של נאנאפה ומשפחתה מתחילים להשתנות.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":3,"status":"הסתיים","aired_from":"2012-10-06","season":{"label":"סתיו 2012","year":2012,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[],"demographic":null,"genres":["Comedy","Supernatural"],"studios":["Passione"],"producers":["Ryukyu Asahi Broadcasting"],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.86,"mal_scored_by":3962,"israel":null,"israel_scored_by":null,"rank":11856,"popularity":6920,"members":12102,"favorites":14},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/12/45991l.webp"},"trailer":null,"characters":[{"name":"Kyan, Nanafa","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/16/301496.webp?s=52deefbbb10f796dbf018fd8b3028491","voice_actors":[{"name":"Yonamine, Ritsu","language":"יפנית","image":null}]},{"name":"Iina","role":"משני","image":"https://cdn.myanimelist.net/images/characters/13/301484.webp?s=c235d79d8bb4561a9ff216c1862a7cc4","voice_