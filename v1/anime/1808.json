{"id":1808,"mal_id":1808,"anizone_id":1808,"url":"https://anizone.co.il/anime/1808/Kamichama-Karin","slug":"Kamichama-Karin","titles":{"hebrew":"קאמיצ'אמה קארין","english":"Kamichama Karin","romaji":"Kamichama Karin","japanese":"かみちゃまかりん","synonyms":["Kami-chama Karin","Little Goddess Karin","Kami-chama Karin, Little Goddess Karin"],"community":[],"known":["Kamichama Karin","かみちゃまかりん","Kami-chama Karin","Little Goddess Karin"]},"synopsis_hebrew":"קרין הנאזונו בת השלוש-עשרה מרגישה שחייה לא יכולים להיות גרועים יותר. הוריה נפטרו כשהייתה צעירה, והשאירו אותה עם דודה שלא מהססת לקרוא לה טיפשה וחסרת תועלת בגלל ציוניה הנמוכים. החבר היחיד שלה, החתול שלה בשם שי-צ'אן, נפטר לאחרונה, מה שהותיר אותה לגמרי לבד. כל מה שנותר לה מהוריה הוא טבעת שנתנה לה אמה, שהיא שומרת עליה כעל הדבר היחיד שנותר לה מהעבר.\n\nהסיפור של \"קמיצ'אמה קרין\" מתחיל ברגע שבו חייה משתנים לטובה, כאשר היא פוגשת את הימקה קוג'ו, ילדה חמודה שגם היא איבדה את הוריה, ואת קזונה קוג'ו, בן דודה שמוצא בנות כטרחה, שניהם מחפשים אחר אלת. טבעת הזיכרון של אמה זוהרת בנוכחותם וממלאת אותה באור שלה, מה שהופך אותה לחכמה יותר, מהירה יותר, ובעלת יכולת להעניק משאלות. מתברר שהטבעת שלה מאפשרת לה להפוך לאלת שהם חיפשו, ועכשיו כשהיא התעוררה לכוח הזה, אחרים יבואו בעקבותיה כדי להשיג אותו...","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":24,"status":"הסתיים","aired_from":"2007-04-06","season":{"label":"אביב 2007","year":2007,"season":"spring"},"broadcast":{"label":"שישי 17:30","day":"friday","time":"17:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Mahou Shoujo","he":"ילדות קסומות"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Comedy","Romance"],"studios":["Satelight"],"producers":["Broccoli","Nihon Ad Systems","Pony Canyon","Studio Kelmadick"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.2,"mal_scored_by":23687,"israel":null,"israel_scored_by":null,"rank":3823,"popularity":3452,"me