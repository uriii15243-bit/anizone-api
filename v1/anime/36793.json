{"id":36793,"mal_id":36793,"anizone_id":36793,"url":"https://anizone.co.il/anime/36793/Real-Girl","slug":"Real-Girl","titles":{"hebrew":"חברה תלת מימדית: חברה אמיתית","english":"Real Girl","romaji":"3D Kanojo: Real Girl","japanese":"3D彼女 リアルガール","synonyms":["3D Girlfriend"],"community":[],"known":["3D Kanojo: Real Girl","Real Girl","3D彼女 リアルガール","3D Girlfriend"]},"synopsis_hebrew":"\n\nטסוטסואי היקארי הוא תלמיד תיכון שמסתפק בבנות הוירטואליות שהוא פוגש במשחקי הוידאו והאנימה. אין לו הרבה חברים ונראה שהוא חי בעולם משלו.\n\nיום אחד, הוא נאלץ לנקות את בריכת בית הספר ביחד עם איגאראשי אירוהא, שהיא התגלמות כל התכונות שהוא מתעב בבנות אמיתיות: היא מבריזה מבית ספר, ההתנהגות שלה בוטה, אין לה חברות ונראה שהיא די זנותית. עם זאת, היא מתנהגת בחברותיות להיקארי ואף מתנגדת לאלו שצוחקים עליו. אך המרירות ובעיות האמון של היקארי גורמות לו להגיד לה דברים נחרצים למדי כלפיה, אבל היא עדיין לא משנה את דעתה עליו.\n\nאחרי זמן מה, נראה כי אירוהא תהפוך להיות החברה האמיתית (התלת-מימדית) הראשונה שלו! כיצד יתמודד היקארי עם הסיטואציה החדשה אליה נקלע?\n","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":22,"status":"הסתיים","aired_from":"2018-04-04","season":{"label":"אביב 2018","year":2018,"season":"spring"},"broadcast":{"label":"רביעי 01:59","day":"wednesday","time":"01:59","timezone":"Asia/Tokyo"},"categories":[{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Otaku Culture","he":"תרבות האוטקו"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Romance"],"studios":["Hoods Entertainment"],"producers":["VAP","Nippon Television Network","DeNA"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":6.86,"mal_scored_by":186089,"israel":3.67,"israel_scored_by":3,"rank":5700,"popularity":740,"members":380050,"favorites":1688},"community_reviews":{"ratings":3,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1327/93616l.webp"},"trailer":{"youtube_id":"NIHvbYdxdfo","url":"https://www.youtube.