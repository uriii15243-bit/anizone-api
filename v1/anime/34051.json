{"id":34051,"mal_id":34051,"anizone_id":34051,"url":"https://anizone.co.il/anime/34051/Akibas-Trip-The-Animation","slug":"Akibas-Trip-The-Animation","titles":{"hebrew":"אקיבה'ס טריפ האנימציה","english":"Akiba's Trip The Animation","romaji":"Akiba's Trip The Animation","japanese":"AKIBA'S TRIP THE ANIMATION","synonyms":[],"community":[],"known":["Akiba's Trip The Animation","AKIBA'S TRIP THE ANIMATION","Akiba's Trip the Animation"]},"synopsis_hebrew":"האוטאקו האחים טמוצו וניווקא דנקיגאי עושים קניות באקיהברה כאשר המקום מוצף במפלצות קוספליי ערפדיות! היצורים הללו, המכונים \"באגד וואנס\", יכולים להשתלט על כל מי שהם נושכים ובמהרה הם מתחילים לגרום למהומה ברחבי העיר. כאשר טמוצו מוצא את עצמו בחסדי אחד מהיצורים הללו, הוא ניצל על ידי מטומה מאיונקה המסתורית, שמחזיקה מחבט בייסבול. יחד, הם נלחמים בעוד כמה מפגשים עם הבאגד וואנס, אך לא עובר זמן רב וטמוצו נפצע אנושות כשהוא מגן על מטומה. ללא ברירה אחרת, היא מחייה אותו כבאגד וואן ברמה גבוהה - בדיוק כמוה!\n\nטמוצו ומטומה, יחד עם האוטאקו הקוספליירית הנלהבת אריסה אהוקיינן, מרכיבים את הקבוצה \"המאיונז החשמלי\" והם מתחילים לחסל את הבאגד וואנס בדרך היחידה שהם מכירים: על ידי קריעת הבגדים שלהם וחשיפתם לאור השמש!\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2017-01-04","season":{"label":"חורף 2017","year":2017,"season":"winter"},"broadcast":{"label":"רביעי 22:30","day":"wednesday","time":"22:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Otaku Culture","he":"תרבות האוטקו"},{"en":"Parody","he":"פרודיה"},{"en":"Urban Fantasy","he":"פנטזיה אורבנית"}],"demographic":null,"genres":["Action","Comedy","Fantasy","Ecchi"],"studios":["Gonzo"],"producers":["AT-X","DLE","Studio Mausu","BS Fuji","Tokyo MX","Evil Line Records","Docomo Anime Store","bilibili","DMM.com","Sotsu Music Publishing","Exa International"],"licensors":["Funimation"],"s