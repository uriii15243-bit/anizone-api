{"id":39686,"mal_id":39686,"anizone_id":39686,"url":"https://anizone.co.il/anime/39686/Magic-Han-War-Season-2","slug":"Magic-Han-War-Season-2","titles":{"hebrew":"מאג'יק האן וור עונה 2","english":"Magic Han War Season 2","romaji":"Mabeob Chunjamun Season 2","japanese":"마법천자문 시즌2","synonyms":[],"community":[],"known":["Mabeob Chunjamun Season 2","Magic Han War Season 2","마법천자문 시즌2"]},"synopsis_hebrew":"העונה השנייה של Mabeob Chunjamun. היא לא שודרה בתלת מימד סטריאוסקופי.\n\nעולם הקסם של האן מביא שלום לאחר ששר הכאוס נחתם. עם זאת, צללי החושך שולטים שוב! אבל יום אחד, שר החמדנות תוקף לפתע ושורף את הר הקופים. אוקי מנסה להביס את שר החמדנות, אך משום מה הוא לא מצליח להשתמש בקסם האן! שר החמדנות מפיל את אוקי ומחריב את מקל הקסם. הזמן השקט נגמר עבור אוקי וליבו פועם שוב. רובי ובובו מגיעים לעזור מאי המסתורין. אוקי יוצא למסע פעם נוספת. עליו להציל את מקל הקסם ולהשיג את השריון המיוחד שלו כדי למנוע את הקונספירציה של תחיית שר הכאוס. תנו למסע מלחמת הקסם של האן להתחיל שוב!\n\n(מקור: האתר הרשמי)","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":25,"status":"הסתיים","aired_from":"2015-01-01","season":{"label":"לא צויין","year":null,"season":null},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"}],"subcategories":[{"en":"Martial Arts","he":"אומנויות לחימה"}],"demographic":{"en":"Kids","he":"Kids"},"genres":["Action","Adventure"],"studios":[],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":0.0,"mal_scored_by":40,"israel":null,"israel_scored_by":null,"rank":18881,"popularity":24917,"members":178,"favorites":0},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1664/100459l.webp"},"trailer":null,"characters":[{"name":"Son, Oh-gong","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/15/643222.webp","voice_actors":[]},{"name":"Don-don","role":"משני","image":"https://cdn.myanimelist.net/im