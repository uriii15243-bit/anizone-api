{"id":30405,"mal_id":30405,"anizone_id":30405,"url":"https://anizone.co.il/anime/30405/From-Heart-to-Heart","slug":"From-Heart-to-Heart","titles":{"hebrew":"מלב אל לב","english":"From Heart to Heart","romaji":"Ishindenshin Shiyou","japanese":"以心伝心しよう","synonyms":["Ishin-denshin Shiyou","Minna no Uta","Ishin-denshin Shiyou, Minna no Uta"],"community":[],"known":["Ishindenshin Shiyou","From Heart to Heart","以心伝心しよう","Ishin-denshin Shiyou","Minna no Uta"]},"synopsis_hebrew":"עיבוד של שיר שיצא בעבר עבור FM מיאזאקי ג'וי, פרסומת לקמפיין בטיחות בדרכים של תחנת רדיו מקומית. השיר בפרסומת היה כל כך פופולרי שאנשים ביקשו לשדר את הפרסומת במקום שירים רגילים. בסופו של דבר, NHK רכשה את הזכויות להציג וליצור וידאו קליפ לגרסה נקייה של השיר (חלק משמעותי מהמילים שונה). זה היה מקרה נדיר שכן מדובר באחד השירים הבודדים של \"מינה נו אוטה\" שהגיעו משדרנים פרטיים, שכן כמעט כולם נוצרים על ידי שדרנים ציבוריים כמו NHK עצמם.\n\nהגרסה המחודשת עדיין הייתה להיט פופולרי והוצגה בתוכנית \"מינה נו אוטה\" במשך 4 חודשים ברציפות.","background_hebrew":null,"type":"Music","episodes":1,"duration_minutes":2,"status":"הסתיים","aired_from":"1993-06-01","season":{"label":"אביב 1993","year":1993,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[],"subcategories":[{"en":"Music","he":"מוזיקה"}],"demographic":{"en":"Kids","he":"Kids"},"genres":[],"studios":[],"producers":["NHK"],"licensors":[],"source":null,"rating":null,"scores":{"mal":4.78,"mal_scored_by":301,"israel":null,"israel_scored_by":null,"rank":null,"popularity":18178,"members":588,"favorites":0},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/88077l.webp"},"trailer":null,"characters":[],"staff":[{"name":"Furukawa, Taku","role":"במאי","roles":["במאי"],"image":"https://cdn.myanimelist.net/images/voiceactors/2/31987.jpg?s=35ee04f2b8261fb786e627e5433a9d1f"}],"external_links":{"myanimelist":"https://myanimelist.net/anime/30405","other":["http://www2.nhk.or.