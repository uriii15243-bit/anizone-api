{"id":63098,"mal_id":63098,"anizone_id":63098,"url":"https://anizone.co.il/anime/63098/Psyren","slug":"Psyren","titles":{"hebrew":"פסיירן","english":"Psyren","romaji":"Psyren","japanese":"PSYЯEN -サイレン-","synonyms":["Siren"],"community":[],"known":["Psyren","PSYЯEN -サイレン-","Siren"]},"synopsis_hebrew":"אגהה יושינה הוא תלמיד תיכון בעל ביטחון עצמי שעוזר לאחרים תמורת תשלום. בדרכו חזרה מעבודה, הוא מוצא בתא טלפון כרטיס חיוג מוזר שהושאר מאחור, ועליו מוטבעת המילה \"פסיירן\". הוא מחליט לשמור אותו, בלי לדעת מה מטרתו. כבר למחרת, אגהה מגלה שלסאקוראקו אממיה, חברתו לכיתה, יש כרטיס חיוג זהה. כשהוא שואל אותה על כך, סאקוראקו מבקשת ממנו להציל אותה, ובכך מסמנת את היום שבו מתחילות צרותיו.\n\nאגהה מבולבל מנסיבות המפגש, ומבין שמשהו לא בסדר כשסאקוראקו נעלמת. בניסיון להבין מה קורה, הוא מחליט להתקשר למספר שמופיע על כרטיס החיוג. קול מסתורי שואל אותו שורת שאלות, המסתיימת בשאלה אחרונה וחידתית: \"האם תרצה לנסוע לפסיירן?\" כך מתחילה השתתפותם של שני בני הנוער במשחק של חיים ומוות בעולם מוזר, שבו שוכנות מפלצות המכונות טאבו. השניים מקבלים את היכולת להשתמש בכוחות על-חושיים המכונים פסי, ונלחמים כדי לחזור למקום שהם קוראים לו בית.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":null,"type":"TV","episodes":null,"duration_minutes":23,"status":"בשידור","aired_from":"2026-10-05","season":{"label":"סתיו 2026","year":2026,"season":"fall"},"broadcast":{"label":"שני 23:00","day":"monday","time":"23:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Romance","he":"רומנטיקה"},{"en":"Sci-Fi","he":"מדע בדיוני"},{"en":"Supernatural","he":"על טבעי"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"High Stakes Game","he":"משחקי מזל"},{"en":"Psychological","he":"פסיכולוגיה"},{"en":"Strategy Game","he":"משחק אסטרטגיה"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Romance","Sci-Fi","Supernatural","Suspense"],"studios":["Satelight"],"producers":["Studio Pierrot","KlockWorx","Shueisha","Kadokawa Media House","Nichion","Kadokawa","REMOW"],"licensors":[],"source":null,"r