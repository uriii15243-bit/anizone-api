{"id":31931,"mal_id":31931,"anizone_id":31931,"url":"https://anizone.co.il/anime/31931/Full-Metal-Panic-Invisible-Victory","slug":"Full-Metal-Panic-Invisible-Victory","titles":{"hebrew":"פול מטאל פאניק! אינויזיבל ויקטורי","english":"Full Metal Panic! Invisible Victory","romaji":"Full Metal Panic! Invisible Victory","japanese":"フルメタル・パニック！Invisible Victory","synonyms":["Full Metal Panic! IV"],"community":[],"known":["Full Metal Panic! Invisible Victory","フルメタル・パニック！Invisible Victory","Full Metal Panic! IV"]},"synopsis_hebrew":"התלמידה הרועשת קאנמה צ'ידורי והחייל סוסוקה סאגארה נהנים מחיי תיכון מאושרים. עם זאת, ימיהם השקטים מופרעים על ידי ארגון הטרור המאיים אמלגם. לאונרד טסטארוסה, חבר בארגון שמחזיק ב\"מלחששים\", מבקש להשיג את קאנמה ואת הידע שלה.\n\nהמאבק של קאנמה וסוסוקה נגד אמלגם מתחיל ממש בשכונתם, ומוביל אותם למסע ציד ברחבי העולם. מהארצות האקזוטיות של לאוס ועד לחוף המקסיקני הצחיח, סוסוקה חייב לאסוף מודיעין כדי להפיל את אמלגם. בינתיים, היכולות של קאנמה גדלות, אך גם התסכול שלה גובר כשהנחישות שלה מתערערת. לכודים במשחק מחבואים אינטנסיבי ובתוכניות אסטרטגיות, השניים מנסים להתחבר ולדחוף את עצמם מעבר לגבולותיהם.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2018-04-13","season":{"label":"אביב 2018","year":2018,"season":"spring"},"broadcast":{"label":"שישי 20:30","day":"friday","time":"20:30","timezone":"Asia/Tokyo"},"categories":[],"subcategories":[{"en":"Mecha","he":"רובוטים"},{"en":"Military","he":"צבאי"}],"demographic":null,"genres":[],"studios":["Xebec"],"producers":["Kadokawa Shoten","AT-X","KlockWorx","Memory-Tech","Tokyo MX","Bandai Namco Entertainment","Hakuhodo","Bandai Namco Arts"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.58,"mal_scored_by":42552,"israel":7.0,"israel_scored_by":null,"rank":1879,"popularity":2313,"members":109612,"favorites":295},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/