{"id":1571,"mal_id":1571,"anizone_id":1571,"url":"https://anizone.co.il/anime/1571/Ghost-Hunt","slug":"Ghost-Hunt","titles":{"hebrew":"ציד רוחות","english":"Ghost Hunt","romaji":"Ghost Hunt","japanese":"ゴーストハント","synonyms":[],"community":[],"known":["Ghost Hunt","ゴーストハント"]},"synopsis_hebrew":"בזמן הלימודים, מאי טניאמה וחבריה אוהבים להחליף סיפורי רוחות. מסתבר שיש בניין בית ספר נטוש בקמפוס שלהם שהוא מרכז להרבה סיפורי רוחות. במהלך הסיפור, הם מופרעים על ידי דמות גברית מסתורית. מתברר שהאדם הוא קזויה שיבויה, בן 17, נשיא חברת המחקר הפסיכי שיבויה. הוא נקרא על ידי המנהל לחקור את הסיפורים סביב בניין בית הספר הנטוש.\n\nלמחרת, בדרכה לבית הספר, מאי עוברת ליד הבניין המדובר. בזמן שהיא בוחנת מצלמה מוזרה שראתה בפנים, היא מופתעת על ידי העוזר של קזויה. בלי לדעת שהיא מפריעה לחקירה, מאי שוברת את המצלמה והעוזר של קזויה נפצע.\n\nקזויה שוכר את מאי בכוח כדי לשלם על המצלמה ולהחליף את העוזר הפצוע שלו. מאותו רגע, מאי מתחילה ללמוד על העולם העל-טבעי ועל מקצוע ציד הרוחות.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":null,"type":"TV","episodes":25,"duration_minutes":24,"status":"הסתיים","aired_from":"2006-10-04","season":{"label":"סתיו 2006","year":2006,"season":"fall"},"broadcast":{"label":"רביעי 01:00","day":"wednesday","time":"01:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Horror","he":"אימה"},{"en":"Mystery","he":"מסתורין"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Horror","Mystery","Supernatural"],"studios":["J.C.Staff"],"producers":["TV Tokyo","Avex Entertainment","Marvelous Entertainment","Delfi Sound"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.74,"mal_scored_by":104739,"israel":6.0,"israel_scored_by":null,"rank":1353,"popularity":1199,"members":245575,"favorites":3152},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/11/73908l.webp"},"trailer":{"youtube_id":"i39YnrNdkcI","url":"https://www.youtube.com/watch?v=i39YnrN