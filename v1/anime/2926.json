{"id":2926,"mal_id":2926,"anizone_id":2926,"url":"https://anizone.co.il/anime/2926/Myself-Yourself","slug":"Myself-Yourself","titles":{"hebrew":"עצמי; עצמך","english":"Myself; Yourself","romaji":"Myself; Yourself","japanese":"マイセルフ; ユアセルフ","synonyms":[],"community":[],"known":["Myself; Yourself","マイセルフ; ユアセルフ"]},"synopsis_hebrew":"לטובת העסק המשפחתי של הוריו, הידאקה סאנה עזב את עיירת הולדתו האהובה, ונאלץ לעבור לטוקיו המרכזית. חמש שנים מאוחר יותר, הוא הופך לתלמיד תיכון ממוצע וחוזר לעיירת הולדתו הותיקה, סאקוראנומורי. סאנה מגלה לצערו שהדברים אינם כפי שנראו ביום בו עזב את המקום השקט והשליו הזה, לפני חמש שנים. לדוגמה, חברת הילדות הטובה ביותר שלו, יאטסוהירו נאנאקה, השתנתה מאז פגישתם האחרונה. ההתקלות בין השניים לא מלבבת במיוחד, וסאנה המבולבל נחוש בדעתו להשיב את חברתו הטובה לשעבר. הוא מגלה לאט לאט על העבר של נאנאקה וההתרחשויות בסאקוראנומורי ב-5 השנים בהן עבר לטוקיו, מתמודד איתן, ועוזר לנאנאקה לבנות עתיד חדש, טוב יותר, ביחד איתו.","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":25,"status":"הסתיים","aired_from":"2007-10-03","season":{"label":"סתיו 2007","year":2007,"season":"fall"},"broadcast":{"label":"רביעי 02:15","day":"wednesday","time":"02:15","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Drama","Romance"],"studios":["Doga Kobo"],"producers":["Marvelous Entertainment","Pony Canyon","Happinet Pictures","5pb."],"licensors":["Maiden Japan"],"source":null,"rating":null,"scores":{"mal":7.1,"mal_scored_by":98122,"israel":null,"israel_scored_by":null,"rank":4424,"popularity":1473,"members":194067,"favorites":778},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/13/75247l.webp"},"trailer":null,"characters":[{"name":"Yatsushiro, Nanaka","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/8/96427.webp?s=45ec5d929e5dc6955f482f6781e6755e","voice_actors":[{"name":"Koshimizu, Am