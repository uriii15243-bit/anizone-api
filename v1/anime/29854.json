{"id":29854,"mal_id":29854,"anizone_id":29854,"url":"https://anizone.co.il/anime/29854/Ushio-Tora-2015","slug":"Ushio-Tora-2015","titles":{"hebrew":"אושיו וטורה (2015)","english":"Ushio & Tora (2015)","romaji":"Ushio to Tora (TV)","japanese":"うしおととら","synonyms":["Ushio and Tora"],"community":[],"known":["Ushio to Tora (TV)","Ushio & Tora (2015)","うしおととら","Ushio & Tora","Ushio and Tora"]},"synopsis_hebrew":"אושיו אאוצוקי הוא תלמיד חטיבת ביניים עקשן ובנו של כוהן מקדש אקסצנטרי, שמנהל את חייו בלי להתייחס לטענות אביו על מפלצות מעולם אחר הידועות כיוקאי. עם זאת, בזמן שהוא מטפל במקדש בזמן שאביו בעבודה, מטלותיו מובילות אותו לגילוי מפתיע: במרתף הוא מוצא יוקאי מאיים שננעץ על ידי חנית החיה האגדית.\n\nהחיה המדוברת היא טורה, הידוע בכוח ההרסני שלו, שמנסה לשכנע את אושיו לשחרר אותו מהחותם של חמש מאות השנים. אושיו לא נותן אמון בדבריו ומסרב לשחרר אותו. אך כאשר התפרצות פתאומית של יוקאי מסכנת את חבריו וביתו, אין לו ברירה אלא להסתמך על טורה, כשהביטוח היחיד שלו הוא החנית העתיקה אם העניינים יצאו משליטה.\n\nהמפגש בין אושיו וטורה הוא רק תחילתה של מסע הצמד הבלתי סביר אל מעמקי העולם הרוחני. עם חנית החיה האגדית בידיו, אושיו יגלה עד כמה העולם העל-טבעי יכול להיות אמיתי ומאיים.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":24,"status":"הסתיים","aired_from":"2015-07-03","season":{"label":"קיץ 2015","year":2015,"season":"summer"},"broadcast":{"label":"שישי 22:30","day":"friday","time":"22:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Mythology","he":"מיתולוגיה"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Supernatural"],"studios":["MAPPA","Studio VOLN"],"producers":["Sotsu","Showgate","Tokuma Japan Communications","Daiichi Shokai"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.57,"mal_scored_by":105760,"israel":7.0,"israel_scored_by":2,"rank":1941,"popularity":1208,"membe