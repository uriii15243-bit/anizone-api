{"id":1250,"mal_id":1250,"anizone_id":1250,"url":"https://anizone.co.il/anime/1250/Elemental-Gelade","slug":"Elemental-Gelade","titles":{"hebrew":"אלמנטל ג'לאדה","english":"Elemental Gelade","romaji":"Erementar Gerad","japanese":"エレメンタルジェレイド","synonyms":["Erementar Gerade"],"community":[],"known":["Erementar Gerad","Elemental Gelade","エレメンタルジェレイド","Elemental Gerad","Erementar Gerade"]},"synopsis_hebrew":"לאחר פשיטה שגרתית, מגלה קוד, פיראט שמיים טירון, מטען יוצא דופן במיוחד בתא המטען של חבריו: רן, \"אדל ריד\", גזע שמוערך על ידי בני אדם בזכות היכולת להעניק כוח לחימה מיוחד לשותפיהם דרך \"ריאקטינג\". הוא מגלה במהרה שרן מוערכת אף יותר ממה שציפה. ספינת הפיראטים מבוקרת על ידי שלושה חברים מסוכנות ההגנה המלאה על אדל ריד \"ארק אייר\", שמנסים לרכוש אותה. כאשר קוד מסרב, הספינה מותקפת לפתע על ידי כוח מסתורי, והקפטן של קוד מטיל עליו את המשימה להגן על רן.\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":24,"status":"הסתיים","aired_from":"2005-04-05","season":{"label":"אביב 2005","year":2005,"season":"spring"},"broadcast":{"label":"שלישי 18:00","day":"tuesday","time":"18:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Fantasy","Romance"],"studios":["Xebec"],"producers":["TV Tokyo","Sotsu","Victor Entertainment","Omnibus Promotion"],"licensors":["Funimation","Discotek Media","Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":7.24,"mal_scored_by":46453,"israel":null,"israel_scored_by":null,"rank":3553,"popularity":2455,"members":101547,"favorites":470},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/2/79163l.webp"},"trailer":null,"characters":[{"name":"Metherlence, Reverie","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/15/50778.webp?s=2906beab3e018d1d