{"id":1965,"mal_id":1965,"anizone_id":1965,"url":"https://anizone.co.il/anime/1965/Sola","slug":"Sola","titles":{"hebrew":"סולה","english":"Sola","romaji":"Sola","japanese":"sola","synonyms":["Sky"],"community":[],"known":["Sola","sola","Sky"]},"synopsis_hebrew":"יוריטו מורימיה אובססיבי לשמיים. הוא במיוחד אוהב לצלם את מגוון הפנים השונות שלהם—זריחות, שקיעות, עננים. באחת מהטיולים המוקדמים שלו לצלם את הזריחה, יוריטו פוגש נערה מוזרה שמתווכחת עם מכונת שתייה. עד שיוריטו מצליח להוציא את מיץ העגבניות של הנערה מהמכונה, היא נעלמת ללא עקבות.\n\nסולה עוקבת אחרי סיפורם של יוריטו, אחותו אאונו, וחבריהם מילדות מאנה וקויורי אישיזוקי, כמו גם אחרי נערה מסתורית שמופיעה ונעלמת, ונראה שהיא נושאת סוד אפל. בעולם שבו קסם ועל-טבעי אינם רחוקים מהשטח, ואף אחד אינו כפי שהוא נראה, אהבה ובדידות מתחרות על עליונות מתחת לשמיים של יוריטו.","background_hebrew":"סולה היה האנימה הראשון שנכתב על ידי היסאיה נאוקי לאחר שעזב את חברת משחקי המחשב Key.","type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2007-04-07","season":{"label":"אביב 2007","year":2007,"season":"spring"},"broadcast":{"label":"שבת 01:28","day":"saturday","time":"01:28","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[],"demographic":null,"genres":["Drama","Romance","Supernatural"],"studios":["Nomad"],"producers":["Lantis"],"licensors":["Bandai Entertainment"],"source":null,"rating":null,"scores":{"mal":7.17,"mal_scored_by":47049,"israel":null,"israel_scored_by":null,"rank":4019,"popularity":2381,"members":105872,"favorites":424},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/7/46119l.webp"},"trailer":{"youtube_id":"E69m9Qarfz8","url":"https://www.youtube.com/watch?v=E69m9Qarfz8","embed_url":"https://www.youtube.com/embed/E69m9Qarfz8"},"characters":[{"name":"Shihou, Matsuri","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/9/39118.webp?s=f4751f3c9aff21