{"id":40403,"mal_id":40403,"anizone_id":40403,"url":"https://anizone.co.il/anime/40403/Sakura-Wars-the-Animation","slug":"Sakura-Wars-the-Animation","titles":{"hebrew":"סאקורה וורס האנימציה","english":"Sakura Wars the Animation","romaji":"Shin Sakura Taisen the Animation","japanese":"新サクラ大戦 the Animation","synonyms":["New Sakura Wars the Animation"],"community":[],"known":["Shin Sakura Taisen the Animation","Sakura Wars the Animation","新サクラ大戦 the Animation","New Sakura Wars the Animation"]},"synopsis_hebrew":"בשנת 1941, שנה לאחר תבוסתו של סוטטסו גנאן, הקפטן סייג'ורו קמיאמה מיחידת הקרב הקיסרית של מחלקת הפרחים בטוקיו יוצא למשימה סודית, וסאקורה אממיה לוקחת זמנית את הפיקוד. בעקבות תקרית באירופה, קמיאמה לוקח ילדה רוסית צעירה בשם קלרה מ. רוז'קובה ומשאיר אותה תחת השגחת מחלקת הפרחים. עם זאת, קפטן יחידת הקרב של מוסקבה, ולרי קמינסקי, נשלח לטוקיו כדי להחזיר את קלרה, ומחלקת הפרחים חייבת לעצור אותו.\n\n(מקור: ויקיפדיה, נערך)","background_hebrew":"שין סאקורה טאיסן האנימציה הוא המשך מקורי למשחק שין סאקורה טאיסן.","type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2020-04-03","season":{"label":"אביב 2020","year":2020,"season":"spring"},"broadcast":{"label":"שישי 22:00","day":"friday","time":"22:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mecha","he":"רובוטים"},{"en":"Performing Arts","he":"אמנות במה"}],"demographic":null,"genres":["Adventure","Sci-Fi"],"studios":["SANZIGEN"],"producers":["Sega","Sammy","Tencent Japan"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":5.95,"mal_scored_by":5632,"israel":null,"israel_scored_by":null,"rank":11395,"popularity":5516,"members":21705,"favorites":26},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1341/105735l.webp"},"trailer":{"youtube_id":"tYbbM7clEYs","url":"https://www.youtube.com/watch?v=tYbbM7clEYs","embed_url":"https://www.youtube.com/embed/tYbbM7clEYs"},