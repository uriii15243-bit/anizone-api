{"id":4186,"mal_id":4186,"anizone_id":4186,"url":"https://anizone.co.il/anime/4186/Chrome-Shelled-Regios","slug":"Chrome-Shelled-Regios","titles":{"hebrew":"כרום שלד רגיוס","english":"Chrome Shelled Regios","romaji":"Koukaku no Regios","japanese":"鋼殻のレギオス","synonyms":["Kokaku no Regios"],"community":[],"known":["Koukaku no Regios","Chrome Shelled Regios","鋼殻のレギオス","Kokaku no Regios"]},"synopsis_hebrew":"בעולם פוסט-אפוקליפטי המוצף ביצורים מוטנטים הנקראים לימביקון או מפלצות זוהמה, האנושות נאלצת לחיות בערים ניידות גדולות הנקראות רגיוס וללמוד להשתמש בנשקים מיוחדים הנקראים דיטה, על ידי ניצול כוח הקיי כדי להגן על עצמם. בעיר האקדמיה זואלני, לייפון אלסייף מקווה להתחיל חיים חדשים ולשכוח את עברו. עם זאת, עברו תפס את תשומת הלב של קריאן לוס, נשיא מועצת התלמידים המניפולטיבי, ונינה אנטאלק, תלמידת אמנויות לחימה וקפטן פלוגת אמנויות הלחימה ה-17, שמיד מזהה את יכולותיו ומחליטה שהוא המועמד המושלם להצטרף לקבוצה שלה. אך עם עבר סודי שלא עוזב אותו וכוחות לא ידועים שמעבר לנורמלי, ייתכן שלייפון לא יוכל להתמודד עם זה.","background_hebrew":null,"type":"TV","episodes":24,"duration_minutes":24,"status":"הסתיים","aired_from":"2009-01-11","season":{"label":"חורף 2009","year":2009,"season":"winter"},"broadcast":{"label":"ראשון 01:00","day":"sunday","time":"01:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Military","he":"צבאי"},{"en":"School","he":"בית ספר"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":null,"genres":["Action","Adventure","Fantasy","Sci-Fi"],"studios":["Zexcs"],"producers":["Kadokawa Shoten","AMG MUSIC"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.27,"mal_scored_by":107530,"israel":null,"israel_scored_by":null,"rank":3380,"popularity":1290,"members":225442,"favorites":1076},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/9/12238l.webp"},"trailer":{"youtub