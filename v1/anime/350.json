{"id":350,"mal_id":350,"anizone_id":350,"url":"https://anizone.co.il/anime/350/Magical-DoReMi","slug":"Magical-DoReMi","titles":{"hebrew":"מאג'יקל דורהמי","english":"Magical DoReMi","romaji":"Ojamajo Doremi","japanese":"おジャ魔女どれみ","synonyms":["Useless Witchgirl Doremi"],"community":[],"known":["Ojamajo Doremi","Magical DoReMi","おジャ魔女どれみ","Useless Witchgirl Doremi"]},"synopsis_hebrew":"הארוקזה דורמי מחשיבה את עצמה כילדה הכי חסרת מזל בעולם. ההורים שלה תמיד רבים, אחותה הקטנה לועגת לה, והבחור שהיא דלוקה עליו מאוהב במישהי אחרת. אם רק הייתה לדורמי שרביט קסמים, חייה היו הרבה יותר טובים—או כך היא חשבה בעבר.\n\nלאחר תקרית עם מכשפה אמיתית, דורמי הופכת לשוליית מכשפה בעצמה, ומתברר שהיא די גרועה בזה גם כן.\n\nעכשיו היא ושתי חברותיה חייבות ללמוד כדי להשתפר בקסמים ולהפוך למכשפות טובות. זאת אומרת, אם הן יצליחו להתרכז בלימודי הקסם שלהן!\n\nשלוש השוליות יצטרכו את כל המזל שהן יכולות להשיג אם הן רוצות לעבור את מבחני המכשפות ולהפוך למכשפות מוסמכות. רק אז יוחזר החוב של דורמי למכשפה מג'וריקה. עד אז, דורמי תישאר ילדה מכשפה חסרת תועלת!","background_hebrew":null,"type":"TV","episodes":51,"duration_minutes":24,"status":"הסתיים","aired_from":"1999-02-07","season":{"label":"חורף 1999","year":1999,"season":"winter"},"broadcast":{"label":"ראשון 08:30","day":"sunday","time":"08:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"Mahou Shoujo","he":"ילדות קסומות"}],"demographic":null,"genres":["Comedy"],"studios":["Toei Animation"],"producers":["Asahi Broadcasting"],"licensors":["4Kids Entertainment"],"source":null,"rating":null,"scores":{"mal":7.38,"mal_scored_by":26897,"israel":null,"israel_scored_by":null,"rank":2792,"popularity":3215,"members":65057,"favorites":947},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1069/133679l.webp"},"trailer":null,"characters":[{"name":"Harukaze, Doremi","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/12/421472.webp?s=80ff8da36c4d07ac793dbc78261dcad2","vo