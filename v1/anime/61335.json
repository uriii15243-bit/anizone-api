{"id":61335,"mal_id":61335,"anizone_id":61335,"url":"https://anizone.co.il/anime/61335/Medalist-Season-2","slug":"Medalist-Season-2","titles":{"hebrew":"המדליסטית עונה 2","english":"Medalist Season 2","romaji":"Medalist 2nd Season","japanese":"メダリスト 第2期","synonyms":[],"community":["מדליסט עונה 2"],"known":["Medalist 2nd Season","Medalist Season 2","メダリスト 第2期"]},"synopsis_hebrew":"מאז שהמאמן המתחיל צוקאסה אקאוראג'י לקח את אינורי יואיצוקה תחת חסותו, היא משפרת את ההחלקה האמנותית שלה בקצב מהיר. אחרי שהיא עוברת מבחן הסמכה, היא זוכה במקום בטורניר מחוז צ'ובו הקרוב, שבו רק חמש מתוך 15 המתחרות יעלו לשלב הבא – טורניר המתחילים היוקרתי של כל יפן. אבל להשיג מקום לא יהיה קל לאינורי: רוב היריבות שלה כבר ניסו את מזלן בתחרות.\n\nהסיכון גבוה כשהתחרות מתחילה, ואחת אחרי השנייה, כל המתחרות נאבקות לתת את ההופעה הטובה ביותר שלהן מול הקהל הגדול. יתרה מכך, הכוכבת העולה של דור ההחלקה האמנותית הנוכחי, היקארו קמיסאקי, לא מתחרה במחוז הזה, מה שמגביר את הנחישות של כולן לעלות שלב. זה כולל את אינורי, שחייבת לנצח את הסיכויים אם היא רוצה לקיים את ההבטחה שלה להגיע להיקארו ולייצג את יפן באולימפיאדה יחד עם צוקאסה.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":"העונה השנייה של מדליסט שודרה ברצועת NUMAnimation של TV Asahi.","type":"TV","episodes":9,"duration_minutes":23,"status":"הסתיים","aired_from":"2026-01-25","season":{"label":"חורף 2026","year":2026,"season":"winter"},"broadcast":{"label":"ראשון 01:30","day":"sunday","time":"01:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Sports","he":"ספורט"}],"subcategories":[{"en":"Performing Arts","he":"אמנות במה"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Drama","Sports"],"studios":["ENGI"],"producers":["TV Asahi","Kodansha","Glovision","Kadokawa"],"licensors":[],"source":null,"rating":null,"scores":{"mal":8.43,"mal_scored_by":23665,"israel":9.0,"israel_scored_by":null,"rank":212,"popularity":3777,"members":48945,"favorites":180},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https