{"id":40028,"mal_id":40028,"anizone_id":40028,"url":"https://anizone.co.il/anime/40028/Attack-on-Titan-Final-Season","slug":"Attack-on-Titan-Final-Season","titles":{"hebrew":"מתקפת הטיטאנים עונה 4","english":"Attack on Titan: Final Season","romaji":"Shingeki no Kyojin: The Final Season","japanese":"進撃の巨人 The Final Season","synonyms":["Shingeki no Kyojin Season 4","Attack on Titan Season 4","Shingeki no Kyojin Season 4, Attack on Titan Season 4"],"community":[],"known":["Shingeki no Kyojin: The Final Season","Attack on Titan: Final Season","進撃の巨人 The Final Season","Attack on Titan Final Season","Ataque a los Titanes Temporada Final","L'Attaque des Titans Saison Finale","Shingeki no Kyojin Season 4","Attack on Titan Season 4"]},"synopsis_hebrew":"גבי בראון ופאלקו גרייס התאמנו כל חייהם להיות היורשים של כוחות הטיטאנים שנמצאים כעת בשליטת מארלי, הם מוכנים לעשות הכל על מנת לסייע לאומתם בחיסול האלדיאנים באי פארדיס. עם זאת, כשהכל נראה כשורה, שלוותם של אנשי מארלי מופרת לפתע בעקבות הגעתם של ארן ייגר וחיל הסיור לשטחם.\nלאחר שהגיעו סוף סוף למרתף ביתם של משפחת ייגר ולמדו על ההיסטוריה האפלה של הטיטאנים ועל החומות, חיל הסיור מחזיק בידיו את התשובות לשאלות שהם נלחמו כל-כך קשה למענן. התשובות, אומנם, שונות ונוראות מעל לכל מה שיכלו להעלות בדעתם. כשהאמת נמצאת ברשותם, הקבוצה יוצאת אל העולם שמעבר לחומות במטרה להציל את האנושות מן הרעידות.","background_hebrew":"שינגקי נו קיוג'ין: העונה האחרונה מעבדת תוכן מתוך כרכים 23-28 של המנגה זוכת הפרסים מאת האג'ימה איסאיאמה.","type":"TV","episodes":16,"duration_minutes":23,"status":"הסתיים","aired_from":"2020-12-07","season":{"label":"חורף 2021","year":2021,"season":"winter"},"broadcast":{"label":"שני 00:10","day":"monday","time":"00:10","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Drama","he":"דרמה"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Gore","he":"גור"},{"en":"Military","he":"צבאי"},{"en":"Survival","he":"הישרדות"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Drama","Suspense"],"studios":