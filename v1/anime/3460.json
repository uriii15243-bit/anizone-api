{"id":3460,"mal_id":3460,"anizone_id":3460,"url":"https://anizone.co.il/anime/3460/Bosco-Adventure","slug":"Bosco-Adventure","titles":{"hebrew":"בוסקו אדוונצ'ר","english":"Bosco Adventure","romaji":"Bosco Adventure","japanese":"ボスコアドベンチャー","synonyms":["Bosco Daibouken"],"community":[],"known":["Bosco Adventure","ボスコアドベンチャー","Bosco Daibouken"]},"synopsis_hebrew":"מבוסס על הספר מאת טוני וולף.\n\nמעיין החיים הוא מקור כל כוחות החיים בעולם בוסקו. הנסיכה אפריקוט, שאמורה להפוך למלכת פונטנלנד - שומרת מעיין החיים - נחטפת על ידי נבלים השואפים לשלוט בעולם בוסקו.\n\nאם הנסיכה אפריקוט לא תוכל לעלות על כס המלכות עד ליקוי החמה הבא, מעיין החיים יתייבש. החיות החיות ביער בוסקו, כולל צפרדע, לוטרה וצב, מחליטות לעזור לנסיכה ולהביאה לפונטנלנד כדי להגן על חייהן השקטים בעולם בוסקו. כך מתחיל המסע בכדור פורח מלא בחלומות, תקווה, הרפתקאות ואהבה!\n\nמקור: האתר הרשמי","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":25,"status":"הסתיים","aired_from":"1986-10-06","season":{"label":"סתיו 1986","year":1986,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":{"en":"Kids","he":"Kids"},"genres":["Adventure","Fantasy"],"studios":["Nippon Animation"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.18,"mal_scored_by":887,"israel":null,"israel_scored_by":null,"rank":3919,"popularity":12325,"members":2440,"favorites":12},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/2/28561l.webp"},"trailer":null,"characters":[{"name":"Apricot","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/12/417573.webp?s=40c94f4a34267ff6c8b455458fe91feb","voice_actors":[{"name":"Minaguchi, Yuko","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/2/56381.jpg?s=006be38deac7972dfd34701b71487c21"}]},{"name":"Damia","role":"משני","image":"https://cdn.my