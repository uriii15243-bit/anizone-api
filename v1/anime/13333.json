{"id":13333,"mal_id":13333,"anizone_id":13333,"url":"https://anizone.co.il/anime/13333/Tari-Tari","slug":"Tari-Tari","titles":{"hebrew":"טארי טארי","english":"Tari Tari","romaji":"Tari Tari","japanese":"TARI TARI","synonyms":[],"community":[],"known":["Tari Tari","TARI TARI"]},"synopsis_hebrew":"בתיכון שירהאמזאקה מתקיים מדי שנה רסיטל מיוחד שבו תלמידי המוזיקה יכולים להציג את כישרונותיהם בפני מקצוענים ואורחים יוקרתיים אחרים. קונאטסו מיאמוטו, תלמידת שנה שלישית, נואשת לשיר ברסיטל האחרון שלה בתיכון, אך מכיוון שפישלה בשנה הקודמת, סגן המנהל אסר עליה להשתתף.\n\nזה הרגע שבו קונאטסו מעלה רעיון חדש כדי להיות מעורבת; במקום להצטרף למקהלה הרשמית, היא תקים מועדון שירה משלה עם חבריה! למרבה הצער, זה מתברר כקשה יותר ממה שהיא דמיינה. חברתה וואקנה סאקאי ויתרה על השירה, וקונאטסו זקוקה ליותר משני חברים בלבד. עם חודש אחד בלבד עד הרסיטל, האם קונאטסו תצליח למצוא מספיק חברים למועדון שלה ולהיות מוכנה לשיר באחד האירועים החשובים ביותר של שנת הלימודים ולסיים את התיכון ללא חרטות?","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2012-07-01","season":{"label":"קיץ 2012","year":2012,"season":"summer"},"broadcast":{"label":"ראשון 22:30","day":"sunday","time":"22:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Slice of Life","he":"חלק מהחיים"}],"subcategories":[{"en":"Music","he":"מוזיקה"},{"en":"Performing Arts","he":"אמנות במה"},{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Slice of Life"],"studios":["P.A. Works"],"producers":["Bandai Visual","Dentsu","Sotsu","Lantis","Pony Canyon","Showgate","Good Smile Company","Infinite"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.29,"mal_scored_by":59996,"israel":null,"israel_scored_by":null,"rank":3287,"popularity":1664,"members":168683,"favorites":552},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/10/83575l.webp"},"trailer":{"youtube_id":"YmTKphUxHi8","url":"https://www.youtube.com/watch?v=YmTKphUxHi8","embe