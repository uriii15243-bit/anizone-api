{"id":9834,"mal_id":9834,"anizone_id":9834,"url":"https://anizone.co.il/anime/9834/Level-E","slug":"Level-E","titles":{"hebrew":"רמה E","english":"Level E","romaji":"Level E","japanese":"レベルE","synonyms":[],"community":[],"known":["Level E","レベルE"]},"synopsis_hebrew":"יוקיטקה צוצואי, נער יליד טוקיו, עובר למחוז יאמאגאטה לתיכון עם מלגת בייסבול. מכיוון שהוא למד בבית הספר התיכון הטוב ביותר ביפן לבייסבול, תושבי העיירה מאוד נרגשים מהגעתו. עם זאת, כשהוא מגיע לדירתו, הוא נתקל באדם מוזר שקורא בנונשלנטיות ולובש את בגדיו! הזר טוען שהוא חייזר שנחת נחיתת חירום על כדור הארץ ואין לו לאן ללכת. הוא חושף את עצמו כבאקה קי אל דוגרה, נסיך הכתר של כוכב הלכת דוגרה, והוא רק אחד ממאות חייזרים שכבר עשו את כדור הארץ לביתם.\n\nלמרות מוצאו המלכותי, הנסיך ידוע כשוטה בין-גלקטי שמפורסם בכך שהוא לא מהסס להטריד אחרים לשם שעשועו האישי. בין אם הוא עורך מבחנים מגוחכים על כפופיו, מעניק כוחות מוזרים לילדים אקראיים, או פשוט מהווה מטרד כללי, אף אחד לא בטוח מהשטויות של הנסיך הטיפש!\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2011-01-11","season":{"label":"חורף 2011","year":2011,"season":"winter"},"broadcast":{"label":"שלישי 01:30","day":"tuesday","time":"01:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Gag Humor","he":"קומדיה הומוריסטית"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Comedy","Sci-Fi"],"studios":["Studio Pierrot","David Production"],"producers":["TV Tokyo","Aniplex","TV Tokyo Music","Sony Music Entertainment","Sakura Create"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.4,"mal_scored_by":41666,"israel":null,"israel_scored_by":null,"rank":2687,"popularity":2460,"members":101037,"favorites":347},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/29668l.webp"},"trailer":null,"characters":[{"name":"Ki El Dogra, Baka","role":"ראשי","image":"https://cdn.my