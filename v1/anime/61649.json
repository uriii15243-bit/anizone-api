{"id":61649,"mal_id":61649,"anizone_id":61649,"url":"https://anizone.co.il/anime/61649/Golden-Curse","slug":"Golden-Curse","titles":{"hebrew":"קיישן דו ז'אנלונג","english":"Golden Curse","romaji":"Caishen Dou Zhanlong","japanese":"财神窦占龙","synonyms":["God of Wealth Dou Zhanlong"],"community":[],"known":["Caishen Dou Zhanlong","Golden Curse","财神窦占龙","God of Wealth Dou Zhanlong"]},"synopsis_hebrew":"הטאואיסט צוי שחרר בטעות את הקרפדה הזהובה האוספת אוצרות כדי לקרוא את הספר השמימי. הקרפדה הזהובה חשקה בשגשוג העולם האנושי והתגלגלה כאדם, דואו ז'אנלונג. כדי להימנע מהאסון השמימי, הקרפדה הזהובה קרעה את שלוש הנשמות ושבע הרוחות בחלל הרוחני של דואו ז'אנלונג, ויצרה תשעה שיבוטים שנפלו לתשעה מקומות שונים. תשעת דואו ז'אנלונגים היו בזמנים ומרחבים מקבילים שונים, וכל מוות הוליד שיבוט חדש. הם חוו \"תשעה מיתות ושלוש עשרה אסונות\" בסך הכל. הסיפור שלנו מתחיל עם דואו ז'אנלונג הראשון.","background_hebrew":"עיבוד לרומן של טיאנשיה בא צ'אנג (天下霸唱), Dou Zhanlong Bie Bao: Qi Gan Ba Jingang (窦占龙憋宝：七杆八金刚).","type":"ONA","episodes":16,"duration_minutes":23,"status":"הסתיים","aired_from":"2026-08-16","season":{"label":"קיץ 2026","year":2026,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Horror","he":"אימה"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Gore","he":"גור"},{"en":"Historical","he":"היסטורי"},{"en":"Psychological","he":"פסיכולוגיה"}],"demographic":null,"genres":["Action","Adventure","Fantasy","Horror","Suspense"],"studios":["CG Year"],"producers":["bilibili","iQIYI"],"licensors":[],"source":null,"rating":null,"scores":{"mal":0.0,"mal_scored_by":105,"israel":null,"israel_scored_by":null,"rank":16082,"popularity":17105,"members":719,"favorites":2},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1454/156919l.webp"},"trailer":{"youtube_id":"TWJyNamsaJU","url":"https://www.youtube.c