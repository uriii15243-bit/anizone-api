{"id":5203,"mal_id":5203,"anizone_id":5203,"url":"https://anizone.co.il/anime/5203/Palm-Town","slug":"Palm-Town","titles":{"hebrew":"עיר הדקל","english":"Palm Town","romaji":"Shin Maple Town Monogatari: Palm Town-hen","japanese":"新メイプルタウン物語 パームタウン編","synonyms":["New Maple Town Stories"],"community":[],"known":["Shin Maple Town Monogatari: Palm Town-hen","Palm Town","新メイプルタウン物語 パームタウン編","New Maple Town Stories"]},"synopsis_hebrew":"הסיפור מתרחש בעיירה חדשה בשם \"פאלם טאון\", שהיא העיירה החדשה שאליה פאטי ודודתה ג'יין עברו, מכיוון שבעלה של ג'יין, ג'ורג', מנהל שם מרכז רפואי. עם זאת, פאטי נתקלת בכמה קשיים כי היא לא רגילה לעיירה החדשה ומתגעגעת לעיר הולדתה ולחבריה. למרות זאת, היא פוגשת את אליס ומסתדרת איתה. במהרה הן הופכות לחברות הכי טובות ומבלות יחד כל יום, חוות דברים חדשים ונהנות מזמנן. הן פוגשות הרבה אנשים שונים במטרה ליצור חברויות רבות וזיכרונות בלתי נשכחים מלאי כיף.","background_hebrew":null,"type":"TV","episodes":50,"duration_minutes":24,"status":"הסתיים","aired_from":"1987-01-18","season":{"label":"חורף 1987","year":1987,"season":"winter"},"broadcast":{"label":"ראשון 08:30","day":"sunday","time":"08:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Fantasy","he":"פנטזיה"},{"en":"Slice of Life","he":"חלק מהחיים"}],"subcategories":[{"en":"Anthropomorphic","he":"האנשה"}],"demographic":null,"genres":["Fantasy","Slice of Life"],"studios":["Toei Animation"],"producers":["Asahi Broadcasting"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.1,"mal_scored_by":796,"israel":null,"israel_scored_by":null,"rank":4437,"popularity":12244,"members":2506,"favorites":6},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/11/56391l.webp"},"trailer":null,"characters":[{"name":"Patty","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/9/121085.webp?s=a4806e1ae9bced805e3e8049e9fc0d3f","voice_actors":[{"name":"Silvestri, Marcella","language":"איטלקית","image":"https://cdn.myanimelist.net/images/voiceactors/3/1568.jpg?s=0a