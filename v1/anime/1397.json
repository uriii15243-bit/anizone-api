{"id":1397,"mal_id":1397,"anizone_id":1397,"url":"https://anizone.co.il/anime/1397/Macross-7","slug":"Macross-7","titles":{"hebrew":"מאקרוס 7","english":"Macross 7","romaji":"Macross 7","japanese":"マクロス７","synonyms":["M7"],"community":[],"known":["Macross 7","マクロス７","M7"]},"synopsis_hebrew":"חלפו 35 שנים מאז שלין מינמיי הביאה שלום בין הזנטרדי לבני האדם באירועי מקרוס. נקי בסרה הוא גיטריסט וזמר בלהקת פייר בומבר. הוא חי בחלק הפחות מפותח של המושבה המעופפת סיטי 7, שמחפשת כוכב לכת ראוי למגורים, ומלחין ושר שירים מתוך אמונה שלמוזיקה יש כוח גדול יותר.\n\nבמהלך טיסתה, הופיעה גזע חייזרי לא ידוע והחל להטיל מצור על סיטי 7. עם זאת, ההתקפות שלו אינן קונבנציונליות - במקום לנסות להשמיד אותם, הם גונבים את מה שמכונה \"ספיריטיה\", מה שהופך את הקורבנות ללא מגיבים ודמויי זומבים. במהלך הקרבות הללו, בסרה תמיד יוצא אל תוך אזור הקרב, שר את שיריו ומצפה שחבר ואויב יקשיבו ויושפעו מהמוזיקה שלו.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":49,"duration_minutes":25,"status":"הסתיים","aired_from":"1994-10-16","season":{"label":"סתיו 1994","year":1994,"season":"fall"},"broadcast":{"label":"ראשון 11:00","day":"sunday","time":"11:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mecha","he":"רובוטים"},{"en":"Military","he":"צבאי"},{"en":"Music","he":"מוזיקה"},{"en":"Space","he":"חלל"}],"demographic":null,"genres":["Adventure","Comedy","Drama","Romance","Sci-Fi"],"studios":["Ashi Productions","Hero Communications"],"producers":["Mainichi Broadcasting System","Big West","Arts Pro"],"licensors":["Nozomi Entertainment"],"source":null,"rating":null,"scores":{"mal":7.18,"mal_scored_by":13551,"israel":null,"israel_scored_by":null,"rank":3938,"popularity":4425,"members":36054,"favorites":318},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1740/98831l.webp"},"trailer":null,"cha