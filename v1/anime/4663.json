{"id":4663,"mal_id":4663,"anizone_id":4663,"url":"https://anizone.co.il/anime/4663/Iron-Fist-Chinmi","slug":"Iron-Fist-Chinmi","titles":{"hebrew":"אגרוף הברזל צ'ינמי","english":"Iron Fist Chinmi","romaji":"Tekken Chinmi","japanese":"鉄拳チンミ","synonyms":["Ironfist Chinmi"],"community":[],"known":["Tekken Chinmi","Iron Fist Chinmi","鉄拳チンミ","Ironfist Chinmi"]},"synopsis_hebrew":"צ'ינמי הוא נער סיני צעיר שמקדיש את עצמו לאימוני אומנויות לחימה. השמועה על כישוריו מגיעה למאסטרים של קונג-פו במקדש המפורסם דיילין, שמזמינים אותו ללמוד אצלם. בזכות מסירותו וההדרכה של מוריו, צ'ינמי הופך לאחד התלמידים המובילים במקדש. בסופו של דבר, מגיע הזמן לעזוב את דיילין ולצאת למסע עלייה לרגל. במסעו הוא מתמודד עם מספר סכנות שבוחנות את כישוריו, אך גם פוגש אנשים רבים שמעניקים לו השראה בדרכים שונות. צ'ינמי, מחושל אך נחוש, חוזר לדיילין לאימונים מתקדמים. אך במהרה נדרשים כישוריו שוב—ההמונים המונגולים מתקרבים למקדש.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":20,"duration_minutes":24,"status":"הסתיים","aired_from":"1988-07-02","season":{"label":"קיץ 1988","year":1988,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Martial Arts","he":"אומנויות לחימה"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure"],"studios":["Production Reed","Ashi Productions"],"producers":["TV Asahi","TOHO"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.23,"mal_scored_by":2120,"israel":null,"israel_scored_by":null,"rank":3656,"popularity":9602,"members":5322,"favorites":13},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/13/57443l.webp"},"trailer":null,"characters":[{"name":"Chinmi","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/7/175837.webp?s=605595aae9f7bc6a57494ebf1ba117cb","voice_actors":[{"name":"Sakamoto, Chika","language":"יפנ