{"id":2553,"mal_id":2553,"anizone_id":2553,"url":"https://anizone.co.il/anime/2553/A-Dog-of-Flanders","slug":"A-Dog-of-Flanders","titles":{"hebrew":"כלב פלנדריה","english":"A Dog of Flanders","romaji":"Flanders no Inu","japanese":"フランダースの犬","synonyms":["Sekai Meisaku Gekijou","A Dog of Flanders","Sekai Meisaku Gekijou, A Dog of Flanders"],"community":[],"known":["Flanders no Inu","A Dog of Flanders","フランダースの犬","El Perro de Flandes","Sekai Meisaku Gekijou"]},"synopsis_hebrew":"נלו טארת' הוא יתום עני אך מאושר שחי עם סבו ג'יהאן בכפר קטן ליד אנטוורפן. לנלו יש כישרון לציור והוא מוקסם ממנו מאז שראה אחת מהתמונות של רובנס (אמן מפורסם) כשהיה ילד קטן. בעזרתו של ג'יהאן במשלוח החלב היומי לאנטוורפן, נלו מגלה יום אחד את פטרש, כלב עבודה שסבל מהתעללות וננטש על ידי בעליו הקודם. הוא מטפל בחיה המותשת ולאחר זמן קצר מתפתחת ביניהם חברות קרובה ואמינה. אלואיס קוז'ז, בתו של האיש העשיר והמשפיע ביותר בכפר בלאקן, היא החברה הטובה ביותר של נלו. כאשר נלו מחליט להפוך לאמן, הוא נאלץ לחוות ממקור ראשון את הבורות והאכזריות של תושבי הכפר. במיוחד אביה של אלואיס רואה בו בטלן שלא יכול להתפרנס מציור תמונות. למרות זאת, נלו מתמיד ולעולם לא מוותר על השגת חלומו ועל זכייה בהערכתם ובכבודם, תוך שהוא נאבק בעוני שלו.\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":52,"duration_minutes":26,"status":"הסתיים","aired_from":"1975-01-05","season":{"label":"חורף 1975","year":1975,"season":"winter"},"broadcast":{"label":"ראשון 19:30","day":"sunday","time":"19:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Slice of Life","he":"חלק מהחיים"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Pets","he":"חיות"},{"en":"Visual Arts","he":"אומנות חזותית"}],"demographic":null,"genres":["Slice of Life"],"studios":["Nippon Animation"],"producers":["Zuiyo"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.48,"mal_scored_by":2337,"israel":null,"israel_scored_by":null,"rank":2308,"popularity":7663,"members":9429,"favorites":38},"community_reviews":null,"images":{"poster":"https://cdn.myanimel