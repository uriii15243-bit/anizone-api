{"id":64844,"mal_id":64844,"anizone_id":64844,"url":"https://anizone.co.il/anime/64844/Maiden-Blood","slug":"Maiden-Blood","titles":{"hebrew":"דם העלמות","english":"Maiden Blood","romaji":"Maiden Blood","japanese":"Maiden Blood","synonyms":[],"community":[],"known":["Maiden Blood"]},"synopsis_hebrew":"ארמגדון הפך את גורל העולם על פיו, כאשר אל רשע קם לאחר ששאב כוח מהאגו של בני האדם, שפחדו מהמוות. כתוצאה מכך, שמונה מיליארד בני אדם הוקרבו, ורק קומץ ניצולים נותר להתקיים ככלי משחק בידי האל בעולם עטוף בחשכה נצחית. בעולם המעוות הזה, שבו ההיגיון נעלם, דם אנושי הפך להכול — ממטבע ומקור דלק ועד לנשק אסור שחושל בידי מכשפים כדי להשמיד שדים.\n\nאווה ואפיקה הן זוג אחיות הכבולות בגורל טרגי בלב האפוקליפסה הזו. האחות הצעירה, אפיקה, היא האדם האולטימטיבי ללחימת דם שאיבדה את נשמתה, בעוד האחות הבכורה, אווה, נולדה ללא יכולת ללכת. אולם רק דמה של אווה יכול לעורר את כוחה של אפיקה להילחם בשדים שטימאו את העולם.\n\n(מקור: MAL News)","background_hebrew":null,"type":"TV","episodes":null,"duration_minutes":0,"status":"עדיין לא שודר","aired_from":"2027-01-01","season":{"label":"לא צויין","year":null,"season":null},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Action","Fantasy"],"studios":["Polygon Pictures"],"producers":["Pony Canyon"],"licensors":[],"source":null,"rating":null,"scores":{"mal":null,"mal_scored_by":null,"israel":null,"israel_scored_by":null,"rank":null,"popularity":11437,"members":3123,"favorites":4},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1121/159668l.webp"},"trailer":{"youtube_id":"Z2SIqLntKGc","url":"https://www.youtube.com/watch?v=Z2SIqLntKGc","embed_url":"https://www.youtube.com/embed/Z2SIqLntKGc"},"characters":[{"name":"Epica","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/5/643729.webp","voice_actors":[{"name":"Anzai, Yukari","language":"יפנית","image