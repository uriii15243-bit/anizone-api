{"id":2036,"mal_id":2036,"anizone_id":2036,"url":"https://anizone.co.il/anime/2036/Princess-Comet","slug":"Princess-Comet","titles":{"hebrew":"קומט-סאן☆ הילדה עם השרביט הקוסמי","english":"Princess Comet","romaji":"Cosmic Baton Girl Comet-san☆","japanese":"Cosmic Baton Girl コメットさん☆","synonyms":[],"community":[],"known":["Cosmic Baton Girl Comet-san☆","Princess Comet","Cosmic Baton Girl コメットさん☆"]},"synopsis_hebrew":"כוכבת (בת 12 בשנות אדם) היא הנסיכה של ממלכת כוכב ההרמוניקה והייתה אמורה לפגוש את הנסיך של ממלכת כוכב הטמבורין בנשף שבו יבחר כלה. אך הוא לא נמצא שם ולכן כוכבת נשלחת לכדור הארץ כדי למצוא אותו. הוא יזוהה על פי אור הכוכבים בעיניו. היא מוצאת את כדור הארץ ומתאהבת באנשים שהיא פוגשת שם. בינתיים, הנסיכה מטאור מממלכת כוכב הקסטנייט גם מגיעה לכדור הארץ בחיפוש אחר הנסיך. בן לווייתה של כוכבת הוא כלבלב קטן עם כוכב בקצה זנבו בשם רובבה בול. כמובן, כוכבת לא הייתה הראשונה לבקר בכדור הארץ ולהתאהב בו, מישהי אחרת עשתה זאת לפניה והתחתנה. חיית המחמד שלה (חתולה לבנה עם אוזני ארנב ולב קטן על זנבה בשם באני) המשיכה לחיות כסוג של פיה ביער. כוחה של כוכבת נמשך מכוכבי ביתה ומועבר דרך השרביט שלה; היא גם עונדת תליון מיוחד שממנו יוצא רובבה בול, ודרכו היא יכולה לזהות ולמצוא את הנסיך.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":43,"duration_minutes":24,"status":"הסתיים","aired_from":"2001-04-01","season":{"label":"אביב 2001","year":2001,"season":"spring"},"broadcast":{"label":"ראשון 09:30","day":"sunday","time":"09:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Adventure","Comedy","Drama","Sci-Fi"],"studios":["Nippon Animation"],"producers":["Group TAC","TV Osaka","Yomiko Advertising","TOHO"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.37,"mal_scored_by":1989,"israel":null,"israel_scored_by":null,"rank":2818,"popularity":9148,"members":6052,"favorites":49},"community_reviews":null,"ima