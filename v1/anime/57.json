{"id":57,"mal_id":57,"anizone_id":57,"url":"https://anizone.co.il/anime/57/Beck-Mongolian-Chop-Squad","slug":"Beck-Mongolian-Chop-Squad","titles":{"hebrew":"בק: מונגוליאן צ'ופ סקוואד","english":"Beck: Mongolian Chop Squad","romaji":"Beck","japanese":"ベック","synonyms":["BECK"],"community":[],"known":["Beck","Beck: Mongolian Chop Squad","ベック","BECK"]},"synopsis_hebrew":"יוקיו \"קויוקי\" טאנאקה בן הארבע-עשרה הוא נער מדוכדך ללא מטרות בחיים. עם זאת, הכל משתנה כאשר קויוקי מציל כלב מוזר למראה בשם בק מהטרדה על ידי קבוצת ילדים מקומיים. בעל הכלב, ריוסוקה \"ריי\" מינאמי בן השש-עשרה, הוא גיטריסט מתפתח וחבר לשעבר בלהקת רוק פופולרית.\n\nלאחר שקויוקי פוגש שוב את ריי בדיינר, הנער המבוגר יותר מוביל אותו למקום המפגש של הלהקה הקודמת שלו ומדהים את קויוקי עם כישורי הגיטרה המדהימים שלו. כשהוא מתחיל להתעניין בזוהר של תרבות הרוק המערבית, קויוקי מחליט להתחיל לנגן בגיטרה תוך כדי שהוא עוזר לריי להגשים את חלומו להוביל את להקת הרוק האולטימטיבית. יחד עם אחותו הצעירה של ריי, מאהו, ועוד כמה חברים, השניים משיקים את הקריירה שלהם בעולם הרוק על ידי הקמת להקה בשם BECK. בק עוקבת אחר המאבקים וההצלחות של הקבוצה כשהם מפיצים את תהילתם ברחבי יפן.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":24,"status":"הסתיים","aired_from":"2004-10-07","season":{"label":"סתיו 2004","year":2004,"season":"fall"},"broadcast":{"label":"חמישי 01:30","day":"thursday","time":"01:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Music","he":"מוזיקה"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Drama"],"studios":["Madhouse"],"producers":["Marvelous Entertainment","Starchild Records","Asatsu DK","Kodansha","DefSTAR Records"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":8.29,"mal_scored_by":153319,"israel":6.0,"israel_scored_by":2,"rank":337,"popularity":735,"members":384709,"favorites":9419},"community_reviews":{"ratings":2,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/11/1