{"id":29758,"mal_id":29758,"anizone_id":29758,"url":"https://anizone.co.il/anime/29758/Taboo-Tattoo","slug":"Taboo-Tattoo","titles":{"hebrew":"טאבו טאטו","english":"Taboo Tattoo","romaji":"Taboo Tattoo","japanese":"タブー・タトゥー","synonyms":[],"community":[],"known":["Taboo Tattoo","タブー・タトゥー"]},"synopsis_hebrew":"סגי, תלמיד חטיבת-ביניים המאומן באומנויות לחימה, מרגיש לפעמים צורך להגן על האנשים החלשים בקרבתו. יום אחד, הוא מגן על חסר-בית אחד מכמה פרחחים, והאיש מעניק לו בתמורה קעקוע מוזר על כף היד. הקעקוע הינו נשק סודי, אשר יוצר במירוץ החימוש בין אמריקה וממלכת סריניסטאן.\n\nסגי מוצא את עצמו מסובך עד מעל הראש כשילדה עוצמתית, המשתמשת גם היא בנשק הסודי, רודפת אחריו בכל הכוח על מנת להסיר ממנו את הקעקוע שבידו. מסתבר שגם הכשרון שלו באומנויות לחימה לא ממש מספיק כדי לשמור עליו בחיים. האם הוא יהיה מסוגל ללמוד איך להפעיל את הכוח הבקעקוע שלו בזמן?","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2016-07-05","season":{"label":"קיץ 2016","year":2016,"season":"summer"},"broadcast":{"label":"שלישי 02:05","day":"tuesday","time":"02:05","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Urban Fantasy","he":"פנטזיה אורבנית"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Fantasy"],"studios":["J.C.Staff"],"producers":["TV Tokyo","Sotsu","AT-X","Magic Capsule","KlockWorx","DIVE II Entertainment","Avex Pictures","BS TV Tokyo"],"licensors":["Funimation","Crunchyroll"],"source":null,"rating":null,"scores":{"mal":5.73,"mal_scored_by":133363,"israel":6.0,"israel_scored_by":2,"rank":12564,"popularity":924,"members":311505,"favorites":261},"community_reviews":{"ratings":2,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/anime/12/80197l.webp"},"trailer":{"youtube_id":"rzfSLQODed0","url":"https://www.youtube.com/watch?v=rzfSLQODed0","embed_url":"https://www.youtube.com/embed/rzfSLQODed0"},"characters":[{"name":"Fluesy, Bluesy","rol