{"id":2161,"mal_id":2161,"anizone_id":2161,"url":"https://anizone.co.il/anime/2161/The-Skull-Man","slug":"The-Skull-Man","titles":{"hebrew":"האיש עם הגולגולת","english":"The Skull Man","romaji":"Skull Man","japanese":"スカルマン SKULL MAN","synonyms":["The Skullman"],"community":[],"known":["Skull Man","The Skull Man","スカルマン SKULL MAN","The Skullman"]},"synopsis_hebrew":"אוטומו סיטי: עיר שבה החירות והצדק התנוונו עד העצם; שבה הקונספירציה שולטת ביום והמוות אורב בלילה... מוות בדמותו של איש הגולגולת, מלאך המוות הממשי שחיוכו השלדי מבשר על מהומה רצחנית ומוות, אפילו למוטנטים המפלצתיים שמאיימים על עולמות התחתונים של העיר!\n\nכדי לחקור רצח מוזר, העיתונאי מינאגאמי היאטו והצלמת קיריקו מאמיה חייבים לעקוב אחרי הטורף האולטימטיבי הזה, דרך גופה מתפוררת של עיר שבה השחיתות זורמת בנהרות עמוקים ומזוהמים כמו חטאי האליטה השלטת, ולחשוף סוד כל כך מזעזע שעיר שלמה הפכה לקבר כדי להכיל אותו! בנקרופוליס סיוטי שבו דבר אינו כפי שהוא נראה, הנקמה מגיעה בדמות ראש המוות החי!\n\n(מקור: Sentai Filmworks)","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2007-04-29","season":{"label":"אביב 2007","year":2007,"season":"spring"},"broadcast":{"label":"ראשון 02:45","day":"sunday","time":"02:45","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Mystery","he":"מסתורין"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[],"demographic":null,"genres":["Action","Mystery","Supernatural"],"studios":["Bones"],"producers":["Diomedéa","Geneon Entertainment"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":6.6,"mal_scored_by":9354,"israel":null,"israel_scored_by":null,"rank":7484,"popularity":4419,"members":36200,"favorites":83},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1273/115661l.webp"},"trailer":null,"characters":[{"name":"Skull Man","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/16/107437.webp?s=597829f3fb20650985f343cb1c0fd3e6","voice_ac