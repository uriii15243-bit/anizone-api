{"id":64,"mal_id":64,"anizone_id":64,"url":"https://anizone.co.il/anime/64/Rozen-Maiden","slug":"Rozen-Maiden","titles":{"hebrew":"רוזן מיידן","english":"Rozen Maiden","romaji":"Rozen Maiden","japanese":"ローゼンメイデン","synonyms":[],"community":[],"known":["Rozen Maiden","ローゼンメイデン"]},"synopsis_hebrew":"ג'ון סאקורהדה, שנפגע מהחוויה בבית הספר, מבלה את ימיו בבית כמתבודד, רוכש דברים באינטרנט רק כדי להחזירם לפני תום תקופת הניסיון החינמית. לכן, כאשר מופיעה פתקה על שולחנו, שואלת אם הוא ירצה להפעיל משהו, הוא מניח שזה משהו שהזמין ומסמן בחוסר תשומת לב \"כן\", מה שמשנה את חייו לנצח.\n\nקופסה מגיעה עם בובה מכנית בפנים, אך זו אינה צעצוע רגיל: לאחר שג'ון מסובב אותה, היא מתחילה ללכת ולדבר כאילו הייתה אדם רגיל. עם גישה מתנשאת, היא מציגה את עצמה כשינקו, הבובה החמישית באוסף רוזן מיידן, קבוצה של בובות מיוחדות שנוצרו על ידי יוצר הבובות האגדי רוזן. האחיות הללו חייבות להילחם זו בזו בתחרות הנקראת משחק אליס בעזרת בן אנוש כדי להבטיח ניצחון. המנצחת הופכת לאליס, ילדה אמיתית הראויה לפגוש את יוצרן.\n\nכאשר עוד בובות חיות מגיעות להתגורר בביתו של ג'ון, ואויבת מעברה של שינקו מופיעה, חייו של ג'ון הופכים למורכבים הרבה יותר ממה שחשב שאפשרי.\n\nנכתב על ידי MAL Rewrite.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2004-10-08","season":{"label":"סתיו 2004","year":2004,"season":"fall"},"broadcast":{"label":"שישי 01:55","day":"friday","time":"01:55","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Drama","he":"דרמה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Drama","Supernatural"],"studios":["Nomad"],"producers":["Mellow Head","Pony Canyon","TBS","Memory-Tech"],"licensors":["Sentai Filmworks","Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":7.41,"mal_scored_by":102570,"israel":5.0,"israel_scored_by":null,"rank":2652,"popularity":1305,"members":223262,"favorites":2210},"community_reviews":{"ratings":1,"written_reviews":0}