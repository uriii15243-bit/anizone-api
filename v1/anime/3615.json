{"id":3615,"mal_id":3615,"anizone_id":3615,"url":"https://anizone.co.il/anime/3615/Neo-Angelique-Abyss","slug":"Neo-Angelique-Abyss","titles":{"hebrew":"ניאו אנג'ליק אייביס","english":"Neo Angelique Abyss","romaji":"Neo Angelique Abyss","japanese":"ネオアンジェリーク Abyss","synonyms":[],"community":[],"known":["Neo Angelique Abyss","ネオアンジェリーク Abyss"]},"synopsis_hebrew":"בעוד אנג'ליק הצעירה חיה את ימיה בשלווה בבית הספר שלה, התקפות של המפלצות תאנאטוס הולכות ומתרבות בכל מקום אחר. יום אחד מופיעים שני מטהרים, גברים עם הכוח להשמיד את התאנאטוס. אחד מהם, ניקס, מנסה לשכנע את אנג'ליק להצטרף אליהם בעבודתם, שכן יש לה את הכוח להיות המטהרת הנשית היחידה. בעוד אנג'ליק מהססת, תאנאטוס מופיע בבית הספר שלהם. ניקס והמטהר השני, ריין, נלחמים בקרב אבוד. עם חברי כיתתה שנופלים קורבן לתאנאטוס והמטהרים מוכנעים, מתעורר באנג'ליק הרצון להציל את כולם. היא הפכה למטהרת הנשית היחידה בארץ ארקדיה, זו הידועה כ\"ביצת המלכה\".","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2008-04-07","season":{"label":"אביב 2008","year":2008,"season":"spring"},"broadcast":{"label":"שני 02:00","day":"monday","time":"02:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Reverse Harem","he":"הרמון (גברים)"}],"demographic":{"en":"Josei","he":"נשים"},"genres":["Comedy","Fantasy","Romance"],"studios":["Yumeta Company"],"producers":["Lantis","MediaNet","Pony Canyon","AT-X","Koei","TYO"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":6.78,"mal_scored_by":15729,"israel":null,"israel_scored_by":null,"rank":6257,"popularity":4198,"members":40275,"favorites":125},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/20960l.webp"},"trailer":null,"characters":[{"name":"Rayne","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/2/170857.webp?s=21632f4dac13da9f250d35b9a39a1294","voice_actors":[