{"id":857,"mal_id":857,"anizone_id":857,"url":"https://anizone.co.il/anime/857/Air-Gear","slug":"Air-Gear","titles":{"hebrew":"אייר גיר","english":"Air Gear","romaji":"Air Gear","japanese":"エア・ギア","synonyms":[],"community":[],"known":["Air Gear","エア・ギア"]},"synopsis_hebrew":"אייר טרקס, הידועים גם כ-AT, הם גלגיליות ממונעות ומתקדמות שהפכו לטרנד החדש שסוחף את המדינה. למרות שכל AT מגיע עם מגביל מהירות, קהילה של נועזים המכונה \"רוכבי הסערה\" מעזה לשנות את המכשיר. תוך שימוש ב-AT בקרבות מחתרתיים, קבוצות שונות מתערבות על חלקי AT יקרי ערך או על סמלי הקבוצה שלהם—סמל הגאווה שלהם—כדי לשלוט ברחובות.\n\nבתקופה זו חי איטסוקי מינאמי, תלמיד חטיבת ביניים הידוע במעורבותו בקרבות רחוב. תמיד שואף להגיע לגבהים שאף אחד אחר לא יכול, הפאנק חסר המעצורים יפרוץ כל מכשול שעומד בדרכו, יחד עם חבריו הטובים קאזומה מיקורה ואוניגירי. עם זאת, כאשר הוא מגלה זוג אייר טרקס בביתו, הדרך לרצונו האמיתי סוף סוף נפתחת: לשלוט בשמיים.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":"אייר גיר מעבד את הפרקים 1-103 מהמנגה המקורית.","type":"TV","episodes":25,"duration_minutes":24,"status":"הסתיים","aired_from":"2006-04-05","season":{"label":"אביב 2006","year":2006,"season":"spring"},"broadcast":{"label":"רביעי 01:00","day":"wednesday","time":"01:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Sports","he":"ספורט"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Delinquents","he":"עבריינות"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Sports","Ecchi"],"studios":["Toei Animation"],"producers":["Marvelous Entertainment","Kodansha"],"licensors":["ADV Films","Funimation"],"source":null,"rating":null,"scores":{"mal":7.48,"mal_scored_by":187474,"israel":7.0,"israel_scored_by":null,"rank":2294,"popularity":747,"members":376967,"favorites":3839},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/11/18227l.webp"},"trailer":{"youtube_id":"9lKEW0lvqcs","url":"https://www.youtube.com/watch?v=9lKEW0lvqcs","embed_url":"h