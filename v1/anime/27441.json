{"id":27441,"mal_id":27441,"anizone_id":27441,"url":"https://anizone.co.il/anime/27441/Show-By-Rock","slug":"Show-By-Rock","titles":{"hebrew":"שואו ביי רוק!!","english":"Show By Rock!!","romaji":"Show By Rock!!","japanese":"SHOW BY ROCK!!（ショウ・バイ・ロック!!）","synonyms":["SB69"],"community":[],"known":["Show By Rock!!","SHOW BY ROCK!!（ショウ・バイ・ロック!!）","SB69"]},"synopsis_hebrew":"ההרפתקה המוזיקלית הגדולה ב-Show by Rock!! מתחילה לאחר שציאן מחליטה לשחק במשחק הקצב האהוב עליה ופתאום נשאבת פנימה, מוצאת את עצמה בעולם שנקרא מידי סיטי, שבו המוזיקה שולטת. היא לומדת שכל מי שמספק מוזיקה מדהימה ועוצמתית גם יכול לשלוט בעיר. עם זאת, לא כל המוזיקה טהורה. תוכנית מרושעת מתבצעת כדי להטביע את כל מידי סיטי בחושך. האם מאוחר מדי עבור ציאן לעשות משהו?\n\nציאן היג'יריקאווה תמיד רואה את עצמה כלא יותר מאשר נערה רגילה שחיה בעולם בינוני. יש לה כישרון גדול וכישורי גיטרה יוצאי דופן, אך היא גם חסרת ביטחון לקחת את הצעד הראשון בהגשמת חלומה לנגן בלהקה ולהיות מיליונרית מוזיקלית! היא לא ידעה שכוח עצום שוכן עמוק בתוכה—הכוח להביס את הרוע עם המוזיקה הקסומה שלה!\n\nהצטרפו לציאן, צ'וצ'ו, רטורי ומואה בעולם שבו המוזיקה היא הכל.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2015-04-05","season":{"label":"אביב 2015","year":2015,"season":"spring"},"broadcast":{"label":"ראשון 22:00","day":"sunday","time":"22:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Isekai","he":"עולם אחר"},{"en":"Music","he":"מוזיקה"}],"demographic":null,"genres":["Comedy","Fantasy"],"studios":["Bones"],"producers":["Shochiku","Pony Canyon","Sanrio","Tokyo MX","Studio GOONEYS","Docomo Anime Store","Sammy","FuRyu"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.04,"mal_scored_by":29811,"israel":null,"israel_scored_by":null,"rank":4762,"popularity":2574,"members":94271,"favorites":399},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/7/73674l.webp"}