{"id":961,"mal_id":961,"anizone_id":961,"url":"https://anizone.co.il/anime/961/Virtua-Fighter","slug":"Virtua-Fighter","titles":{"hebrew":"לוחם וירטואלי","english":"Virtua Fighter","romaji":"Virtua Fighter","japanese":"バーチャファイター","synonyms":[],"community":[],"known":["Virtua Fighter","バーチャファイター","El Defendor Virtuoso/ Virtua Fighter"]},"synopsis_hebrew":"אקירה יוקי הקדיש שנים רבות לשיפור כישורי הבאג'יקואן שלו בהנחיית סבו. הוא משתוקק לראות את קבוצת הכוכבים של שמונת כוכבי השמיים, שנחשפת רק לאלו בעלי כוח אמיתי. תשוקה בוערת זו דוחפת אותו לצאת למסעות, כדי ללמוד יותר על איך לראות את הכוכבים.\n\nבינתיים, מדענית רובוטיקה זדונית בשם אווה דוריקס שואפת ליצור את החייל המושלם. הקבוצה של אווה, ג'אדג'מנט 6, עוקבת וחוטפת את שרה בריאנט, סטודנטית בקולג' ומכירה קרובה של אקירה, שחוקרת תאונה מסתורית הקשורה לאחיה. אקירה חייב כעת להילחם בדרכו אל שרה כדי להציל אותה מציפורני ג'אדג'מנט 6, דרך מסוכנת שוודאי תהיה מלאה באתגרים רבים.","background_hebrew":null,"type":"TV","episodes":35,"duration_minutes":22,"status":"הסתיים","aired_from":"1995-10-09","season":{"label":"סתיו 1995","year":1995,"season":"fall"},"broadcast":{"label":"שני 18:30","day":"monday","time":"18:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"}],"subcategories":[{"en":"Martial Arts","he":"אומנויות לחימה"}],"demographic":null,"genres":["Action"],"studios":["Tokyo Movie Shinsha"],"producers":["Aniplex","TMS Entertainment","Yomiko Advertising","Sega","Half H.P Studio","TV Tokyo Music","Sony Music Entertainment"],"licensors":["Media Blasters","Discotek Media"],"source":null,"rating":null,"scores":{"mal":7.15,"mal_scored_by":5273,"israel":null,"israel_scored_by":null,"rank":4154,"popularity":6641,"members":13330,"favorites":53},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1234/110241l.webp"},"trailer":null,"characters":[{"name":"Yuki, Akira","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/9/80321.webp?s=41391b7af13e5b68477c126ab531dede","voice_a