{"id":180,"mal_id":180,"anizone_id":180,"url":"https://anizone.co.il/anime/180/Vandread","slug":"Vandread","titles":{"hebrew":"ונדרד","english":"Vandread","romaji":"Vandread","japanese":"ヴァンドレッド","synonyms":["Vandread Stage One","Vandread First Stage","Vandread Stage One, Vandread First Stage"],"community":[],"known":["Vandread","ヴァンドレッド","Vandread Stage One","Vandread First Stage"]},"synopsis_hebrew":"ב\"וונדרד\", גברים הם ממאדים ונשים מנוגה! טוב, לא בדיוק. הטכנולוגיה אפשרה לאנושות ליישב את כל גלקסיית שביל החלב, ובמערכת כוכבים אחת, הגברים והנשים חיים על שני כוכבים שונים, טאראק ומג'רה. מלחמת מינים מרה ומאוד מילולית משתוללת, עד כדי כך שהם כבר לא רואים אחד את השני כאותו מין!\n\nהיביקי טוקאי, פועל מדרגה שלישית מטאראק, מוצא את עצמו תקוע על ספינת קרב לאחר ניסיון כושל לגנוב רובוט. כאשר פיראטיות נשיות לוכדות את הוונגרד הטאראקי, נראה שהמצב לא יכול להיות גרוע יותר עבור היביקי. למרבה הצער, הוא כן; כאשר הצוות הגברי של הוונגרד יורה על הספינה שנתפסה מתוך ייאוש, הם יוצרים חור תולעת ענק, ששואב את הוונגרד ואת ספינות הפיראטים המג'ריות לתוכו! עכשיו, כשהם תקועים רחוק מכוכבי הבית שלהם, הגברים והנשים הללו חייבים ללמוד לעבוד יחד אם הם אי פעם ירצו לחזור הביתה.","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":22,"status":"הסתיים","aired_from":"2000-10-03","season":{"label":"סתיו 2000","year":2000,"season":"fall"},"broadcast":{"label":"שלישי 18:30","day":"tuesday","time":"18:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Sci-Fi","he":"מדע בדיוני"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Mecha","he":"רובוטים"},{"en":"Space","he":"חלל"}],"demographic":null,"genres":["Sci-Fi","Ecchi"],"studios":["Gonzo"],"producers":["GDH","Dentsu","Media Factory"],"licensors":["Funimation","Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":7.16,"mal_scored_by":45690,"israel":null,"israel_scored_by":null,"rank":4097,"popularity":2614,"members":91786,"favorites":447},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/ani