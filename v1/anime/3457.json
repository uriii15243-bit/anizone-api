{"id":3457,"mal_id":3457,"anizone_id":3457,"url":"https://anizone.co.il/anime/3457/Vampire-Knight","slug":"Vampire-Knight","titles":{"hebrew":"אביר ערפד","english":"Vampire Knight","romaji":"Vampire Knight","japanese":"ヴァンパイア騎士〈ナイト〉","synonyms":["Vampire Kishi"],"community":[],"known":["Vampire Knight","ヴァンパイア騎士〈ナイト〉","El Caballero Vampiro","Vampire Kishi"]},"synopsis_hebrew":"זיכרונה הראשון של יוקי הוא שערפד מנסה לאכול אותה. היא ניצלת על ידי קוראן קאנאמה אשר לוקח אותה למכר שלו, שמגדל אותה כאביה. עשר שנים מאוחר יותר, יוקי עדיין מרגישה חייבת לקאנאמה. היא חיה באקדמיית קרוס המחולקת לשתי כיתות – כיתת היום וכיתת הלילה המתנהלות כך שבמהלך היום לומדת כיתת היום, ובמהלך הלילה לומדת כיתת הלילה – המלאה בערפדים, וביניהם קוראן קאנאמה.\n","background_hebrew":"ואמפייר נייט שוחרר על ידי מנגה אנטרטיינמנט בבריטניה ועל ידי מדמן אנטרטיינמנט באוסטרליה. ואמפייר נייט זמין לצפייה בסטרימינג בהולו ובנטפליקס. בנוסף, האנימה עובדה לדיסקי דרמה, מחזות זמר בלייב-אקשן, סימולטורים לדייטים וספרי אמנות.","type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2008-04-08","season":{"label":"אביב 2008","year":2008,"season":"spring"},"broadcast":{"label":"שלישי 01:00","day":"tuesday","time":"01:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Mystery","he":"מסתורין"},{"en":"Romance","he":"רומנטיקה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Love Polygon","he":"אהבה יותר מאישה אחת"},{"en":"School","he":"בית ספר"},{"en":"Vampire","he":"ערפדים"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Drama","Mystery","Romance","Supernatural"],"studios":["Studio Deen"],"producers":["TV Tokyo","Aniplex","Nihon Ad Systems"],"licensors":["VIZ Media"],"source":null,"rating":null,"scores":{"mal":6.83,"mal_scored_by":371814,"israel":6.0,"israel_scored_by":null,"rank":5937,"popularity":395,"members":645302,"favorites":7603},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/7327l.we