{"id":1685,"mal_id":1685,"anizone_id":1685,"url":"https://anizone.co.il/anime/1685/Duel-Masters","slug":"Duel-Masters","titles":{"hebrew":"דואל מאסטרס","english":"Duel Masters","romaji":"Duel Masters","japanese":"デュエル・マスターズ","synonyms":["Duel Masters 2.0"],"community":[],"known":["Duel Masters","デュエル・マスターズ","Duel Masters 2.0"]},"synopsis_hebrew":"עולם ה\"דואל מאסטרס\" הוא אחד מחמש ציוויליזציות גדולות. דרך משחק קלפים, הדואליסטים יכולים להביא את העולמות הללו לידי קיום, ולהפוך את מה שהיה בעבר מופשט למציאות. הדואליסטים המיומנים הללו ידועים כמאסטרים של קייג'ודו.\n\nשובו קיריפודה הוא השחקן הטוב ביותר במגרש המשחקים המקומי שלו, ושואף להפוך למאסטר ברמה עולמית כמו אביו. הצעד הראשון שלו בדרך לכיבוש מתחיל בזכייה בטורניר מקומי. או לפחות כך היה צריך להיות, אלא שהוא מובס על ידי המאסטר הטוב ביותר בעולם של קייג'ודו, נייט. שובו מפסיד, אך לאחר שהוא נזכר במילות החוכמה שאביו החדיר בו, הוא מחליט להמשיך בדרך להפוך לדואליסט שיכול ליהנות מהמשחק כפי שהוא. וכך מתחיל המסע שלו לניצחון - וכפי שכולנו יודעים, המסע הוא החלק החשוב ביותר!","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":21,"status":"הסתיים","aired_from":"2002-10-21","season":{"label":"סתיו 2002","year":2002,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Strategy Game","he":"משחק אסטרטגיה"}],"demographic":{"en":"Kids","he":"Kids"},"genres":["Action","Comedy","Fantasy"],"studios":["Studio Hibari","A.C.G.T."],"producers":["Shogakukan Productions"],"licensors":["Hasbro"],"source":null,"rating":null,"scores":{"mal":5.87,"mal_scored_by":13575,"israel":null,"israel_scored_by":null,"rank":11806,"popularity":5188,"members":24960,"favorites":44},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/21506l.webp"},"trailer":null,"characters":[{"name":"Kirifuda, Shoubu","role":"ראשי","image":"https://cdn.myanimel