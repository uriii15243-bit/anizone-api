{"id":48455,"mal_id":48455,"anizone_id":48455,"url":"https://anizone.co.il/anime/48455/Beyblade-Burst-QuadDrive","slug":"Beyblade-Burst-QuadDrive","titles":{"hebrew":"בייבלייד בורסט קוואדרייב","english":"Beyblade Burst QuadDrive","romaji":"Beyblade Burst Dynamite Battle","japanese":"ベイブレードバーストダイナマイトバトル","synonyms":["Beyblade Burst Dynamite Battle"],"community":[],"known":["Beyblade Burst Dynamite Battle","Beyblade Burst QuadDrive","ベイブレードバーストダイナマイトバトル"]},"synopsis_hebrew":"\"האם יש מישהו חזק? בואו לאתגר את דייקוקוטן בל!\"\n\nשמועות נפוצו בעולם על בית הקברות של הביי, \"שער המקאי\". והבעלים הוא דייקוקוטן בל. הוא ה\"דמון קינג\" האמיתי שמתפאר בכך שהוא בלתי מנוצח בשער המקאי.\n\nבל משתלט על השידורים ברחבי העולם ומכריז מלחמה על כל הבליידרים! הביי של השטן בידו, דינמיט בליאל! מול הבייבלייד הלא ידוע, אגדות כמו ואלט אוי גם מתייצבות מולו!\n\nכעת, האגדה של דמון קינג בל, שהפך את כל העולם לאויב, עומדת להתחיל!\n\n(מקור: האתר הרשמי)","background_hebrew":null,"type":"ONA","episodes":52,"duration_minutes":12,"status":"הסתיים","aired_from":"2021-04-02","season":{"label":"אביב 2021","year":2021,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Mystery","he":"מסתורין"}],"subcategories":[],"demographic":{"en":"Kids","he":"Kids"},"genres":["Action","Adventure","Comedy","Mystery"],"studios":["OLM"],"producers":["ADK Emotions"],"licensors":["ADK Emotions NY Inc."],"source":null,"rating":null,"scores":{"mal":6.25,"mal_scored_by":2753,"israel":null,"israel_scored_by":null,"rank":9678,"popularity":8886,"members":6481,"favorites":34},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1156/113543l.webp"},"trailer":null,"characters":[{"name":"Kurenai, Shuu","role":"משני","image":"https://cdn.myanimelist.net/images/characters/9/302084.webp?s=536b61543d284c6cfe9922b68caec8ab","voice_actors":[{"name":"