{"id":33899,"mal_id":33899,"anizone_id":33899,"url":"https://anizone.co.il/anime/33899/IDOLiSH7","slug":"IDOLiSH7","titles":{"hebrew":"איידוליש7","english":"IDOLiSH7","romaji":"IDOLiSH7","japanese":"アイドリッシュセブン","synonyms":["Idolish Seven","Ainana","Idolish Seven, Ainana"],"community":[],"known":["IDOLiSH7","アイドリッシュセブン","Idolish Seven","Ainana"]},"synopsis_hebrew":"ביומה הראשון בעבודה בסוכנות ההפקות הקטנה של אביה, צומוגי טאקאנהאשי לא ציפתה שתמונה למנהלת של קבוצת האיידולים הגברית החדשה של הסוכנות. למרות שהייתה בהלם מכך שאביה נותן לה אמון בפרויקט כה גדול כל כך מוקדם, צומוגי נשבעת לעשות כל שביכולתה כדי לתמוך בשבעת הבנים הצעירים. לאחר שראתה עד כמה הבנים עובדים היטב כצוות, צומוגי נפגשת עם אביה ולומדת שהמשימה הראשונה שלה כמנהלת תהיה להוציא ארבעה בנים מהקבוצה. זאת משום שאביה מאמין ששבעה איידולים הם יותר מדי לניהול, והקבוצה המובילה הנוכחית, TRIGGER, כוללת רק שלושה חברים.\n\nלאחר שערכה אודישן מאולתר, צומוגי חוזרת לאביה ומצהירה באומץ שהיא מסרבת להוציא מישהו מהקבוצה, מכיוון שלכל חבר יש קסם ייחודי שמחזק את האטרקטיביות של הקבוצה כולה. היא חוזרת אל הבנים והם נרגשים שאף אחד מהם לא יפספס את חלומותיו. יחד הם הופכים ל-IDOLiSH7, ומתכוננים להתמודד עם העולם התחרותי של האיידולים.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":17,"duration_minutes":24,"status":"הסתיים","aired_from":"2018-01-07","season":{"label":"חורף 2018","year":2018,"season":"winter"},"broadcast":{"label":"ראשון 22:30","day":"sunday","time":"22:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Idols (Male)","he":"מפורסם"},{"en":"Music","he":"מוזיקה"}],"demographic":null,"genres":["Drama"],"studios":["TROYCA"],"producers":["Bandai Visual","Lantis","Bandai Namco Games"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.69,"mal_scored_by":26864,"israel":null,"israel_scored_by":null,"rank":1512,"popularity":2843,"members":79971,"favorites":1566},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1390/90828l.webp