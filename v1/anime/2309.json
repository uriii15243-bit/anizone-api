{"id":2309,"mal_id":2309,"anizone_id":2309,"url":"https://anizone.co.il/anime/2309/Azusa-Will-Help","slug":"Azusa-Will-Help","titles":{"hebrew":"אזוסה תעזור!","english":"Azusa Will Help!","romaji":"Azusa, Otetsudai Shimasu!","japanese":"アズサ、お手伝いします！","synonyms":["Azusa Helps!","Azusa, Otetsudaishimasu!","Azusa Helps!, Azusa, Otetsudaishimasu!"],"community":[],"known":["Azusa, Otetsudai Shimasu!","Azusa Will Help!","アズサ、お手伝いします！","Azusa Helps!","Azusa, Otetsudaishimasu!"]},"synopsis_hebrew":"קבוצת הבייסבול של תיכון קארוגאמו לא מצליחה במיוחד. לאחר הפסד קשה לנשרים, רבים מהשחקנים עוזבים, וכעת יש לקבוצה רק שמונה שחקנים, אחד פחות מהנדרש כדי לשחק משחק.\n\nבניגוד לעקרונותיו, הדמות הראשית, הארומאקי שונפיי, מחליט לקנות רובוט בייסבול. אך מכיוון שאין לו מספיק כסף, הוא בסופו של דבר קונה את רובוטית המשרתת בשם אזוסה. למרות שלאזוסה יש לב חם ונחישות חזקה, נראה שאין לה סיכוי מול יריביה שהיו רובוטי בייסבול מהשורה הראשונה. התקווה היחידה של הקבוצה טמונה בסוד הקבור בעבר המעורפל של אזוסה.","background_hebrew":"זוכה בפרס הגדול השני של ANIMAX.","type":"TV Special","episodes":1,"duration_minutes":44,"status":"הסתיים","aired_from":"2004-08-01","season":{"label":"קיץ 2004","year":2004,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Sci-Fi","he":"מדע בדיוני"},{"en":"Sports","he":"ספורט"}],"subcategories":[{"en":"Team Sports","he":"ספורט קבוצתי"}],"demographic":null,"genres":["Comedy","Sci-Fi","Sports"],"studios":["TMS Entertainment"],"producers":["Animax"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.28,"mal_scored_by":1881,"israel":null,"israel_scored_by":null,"rank":9497,"popularity":10377,"members":4220,"favorites":1},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1483/127577l.webp"},"trailer":null,"characters":[{"name":"Azusa","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/15/79913.webp?s=1f189d0ab2b03c4624eba6e510