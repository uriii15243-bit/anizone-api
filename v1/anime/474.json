{"id":474,"mal_id":474,"anizone_id":474,"url":"https://anizone.co.il/anime/474/Macross-Plus","slug":"Macross-Plus","titles":{"hebrew":"מאקרוס פלוס","english":"Macross Plus","romaji":"Macross Plus","japanese":"マクロスプラス","synonyms":[],"community":[],"known":["Macross Plus","マクロスプラス"]},"synopsis_hebrew":"השנה היא 2040 והגלקסיה משגשגת עם מספר מושבות וטכנולוגיה מתקדמת. הבינה המלאכותית קרובה לשלמות והאיידול המובילה הנוכחית היא שרון אפל, איידול וירטואידית כמעט מושלמת. כל מה שחסר לה הם רגשות אמיתיים, אותם מספקת מיונג פאנג לון. הופעת הבכורה של שרון מתקיימת בכוכב עדן, שם באותו זמן, טייסי הקרב איסאמו דייסון וגולד בואומן נאבקים על עליונות אווירית עבור \"פרויקט סופרנובה\". איסאמו, גולד ומיונג היו פעם חברי ילדות, אך לאחר תאונה לפני שבע שנים, הם הלכו כל אחד לדרכו. עם חזרתה של מיונג לתמונה, הסכסוכים הישנים מתעוררים מחדש. וכאשר טכניקת בינה מלאכותית לא יציבה ולא חוקית מותקנת בשרון, המצב מחמיר.\n\n(מקור: ANN)","background_hebrew":null,"type":"OVA","episodes":4,"duration_minutes":39,"status":"הסתיים","aired_from":"1994-08-25","season":{"label":"קיץ 1994","year":1994,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Mecha","he":"רובוטים"},{"en":"Military","he":"צבאי"},{"en":"Space","he":"חלל"}],"demographic":null,"genres":["Drama","Romance","Sci-Fi"],"studios":["Triangle Staff"],"producers":["Bandai Visual","Mainichi Broadcasting System","Studio Nue","Big West","Hero Communications"],"licensors":["Manga Entertainment","Anime Limited"],"source":null,"rating":null,"scores":{"mal":7.73,"mal_scored_by":25158,"israel":7.0,"israel_scored_by":null,"rank":1394,"popularity":3422,"members":57938,"favorites":521},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/12/75807l.webp"},"trailer":null,"characters":[{"name":"Dyso