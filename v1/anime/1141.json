{"id":1141,"mal_id":1141,"anizone_id":1141,"url":"https://anizone.co.il/anime/1141/A-Tree-of-Palme","slug":"A-Tree-of-Palme","titles":{"hebrew":"עץ של פאלם","english":"A Tree of Palme","romaji":"Palme no Ki","japanese":"パルムの樹","synonyms":["Arbre de Palmem"],"community":[],"known":["Palme no Ki","A Tree of Palme","パルムの樹","Arbre de Palmem"]},"synopsis_hebrew":"בפינה נידחת של כוכב הלכת ארקנה, פאלם, אנדרואיד תבוני שנוצר מעץ מיסטי שאומרים כי הוא סופג את זיכרונות הציוויליזציות שבהן הוא מושרש, מתעורר על ידי קוראם, לוחמת פצועה משבט סול. היא מפקידה בידיו את ה\"ביצה של הגג\" המיסטית ומתחננת בפניו לקחת אותה לממלכה האגדית של תמאס.\n\nמונע במטרה לקיומו, הוא מקבל על עצמו את משימתה של קוראם להעביר את השריד למקורו: מרכז הכוכב, המאויים על ידי כוח מרושע והרסני.\n\nמקור: ADV Films","background_hebrew":"עץ פאלמה נבחר באופן רשמי להתחרות על דוב הזהב בפסטיבל הסרטים הבין-לאומי של ברלין ה-52. הסרט שואב השראה באופן חופשי מהרומן משנת 1883, הרפתקאות פינוקיו, מאת קרלו קולודי.","type":"Movie","episodes":1,"duration_minutes":136,"status":"הסתיים","aired_from":"2002-03-16","season":{"label":"חורף 2002","year":2002,"season":"winter"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[],"demographic":null,"genres":["Adventure","Drama","Fantasy","Romance"],"studios":["Palm Studio"],"producers":["Genco","Kadokawa Shoten"],"licensors":["ADV Films"],"source":null,"rating":null,"scores":{"mal":6.59,"mal_scored_by":3327,"israel":null,"israel_scored_by":null,"rank":7544,"popularity":7345,"members":10522,"favorites":38},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1637/144014l.webp"},"trailer":null,"characters":[{"name":"Palme","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/13/69571.webp?s=fe2955ce16d857ff761616ab5d86fbdc","voice_actors":[{"name":"Hiramatsu, Aki