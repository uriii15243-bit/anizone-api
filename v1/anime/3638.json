{"id":3638,"mal_id":3638,"anizone_id":3638,"url":"https://anizone.co.il/anime/3638/Kaiketsu-Zorori","slug":"Kaiketsu-Zorori","titles":{"hebrew":"קייקטסו זורורי","english":"Kaiketsu Zorori","romaji":"Kaiketsu Zorori","japanese":"かいけつゾロリ","synonyms":[],"community":[],"known":["Kaiketsu Zorori","かいけつゾロリ","Zorori - Le Magnifique"]},"synopsis_hebrew":"מעובד מתוך ספרי הסיפורים הפופולריים באותו שם מאת יוטאקה הארה, \"קאיקצו זורורי\" עוקב אחר הרפתקאותיו של שועל ערמומי בשם זורורי, הנחוש להפוך למלך השובבות עם טירה משלו וכלה יפה. למרות שזורורי ידוע במתיחותיו ותחבולותיו, התוכניות הערמומיות שלו לעיתים קרובות מתהפכות ומסייעות למטרותיו, ולמרות שהוא נראה מרושע ולא מוסרי, הוא למעשה אכפתי ורגשני. עם זאת, לזורורי יש את החוכמה, האינטליגנציה והזריזות למצוא תמיד פתרון גם במצבים הנואשים ביותר. נוסע עם זוג חזירי בר תאומים, אישישי ונושישי, הוא ממשיך במסעו כדי לגרום לאמו המנוחה להיות גאה בו.","background_hebrew":null,"type":"TV","episodes":52,"duration_minutes":24,"status":"הסתיים","aired_from":"2004-02-01","season":{"label":"חורף 2004","year":2004,"season":"winter"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"}],"subcategories":[],"demographic":null,"genres":["Adventure","Comedy"],"studios":["Ajia-do","Amber Film Works"],"producers":["Nagoya Broadcasting Network"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.13,"mal_scored_by":1589,"israel":null,"israel_scored_by":null,"rank":4230,"popularity":10172,"members":4465,"favorites":45},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1330/131495l.webp"},"trailer":null,"characters":[{"name":"Zorori","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/7/405621.webp?s=2b92cc6af4e344a9e02f6f82b3c585c7","voice_actors":[{"name":"Yamadera, Kouichi","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/2/73614.jpg?s=643eee95220ed1edde3cb796861fafec"}]