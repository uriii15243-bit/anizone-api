{"id":33003,"mal_id":33003,"anizone_id":33003,"url":"https://anizone.co.il/anime/33003/Magical-Girl-Raising-Project","slug":"Magical-Girl-Raising-Project","titles":{"hebrew":"פרויקט הילדה הקסומה","english":"Magical Girl Raising Project","romaji":"Mahou Shoujo Ikusei Keikaku","japanese":"魔法少女育成計画","synonyms":["MahouIku"],"community":[],"known":["Mahou Shoujo Ikusei Keikaku","Magical Girl Raising Project","魔法少女育成計画","MahouIku"]},"synopsis_hebrew":"עבור רבות מהבנות בעיר N, משחק התפקידים החברתי הפופולרי \"פרויקט גידול הבנות הקסומות\" הוא הכי קרוב שהן יכולות להגיע להיות בנות קסומות אמיתיות. עם זאת, עבור כמה שחקניות נדירות, החלום הזה יכול להפוך למציאות. אחת מהן היא קויוקי הימקאוה, שמקבלת הודעה בלילה אחד שהיא נבחרה להפוך לבת קסומה, האווטאר שלה במשחק, סנואו וייט.\n\nכאשר קויוקי ושחקניות נוספות שנבחרו בעיר מתחילות לעזור לאנשים במצוקה, הן מקבלות הודעה נוספת: המנהלים החליטו שהם רוצים לצמצם את מספר הבנות הקסומות. מי שתאסוף את הכמות הנמוכה ביותר של סוכריות קסם—שניתנות עבור פעילויות הבת הקסומה שלהן—בתחרות השבועית, תאבד את כוחותיה. אך כאשר טרגדיה אמיתית מתרחשת לשחקנית הראשונה שנושרת, הן נחשפות להשלכות של איבוד היכולות שלהן. ככל שיותר משתתפות מאבדות את התחרות ויותר חוקים מעוותים מתווספים, הבנות מבינות במהרה שהתחרות שלהן היא למעשה מאבק נואש להישרדות.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2016-10-02","season":{"label":"סתיו 2016","year":2016,"season":"fall"},"broadcast":{"label":"ראשון 00:00","day":"sunday","time":"00:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Gore","he":"גור"},{"en":"High Stakes Game","he":"משחקי מזל"},{"en":"Mahou Shoujo","he":"ילדות קסומות"},{"en":"Survival","he":"הישרדות"}],"demographic":null,"genres":["Action","Suspense"],"studios":["Lerche"],"producers":["Genco","AT-X","Magic Capsule","flying DOG","Cospa","Toranoana","Medicos Entertainment","Animatic","Highlights Entertainment"],"licensors":["