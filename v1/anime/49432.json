{"id":49432,"mal_id":49432,"anizone_id":49432,"url":"https://anizone.co.il/anime/49432/The-Flame-Imperial-Guards","slug":"The-Flame-Imperial-Guards","titles":{"hebrew":"שומרי האש הקיסריים","english":"The Flame Imperial Guards","romaji":"Chi Yan Jinyiwei","japanese":"赤焰锦衣卫","synonyms":[],"community":[],"known":["Chi Yan Jinyiwei","The Flame Imperial Guards","赤焰锦衣卫"]},"synopsis_hebrew":"מבוא: צ'י יאן ג'ין ייווי צ'ין הו וחבריו מאמינים ב\"הקיסר שומר על המדינה, הג'ין שומר על המדינה, העצמות האבירות מסתתרות בנהרות ובאגמים, ומאה מיתות לא ישאירו שם\", והם נלחמים באומץ נגד כוחות המורדים כדי להגן על המדינה והארץ. לא רק שיש להם את תחושת האחריות של ג'ין ייווי להגן על שלום המדינה, אלא גם את הלב האבירי של בני ובנות הנהרות והאגמים. צ'ין הו, שתמיד היה חסר משמעת ופרוע, מוצא את עצמו מעורב בהדרגה בקונספירציה מזעזעת הנוגעת לאנשי העולם בעקבות חקירת מקרה רצח מוזר. במקביל, הוא גם חושף את תעלומת חוויות חייו שנקברו במשך יותר מ-20 שנה. בחקירת מקרים מסוכנים ביותר שוב ושוב, איום האויב, בגידת עמיתיו והחשד של שותפיו לא השמידו את שאיפתו של צ'ין הו לצדק. בסופו של דבר, קסם אישיותו השפיע על שותפיו, וכולם התגברו על כל הקשיים ולא פחדו מכוח, רק כדי לחפש שלום עבור החיים התמימים שאבדו.","background_hebrew":null,"type":"ONA","episodes":24,"duration_minutes":20,"status":"הסתיים","aired_from":"2022-12-31","season":{"label":"סתיו 2022","year":2022,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Fantasy"],"studios":["Chosen"],"producers":["iQIYI","High Energy Studio","Fujian Ziyan Animation Technology"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.46,"mal_scored_by":203,"israel":null,"israel_scored_by":null,"rank":8357,"popularity":15039,"members":1170,"favorites":8},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1976/116550l.webp"},"trailer":{"youtube_id":"rPElzMHHHZs","url":"https://www.youtube.com/watch?v=rPElzM