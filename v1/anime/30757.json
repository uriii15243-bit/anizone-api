{"id":30757,"mal_id":30757,"anizone_id":30757,"url":"https://anizone.co.il/anime/30757/Monster-Strike","slug":"Monster-Strike","titles":{"hebrew":"מונסטר סטרייק","english":"Monster Strike","romaji":"Monster Strike","japanese":"モンスターストライク","synonyms":[],"community":[],"known":["Monster Strike","モンスターストライク"]},"synopsis_hebrew":"רן הומורה חזר זה עתה לעיר הולדתו, קמינהרה, אך הוא לא מצליח לזכור הרבה מהזמן שבילה שם מלבד הבזקים מעורפלים. כשהוא מקבל את הטלפון הנייד שלו בחזרה מחנות התיקונים, הוא מגלה שמשחק מסתורי בשם \"מונסטר סטרייק\" הותקן עליו. בלי לדעת מה מטרתו או איך הגיע לשם, רן מחליט לפתוח אותו, פעולה שתשנה את חייו לנצח כאשר הוא מוצא את עצמו מותקף לפתע על ידי אדם מוזר.\n\nכעת, לכוד על גג בית הספר שלו, אשר באופן מוזר הוגדר כ\"במה\", רן נדהם לראות את האיש מזמן מפלצת מציאותית מהמשחק, אחת שמסוגלת לגרום נזק אמיתי לבני אדם. הסיכוי היחיד שלו לצאת מהמצב הזה בחיים הוא לזמן את הדרקון אורגון, שאומר לרן שהוא ימחץ את המפלצת היריבה בשבילו. למרבה הצער, מתברר שאורגון הוא דרקון זעיר וחסר תועלת לחלוטין!\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"ONA","episodes":51,"duration_minutes":10,"status":"הסתיים","aired_from":"2015-10-10","season":{"label":"סתיו 2015","year":2015,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Video Game","he":"משחק מחשב"}],"demographic":null,"genres":["Action","Fantasy"],"studios":["Studio Hibari"],"producers":["Ultra Super Pictures","XFLAG"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.4,"mal_scored_by":6497,"israel":null,"israel_scored_by":null,"rank":8782,"popularity":5056,"members":26475,"favorites":36},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/13/78835l.webp"},"trailer":{"youtube_id":"DRAvfcK8OIE","url":"https://www.youtube.com/watch?v=DRAvfcK8OIE","embed_url":"https://www.youtube.com/embed/DRAvfcK8OIE"},"characters":[{"name":"Lucifer","r