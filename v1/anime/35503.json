{"id":35503,"mal_id":35503,"anizone_id":35503,"url":"https://anizone.co.il/anime/35503/Revue-Starlight","slug":"Revue-Starlight","titles":{"hebrew":"מחזמר☆הבנות רביו סטארלייט","english":"Revue Starlight","romaji":"Shoujo☆Kageki Revue Starlight","japanese":"少女☆歌劇 レヴュースタァライト","synonyms":["Girls'☆Opera Revue Starlight"],"community":[],"known":["Shoujo☆Kageki Revue Starlight","Revue Starlight","少女☆歌劇 レヴュースタァライト","Girls'☆Opera Revue Starlight"]},"synopsis_hebrew":"כל שכבה באקדמייה לאומנויות הבמה 'סיישו' מחולקת לשתי כיתות: כיתה א' וכיתה\nב'. בכיתה א' לומדות הבנות אשר שואפות להיות בקדמת הבמה: הן לומדות בעיקר\nשירה, משחק וריקוד מכל הסוגים. בכיתה ב' לומדות בנות אשר שואפות לעבוד מאחורי\nהקלעים: כתיבת תסריט, הלחנה, הכנת תפאורה ועוד.\n\nעלילת הסדרה עוקבת אחר אייג'ו קארן. בילדותה, היא וחברתה קאגורה היקארי הבטיחו\nאחת לשניה שהן יגיעו להיות שחקניות, ויופיעו יחד במחזמר 'סטארלייט'. אך דרכיהן נפרדו,\nוהן לא התראו מאז ההבטחה.\nכיום, קארן לומדת בכיתה א' בשכבת הגיל השניה בסיישו, והמחזור שלה נבחר להעלות את\nהמחזמר 'סטארלייט' בכל שלוש שנותיו בתיכון. בשנה שעברה, קארן בקושי הצליחה להתברג\nלאחד מהתפקידים הראשיים, ונראה שהשנה לא ילך לה טוב יותר. זאת עד הרגע, בו באופן\nמפתיע, חברת ילדותה היקארי מופיעה ומצטרפת לכיתתה.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2018-07-13","season":{"label":"קיץ 2018","year":2018,"season":"summer"},"broadcast":{"label":"שישי 01:28","day":"friday","time":"01:28","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Music","he":"מוזיקה"},{"en":"Performing Arts","he":"אמנות במה"},{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Drama"],"studios":["Kinema Citrus"],"producers":["Pony Canyon","TBS","Bushiroad","Overlap","Nelke Planning","APDREAM"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.67,"mal_scored_by":35432,"israel":null,"israel_scored_by":null,"rank":1572,"popularity":2466,"members":100535,"favorites":1661},"c