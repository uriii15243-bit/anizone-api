{"id":31229,"mal_id":31229,"anizone_id":31229,"url":"https://anizone.co.il/anime/31229/Servamp","slug":"Servamp","titles":{"hebrew":"סרוואמפ","english":"Servamp","romaji":"Servamp","japanese":"SERVAMP（サーヴァンプ）","synonyms":[],"community":[],"known":["Servamp","SERVAMP（サーヴァンプ）"]},"synopsis_hebrew":"מאהירו שירוטה מאמין בכל לבו בפשטות ובכך שצריך להימנע מדברים מסובכים בכל מחיר. הוא חושב שעדיף לעשות משהו גם אם עלול להתחרט מאשר לא לעשות בכלל – אידיאולוגיה זו הובילה את הנער בן ה-15 לאסוף חתול תועה בדרכו הביתה מבית הספר. הוא קורא לחתול השחור בחיבה \"קורו\", בלי לדעת שמפגש אקראי זה יביא לשינוי יוצא דופן בחיי היום-יום שלו.\nיום אחד, מאהירו חוזר הביתה ומגלה משהו מוזר למדי: צעיר מסתורי שהוא מעולם לא פגש קודם לכן. הפאניקה שלו גורמת לאור שמש לפגוע באורח האורח הבלתי מוזמן, ולתדהמתו של מאהירו – האורח הופך לקורו! לאחר שהוא נחשף כערפד עצלן שפשוט רוצה לרבוץ, קורו מבטיח לעזוב עם רדת הלילה. עם זאת, אסון אחר אסון מובילים לכך שמאהירו בטעות כורת חוזה עם האורח הלא קרוא שלו, ומכניס את עצמו לקרב מסכן חיים בין משרתים על-טבעיים ויצורים צמאי דם – רחוק מאוד מפשטות.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2016-07-05","season":{"label":"קיץ 2016","year":2016,"season":"summer"},"broadcast":{"label":"שלישי 23:00","day":"tuesday","time":"23:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Vampire","he":"ערפדים"}],"demographic":{"en":"Josei","he":"נשים"},"genres":["Action","Supernatural"],"studios":["Brain's Base","Platinum Vision"],"producers":["Frontier Works","Lantis","Kadokawa Shoten","AT-X","Sony Music Communications","Hakuhodo DY Music & Pictures","Yomiuri TV Enterprise","Adores","Heroz"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.87,"mal_scored_by":126958,"israel":7.0,"israel_scored_by":null,"rank":5683,"popularity":922,"members":313109,"favorites":1380},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"po