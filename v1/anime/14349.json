{"id":14349,"mal_id":14349,"anizone_id":14349,"url":"https://anizone.co.il/anime/14349/Little-Witch-Academia","slug":"Little-Witch-Academia","titles":{"hebrew":"האקדמיה למכשפות קטנות","english":"Little Witch Academia","romaji":"Little Witch Academia","japanese":"リトルウィッチアカデミア","synonyms":["Wakate Animator Ikusei Project","2012 Young Animator Training Project","Anime Mirai 2012","LWA","Wakate Animator Ikusei Project, 2012 Young Animator Training Project, Anime Mirai 2012, LWA"],"community":[],"known":["Little Witch Academia","リトルウィッチアカデミア","Wakate Animator Ikusei Project","2012 Young Animator Training Project","Anime Mirai 2012","LWA"]},"synopsis_hebrew":"בעולם בו מתרחשת האנימה מכשפות חיות לצידם של בני אדם,\nובנוסף להתקדמות הטכנולוגית יש בעולם גם קסמים. יש רק בעיה\nאחת, הקסם מתחיל לאט לאט להעלם מהעולם ולהפוך לחסר תועלת.\nקאגארי אטסוקו הייתה רק ילדה קטנה כשראתה את מופע הקסמים של\nהמכשפה שאריוט. מופע זה הדהים אותה עד כדי כך, שהיא החליטה להפוך\nלהיות מכשפה כשהיא תהיה גדולה. וככה הגיעה אטסוקו ללמוד בלונה נובה,\nהאקדמיה המפורסמת למכשפות, למרות שהיא רק נערה רגילה.\nלמרות כל הקשיים בהם היא נתקלת, ולמרות חוסר הכישרון שלה בקסמים,\nאטסוקו לא מוכנה לוותר על חלומה הגדול להיות כמו שאריוט.","background_hebrew":"ליטל וויץ' אקדמיה הוא אחד מארבעת יצירות האנימה שכל אחת מהן קיבלה 38 מיליון ין (כ-480,000 דולר) מפרויקט \"הכשרת אנימטורים צעירים 2012\". כמו בשנים 2010 ו-2011, קבוצת העבודה של האנימציה קיבלה 214.5 מיליון ין (2.65 מיליון דולר) מסוכנות לענייני תרבות של ממשלת יפן, והפיצה את רוב הכספים הללו לאולפנים שמכשירים אנימטורים צעירים בעבודה מעשית. התגובה החיובית לסרט הובילה את סטודיו טריגר להפעיל קמפיין מימון המונים בקיקסטארטר למימון סרט המשך, שהצליח לעבור את יעד המימון שלו.","type":"Movie","episodes":1,"duration_minutes":26,"status":"הסתיים","aired_from":"2013-03-02","season":{"label":"חורף 2013","year":2013,"season":"winter"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Adventure","Comedy","Fantasy"],"studios":["Trigger"],"producers":["Half H.P Studio","Ultra Super Pictures"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.79,"mal_scored_by":181637,"israel":7.0,"israel_scored_by":null,"rank":1214,"popularity":887,"members":328145,"favorites":1407},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1890/147903l.webp"},"trailer":{"youtube_id":"siI44zxkRUs","url":"https://www.youtube.com/watch?v=siI44zxkRUs","embed_url":"https://www.youtube.com/embed/siI44zxkRUs"},"characters":[{"name":"Kagari, Atsuko","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/3/288756.webp?s=63bf3809d426281871a7b65ed4caf67b","voice_actors":[{"name":"Han, Megumi","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/2/72566.jpg?s=60a301c84a239dd985e50df49731afa1"}]},{"name":"Manbavaran, Sucy","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/10/322889.webp?s=19989534d5c712dd47fe8870a723d728","voice_actors":[{"name":"Murase, Michiyo","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/3/79858.jpg?s=c35e0246762df89c882267cbe0bc0f95"}]},{"name":"Cavendish, Diana","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/15/337178.webp?s=b0cf2432d7f235d082659edb2dafb36a","voice_actors":[{"name":"Hikasa, Youko","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/2/73783.jpg?s=72823e783f56ec977f0755dc9e02d134"}]},{"name":"Jansson, Lotte","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/11/322887.webp?s=a63b150776d5cdda8049cbafba1fd94e","voice_actors":[{"name":"Orikasa, Fumiko","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/3/75768.jpg?s=c801191f8810685b11b48a9b4b45e277"}]},{"name":"Callistis, Ursula","role":"משני","image":"h