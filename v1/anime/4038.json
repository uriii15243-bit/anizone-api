{"id":4038,"mal_id":4038,"anizone_id":4038,"url":"https://anizone.co.il/anime/4038/Psychic-Squad","slug":"Psychic-Squad","titles":{"hebrew":"סקוואד פסיכי","english":"Psychic Squad","romaji":"Zettai Karen Children","japanese":"絶対可憐チルドレン","synonyms":["Absolutely Lovely Children","ZKC","Absolutely Lovely Children, ZKC"],"community":[],"known":["Zettai Karen Children","Psychic Squad","絶対可憐チルドレン","Absolutely Lovely Children","ZKC"]},"synopsis_hebrew":"הן חמודות, מקסימות ושלוש מהאספרים החזקים ביותר שהעולם ראה אי פעם: קאורו, הפסיכוקינטית הנועזת שיכולה להזיז חפצים בכוח המחשבה; שיהו, הפסיכומטרית הסרקסטית והאפלה שיכולה לקרוא מחשבות מאנשים ולקרוא את העבר של חפצים דוממים כמו ספר; ואוי, הרגועה והרציונלית מבין השלוש, שיכולה לטלפורט את עצמה ואת האחרות כרצונה. אז מה לעשות עם המפלצות הפסיכיות הפוטנציאליות הללו? הכירו את B.A.B.E.L., בסיס התמיכה במעבדת ESP, שם \"הילדים\" ואחרים כמותם יכולים להיות חלק מהפתרון לגל הולך וגובר של אבולוציה פסיכית. זהו פתרון של רווח לשני הצדדים... אלא אם כן אתה קואיצ'י מינאמוטו, הצעיר העמוס בעבודה שנאלץ לפקד על צוות של שלוש ילדות לפני גיל ההתבגרות!\n\nמקור: Sentai Filmworks","background_hebrew":null,"type":"TV","episodes":51,"duration_minutes":24,"status":"הסתיים","aired_from":"2008-04-06","season":{"label":"אביב 2008","year":2008,"season":"spring"},"broadcast":{"label":"ראשון 10:00","day":"sunday","time":"10:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Comedy"],"studios":["SynergySP"],"producers":["TV Tokyo","Half H.P Studio","Shogakukan Productions"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.3,"mal_scored_by":12752,"israel":null,"israel_scored_by":null,"rank":3232,"popularity":3709,"members":50210,"favorites":128},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/5/75581l.webp"},"trailer":null,"character