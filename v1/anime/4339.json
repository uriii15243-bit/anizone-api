{"id":4339,"mal_id":4339,"anizone_id":4339,"url":"https://anizone.co.il/anime/4339/Attack-on-Tomorrow","slug":"Attack-on-Tomorrow","titles":{"hebrew":"התקפה על המחר","english":"Attack on Tomorrow","romaji":"Ashita e Attack!","japanese":"あしたへアタック！","synonyms":["Smash"],"community":[],"known":["Ashita e Attack!","Attack on Tomorrow","あしたへアタック！","Smash"]},"synopsis_hebrew":"הדרמה הזו מספרת את סיפורן של נערות בתיכון. נערות שאוהבות לשחק כדורעף מקימות קבוצה בבית הספר שלהן. למרות שהקבוצה מתחילה כמועדון ספורט חלש ולא מאורגן, עם הזמן התשוקה והמאמץ יוצאי הדופן של הבנות מאפשרים לקבוצה שלהן להפוך לאחת הקבוצות המאורגנות והמוכרות ביותר בבית הספר. כעת הן שואפות לזכות באליפות בליגת הכדורעף הארצית לתיכונים. למרות שזה כואב וקשה להשיג מטרה כזו, נחמד שיש חברים לחלוק איתם את התחושה, במיוחד את השמחה. דרך הכדורעף, הבנות לומדות וחוות שיעורים רבים בחיים כשהן מתבגרות. בואו נשתף את הצחוק שלהן.\n\nמקור: Nippon Animation","background_hebrew":null,"type":"TV","episodes":23,"duration_minutes":24,"status":"הסתיים","aired_from":"1977-04-04","season":{"label":"אביב 1977","year":1977,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Sports","he":"ספורט"}],"subcategories":[{"en":"School","he":"בית ספר"},{"en":"Team Sports","he":"ספורט קבוצתי"}],"demographic":null,"genres":["Drama","Sports"],"studios":["Nippon Animation"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.59,"mal_scored_by":920,"israel":null,"israel_scored_by":null,"rank":7503,"popularity":11608,"members":2983,"favorites":7},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1039/135444l.webp"},"trailer":null,"characters":[{"name":"Hijiri, Mimi","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/10/509640.webp?s=4d466e280718fcdba4009dcc0ba7ab7d","voice_actors":[{"name":"Koyama, Mami","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/2/