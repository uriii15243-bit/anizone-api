{"id":1276,"mal_id":1276,"anizone_id":1276,"url":"https://anizone.co.il/anime/1276/Ys","slug":"Ys","titles":{"hebrew":"Ys","english":null,"romaji":"Ys","japanese":"Ys イース","synonyms":["Ancient Books of Ys"],"community":[],"known":["Ys","Ys イース","Ancient Books of Ys"]},"synopsis_hebrew":"חיות מיתיות מטילות מצור על תושבי אסטריה, שהקימו צבא כדי להילחם בחזרה. החיות אינן מרפות ונראה שאין סוף למספרן, בעוד אוכלוסיית המגינים מתמעטת בכל עימות. אפילו בעיירה מינאה, שבה האנשים מוגנים מאחורי חומות הטירה, ההתקפות המתמשכות הותירו אותם חסרי תקווה. אז ניתנה נבואה המכריזה על בואו של נשמה צעירה ואמיצה שעשויה להיות זו שתביא את ישועתם.\n\n\"Ys\" עוקב אחר אדול כריסטין, הרפתקן המונע על ידי תשוקה לנדודים אל האי אסטריה, שנשטף לחוף לאחר טביעת ספינה. בעקבות הדרכתה של מגדת העתידות שרה טובא, הוא ובעלי בריתו ינדדו באי בחיפוש אחר הספרים האגדיים הידועים כ\"ספרי Ys\". זו תהיה מסע ארוך ומסוכן, אך אם הגורל אכן פועל, אז אדול יהיה בוודאי הגיבור שישיב את השלום לאסטריה.","background_hebrew":null,"type":"OVA","episodes":7,"duration_minutes":26,"status":"הסתיים","aired_from":"1989-11-21","season":{"label":"סתיו 1989","year":1989,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Action","Adventure","Drama","Fantasy"],"studios":["Tokyo Kids","Urban Product"],"producers":["Starchild Records","Nihon Falcom"],"licensors":["Media Blasters"],"source":null,"rating":null,"scores":{"mal":6.57,"mal_scored_by":3334,"israel":null,"israel_scored_by":null,"rank":7710,"popularity":7539,"members":9809,"favorites":17},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/9/23207l.webp"},"trailer":null,"characters":[{"name":"Christin, Adol","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/11/508968.webp?s=97d1b3fc72684df81ec949269e37cf5c","vo