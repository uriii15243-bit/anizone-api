{"id":34572,"mal_id":34572,"anizone_id":34572,"url":"https://anizone.co.il/anime/34572/Black-Clover","slug":"Black-Clover","titles":{"hebrew":"תלתן שחור","english":"Black Clover","romaji":"Black Clover","japanese":"ブラッククローバー","synonyms":[],"community":["בלאק קלובר"],"known":["Black Clover","ブラッククローバー"]},"synopsis_hebrew":"אסטה ויונו ננטשו יחדיו באותה הכנסייה ובאותו היום, ולא נפרדו אף לרגע מאז. כילדים הם הבטיחו שהם יתחרו אחד בשני כדי לראות מי יהיה קיסר הקסם הבא. עם זאת, ככל שהם גדלו, כך גם גדלו ההבדלים בניהם.\nיונו הוא גאון עם שליטה ומיומנות אדירות בקסם שלו, בעוד שאסטה לא מסוגל להשתמש בקסם כלל ומנסה לפצות על כך עם אימונים פיזיים מפרכים.\n כשהם קיבלו את גרימווארים שלהם בגיל 15, יונו קיבל ספר מרהיב עם תלתן בעל ארבעה עלים, בעוד שאסטה לא קיבל כלום. עם זאת, כאשר נבל איים על חיו של יונו, אסטה קיבל גרימוואר עם תלתן בעל חמישה עלים, תלתן שחור!\nכעת שני החברים יוצאים לעולם הגדול, כששניהם הולכים לעבר אותה המטרה!","background_hebrew":"בלאק קלובר מעבד את 27 הכרכים הראשונים של המנגה המקורית.","type":"TV","episodes":170,"duration_minutes":23,"status":"הסתיים","aired_from":"2017-10-03","season":{"label":"סתיו 2017","year":2017,"season":"fall"},"broadcast":{"label":"שלישי 18:25","day":"tuesday","time":"18:25","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Fantasy"],"studios":["Studio Pierrot"],"producers":["TV Tokyo","Avex Pictures","Shueisha"],"licensors":["Funimation","Crunchyroll"],"source":null,"rating":null,"scores":{"mal":8.15,"mal_scored_by":1017293,"israel":8.08,"israel_scored_by":13,"rank":528,"popularity":52,"members":1963288,"favorites":52401},"community_reviews":{"ratings":13,"written_reviews":2},"images":{"poster":"https://cdn.myanimelist.net/images/anime/2/88336l.webp"},"trailer":{"youtube_id":"vUjAxk1qYzQ","url":"https://www.youtube.com/watch?v=vUjAxk1qYzQ","embed_url":"https://www.youtube.com/embed/vUjAxk1qYzQ"},"characters":[{"name":"Su