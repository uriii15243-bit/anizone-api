{"id":6374,"mal_id":6374,"anizone_id":6374,"url":"https://anizone.co.il/anime/6374/Eagle-Riders","slug":"Eagle-Riders","titles":{"hebrew":"איגל ריידרס","english":"Eagle Riders","romaji":"Kagaku Ninja-tai Gatchaman II","japanese":"科学忍者隊ガッチャマンII","synonyms":["Science Ninja Team Gatchaman II","Kagaku Ninjatai Gatchaman II","Science Ninja Team Gatchaman II, Kagaku Ninjatai Gatchaman II"],"community":[],"known":["Kagaku Ninja-tai Gatchaman II","Eagle Riders","科学忍者隊ガッチャマンII","Science Ninja Team Gatchaman II","Kagaku Ninjatai Gatchaman II"]},"synopsis_hebrew":"שנתיים לאחר התבוסה של גלאקטור והמוות לכאורה של קונדור ג'ו, ספינת תענוגות מותקפת על ידי לידר X, שמחסל כמעט את כל הנוסעים על הסיפון. אחת הניצולות, ילדה צעירה, נתפסת על ידי X ומזדקנת במהירות לנבלית המוזרה בעלת הקול הגברי, גל סדרא. למרות המראה הבוגר שלה, גל סדרא אינה חסינה מהתפרצויות ילדותיות והתנהגות לא בוגרת.\n\nבעיצומו של תחיית גלאקטור, צוות הנינג'ה המדעי נקרא שוב לפעולה, כאשר אדם מפוקפק בשם הוק גץ משמש כמחליף לג'ו. במהרה מתגלה שגץ הוא סוכן גלאקטור בתחפושת (והרג את גץ האמיתי שהיה אמור להצטרף), והוא נהרג על ידי שוריקן נוצה מסתורי. לאחר רמזים שהתפשטו בשלושת הפרקים הראשונים, ג'ו מופיע מחדש בפרק הרביעי, לאחר ששרד איכשהו את פציעותיו הקטלניות בסוף הסדרה הראשונה, ומצטרף שוב לצוות. מאוחר יותר מתגלה שהוא ניצל על ידי מדען לשעבר של גלאקטור על סף מותו, והיה נתון לשדרוגים קיברנטיים שונים.\n\nבהמשך הסדרה מוצגת מדענית בשם ד\"ר פנדורה, שאיבדה את בעלה ובתה באסון ספינת התענוגות. מבלי לדעת, בתה סמי שרדה והיא למעשה גל סדרא.","background_hebrew":null,"type":"TV","episodes":52,"duration_minutes":23,"status":"הסתיים","aired_from":"1978-10-01","season":{"label":"סתיו 1978","year":1978,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Action","Adventure","Sci-Fi"],"studios":["Tatsunoko Production"],"producers":[],"licensors":["Sentai Film