{"id":50796,"mal_id":50796,"anizone_id":50796,"url":"https://anizone.co.il/anime/50796/Insomniacs-After-School","slug":"Insomniacs-After-School","titles":{"hebrew":"נדודי שינה אחרי בית הספר","english":"Insomniacs After School","romaji":"Kimi wa Houkago Insomnia","japanese":"君は放課後インソムニア","synonyms":["Kimisomu"],"community":[],"known":["Kimi wa Houkago Insomnia","Insomniacs After School","君は放課後インソムニア","Kimisomu"]},"synopsis_hebrew":"תלמיד התיכון גאנטה נקאמי מתקשה להירדם ברוב הלילות. כתוצאה מכך, הוא עצבני בבית הספר ותמיד יחפש מקום שקט לנמנם בו.\nמנגד, איסאקי מגארי, בעלת רוח חופשייה וחביבה על כל חבריה, אבל איש לא יודע על הפרעת השינה שלה.\nכאשר היא צריכה לעצום עין לזמה מה, היא עושה שימוש בחדר הנטוש של מועדון האסטרונומיה של בית הספר.\n\nכפי שחרץ הגורל, נקאמי מוצה את מגארי מנמנמת במצפה הכוכבים.\nוכאשר מגארי מגלה שלה ולנקאמי יש מכנה משותף, היא מציעה לחלוק את מקום השינה שלה עם חברה לנדודי השינה.\nכשהשניים מוצאים קירבה בחברתו אחד של השנייה, המאבקים שהם מתמודדים איתם נהפכים לקלים יותר.","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2023-04-11","season":{"label":"אביב 2023","year":2023,"season":"spring"},"broadcast":{"label":"שלישי 00:00","day":"tuesday","time":"00:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Romance"],"studios":["LIDENFILMS"],"producers":["TV Tokyo","Pony Canyon","Ultra Super Pictures","Shogakukan","MAGNET","CHOCOLATE"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":8.08,"mal_scored_by":113883,"israel":9.0,"israel_scored_by":null,"rank":643,"popularity":995,"members":290014,"favorites":2661},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1402/134007l.webp"},"trailer":{"youtube_id":"YcgFC0Mf-ME","url":"https://www.youtube.com/watch?v=YcgFC0Mf-ME","embed_url":"https://www.y