{"id":1707,"mal_id":1707,"anizone_id":1707,"url":"https://anizone.co.il/anime/1707/Ultimate-Muscle","slug":"Ultimate-Muscle","titles":{"hebrew":"שריר אולטימטיבי","english":"Ultimate Muscle","romaji":"Kinnikuman II Sei","japanese":"キン肉マンII世","synonyms":["Kinnikuman Nisei","Kinnikuman Second Generations","Ultimate Muscle: The Kinnikuman Legacy","Kinnikuman Nisei, Kinnikuman Second Generations, Ultimate Muscle: The Kinnikuman Legacy"],"community":[],"known":["Kinnikuman II Sei","Ultimate Muscle","キン肉マンII世","Kinnikuman Nisei","Kinnikuman Second Generations","Ultimate Muscle: The Kinnikuman Legacy"]},"synopsis_hebrew":"קיניקומן II סיי מתרחש מספר שנים לאחר האירועים של קיניקומן המקורי. מנטארו קיניקו הוא הנסיך ה-59 של כוכב קיניקו ובנו של המתאבק המפורסם, המלך סוגורו. עצלן, ילדותי ופחדן, מנטארו נראה שאין לו הרבה במשותף עם אביו הגיבור.\n\nכאשר קבוצה חזקה המכנה את עצמה dMP מאיימת על כדור הארץ, רק מישהו חזק כמו קיניקומן יכול לעמוד מולם. מאחר שלא יודעים היכן נמצא המלך כרגע, מתכננים שבנו מנטארו ייקח על עצמו את התפקיד. הרעיון להילחם בנבלי-על לא מוצא חן בעיני מנטארו, והוא בתחילה בורח מחובתו. הוא נמלט לכדור הארץ, שם הוא פוגש את מיט, המאמן הוותיק של אביו. למרות החסרונות של מנטארו, מיט רואה בו את המלך סוגורו ומאמין שהוא יכול להוביל את הנסיך לדרך הנכונה. כך מתחיל המסע של מנטארו לשפר את עצמו ולהציל את העולם.","background_hebrew":null,"type":"TV","episodes":51,"duration_minutes":24,"status":"הסתיים","aired_from":"2002-01-09","season":{"label":"חורף 2002","year":2002,"season":"winter"},"broadcast":{"label":"רביעי 18:00","day":"wednesday","time":"18:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Sci-Fi","he":"מדע בדיוני"},{"en":"Sports","he":"ספורט"}],"subcategories":[{"en":"Combat Sports","he":"קרבות ספורט"}],"demographic":null,"genres":["Comedy","Sci-Fi","Sports"],"studios":["Toei Animation"],"producers":["TV Tokyo","Yomiko Advertising"],"licensors":["4Kids Entertainment","Discotek Media"],"source":null,"rating":null,"scores":{"mal":6.95,"mal_scored_by":97