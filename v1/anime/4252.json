{"id":4252,"mal_id":4252,"anizone_id":4252,"url":"https://anizone.co.il/anime/4252/Explorer-Woman-Ray","slug":"Explorer-Woman-Ray","titles":{"hebrew":"אקספלורר וומן ריי","english":"Explorer Woman Ray","romaji":"Explorer Woman Ray","japanese":"EXPLORER WOMAN RAY (エクスプローラーウーマン・レイ)","synonyms":[],"community":[],"known":["Explorer Woman Ray","EXPLORER WOMAN RAY (エクスプローラーウーマン・レイ)"]},"synopsis_hebrew":"היא ארכיאולוגית וגם חגורה שחורה, וריי קזוקי תזדקק למוחה ולכוחה כשהיא צוללת להרפתקה מלאה במתח. ריי בוחנת תגלית ארכיאולוגית מרתקת: מקדש אגדי הממוקם באזור מבודד בעולם.\n\nכמו תמיד, יש לה איתה מראה מוזרה שהייתה שייכת לאביה; מראה שעשויה לספק גישה לציוויליזציה שנעלמה. במהלך החפירה, ריי פוגשת את מאי ומאמי טאצ'יבאנה, נערות מתבגרות חסרות דאגות שמחפשות סכנה ללא חשש. והן אכן מוצאות סכנה, בדמותו של ריג ודה.\n\nודה מחפש פרס גדול: המראה של ריי. אבל היא תצטרך לעצור אותו בכל מחיר, כי אם ודה ישים את ידיו על החפץ החזק, הוא יחזיק בסודות שעלולים להוביל לאסון.","background_hebrew":null,"type":"OVA","episodes":2,"duration_minutes":30,"status":"הסתיים","aired_from":"1989-05-26","season":{"label":"אביב 1989","year":1989,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"}],"subcategories":[],"demographic":null,"genres":["Action","Adventure"],"studios":["AIC","animate Film"],"producers":["Toshiba EMI"],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.62,"mal_scored_by":857,"israel":null,"israel_scored_by":null,"rank":13060,"popularity":12421,"members":2371,"favorites":1},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/10/56653l.webp"},"trailer":null,"characters":[{"name":"Johnson","role":"משני","image":"https://cdn.myanimelist.net/images/characters/5/80396.webp?s=8d8da151a3d9952ae44784ee41a31ad4","voice_actors":[{"name":"Koseki, Hajime","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/3/10907.jpg?s=