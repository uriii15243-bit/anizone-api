{"id":5034,"mal_id":5034,"anizone_id":5034,"url":"https://anizone.co.il/anime/5034/Corpse-Princess-Kuro","slug":"Corpse-Princess-Kuro","titles":{"hebrew":"נסיכת הגופות: קורו","english":"Corpse Princess: Kuro","romaji":"Shikabane Hime: Kuro","japanese":"屍姫 玄","synonyms":["Shikabane Hime Second Season"],"community":[],"known":["Shikabane Hime: Kuro","Corpse Princess: Kuro","屍姫 玄","Shikabane Hime Second Season"]},"synopsis_hebrew":"המשך ישיר ל\"שיקבנה הימה: אקה\", המתרחש שישה חודשים לאחר מותו של טגאמי קייסיי בידי השיצ'יסיי (שבעת הכוכבים), קבוצה של שיקבנה עילית שפועלים מתוך יותר מאשר חרטות בלבד. בהתאם לבקשתו האחרונה של קייסיי, קאגאמי אורי יצר חוזה זמני עם מאקינה כדי להציל אותה מהפיכה לשיקבנה. מאז, אורי מתאמן להפוך לנזיר ראוי כדי שיוכל להישאר מחובר למאקינה ולעזור לה להילחם בשיצ'יסיי - אלו שהרגו במקור את מאקינה, את כל משפחת הושימורה, וכעת גם את קייסיי. עם זאת, הנזיר הבוגד שישידו אקאשה הצטרף לשיצ'יסיי בניסיון להשמיד את כל שיקבנה הימה ואת כל ארגון הנזירים שמשתמש בהם - כת קוגון.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2009-01-01","season":{"label":"חורף 2009","year":2009,"season":"winter"},"broadcast":{"label":"חמישי 10:30","day":"thursday","time":"10:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Horror","he":"אימה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Horror","Supernatural"],"studios":["Gainax","feel."],"producers":["Square Enix","Starchild Records"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.25,"mal_scored_by":34080,"israel":null,"israel_scored_by":null,"rank":3524,"popularity":2796,"members":82066,"favorites":125},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1125/105989l.webp"},"trailer":null,"characters":[{"name":"Hoshimura, Makina","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/4/58017.webp?s=359c