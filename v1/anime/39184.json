{"id":39184,"mal_id":39184,"anizone_id":39184,"url":"https://anizone.co.il/anime/39184/A3-Season-Spring-Summer","slug":"A3-Season-Spring-Summer","titles":{"hebrew":"A3! עונת אביב וקיץ","english":"A3! Season Spring & Summer","romaji":"A3! Season Spring & Summer","japanese":"A3! SEASON SPRING & SUMMER","synonyms":["Act! Addict! Actors! Season Spring & Summer"],"community":[],"known":["A3! Season Spring & Summer","A3! SEASON SPRING & SUMMER","Act! Addict! Actors! Season Spring & Summer"]},"synopsis_hebrew":"רחוב ולודו, המלא במופעי רחוב והופעות, מושך אליו את כל מי שמתעניין בצפייה בשחקנים מקצועיים. לאחר קבלת מכתב מסתורי, איזומי טאצ'יבאנה מגיעה למקום שבו אביה ניהל בעבר קבוצת תיאטרון פופולרית בשם חברת מנקאי, אך מגלה שהמבנה עומד לשנות ייעוד בשל חובות כבדים. ברגע האחרון, היא מצליחה לשכנע את גובה החובות לתת לקבוצה הזדמנות נוספת. הוא מוכן להסכים, אך בשלושה תנאים: המופע הראשון שלהם חייב להיות מופק בהצלחה עד החודש הבא, ארבעת תתי-הקבוצות הגבריות חייבות להיות משוחזרות, והחוב חייב להיות משולם בתוך שנה. בנוסף, איזומי עצמה חייבת להפוך לבמאית.\n\nללא זמן לבזבז, איזומי אוספת במהירות חמישה אנשים לקבוצת האביב: סאקויה סאקומה, תלמיד תיכון נלהב; מסומי אוסוי, נער המאוהב באיזומי; צוזורו מינאגי, מחזאי שאפתן; איטארו צ'יגאסאקי, עובד משרד בוגר; וציטרון, זר ידידותי. למרות שיש להם מעט או אין ניסיון במשחק, על איזומי מוטלת המשימה לאמן ולהכין אותם להופעה שתשיב את חברת מנקאי לתהילתה הקודמת.\n\nנכתב על ידי MAL Rewrite.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2020-01-14","season":{"label":"חורף 2020","year":2020,"season":"winter"},"broadcast":{"label":"שלישי 00:00","day":"tuesday","time":"00:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Performing Arts","he":"אמנות במה"}],"demographic":null,"genres":["Drama"],"studios":["P.A. Works","Studio 3Hz"],"producers":["Pony Canyon","Liber Entertainment"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.09,"mal_scored_by":1