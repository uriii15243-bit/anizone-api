{"id":238,"mal_id":238,"anizone_id":238,"url":"https://anizone.co.il/anime/238/Flame-of-Recca","slug":"Flame-of-Recca","titles":{"hebrew":"להבת רקה","english":"Flame of Recca","romaji":"Rekka no Honoo","japanese":"烈火の炎","synonyms":["Recca no Honoo"],"community":[],"known":["Rekka no Honoo","Flame of Recca","烈火の炎","Recca no Honoo"]},"synopsis_hebrew":"רוב האנשים חושבים שנינג'ות הן דבר מהעבר, אבל רקה האנאבישי מקווה אחרת. למרות שהוא מגיע ממשפחה שמייצרת זיקוקים, הוא אוהב לחשוב על עצמו כנינג'ה מודרני בעיצוב עצמי. נשמע כיף, נכון? אולי לא. רקה מוצא את עצמו בהרבה קרבות כי פעם הכריז באומץ שאם מישהו יוכל להביס אותו, הוא יהפוך למשרתו.\n\nיום אחד, רקה פוגש את יאנאגי סאקושיטה, נערה עדינה עם היכולת לרפא כל פצע או פגיעה. המפגש שלהם מתחיל שרשרת של אירועים שמובילים לגילוי מפתיע. רקה הוא החבר האחרון ששרד משבט נינג'ות אגדי שנכחד לפני מאות שנים. אפילו יותר מדהים מלהיות נינג'ה אמיתי, הוא גם שולט בכוח לשלוט באש. מה זה אומר עבור רקה? מי הם האנשים המוזרים האלה שרודפים אחריו ואחרי יאנאגי? גלו ב\"רקה נו הונו\"!","background_hebrew":null,"type":"TV","episodes":42,"duration_minutes":23,"status":"הסתיים","aired_from":"1997-07-19","season":{"label":"קיץ 1997","year":1997,"season":"summer"},"broadcast":{"label":"שבת 18:30","day":"saturday","time":"18:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"}],"subcategories":[{"en":"Martial Arts","he":"אומנויות לחימה"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure"],"studios":["Studio Pierrot"],"producers":["Fuji TV"],"licensors":["VIZ Media","Discotek Media"],"source":null,"rating":null,"scores":{"mal":7.35,"mal_scored_by":29923,"israel":null,"israel_scored_by":null,"rank":2949,"popularity":2978,"members":74172,"favorites":285},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1646/113504l.webp"},"trailer":null,"characters":[{"name":"Hanabishi, Rekka","role":"ראשי","image":"https://cdn.myanim