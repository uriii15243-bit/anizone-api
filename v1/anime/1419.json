{"id":1419,"mal_id":1419,"anizone_id":1419,"url":"https://anizone.co.il/anime/1419/Lupin-III-Farewell-to-Nostradamus","slug":"Lupin-III-Farewell-to-Nostradamus","titles":{"hebrew":"לופן השלישי: פרידה מנוסטרדמוס","english":"Lupin III: Farewell to Nostradamus","romaji":"Lupin III: Kutabare! Nostradamus","japanese":"ルパン三世『くたばれ!ノストラダムス,』","synonyms":["Rupan Sansei","Lupin III: Die! Nostradamus","Rupan Sansei, Lupin III: Die! Nostradamus"],"community":[],"known":["Lupin III: Kutabare! Nostradamus","Lupin III: Farewell to Nostradamus","ルパン三世『くたばれ!ノストラダムス,』","Rupan Sansei","Lupin III: Die! Nostradamus"]},"synopsis_hebrew":"לאחר שוד יהלומים בברזיל, לופן מחביא את היהלום בתוך בובה ועולה על מטוס שיוצא מהמדינה. במהלך הטיסה, הבובה נגנבת על ידי ילדה קטנה בשם ג'וליה, שהמטפלת שלה היא לא אחרת מאשר פוג'יקו מינה. לפני שלופן מצליח להחזיר את הבובה, המטוס נחטף והילדה נחטפת. החוטפים מחפשים את אותו הדבר שפוג'יקו מחפשת - ספר נבואות של נוסטרדמוס המוסתר במגדל של אביה של ג'וליה. לופן והחבורה מצטרפים יחד כדי להציל את הילדה, להחזיר את היהלום ולגלות את הסודות שמקיפים את הספר המוזר.\n\nמקור: ANN","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":97,"status":"הסתיים","aired_from":"1995-04-22","season":{"label":"אביב 1995","year":1995,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Mystery","he":"מסתורין"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Adventure","Comedy","Mystery"],"studios":["Tokyo Movie Shinsha"],"producers":["VAP","Tohokushinsha Film Corporation"],"licensors":["Funimation","Discotek Media"],"source":null,"rating":null,"scores":{"mal":7.36,"mal_scored_by":6374,"israel":null,"israel_scored_by":null,"rank":2873,"popularity":6626,"members":13385,"favorites":12},"community_reviews":null,"images":{"poster":"https://cdn.myanimelis