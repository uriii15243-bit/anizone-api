{"id":36296,"mal_id":36296,"anizone_id":36296,"url":"https://anizone.co.il/anime/36296/Hinamatsuri","slug":"Hinamatsuri","titles":{"hebrew":"הינאמטסורי","english":"Hinamatsuri","romaji":"Hinamatsuri","japanese":"ヒナまつり","synonyms":["Hina Festival"],"community":[],"known":["Hinamatsuri","ヒナまつり","Hina Festival"]},"synopsis_hebrew":"בעודו חוגג את ההצלחה בהשגת אגרטל יקר לאוסף שלו, יושיפומי ניטה, חבר ביאקוזה, מופרע בגסות כאשר קפסולה גדולה ומוזרה מופיעה פתאום ונופלת על ראשו. הוא פותח את הקפסולה ומגלה נערה צעירה עם שיער כחול, שאינה מגלה דבר על עצמה מלבד שמה—הינה—והעובדה שיש לה כוחות עצומים. כאילו הדברים לא יכולים להחמיר, היא מאבדת שליטה ויוצרת פיצוץ אם כוחותיה לא בשימוש. ללא ברירה אחרת, ניטה מוצא את עצמו הופך למטפל שלה.\n\nכדי לאפשר לה להשתמש בכוחותיה בחופשיות, ניטה מבקש מהינה לעזור בעסקת בנייה, שעוברת בצורה חלקה. אך בזמן שזה קורה, קבוצה יריבה של יאקוזה תוקפת בסתר את הבוס שלו. להפתעתו של ניטה, עמיתיו מאשימים אותו בכך! כשהוא נדרש לתקוף את הקבוצה היריבה כתגובה, ניטה מתכונן ומגיע למקום המסתור שלהם. אך לפתע, הינה מתערבת באופן בלתי צפוי ועוזרת לו לחסל את כל הקבוצה. כפי שמתברר, הינה עשויה להפוך לנכס יקר ערך עבור ניטה ועסקי היאקוזה שלו, בתנאי שלא תשתמש בכוחותיה עליו קודם! וכך מתחיל החיים המוזרים של הצמד הבלתי רגיל הזה.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2018-04-06","season":{"label":"אביב 2018","year":2018,"season":"spring"},"broadcast":{"label":"שישי 21:00","day":"friday","time":"21:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"Childcare","he":"טיפול בילדים"},{"en":"Organized Crime","he":"פשע מאורגן"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Comedy"],"studios":["feel."],"producers":["AT-X","Magic Capsule","Nippon Columbia","Kadokawa Media House","NTT Plala","Kadokawa","Akatsuki"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":8.11,"mal_scored_by":272306,