{"id":1019,"mal_id":1019,"anizone_id":1019,"url":"https://anizone.co.il/anime/1019/Mirage-of-Blaze","slug":"Mirage-of-Blaze","titles":{"hebrew":"מיראז' אוף בלייז","english":"Mirage of Blaze","romaji":"Honoo no Mirage","japanese":"炎の蜃気楼 [ミラージュ]","synonyms":[],"community":[],"known":["Honoo no Mirage","Mirage of Blaze","炎の蜃気楼 [ミラージュ]"]},"synopsis_hebrew":"טקאיה אוגי הוא סתם בחור תיכון רגיל שרוצה לא יותר מאשר להגן על חברו הטוב ביותר ולחיות חיים נורמליים. ואז נכנס לתמונה נובוצונה נאואה, גבר מבוגר יותר שמודיע לטקאיה שהוא למעשה גלגול נשמות של הלורד קאגטורה. נאואה, שהוא בעצמו מחזיק, מעורר את היכולות של טקאיה לגרש רוחות רעות ולהילחם בעולם התחתון הפיאודלי. בעוד שרוב המחזיקים זוכרים את חייהם הקודמים לפני שנולדו מחדש, טקאיה לא זוכר. נאואה מודה על כך, בהתחשב בעברו הסוער והמתעלל עם הלורד קאגטורה. ככל שטקאיה משפר את יכולותיו, הוא גם מתחיל לזכור מה נאואה עשה מתוך אהבתו אליו. בינתיים, כוחות האופל של שבטי הוג'ו ופומה מתחילים את התקפתם כאשר העולם התחתון הפיאודלי יורד על העולם החי.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2002-01-07","season":{"label":"חורף 2002","year":2002,"season":"winter"},"broadcast":{"label":"שני 18:00","day":"monday","time":"18:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Boys Love","he":"אהבת בנים"},{"en":"Drama","he":"דרמה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Reincarnation","he":"חזר לחיים"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Action","Boys Love","Drama","Supernatural"],"studios":["Madhouse"],"producers":["Aniplex"],"licensors":["Media Blasters"],"source":null,"rating":null,"scores":{"mal":6.47,"mal_scored_by":8694,"israel":null,"israel_scored_by":null,"rank":8300,"popularity":5022,"members":26985,"favorites":92},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/22614l.webp"},"trailer":null,"characters":