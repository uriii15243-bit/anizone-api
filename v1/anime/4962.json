{"id":4962,"mal_id":4962,"anizone_id":4962,"url":"https://anizone.co.il/anime/4962/Six-Gates-Faraway-Mon-Colle-Knights","slug":"Six-Gates-Faraway-Mon-Colle-Knights","titles":{"hebrew":"ששת השערים הרחק אבירי מון קול","english":"Six Gates Faraway Mon Colle Knights","romaji":"Rokumon Tengai Mon Colle Knights","japanese":"六門天外モンコレナイト","synonyms":["Rokumon Tengai Monkore Knight"],"community":[],"known":["Rokumon Tengai Mon Colle Knights","Six Gates Faraway Mon Colle Knights","六門天外モンコレナイト","Mon Colle Knights","Los Caballeros del Mundo Mon","Rokumon Tengai Monkore Knight"]},"synopsis_hebrew":"שני מדענים מטורפים, פרופסור היראגי והרוזן קולקשן, מצליחים בו זמנית לפתוח חור חלום לעולם מקביל שבו המיתוסים הם אמיתיים, עולם הסיקסגייט. פרופסור היראגי מגייס את בתו רוקונה ואת חברה מונדו להיות אבירי מון קול ולהעזור לו להשיג שישה פריטים קסומים לפני שהרוזן קולקשן ישיג אותם. פריטים אלו יכולים לשנות את מחסומי הממדים כאשר הם משולבים, ומאפשרים להשתמש בהם כדי להעביר את הקסם של עולם הסיקסגייט לעולם האנושי בשלום, להשתלט על מוחות כל המפלצות, או גרוע מכך, לשנות את המציאות.\n\nבעוד שהכניסה הזו כוללת פרטים המבוססים על הגרסה היפנית, היא כוללת גם את הגרסה ששודרה ב-Jetix.","background_hebrew":null,"type":"TV","episodes":51,"duration_minutes":25,"status":"הסתיים","aired_from":"2000-01-10","season":{"label":"חורף 2000","year":2000,"season":"winter"},"broadcast":{"label":"שני 18:00","day":"monday","time":"18:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Parody","he":"פרודיה"}],"demographic":{"en":"Kids","he":"Kids"},"genres":["Adventure","Comedy","Fantasy"],"studios":["Studio Deen"],"producers":[],"licensors":["Discotek Media"],"source":null,"rating":null,"scores":{"mal":6.62,"mal_scored_by":2194,"israel":null,"israel_scored_by":null,"rank":7341,"popularity":9011,"members":6258,"favorites":19},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/17055