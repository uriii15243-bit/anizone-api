{"id":62856,"mal_id":62856,"anizone_id":62856,"url":"https://anizone.co.il/anime/62856/Sparks-of-Tomorrow","slug":"Sparks-of-Tomorrow","titles":{"hebrew":"ניצוצות המחר","english":"Sparks of Tomorrow","romaji":"Nijusseiki Denki Mokuroku: Eureka Evrika","japanese":"二十世紀電氣目録-ユーレカ・エヴリカ-","synonyms":["20th Century Electricity Catalog"],"community":[],"known":["Nijusseiki Denki Mokuroku: Eureka Evrika","Sparks of Tomorrow","二十世紀電氣目録-ユーレカ・エヴリカ-","20th Century Electricity Catalog"]},"synopsis_hebrew":"בגרסה חלופית של ראשית המאה ה-20, שבה הקידמה הטכנולוגית התפתחה במסלול שונה שעוצב בידי כוח הקיטור, קיוטו עטופה בעשן תמידי.\n\nנער, שהתקשח בעקבות אובדן אחיו, נעשה חשדן לאחר שחלומם המשותף על \"עידן החשמל\" נגדע באיבו. נערה אדוקה מאוד מסתירה עמוק בלבה את חלומותיה ואת חרטותיה על אמה המנוחה. כשהשניים נפגשים, הם יוצאים לחקור את סודותיו של קטלוג החשמל של המאה ה-20, הצצה אל העתיד שלו הם מייחלים.\n\nיחד, עליהם להתמודד עם עברם ולסלול דרך אל העתיד שבו האמינו פעם.\n\n(מקור: Press Release)","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2026-07-05","season":{"label":"קיץ 2026","year":2026,"season":"summer"},"broadcast":{"label":"ראשון 23:00","day":"sunday","time":"23:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Historical","he":"היסטורי"}],"demographic":null,"genres":["Drama"],"studios":["Kyoto Animation"],"producers":["Lantis","Pony Canyon","Rakuonsha","ABC Animation","Heart Company","Bandai Namco Music Live"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.43,"mal_scored_by":31220,"israel":9.0,"israel_scored_by":3,"rank":2556,"popularity":2333,"members":108651,"favorites":486},"community_reviews":{"ratings":3,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1068/158475l.webp"},"trailer":{"youtube_id":"-W2vs2etG9o","url":"https://www.youtube.com/watch?v=-W2vs2etG9o","embed_url":"https://www.youtube.com/embed/-W2vs2etG9o"},"characters":[{"n