{"id":35255,"mal_id":35255,"anizone_id":35255,"url":"https://anizone.co.il/anime/35255/The-Relative-Worlds","slug":"The-Relative-Worlds","titles":{"hebrew":"גם אם סוף העולם יגיע מחר - הסרט","english":"The Relative Worlds","romaji":"Soutai Sekai","japanese":"ソウタイセカイ","synonyms":[],"community":[],"known":["Soutai Sekai","The Relative Worlds","ソウタイセカイ","Les Mondes Parallèles"]},"synopsis_hebrew":"שין האזמה סגר את לבו מאז מותה המסתורי והפתאומי של אמו במהלך ילדותו. כשאביו המדען התעסק עד מעל לראשו במחקר, הוא סמך רק על חברת ילדותו, קוטורי איזומי, בתו טובת הלב של מעסיקו של אביו. בסוף השנה השלישית בתיכון עם סיום הלימודים, סוף סוף שין וקוטורי מתחילים להתקדם יחד, גם בחיים וגם באהבה.\n הכל מתפרק שוב כשגם אביו של שין מת פתאום. אבל לפני שהעניינים מסתדרים, הוא וקוטורי מגלים את הסוד העומד מאחורי מותם הפתאומי של הוריו כשהם נתקלים באנשים מיפן המקבילה. ביניהם ג'ין, המקביל של שין, שנלחם בכלי הנשק האינטליגנטים מיקו וריקו.","background_hebrew":null,"type":"ONA","episodes":2,"duration_minutes":15,"status":"הסתיים","aired_from":"2017-04-28","season":{"label":"אביב 2017","year":2017,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Sci-Fi"],"studios":["Craftar Studios"],"producers":["Hulu","Lucky Pictures"],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.68,"mal_scored_by":2583,"israel":null,"israel_scored_by":null,"rank":12817,"popularity":7828,"members":8937,"favorites":7},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1433/95260l.webp"},"trailer":{"youtube_id":"LU5Ecq0e2Kg","url":"https://www.youtube.com/watch?v=LU5Ecq0e2Kg","embed_url":"https://www.youtube.com/embed/LU5Ecq0e2Kg"},"characters":[{"name":"Izumi, Kotori","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/8/335160.webp?s=f7d50c7b063e2979754e398010771a01","voice_actors":[{"name":"Uchida, Maaya","language":"יפ