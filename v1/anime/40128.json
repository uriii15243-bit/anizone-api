{"id":40128,"mal_id":40128,"anizone_id":40128,"url":"https://anizone.co.il/anime/40128/Arte","slug":"Arte","titles":{"hebrew":"ארטה","english":"Arte","romaji":"Arte","japanese":"アルテ","synonyms":[],"community":[],"known":["Arte","アルテ"]},"synopsis_hebrew":"במאה ה-16, העיר פירנצה משגשגת בתחייה תרבותית ויצירתית לרגל חגיגות הרנסנס. ארטה, גברת צעירה מקסימה ממשפחה אריסטוקרטית, חולמת להיות אמנית ולתרום לחידוש הציביליזציה. אולם, עם מות אביה, היא מאבדת את האדם היחיד שהאמין בתשוקתה לאמנות. כעת מצפים ממנה להינשא לאציל ולחיות כעקרת בית מעודנת מבלי לבייש את שם משפחתה. ארטה העקשנית, המסרבת להשלים עם גורלה, יוצאת לרחובות בחיפוש אחר אמן מאסטר שייקח אותה כשוליה.\nבחיפושיה אחר מנטור, ארטה נאלצת להתמודד עם מציאות קשה כאשר היא נדחית לחלוטין בגלל היותה אמנית. איש אינו מאמין כי נשים מסוגלות לאומנות עילית, ולכן אף אחד אינו מוכן לקבל אותה. למרבה המזל, אמן מפורסם בשם ליאו משתכנע לקחת אותה כתלמידתו מאחר שממילא אין לו תלמידים. וכך, מתחילים חייה החדשים של ארטה, הרחק מהנוחות של חינוכה האצילי. כשוליה, עליה להרוויח את לחמה תוך התמודדות עם אתגרים שונים לאורך הדרך הקשה להפוך לאמנית מקצועית ומנוסה.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2020-04-04","season":{"label":"אביב 2020","year":2020,"season":"spring"},"broadcast":{"label":"שבת 22:00","day":"saturday","time":"22:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Visual Arts","he":"אומנות חזותית"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Drama"],"studios":["Seven Arcs"],"producers":["MediaNet","Toei Video","KlockWorx","flying DOG","Nikkatsu","Asmik Ace","BS Fuji","NBCUniversal Entertainment Japan","Tokyo MX","Glovision","North Stars Pictures","Ray","Muse Communication"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.21,"mal_scored_by":63596,"israel":7.0,"israel_scored_by":null,"rank":3730,"popularity":1851,"members":147592,"favorites":412},"community_reviews":{