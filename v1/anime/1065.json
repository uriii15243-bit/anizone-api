{"id":1065,"mal_id":1065,"anizone_id":1065,"url":"https://anizone.co.il/anime/1065/Touch","slug":"Touch","titles":{"hebrew":"טאץ'","english":"Touch","romaji":"Touch","japanese":"タッチ","synonyms":[],"community":[],"known":["Touch","タッチ","Touch: Bateadores"]},"synopsis_hebrew":"הסיפור מתמקד בשלוש דמויות—אואסוגי קאוזויה, אחיו התאום הבכור טאצויה, ואסאקורה מינאמי. קאוזויה הוא חביב העיירה שלו, כיוון שהוא מוכשר, חרוץ והפיצ'ר המוביל של קבוצת הבייסבול של חטיבת הביניים שלו. טאצויה הוא בטלן חסר תקווה שחי בצל אחיו, למרות שייתכן שהוא מוכשר יותר ממנו. מינאמי היא החברה היפה מהילדות ולמעשה האחות מהבית השכן שמתייחסת לשניהם כשווים. החברה מניחה ברובה שקאוזויה ומינאמי יהפכו לזוג המושלם, כולל טאצויה. אך ככל שהזמן עובר, טאצויה מבין שהוא מוכן להקריב הכל למען אחיו, חוץ מלוותר על מינאמי לטובת קאוזויה. וכך מסופר הסיפור על טאצויה שמנסה להוכיח את עצמו מול אחיו הצעיר והמוכשר, איך זה משפיע על הקשר בין השלושה, וניסיונותיהם של שני האחים להגשים את חלומותיה של מינאמי לכל החיים.","background_hebrew":null,"type":"TV","episodes":101,"duration_minutes":25,"status":"הסתיים","aired_from":"1985-03-24","season":{"label":"אביב 1985","year":1985,"season":"spring"},"broadcast":{"label":"ראשון 19:00","day":"sunday","time":"19:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Sports","he":"ספורט"}],"subcategories":[{"en":"Love Polygon","he":"אהבה יותר מאישה אחת"},{"en":"School","he":"בית ספר"},{"en":"Team Sports","he":"ספורט קבוצתי"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Drama","Romance","Sports"],"studios":["Group TAC"],"producers":["Asatsu DK","Fuji TV","TOHO"],"licensors":[],"source":null,"rating":null,"scores":{"mal":8.02,"mal_scored_by":11737,"israel":null,"israel_scored_by":null,"rank":747,"popularity":4173,"members":40693,"favorites":631},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/53087l.webp"},"trailer":null,"characters":[{"name":"Uesugi, Tatsuya","role":"ראשי","image":"https://cdn.myan