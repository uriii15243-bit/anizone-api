{"id":3619,"mal_id":3619,"anizone_id":3619,"url":"https://anizone.co.il/anime/3619/Nanako-SOS","slug":"Nanako-SOS","titles":{"hebrew":"נאנאקו SOS","english":"Nanako SOS","romaji":"Nanako SOS","japanese":"ななこSOS","synonyms":["Nana the Super Girl"],"community":[],"known":["Nanako SOS","ななこSOS","Supernana","Nana the Super Girl"]},"synopsis_hebrew":"נאנאקו היא נערה צעירה שמקבלת באופן בלתי צפוי כוחות על-טבעיים ובאותו זמן מאבדת את זיכרונה מהעבר. במקרה, גאון מדעי בשם מרלו נוכח כשהיא מקבלת את כוחותיה. מרלו הוא תלמיד תיכון חרוץ עם שאיפות יוצאות דופן. הוא משכנע את נאנאקו להצטרף לסוכנות הבלשים שלו על ידי הבטחה לעזור לה להחזיר את זיכרונה. נאנאקו מאמינה לו בתמימות, אך הכוונה האמיתית של מרלו היא להשתמש בכוחותיה לטובת הסוכנות שלו ולעצמו.\n\nהסיפור מתפתח כאשר נאנאקו נתקלת במגוון משימות מסוכנות ואירועים מסתוריים, אך האופי השמשי הטבעי שלה עוזר לה לעבור את כל התקריות כשהיא פותרת כל תעלומה אחת אחרי השנייה.\n\n(מקור: ויקיפדיה)","background_hebrew":null,"type":"TV","episodes":39,"duration_minutes":23,"status":"הסתיים","aired_from":"1983-04-02","season":{"label":"אביב 1983","year":1983,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Parody","he":"פרודיה"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":null,"genres":["Comedy","Romance"],"studios":["Kokusai Eigasha"],"producers":["Fuji TV"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.73,"mal_scored_by":743,"israel":null,"israel_scored_by":null,"rank":6576,"popularity":11545,"members":3043,"favorites":8},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/2/6635l.webp"},"trailer":null,"characters":[{"name":"Pollon","role":"משני","image":"https://cdn.myanimelist.net/images/characters/11/473340.webp?s=2e2c65713fa8502baa6782e83d1432c5","voice_actors":[{"name":"Miura, Masako","language":"יפנית","image":"https://cdn.myanimelist.net/imag