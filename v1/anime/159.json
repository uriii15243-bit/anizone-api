{"id":159,"mal_id":159,"anizone_id":159,"url":"https://anizone.co.il/anime/159/The-Melody-of-Oblivion","slug":"The-Melody-of-Oblivion","titles":{"hebrew":"מנגינת השכחה","english":"The Melody of Oblivion","romaji":"Boukyaku no Senritsu","japanese":"忘却の旋律","synonyms":[],"community":[],"known":["Boukyaku no Senritsu","The Melody of Oblivion","忘却の旋律","La Melodía del Olvido"]},"synopsis_hebrew":"מלחמה גדולה התרחשה במאה ה-20 בין בני האדם למפלצות. מאז, המפלצות שולטות בעולם בפחד אך נשארות יחסית נסתרות מעיני הציבור. נער בשם בוקה מהרהר בעבר ותוהה מה עלה בגורל לוחמי המרוס שהגנו על העולם באומץ רב נגד השדים. הוא פוגש במהרה את קורופונה ולומד על כוחם של המרוס ועל מכונות ה-I-bar שהם רוכבים עליהן בקרב. הלוחמים הם היחידים שיכולים לראות ולשמוע את מנגינת השכחה, נערה פנטום שמוסתרת ומחכה להינצל ולהיות מושיעת האנושות. במהלך קרב בין קורופונה לשד, בוקה מגלה משהו שרק בחלומותיו הפרועים ביותר יכול היה לדמיין... גם הוא יכול לשמוע את המנגינה הזו. במהלך מסעותיו, בוקה פוגש מפלצות רבות וסוכניהם, חברים ושותפים, כשהוא מגלה את היקף כוחותיו החדשים. עליו להמשיך להילחם ברשע בתקווה לשחרר את בוקיאקו נו סנריטסו ולשחרר עולם ששכח את מנגינתו היפהפייה שהייתה פעם.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":24,"duration_minutes":23,"status":"הסתיים","aired_from":"2004-04-07","season":{"label":"אביב 2004","year":2004,"season":"spring"},"broadcast":{"label":"רביעי 02:54","day":"wednesday","time":"02:54","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Horror","he":"אימה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mecha","he":"רובוטים"},{"en":"Psychological","he":"פסיכולוגיה"},{"en":"Space","he":"חלל"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Adventure","Fantasy","Horror","Sci-Fi"],"studios":["J.C.Staff"],"producers":["Gainax","Kadokawa Shoten","TBS","Ken Media"],"licensors":["Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":6.31,"mal_scored_b