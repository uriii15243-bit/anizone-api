{"id":535,"mal_id":535,"anizone_id":535,"url":"https://anizone.co.il/anime/535/Slayers-Next","slug":"Slayers-Next","titles":{"hebrew":"סליירס נקסט","english":"Slayers Next","romaji":"Slayers Next","japanese":"スレイヤーズNEXT","synonyms":[],"community":[],"known":["Slayers Next","スレイヤーズNEXT"]},"synopsis_hebrew":"בממלכת זואנה, לינה אינברס וגורי גברייב נתקלים באופן בלתי צפוי בחבריהם הוותיקים, זלגדיס גרייורדס והנסיכה אמיליה ויל טסלה סיילון. עם איחודם מחדש, החברים מצליחים בקלות לסכל את תוכניותיו המרושעות של מלך זואנה ובתו לכבוש את העולם.\n\nזמן קצר לאחר מכן, מתגלה שזלגדיס מחפש את הספר הקסום היקר ביותר בעולם, קלייר בייבל, בתקווה לגלות שיטה להחזיר את גופו האנושי בין הסודות הרבים שהוא מכיל. למרות מחאותיו, שאר הקבוצה מחליטה להצטרף למסע לאחר ששמעו על משימתו. אך בדיוק כשהם תוהים היכן להתחיל לחפש את הספר האגדי, הם נתקלים בכומר מסתורי בשם זלוס, שטוען שהוא עשוי לעזור להם במרדף.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":24,"status":"הסתיים","aired_from":"1996-04-05","season":{"label":"אביב 1996","year":1996,"season":"spring"},"broadcast":{"label":"שישי 18:30","day":"friday","time":"18:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Action","Adventure","Comedy","Fantasy"],"studios":["E&G Films"],"producers":["J.C.Staff","TV Tokyo","SoftX"],"licensors":["Funimation","Central Park Media","Enoki Films"],"source":null,"rating":null,"scores":{"mal":8.02,"mal_scored_by":39985,"israel":null,"israel_scored_by":null,"rank":746,"popularity":2907,"members":76924,"favorites":892},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1165/92536l.webp"},"trailer":null,"characters":[{"name":"Inverse, Lina","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/2/38218.webp?s=f06e6e2d2d3a321a2f028cceb9f75829","voice_actors":[{"name":"Hayashib