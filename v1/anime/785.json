{"id":785,"mal_id":785,"anizone_id":785,"url":"https://anizone.co.il/anime/785/Otaku-no-Video","slug":"Otaku-no-Video","titles":{"hebrew":"אוטאקו נו וידאו","english":"Otaku no Video","romaji":"Otaku no Video","japanese":"おたくのビデオ","synonyms":["Geeks' Video"],"community":[],"known":["Otaku no Video","おたくのビデオ","Geeks' Video"]},"synopsis_hebrew":"מבוסס במידה מסוימת על הסיפור האמיתי של הקמת גיינאקס, \"אוטאקו נו וידאו\" עוסק בכל ההיבטים של אורח החיים של אוטאקו. טאקשי קובו הוא צעיר שחי חיים ממוצעים עד שהוא נגרר לקבוצה של אוטאקו. לאט לאט הוא הופך להיות יותר כמוהם עד שהוא מחליט לנטוש את חייו הקודמים כדי להפוך למלך האוטאקו—האוטאקינג!\n\nמשולבים בסיפור ראיונות בלייב-אקשן עם אוטאקו אמיתיים, המתייחסים לכל היבט של חיי אוטאקו קיצוניים. לא רק מעריצי אנימה ומנגה נכללים, אלא גם מעריצי מדע בדיוני, מעריצי צבא וקבוצות נוספות של גיקים יפניים.","background_hebrew":null,"type":"OVA","episodes":2,"duration_minutes":48,"status":"הסתיים","aired_from":"1991-09-27","season":{"label":"קיץ 1991","year":1991,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Mecha","he":"רובוטים"},{"en":"Otaku Culture","he":"תרבות האוטקו"}],"demographic":null,"genres":["Comedy","Drama","Sci-Fi"],"studios":["Gainax"],"producers":["Youmex"],"licensors":["AnimEigo"],"source":null,"rating":null,"scores":{"mal":7.14,"mal_scored_by":15500,"israel":null,"israel_scored_by":null,"rank":4193,"popularity":4382,"members":36892,"favorites":131},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1217/117018l.webp"},"trailer":null,"characters":[{"name":"Kubo, Takeshi","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/7/487660.webp?s=ddab4bf4b7272e49d930775424b6c778","voice_actors":[{"name":"Tsujitani, Kouji","language":"יפנית","image":"https://cdn.myanimelist.net