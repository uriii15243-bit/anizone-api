{"id":4459,"mal_id":4459,"anizone_id":4459,"url":"https://anizone.co.il/anime/4459/Prince-Mackaroo","slug":"Prince-Mackaroo","titles":{"hebrew":"נסיך מקארו","english":"Prince Mackaroo","romaji":"Ojarumaru","japanese":"おじゃる丸","synonyms":[],"community":[],"known":["Ojarumaru","Prince Mackaroo","おじゃる丸"]},"synopsis_hebrew":"בעידן הייאן, לפני כ-1000 שנה, ילד צעיר ממשפחה אצילה בשם אוג'ארומארו משתעמם מחייו המפנקים. בינתיים, שלושה שדים גונבים את מקל הכוח של אנמה, מלך השדים, ואז מאבדים אותו. אוג'ארומארו מוצא אותו ומשתמש בו כדי להעביר את עצמו לזמן ההווה. כאן, הוא מתיידד עם ילד צעיר בשם קאזומה והופך לחלק ממשפחתו. ככל שהזמן עובר, אוג'ארומארו יוצר חברים חדשים רבים, תוך שהוא מתחמק מהמאמצים הקומיים של שלושת השדים, אקאנה, קיסוקה ואובי, שמנסים להשיב את המקל. (מקור: ANN)","background_hebrew":"העונה השנייה ששודרה בשנת 1999 (פרקים 91-180) זכתה בפרס הצטיינות בפסטיבל האמנויות המדיה היפני השלישי.","type":"TV","episodes":null,"duration_minutes":10,"status":"בשידור","aired_from":"1998-10-05","season":{"label":"סתיו 1998","year":1998,"season":"fall"},"broadcast":{"label":"לא צויין 18:10","day":null,"time":"18:10","timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Award Winning","he":"זוכה פרס"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":{"en":"Kids","he":"Kids"},"genres":["Adventure","Award Winning","Comedy","Fantasy"],"studios":["Gallop"],"producers":["NHK"],"licensors":["Enoki Films"],"source":null,"rating":null,"scores":{"mal":6.36,"mal_scored_by":612,"israel":null,"israel_scored_by":null,"rank":9025,"popularity":12096,"members":2601,"favorites":7},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1072/154254l.webp"},"trailer":null,"characters":[{"name":"Sakanoue, Ojarumaru","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/2/112658.webp?s=2c1b230a9b063ce232bbb2a26725cbb7","voice_actors":[{"name":"Nishimura, Chinami","language":"יפנית","image":"https