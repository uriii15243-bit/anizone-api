{"id":25429,"mal_id":25429,"anizone_id":25429,"url":"https://anizone.co.il/anime/25429/Isuca","slug":"Isuca","titles":{"hebrew":"איסוקה","english":"Isuca","romaji":"Isuca","japanese":"ISUCA [イスカ]","synonyms":["Isuka"],"community":[],"known":["Isuca","ISUCA [イスカ]","Isuka"]},"synopsis_hebrew":"עלילת הסדרה סובבת סביב אסאנו שינצ'ירו, נער תיכון ממוצע, אשר ננטש על-ידי הוריו והוכרח לעבוד למחייתו. שינצ'ירו לא הסתדר עם עבודתו הנוכחית ואף פוטר ממנה.\nיום בהיר אחד, קיבל שינצ'ירו הצעה ממורה בבית ספרו לעבוד כעקר בית בבית תלמידה נוספת בבית הספר, המוכרת כסאקויה שימוזו, בחצי משרה. באחד הערבים, כאשר עמד לעזוב את בית הספר, שינצ'ירו הבחין בשימוזו יורה בחץ וקשת לעבר יצורים מוזרים, ומסתבר שאלו היו שדים. מאותו לילה, הבין שינצ'ירו כי הוא עובד עבור אחת מראשי משפחות החיסול לשדים, משפחת שימוזו.","background_hebrew":"הפרק הראשון הוקרן בהקרנה מוקדמת בקדוקאווה סינמה שינג'וקו בטוקיו ב-5 בינואר 2015. השידור הרגיל החל ב-24 בינואר 2015.","type":"TV","episodes":10,"duration_minutes":23,"status":"הסתיים","aired_from":"2015-01-24","season":{"label":"חורף 2015","year":2015,"season":"winter"},"broadcast":{"label":"שבת 01:35","day":"saturday","time":"01:35","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Supernatural","he":"על טבעי"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Harem","he":"הרמון (נשים)"},{"en":"Mythology","he":"מיתולוגיה"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Comedy","Romance","Supernatural","Ecchi"],"studios":["Arms"],"producers":["Kadokawa Shoten","AT-X","DAX Production","KlockWorx","MAGES."],"licensors":["Discotek Media"],"source":null,"rating":null,"scores":{"mal":5.97,"mal_scored_by":71071,"israel":null,"israel_scored_by":null,"rank":11267,"popularity":1739,"members":158818,"favorites":105},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1769/134794l.webp"},"trailer":{"youtube_id":"Ut_1