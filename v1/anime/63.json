{"id":63,"mal_id":63,"anizone_id":63,"url":"https://anizone.co.il/anime/63/DearS","slug":"DearS","titles":{"hebrew":"דירס","english":"DearS","romaji":"DearS","japanese":"ディアーズ","synonyms":[],"community":[],"known":["DearS","ディアーズ"]},"synopsis_hebrew":"לפני שנה, עב\"ם שהכיל 150 חייזרים התרסק לחופי קאסאי. מכיוון שאף אחד לא הצליח לתקן את הספינה שלהם, ממשלת יפן החליטה להעניק להם את הכינוי \"DearS\" ולהפוך אותם לאזרחים יפנים, תוך לימוד השפה, המנהגים והתרבות של יפן. עם זאת, כדי להכיר טוב יותר את החברה האנושית, הוחלט על תוכנית אירוח שתאפשר להם להתערבב עם בני אדם אחרים.\n\nבוקר ערפילי אחד, משאית שנשאה קפסולה עם אחת מהחייזרים הללו הפילה אותה לגדת הנהר, ושחררה אותה מהכלא שלה. היא נמצאת בסופו של דבר על ידי תלמיד תיכון בשם טאקיה איקוהארה, שמציל אותה מפגיעת משאית ומרחם עליה, למרות שהוא מאוד חשדן כלפי הגזע שלהם ולא רוצה שום קשר איתם. לאחר שהיא מקבלת את השם רן, היא מטביעה עליו את חותמה כ\"מאסטר\" שלה ומשמשת כ\"עבד\" האישי שלו, ומשאירה אותו עם \"DearS\" שרוצה להישאר איתו בכל מחיר ומביאה לסיום את ימיו הרגילים והחסרי חייזרים.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2004-07-11","season":{"label":"קיץ 2004","year":2004,"season":"summer"},"broadcast":{"label":"ראשון 00:30","day":"sunday","time":"00:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Sci-Fi","he":"מדע בדיוני"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Comedy","Romance","Sci-Fi","Ecchi"],"studios":["Daume"],"producers":["Bandai Visual","HAL Film Maker","Genco","Lantis"],"licensors":["Discotek Media","Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":6.55,"mal_scored_by":82828,"israel":null,"israel_scored_by":null,"rank":7780,"popularity":1741,"members":158684,"favorites":379},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1207/98872l.webp"},"trailer":null,"characters":[{"name"