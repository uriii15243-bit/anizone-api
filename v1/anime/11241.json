{"id":11241,"mal_id":11241,"anizone_id":11241,"url":"https://anizone.co.il/anime/11241/Brave-10","slug":"Brave-10","titles":{"hebrew":"עשרת האמיצים","english":"Brave 10","romaji":"Brave 10","japanese":"ブレイブ・テン","synonyms":["Brave10","Brave Ten","Brave10, Brave Ten"],"community":[],"known":["Brave 10","ブレイブ・テン","Brave10","Brave Ten"]},"synopsis_hebrew":"לאחר שביתה של איסנאמי, כוהנת צעירה ממקדש איזומו, עלה בלהבות על ידי קבוצת נינג'ות, היא ברחה אל היערות על מנת לא להיהרג בדומה למשפחתה. במקרה, היא נתקלת בסאיזו קיריגהקורה, נינג'ה נודד מבית הספר \"איגה\". שניהם מגיעים ל\"טירת אודאה\" במטרה לבקש מיוקימורה סאנדה עזרה. מתגלה לנו שאיסנאמי מחזיקה בכוח משונה והרסני, וסאנדה מסכימה לעזור לה. היא מכנסת עשרה לוחמים אמיצים שילחמו לצידה.\nאלו הם \"עשרת האמיצים\". הסיפור מתרחש בתקופת המלחמות, ועוקב אחר המסע של סאיזו ואיסנאמי לאורך הממלכות הנמצאות במלחמה, בחיפוש אחר הלוחמים האמיצים שישרתו תחת יוקימורה. כל אחד מהלוחמים מחזיק ביכולות מיוחדות משלו. צפוי לשניהם מסע ארוך יחדיו.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2012-01-08","season":{"label":"חורף 2012","year":2012,"season":"winter"},"broadcast":{"label":"ראשון","day":"sunday","time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Samurai","he":"סמוראי"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Adventure"],"studios":["TMS Entertainment"],"producers":["Media Factory","Studio Saki Makura","TMS Music"],"licensors":["NIS America","Discotek Media"],"source":null,"rating":null,"scores":{"mal":6.73,"mal_scored_by":72458,"israel":7.0,"israel_scored_by":null,"rank":6538,"popularity":1780,"members":154496,"favorites":265},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1704/143834l.webp"},"trailer":{"youtube_id":"ioSn1KaDEj0","u