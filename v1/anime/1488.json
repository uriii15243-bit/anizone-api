{"id":1488,"mal_id":1488,"anizone_id":1488,"url":"https://anizone.co.il/anime/1488/Area-88","slug":"Area-88","titles":{"hebrew":"אזור 88","english":"Area 88","romaji":"Area 88","japanese":"エリア88","synonyms":["Area 88 OVA"],"community":[],"known":["Area 88","エリア88","Area 88 OVA"]},"synopsis_hebrew":"לאחר ששין קאזאמה נפל בפח וחתם על מסמך על ידי מישהו שחשב לחבר, הוא נאלץ להפוך לטייס קרב בלגיון הזרים של שכירי חרב, הנלחמים במלחמת אזרחים במדינת אסלאן. נחוש להרוויח מספיק כסף כדי לשבור את החוזה ולחזור ליפן, שין הצליח להפוך לאחד הטייסים הקטלניים ביותר בבסיס הידוע כ\"אזור 88\". אך לאחר שבילה כל כך הרבה זמן במקום שבו חייו תמיד בסכנה, האם שין יישאר אותו אדם אם וכאשר יוכל לחזור לעולם האזרחי?\n\nנכתב על ידי MAL Rewrite","background_hebrew":"אזור 88 פורסם על ידי Central Park Media בשלושה קלטות VHS ודיסקי לייזר בשנת 1992. בשנת 2000, שני הפרקים הראשונים יצאו על גבי DVD. בשנת 2006, חברת ADV Films רכשה את הרישיון והוציאה גרסת DVD של ה-OVA שערוכה לשני פרקים ארוכים. Discotek Media פרסמה גרסה מחודשת של אזור 88 על גבי DVD ב-30 באוקטובר 2018.","type":"OVA","episodes":3,"duration_minutes":65,"status":"הסתיים","aired_from":"1985-02-05","season":{"label":"חורף 1985","year":1985,"season":"winter"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Military","he":"צבאי"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Drama","Romance"],"studios":["Studio Pierrot"],"producers":[],"licensors":["ADV Films","Central Park Media","Discotek Media"],"source":null,"rating":null,"scores":{"mal":7.51,"mal_scored_by":7864,"israel":null,"israel_scored_by":null,"rank":2165,"popularity":5440,"members":22429,"favorites":249},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/11/2856l.webp"},"trailer":{"youtube_id":"zgEPsQvnmOs","url":"https://www.youtube.com/wat