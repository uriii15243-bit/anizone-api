{"id":28205,"mal_id":28205,"anizone_id":28205,"url":"https://anizone.co.il/anime/28205/Fastening-Days","slug":"Fastening-Days","titles":{"hebrew":"ימים של חיבור","english":"Fastening Days","romaji":"Fastening Days","japanese":"FASTENING DAYS","synonyms":[],"community":[],"known":["Fastening Days","FASTENING DAYS"]},"synopsis_hebrew":"יוג'י וקיי, ילד וילדה, חיים בעיירה בעתיד הלא כל כך רחוק עם אמם המאמצת, אנה. אבל לילדים שנראים רגילים יש סוד שמוסתר אפילו מאמם שלא חושדת בדבר.\n\nיוג'י וקיי הם גיבורי על שמגנים על עיירתם! עם נפנוף בגלימותיהם, השניים ושותפם הדובי הרובוטי, אוסקר, מגנים על תושבי העיירה בעזרת מכשירים מתקדמים שהם בנו בעצמם. אבל מפני איזה איום? והאם גיבורינו הקטנים יצליחו להתגבר על המשבר שעומד לאיים על השלווה היומיומית של העיירה?\n\nבדקו את האנימציה המרתקת הזו מהעתיד הקרוב כדי לגלות!\n\n(מקור: האתר הרשמי)","background_hebrew":null,"type":"ONA","episodes":1,"duration_minutes":11,"status":"הסתיים","aired_from":"2014-10-30","season":{"label":"סתיו 2014","year":2014,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[],"subcategories":[],"demographic":{"en":"Kids","he":"Kids"},"genres":[],"studios":["Studio Colorido"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.37,"mal_scored_by":3060,"israel":null,"israel_scored_by":null,"rank":8934,"popularity":8804,"members":6644,"favorites":2},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/10/68209l.webp"},"trailer":null,"characters":[{"name":"Kei","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/15/267065.webp?s=de46208a3e53a4f8651026c984ae6608","voice_actors":[{"name":"Shiraishi, Ryouko","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/2/68031.jpg?s=3d4e00b97ff97695c36a1e95d59498fd"}]},{"name":"Youji","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/10/267063.webp?s=8b05b4b3b4e184394084749d4e92d855","voice_actors":[{"name":"Ono,