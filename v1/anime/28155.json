{"id":28155,"mal_id":28155,"anizone_id":28155,"url":"https://anizone.co.il/anime/28155/Yatterman-Night","slug":"Yatterman-Night","titles":{"hebrew":"ליל יטרמן","english":"Yatterman Night","romaji":"Yoru no Yatterman","japanese":"夜ノヤッターマン","synonyms":[],"community":[],"known":["Yoru no Yatterman","Yatterman Night","夜ノヤッターマン"]},"synopsis_hebrew":"כמה דורות לאחר סדרת יאטארמן המקורית, לאופרד חיה עם אמה והאפוטרופוסים שלה, דורותי, וולטקצה ואלפנטוס, ממש מחוץ לממלכת יאטאר המשגשגת. היא חיה חיים מאושרים, אם כי עניים, מבלי לדעת על קשריה המשפחתיים לכנופיית דורונבו הידועה לשמצה, עד שהיא מגלה ציור קיר של דורונזו, בויאקי וטונזורה באזור סגור בביתה. מתברר שדורותי, וולטקצה ואלפנטוס הם צאצאים של הפושעים המרושעים, ולכן נאסר עליהם להיכנס לממלכת הגיבור יאטארמן!\n\nבהתחלה, לאופרד נשבעת לעולם לא לעסוק במעשים מרושעים כמו אבותיה, אך נסיבות חדשות עשויות להוביל אותה להפר את הבטחתה, וללבוש את זהות הנבל בחיפוש אחר צדק אמיתי.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2015-01-11","season":{"label":"חורף 2015","year":2015,"season":"winter"},"broadcast":{"label":"ראשון 22:00","day":"sunday","time":"22:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Drama","he":"דרמה"}],"subcategories":[],"demographic":null,"genres":["Action","Adventure","Comedy","Drama"],"studios":["Tatsunoko Production"],"producers":["Yomiuri Telecasting","Starchild Records","Lantis","Half H.P Studio"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.52,"mal_scored_by":13304,"israel":null,"israel_scored_by":null,"rank":8018,"popularity":4530,"members":34356,"favorites":31},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/11/71773l.webp"},"trailer":{"youtube_id":"yL9mGc5gbiU","url":"https://www.youtube.com/watch?v=yL9mGc5gbiU","embed_url":"https://www.youtube.com/embed/yL9mGc5gbiU"},"characters":[{"name":"Doronjo","r