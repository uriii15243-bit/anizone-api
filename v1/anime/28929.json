{"id":28929,"mal_id":28929,"anizone_id":28929,"url":"https://anizone.co.il/anime/28929/Vampire-Holmes","slug":"Vampire-Holmes","titles":{"hebrew":"ואמפייר הולמס","english":"Vampire Holmes","romaji":"Vampire Holmes","japanese":"VAMPIRE HOLMES","synonyms":[],"community":[],"known":["Vampire Holmes","VAMPIRE HOLMES"]},"synopsis_hebrew":"הבלש הדגול הולמס לא פותר תעלומות ולא משתמש בהיגיון דדוקטיבי. הוא כן, עם זאת, צד ערפדים. באמצעות פרקים של שלוש דקות, \"ערפד הולמס\" מספר מחדש את סיפורו של הולמס הגדול ועוזרו. מה שמתחיל כסוכנות בלשים רגילה מקבל תפנית לעולם העל-טבעי כאשר משטרת המטרופולין של לונדון שוכרת בסתר את הולמס והדסון לחקור ערפדים.\n\nאו לפחות זה מה שהולמס היה מספר לכל מי ששואל. במציאות, הוא והדסון מבלים את רוב זמנם בישיבה ובוויכוחים, ולא מצליחים לפתור אף מקרה. יחד עם קירה, החתול השד שאינו כל כך שחור, ובעלת הבית המפחידה שלהם שצמאה לשכר דירה, זהו סיפורו של האיש שלא היה הבלש הגדול ביותר של לונדון.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":3,"status":"הסתיים","aired_from":"2015-04-04","season":{"label":"אביב 2015","year":2015,"season":"spring"},"broadcast":{"label":"שבת 01:55","day":"saturday","time":"01:55","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Mystery","he":"מסתורין"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[],"demographic":null,"genres":["Comedy","Mystery","Supernatural"],"studios":["Studio! Cucuri"],"producers":["CUCURI"],"licensors":[],"source":null,"rating":null,"scores":{"mal":3.35,"mal_scored_by":10162,"israel":null,"israel_scored_by":null,"rank":15355,"popularity":5398,"members":22791,"favorites":61},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/12/74765l.webp"},"trailer":null,"characters":[{"name":"Holmes","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/2/279133.webp?s=1a148127d97e8642190f660b1f93fa20","voice_actors":[{"name":"Sena, Yoshinobu","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors