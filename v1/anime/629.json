{"id":629,"mal_id":629,"anizone_id":629,"url":"https://anizone.co.il/anime/629/Magic-Users-Club-OVA","slug":"Magic-Users-Club-OVA","titles":{"hebrew":"מועדון משתמשי הקסם OVA","english":"Magic User's Club OVA","romaji":"Mahoutsukai Tai!","japanese":"魔法使いTai!","synonyms":[],"community":[],"known":["Mahoutsukai Tai!","Magic User's Club OVA","魔法使いTai!","Magic User's Clus OVA","Escuela De Brujas Ovas"]},"synopsis_hebrew":"יום אחד שמשי הגיעו פולשים מהחלל. הם לא היו אנשים ירוקים קטנים או בנות מצחיקות שלובשות תלבושות בית ספר, אלא רובוטים מכוערים שהביסו את כוחות האו\"ם בשניות. לאחר מכן הפולשים, הידועים כ\"עיניים\", הסתובבו והתבוננו בחברה האנושית. למעשה, הם היו שלווים אלא אם הותקפו. הם היו מנומסים ועקבו אחרי כל חוקי התנועה. ובכל זאת, הם היו חייזרים ואנשי כדור הארץ רצו שהם יחזרו הביתה. מועדון הקסם של תיכון קיטאנוהאשי לקח על עצמו להביס את הרובוטים המרושעים האלה ולשחרר את העולם.\n\n(מקור: ANN)","background_hebrew":null,"type":"OVA","episodes":6,"duration_minutes":27,"status":"הסתיים","aired_from":"1996-05-25","season":{"label":"אביב 1996","year":1996,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Comedy","Fantasy","Romance","Sci-Fi"],"studios":["Triangle Staff"],"producers":["Bandai Visual","Youmex"],"licensors":["Nozomi Entertainment","Media Blasters","NYAV Post"],"source":null,"rating":null,"scores":{"mal":7.11,"mal_scored_by":4730,"israel":null,"israel_scored_by":null,"rank":4359,"popularity":6683,"members":13137,"favorites":39},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/10/22077l.webp"},"trailer":null,"characters":[{"name":"Aburatsubo, Ayanojou","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/5/104940.webp?s=120dd61134fcb0f1b55d53bec10c823a","voice_actors":[{"name":"Koyasu