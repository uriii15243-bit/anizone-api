{"id":12883,"mal_id":12883,"anizone_id":12883,"url":"https://anizone.co.il/anime/12883/Tsuritama","slug":"Tsuritama","titles":{"hebrew":"טסוריטאמה","english":"Tsuritama","romaji":"Tsuritama","japanese":"つり球","synonyms":["Fishing Ball"],"community":[],"known":["Tsuritama","つり球","Fishing Ball"]},"synopsis_hebrew":"סאנאדה יוקי הוא נער בעל בעיות חברתיות קשות בעקבות מעברי דירה רבים שהוא\nנאלץ לחוות בשל עבודתה של סבתו. הוא לא יודע כיצד לנהוג בסיטוצאיות פשוטות\nויומיומית, וקשה לו אפילו לדבר עם אנשים. יום אחד עוברים הוא וסבתו לעיר נמל בשם\nאנושימה. שם, ביומו הראשון בבית הספר, פוגש יוקי נער מוזר שמסתובב עם דג מדבר\nעל הראש. הנער, הארו שמו, טוען שהוא חייזר, ויש לו קטע לירות על אנשים עם רובה\nמים. יוקי ההמום מנסה להתרחק מהארו, אך כשמסתבר שסבתו הזמינה את הארו לגור\nאיתם, הוא מבין שזה אבוד. בנוסף על כך, הארו מצפה מיוקי ללמוד לדוג, בטענה שככה הם\nיצילו את העולם.","background_hebrew":"אירוע טרום-שידור התקיים ב-7 באפריל 2012. האנימה שודרה רשמית ב-13 באפריל 2012.","type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2012-04-13","season":{"label":"אביב 2012","year":2012,"season":"spring"},"broadcast":{"label":"שישי 01:15","day":"friday","time":"01:15","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Comedy","Sci-Fi"],"studios":["A-1 Pictures"],"producers":["Aniplex","Dentsu","Fuji TV","Sakura Create"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.65,"mal_scored_by":62032,"israel":null,"israel_scored_by":null,"rank":1649,"popularity":1590,"members":178757,"favorites":2325},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/69909l.webp"},"trailer":{"youtube_id":"pn-BDOSDDa4","url":"https://www.youtube.com/watch?v=pn-BDOSDDa4","embed_url":"https://www.youtube.com/embed/pn-BDOSDDa4"},"characters":[{"name":"Haru","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/16/231325.