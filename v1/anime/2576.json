{"id":2576,"mal_id":2576,"anizone_id":2576,"url":"https://anizone.co.il/anime/2576/Raccoon-Rascal","slug":"Raccoon-Rascal","titles":{"hebrew":"ראקון ראסקל","english":"Raccoon Rascal","romaji":"Araiguma Rascal","japanese":"あらいぐまラスカル","synonyms":["Sekai Meisaku Gekijou"],"community":[],"known":["Araiguma Rascal","Raccoon Rascal","あらいぐまラスカル","Rascal, der Waschbär","Rascal, el Mapache","Sekai Meisaku Gekijou"]},"synopsis_hebrew":"החיים בבריילספורד ג'נקשן, ויסקונסין, פשוטים ושקטים עבור סטרלינג נורת', שמבלה את רוב זמנו הפנוי בטיפול בבעלי חיים. עם אמו בבית החולים ואחיו הנלחם בחזית המערבית, הנער חי רק עם אביו וכלבו האוזר.\n\nבסוף שבוע אחד, כשהוא מתרחק מהמטלות הרגילות שלו, סטרלינג, חברו אוסקר והאוזר יוצאים לטיול דיג. בדרכם לנהר, כלבו תופס ריח בבסיס עץ. כשהם חושפים קן של דביבון, שני הבנים מוצאים גור יתום. צייד שעבר הרג את אמו של הגור כדי להכין כובע פרווה, מה שמשאיר את סטרלינג לאמץ ולטפל בדביבון היתום.\n\nקרוע ממשפחתו המתפרקת, אחיו בחפירות, יחד עם בריאותה הרופפת של אמו, הקשרים של סטרלינג עם החיים והעולם סביבו נשמרים ומתחזקים על ידי החיים עם חברו החדש, ה\"פלא זנב הטבעת\" והנוכל, שהוא מכנה ראסקאל.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":null,"type":"TV","episodes":52,"duration_minutes":25,"status":"הסתיים","aired_from":"1977-01-02","season":{"label":"חורף 1977","year":1977,"season":"winter"},"broadcast":{"label":"ראשון 19:30","day":"sunday","time":"19:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Slice of Life","he":"חלק מהחיים"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Pets","he":"חיות"}],"demographic":null,"genres":["Slice of Life"],"studios":["Nippon Animation"],"producers":["Fuji TV"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.98,"mal_scored_by":1280,"israel":null,"israel_scored_by":null,"rank":5019,"popularity":10208,"members":4424,"favorites":14},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/7/3363l.webp"},"trailer":null,"characters":[{"name":"Rascal","role":"ראשי","image":"https