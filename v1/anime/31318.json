{"id":31318,"mal_id":31318,"anizone_id":31318,"url":"https://anizone.co.il/anime/31318/Comet-Lucifer","slug":"Comet-Lucifer","titles":{"hebrew":"כוכב השביט לוציפר","english":"Comet Lucifer","romaji":"Comet Lucifer","japanese":"コメット・ルシファー","synonyms":[],"community":[],"known":["Comet Lucifer","コメット・ルシファー"]},"synopsis_hebrew":"הסיפור מתרחש בעולם הנקרא גיפט, עולם המלא קריסטלים כחולים הנקראים גיפטודיום.\nסוגו אמאגי הוא ילד שחי בעיר שנקראת \"גארדן אינדיגו\", ויש לו תחביב של אסיפת קריסטלים נדירים.\nיום אחד, סוגו נקלע למריבה בין חבריו לכיתה, קאון, רומן ואוטו,\nובעקבות המריבה הוא נופל לעומק ההריסות ומגלה שם אגם תת-קרקעי.\nשם, סוגו פוגש נערה מסתורית עם שיער כחול ועיניים אדומות.\nמי הנערה הזאת, ומה פגישתם תעולל?\nהדלת להרפתקה נפתחת עם קשר החברות החדש ביניהם.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2015-10-04","season":{"label":"סתיו 2015","year":2015,"season":"fall"},"broadcast":{"label":"ראשון 22:30","day":"sunday","time":"22:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Mecha","he":"רובוטים"}],"demographic":null,"genres":["Adventure","Fantasy"],"studios":["8bit"],"producers":["Bandai Visual","Lantis","Bushiroad","Good Smile Company","BS11","Sony PCL"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":5.83,"mal_scored_by":46338,"israel":null,"israel_scored_by":null,"rank":12034,"popularity":2306,"members":109961,"favorites":92},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/76111l.webp"},"trailer":{"youtube_id":"ca_OPhc5P3Y","url":"https://www.youtube.com/watch?v=ca_OPhc5P3Y","embed_url":"https://www.youtube.com/embed/ca_OPhc5P3Y"},"characters":[{"name":"Felia","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/14/289233.webp?s=9d020bdfb0c1e49e704b6cb28a118fef","voice_actors":[{"name":"Ohashi, Ayaka","language":"יפנית","image":"https://cdn