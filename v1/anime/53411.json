{"id":53411,"mal_id":53411,"anizone_id":53411,"url":"https://anizone.co.il/anime/53411/Buddy-Daddies","slug":"Buddy-Daddies","titles":{"hebrew":"אבות וחברים","english":"Buddy Daddies","romaji":"Buddy Daddies","japanese":"Buddy Daddies","synonyms":[],"community":[],"known":["Buddy Daddies"]},"synopsis_hebrew":"המתנקשים קאזוקי קורוסו וריי סואווה פוגשים את מירי, ילדה שמחפשת את אביה ביום חג המולד. קאזוקי, ריי ומירי מתחילים לגור יחד באופן בלתי צפוי.\nהסיפור עוקב אחר קאזוקי קורוסו, קבלן פלילים שחי עם חברו הטוב, ריי סואווה, מתנקש מקצועי שגדל מילדות להיות רוצח שכיר.\nקאזוקי הוא יוצא דופן ואוהב הימורים ונשים, בעוד ריי הוא איש של מעט מילים שמבלה את השעות החופשיות שלו במשחקי וידאו.\nיום אחד, שני החברים איכשהו מטפלים במירי אונאסאקה, ילדה בת ארבע שאביה הוא בוס המאפיה, לאחר שמירי נקלעת בטעות לחילופי אש בבית מלון בזמן שהיא מחפשת את אביה.","background_hebrew":"באדי דאדיז יצא בבלו-ריי ו-DVD בשישה כרכים מה-22 במרץ 2023 עד ה-23 באוגוסט 2023.","type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2023-01-07","season":{"label":"חורף 2023","year":2023,"season":"winter"},"broadcast":{"label":"שבת 00:00","day":"saturday","time":"00:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"Childcare","he":"טיפול בילדים"},{"en":"Organized Crime","he":"פשע מאורגן"}],"demographic":null,"genres":["Action","Comedy"],"studios":["P.A. Works"],"producers":["Aniplex","Movic","Nitroplus","Tokyo MX","Nagoya Broadcasting Network","BS11","Bit grooove promotion"],"licensors":["Crunchyroll"],"source":null,"rating":null,"scores":{"mal":8.09,"mal_scored_by":169080,"israel":7.5,"israel_scored_by":2,"rank":617,"popularity":761,"members":371240,"favorites":3759},"community_reviews":{"ratings":2,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1553/133767l.webp"},"trailer":{"youtube_id":"jt_k3CE3-PM","url":"https://www.youtube.com/watch?v=jt_k3CE3-PM","embed_url":"https://www.youtube.co