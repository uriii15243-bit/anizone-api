{"id":202,"mal_id":202,"anizone_id":202,"url":"https://anizone.co.il/anime/202/Wolfs-Rain","slug":"Wolfs-Rain","titles":{"hebrew":"גשם הזאב","english":"Wolf's Rain","romaji":"Wolf's Rain","japanese":"ウルフズレイン","synonyms":["Wolf Rain"],"community":[],"known":["Wolf's Rain","ウルフズレイン","Wolf Rain"]},"synopsis_hebrew":"כבר ידוע לכולם שרוב הזאבים נכחדו מן העולם לפני כ-200 שנה, אך מעטים מהזאבים שנותרו בחיים \"לבשו\" צורת אדם, וכיום הם חיים בסביבת בני האדם כחלק מהם, נרדפים על ידי בני האדם הפוחדים מקיומם.\nקיבה הוא זאב בודד וצעיר שנודד בערים בחיפושו אחר פרחי הלונאר, אשר לפי האגדה אמורים להוביל את הזאבים אל גן העדן. גן העדן אמור להתגלות בסוף העולם, אך ורק בפני הזאבים.\nרוב הזאבים אינם מאמינים באגדה ומתרגלים לחיי אדם, אך קיבה רואה את גן העדן כסיבה היחידה להמשיך ולחיות. אל קיבה מצטרפים שלושה זאבים נוספים: טסומה, היגה וטובואה. יחד, הם יוצאים למסע חיפוש אחר גן העדן.","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":23,"status":"הסתיים","aired_from":"2003-01-07","season":{"label":"חורף 2003","year":2003,"season":"winter"},"broadcast":{"label":"שלישי 02:10","day":"tuesday","time":"02:10","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Mystery","he":"מסתורין"}],"subcategories":[],"demographic":null,"genres":["Action","Adventure","Drama","Fantasy","Mystery"],"studios":["Bones"],"producers":["Bandai Visual","Asatsu DK","Fuji TV"],"licensors":["Funimation","Bandai Entertainment"],"source":null,"rating":null,"scores":{"mal":7.79,"mal_scored_by":139906,"israel":7.0,"israel_scored_by":null,"rank":1227,"popularity":790,"members":358683,"favorites":6071},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/5/59403l.webp"},"trailer":{"youtube_id":"6ydbrdQXMeM","url":"https://www.youtube.com/watch?v=6ydbrdQXMeM","embed_url":"https://www.youtube.com/embed/6ydbrdQXMeM"},"characters":[{"name":"