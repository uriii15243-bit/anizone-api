{"id":36851,"mal_id":36851,"anizone_id":36851,"url":"https://anizone.co.il/anime/36851/The-Disaster-Awareness-Video","slug":"The-Disaster-Awareness-Video","titles":{"hebrew":"סרטון המודעות לאסון","english":"The Disaster Awareness Video","romaji":"Bousai Keihatsu Douga","japanese":"防災啓発動画","synonyms":[],"community":[],"known":["Bousai Keihatsu Douga","The Disaster Awareness Video","防災啓発動画"]},"synopsis_hebrew":"בהכנה לאסון רחב היקף שיתרחש באזור המטרופולין של טוקיו, השתמשנו במדיה הוויזואלית והזכירה של אנימה כדי ליצור \"סרטון חינוכי למניעת אסונות\" במטרה להעביר ידע קל להבנה על מניעת אסונות לתושבים זרים ביפן.\n\nבארבע שפות: יפנית, אנגלית, סינית וקוריאנית, הסרטון מלמד ידע כמו על מה להיזהר במקרה של רעידת אדמה, מה להכין מראש לרעידת אדמה, ומה לעשות אם רעידת אדמה מתרחשת בזמן העבודה או מחוץ לבית. אנו מקווים שהסרטון יהיה שימושי בהעלאת המודעות למניעת אסונות ובהכנה לאסון.\n\n(מקור: הוועדה לתקשורת בינלאומית של טוקיו)","background_hebrew":null,"type":"ONA","episodes":2,"duration_minutes":6,"status":"הסתיים","aired_from":"2014-04-01","season":{"label":"אביב 2014","year":2014,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Slice of Life","he":"חלק מהחיים"}],"subcategories":[{"en":"Educational","he":"חינוכי"}],"demographic":null,"genres":["Slice of Life"],"studios":[],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.71,"mal_scored_by":114,"israel":null,"israel_scored_by":null,"rank":12625,"popularity":21778,"members":319,"favorites":0},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/10/89145l.webp"},"trailer":null,"characters":[{"name":"Anna","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/16/344324.webp?s=edc2fc0fa8caf2fc57f2b15b95c5fa21","voice_actors":[{"name":"Seto, Erina","language":"קוריאנית","image":"https://cdn.myanimelist.net/images/voiceactors/3/51175.jpg?s=ccb5ecf20278c96f8068d8e231e31237"}]},{"name":"Bob","role":"ראשי