{"id":31221,"mal_id":31221,"anizone_id":31221,"url":"https://anizone.co.il/anime/31221/Tantei-Team-KZ-Jiken-Note","slug":"Tantei-Team-KZ-Jiken-Note","titles":{"hebrew":"טנטיי טים קז'י ג'יקן נוט","english":"Tantei Team KZ Jiken Note","romaji":"Tantei Team KZ Jiken Note","japanese":"探偵チームＫＺ（カッズ）事件ノート","synonyms":[],"community":[],"known":["Tantei Team KZ Jiken Note","探偵チームＫＺ（カッズ）事件ノート"]},"synopsis_hebrew":"איה טאצ'יבאנה היא תלמידת כיתה ו' שמודאגת ומוטרדת מחברים, משפחה, ציונים ועוד. יום אחד, היא מצטרפת ל\"צוות הבלשים KZ\" עם ארבעה בנים מאוד ייחודיים שהיא פגשה בבית הספר להשלמות. יש את המנהיג הכריזמטי והבולט קאזואומי וואקטאקה, את המסתורי \"מומחה ליחסים אישיים\" טאקאקאזו קורוקי, את הגאון המתמטי החכם והסטואי קאזונורי אואסוגי, ואת קאזוהיקו קוזוקה בעל הלב הטוב שמצטיין בעניינים חברתיים ומדע. איה מוצאת את מקומה ביניהם כ\"מומחית לשפה\". \"צוות הבלשים KZ\" מעורב במקרים מודרניים, וגם אם הם מתווכחים מדי פעם, הם משתפים פעולה על ידי שילוב הכישרונות והיכולות של כל אחד מהם כדי לפתור את המקרים הללו.\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":16,"duration_minutes":9,"status":"הסתיים","aired_from":"2015-10-07","season":{"label":"סתיו 2015","year":2015,"season":"fall"},"broadcast":{"label":"רביעי 18:45","day":"wednesday","time":"18:45","timezone":"Asia/Tokyo"},"categories":[{"en":"Mystery","he":"מסתורין"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Mystery"],"studios":["Signal.MD"],"producers":["Kodansha","Sony Music Communications","Tosho Printing","Tokyu Agency"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.18,"mal_scored_by":6278,"israel":null,"israel_scored_by":null,"rank":10103,"popularity":6308,"members":15096,"favorites":16},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/12/76574l.webp"},"trailer":null,"characters":[{"name":"Sunahara, Kakeru","role":"משני","image":"https://cdn.myanimelist.net/images/characters/2/294759.webp?s=06105d10e9bc42c21ccd8e0566e71391","voice_actor