{"id":15547,"mal_id":15547,"anizone_id":15547,"url":"https://anizone.co.il/anime/15547/B-Daman-Fireblast","slug":"B-Daman-Fireblast","titles":{"hebrew":"בי-דאמן פיירבלסט","english":"B-Daman Fireblast","romaji":"Cross Fight B-Daman eS","japanese":"クロスファイト ビーダマン eS","synonyms":[],"community":[],"known":["Cross Fight B-Daman eS","B-Daman Fireblast","クロスファイト ビーダマン eS"]},"synopsis_hebrew":"האנימה מתרחשת בארץ קרסט, שם הקריסטל המסתורי B התחיל להשתולל. הדמות הראשית, גודאי קאמון, גר באזור הדרומי של ארץ קרסט, והוא נער נמרץ שאוהב את B-דאמן. עם זאת, הוא איבד את כל זיכרונותיו מהעבר על B-דאמן ומשפחתו, למעט אחותו הגדולה אאונה שחיה איתו. יום אחד, קאמון פוגש את גלוון, B-דאמן בחנות המקומית שלו, B-ג'אנק, והוא מוצא את גלוון מוכר באופן מוזר. גלוון הופך לשותפו, והוא חוזר לקרבות B-דאמן פעם נוספת.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":52,"duration_minutes":12,"status":"הסתיים","aired_from":"2012-10-07","season":{"label":"סתיו 2012","year":2012,"season":"fall"},"broadcast":{"label":"ראשון 08:45","day":"sunday","time":"08:45","timezone":"Asia/Jerusalem"},"categories":[],"subcategories":[{"en":"Strategy Game","he":"משחק אסטרטגיה"}],"demographic":{"en":"Kids","he":"Kids"},"genres":[],"studios":["SynergySP"],"producers":["TV Tokyo","d-rights"],"licensors":["ADK Emotions NY Inc."],"source":null,"rating":null,"scores":{"mal":6.57,"mal_scored_by":2156,"israel":null,"israel_scored_by":null,"rank":7655,"popularity":10267,"members":4343,"favorites":17},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/2/42247l.webp"},"trailer":null,"characters":[{"name":"Ryugasaki, Kakeru","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/10/140541.webp?s=1163fa2e965488626b1c8cb0125f91cd","voice_actors":[{"name":"Oohara, Momoko","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/3/32783.jpg?s=a14867bceb5408c7bec44a65b30b0e6a"}]},{"name":"Shirogane, Subaru","role":"ראשי","image":"https://cdn.myanimelist.net/images/ch