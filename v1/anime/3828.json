{"id":3828,"mal_id":3828,"anizone_id":3828,"url":"https://anizone.co.il/anime/3828/Maegami-Tarou","slug":"Maegami-Tarou","titles":{"hebrew":"מאגמי טארו","english":"Maegami Tarou","romaji":"Maegami Tarou","japanese":"まえがみ太郎","synonyms":[],"community":[],"known":["Maegami Tarou","まえがみ太郎"]},"synopsis_hebrew":"זהו סיפור הרפתקאות בסגנון אגדה על ילד פעיל במסע לחיפוש מי החיים. הילד יוצא למסע הזה לאחר שלמד שמי החיים נחוצים כדי לשמח את כפרו.\n\nבדרכו, הוא פוגש אלים, שדים... במהרה הוא מגלה שהנחש הרשע גנב את המים, והוא פונה לארמון הנחש. להביס את הנחש אינו קל מכיוון שיש לו את מי החיים להחיות את עצמו. הילד הזה - מאגאמי טארו - ממשיך במסעו האמיץ בשיתוף פעולה עם יצורים שונים והאלים.","background_hebrew":null,"type":"TV Special","episodes":1,"duration_minutes":68,"status":"הסתיים","aired_from":"1979-04-29","season":{"label":"אביב 1979","year":1979,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"}],"subcategories":[],"demographic":null,"genres":["Adventure"],"studios":["Nippon Animation"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.1,"mal_scored_by":126,"israel":null,"israel_scored_by":null,"rank":10568,"popularity":17890,"members":617,"favorites":0},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/8/29237l.webp"},"trailer":null,"characters":[],"staff":[{"name":"Saitou, Hiroshi","role":"במאי","roles":["במאי"],"image":null},{"name":"Matsutani, Miyoko","role":"יוצר מקורי","roles":["יוצר מקורי"],"image":"https://cdn.myanimelist.net/images/voiceactors/2/19585.jpg?s=4dcefac7b30abb3e8ddafcf2473d5939"}],"external_links":{"myanimelist":"https://myanimelist.net/anime/3828","other":["http://www.nippon-animation.co.jp/work/maegamitaro.html","https://anidb.net/perl-bin/animedb.pl?show=anime&aid=4259","https://www.animenewsnetwork.com/encyclopedia/anime.php?id=9007"]},"attribution":{"source":"AniZone","source_url":"https://anizo