{"id":6746,"mal_id":6746,"anizone_id":6746,"url":"https://anizone.co.il/anime/6746/Durarara","slug":"Durarara","titles":{"hebrew":"דורארארה!!","english":"Durarara!!","romaji":"Durarara!!","japanese":"デュラララ!!","synonyms":["Dhurarara!!","Dyurarara!!","Dulalala!!","Dullalala!!","DRRR!!","Dhurarara!!, Dyurarara!!, Dulalala!!, Dullalala!!, DRRR!!"],"community":[],"known":["Durarara!!","デュラララ!!","Dhurarara!!","Dyurarara!!","Dulalala!!","Dullalala!!","DRRR!!"]},"synopsis_hebrew":"הסיפור מתרחש באזור המסחרי של טוקיו, מחוז איקבוקורו. המחוז מלא בכנופיות צעירים אנונימיות ובתושבים מסוכנים המשוטטים להם שם, וגם באגדה אורבנית העונה לשם \"דולאהן\", הרוכב חסר הראש, שרוכב על אופנוע שחור ללא פנסים או רעש מנוע.\n\nרייוגאמין מיקאדו, הוא תלמיד תיכון רגיל שתמיד השתוקק לריגוש של חיי העיר, והזמנה מחבר ילדות משכנעת אותו לעבור לאיקבוקורו. שם הם עדים לרוכב השחור ביומו הראשון בעיר, מכאן פורץ מאבק על ראשו הנעדר של דולאהן.","background_hebrew":"ג'וני יונג בוש וקארי וולגרן היו מועמדים לפרסי \"הביצוע הקולי הטוב ביותר לגבר\" ו\"הביצוע הקולי הטוב ביותר לאישה\" בטקס פרסי הדיבוב של BTVA לאנימה בשנת 2012 על הופעותיהם ב-Durarara!!.","type":"TV","episodes":24,"duration_minutes":24,"status":"הסתיים","aired_from":"2010-01-08","season":{"label":"חורף 2010","year":2010,"season":"winter"},"broadcast":{"label":"שישי 01:25","day":"friday","time":"01:25","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Mystery","he":"מסתורין"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[],"demographic":null,"genres":["Action","Mystery","Supernatural"],"studios":["Brain's Base"],"producers":["Aniplex","Square Enix","Mainichi Broadcasting System","Movic","ASCII Media Works"],"licensors":["Aniplex of America"],"source":null,"rating":null,"scores":{"mal":8.08,"mal_scored_by":696646,"israel":7.86,"israel_scored_by":7,"rank":637,"popularity":101,"members":1509839,"favorites":30658},"community_reviews":{"ratings":7,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/anime/10