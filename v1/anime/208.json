{"id":208,"mal_id":208,"anizone_id":208,"url":"https://anizone.co.il/anime/208/ROD-Read-or-Die","slug":"ROD-Read-or-Die","titles":{"hebrew":"R.O.D - לקרוא או למות","english":"R.O.D - Read or Die","romaji":"R.O.D: Read or Die","japanese":"R.O.D リード・オア・ダイ","synonyms":["ROD OVA","Read or Die OVA","ROD OVA, Read or Die OVA"],"community":[],"known":["R.O.D: Read or Die","R.O.D - Read or Die","R.O.D リード・オア・ダイ","ROD OVA","Read or Die OVA"]},"synopsis_hebrew":"יומיקו רידמן היא ביבליומאנית חביבה וקצרת ראייה שעובדת כמורה מחליפה בתיכון יפני. זהותה האמיתית, עם זאת, היא של סוכנת חשאית במחלקת המבצעים המיוחדים של הספרייה הבריטית. שם הקוד שלה: \"הנייר\". הכינוי מציין את היכולת העל-טבעית שלה לשלוט בנייר ולהפוך אותו לכל חפץ שהיא יכולה לדמיין, כולל כלים ונשק במאבקה נגד צבא IJIN (דמות היסטורית גדולה) החזק והאנוכי! יחד עם שותפתה, המסתורית \"גברת דיפ\", יומיקו נוסעת ברחבי העולם בניסיון לפתור את התעלומה מאחורי גלגול הנשמות של דמויות היסטוריות וניסיונן לשלוט בעולם.\n\nמקור: RightStuf","background_hebrew":null,"type":"OVA","episodes":3,"duration_minutes":31,"status":"הסתיים","aired_from":"2001-05-23","season":{"label":"אביב 2001","year":2001,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Mystery","he":"מסתורין"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Historical","he":"היסטורי"}],"demographic":null,"genres":["Action","Adventure","Mystery","Sci-Fi"],"studios":["Studio Deen"],"producers":["Aniplex","SME Visual Works"],"licensors":["Aniplex of America","Manga Entertainment"],"source":null,"rating":null,"scores":{"mal":7.61,"mal_scored_by":36499,"israel":null,"israel_scored_by":null,"rank":1774,"popularity":2862,"members":79132,"favorites":387},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1824/98849l.webp"},"trailer":null,"characters":[{"name":"Readman, Yomiko","