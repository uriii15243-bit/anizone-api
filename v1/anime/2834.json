{"id":2834,"mal_id":2834,"anizone_id":2834,"url":"https://anizone.co.il/anime/2834/MiracleGirls","slug":"MiracleGirls","titles":{"hebrew":"מירקל☆גירלז","english":"Miracle☆Girls","romaji":"Miracle☆Girls","japanese":"ミラクル☆ガールズ","synonyms":[],"community":[],"known":["Miracle☆Girls","ミラクル☆ガールズ"]},"synopsis_hebrew":"מיקאגה וטומומי מצונאגה הן \"בנות הפלא\": יש להן קשר טלפתי זו עם זו והן יכולות לטלפורט כשמחברות את אצבעותיהן הקטנות. טומומי היא כוכבת ספורט ויש לה חבר בשם נודה. מיקאגה היא התלמידה הכי חכמה בבית הספר והיא מאוהבת בסנפאי שלה. הוא עבר ללונדון כדי ללמוד, אבל הם עדיין שמרו על קשר, עד שנסיכה אנוכית בשם מארי החליטה שהוא צריך לבוא איתה חזרה לדיאמאס. בינתיים, ביפן, התאומות מתמודדות עם בעיות שונות משלהן. אך במהרה הן מבינות שיש קשר בין מארי, אגדה עתיקה, ובין נערה שהן מכירות בשם אמה.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":51,"duration_minutes":24,"status":"הסתיים","aired_from":"1993-01-08","season":{"label":"חורף 1993","year":1993,"season":"winter"},"broadcast":{"label":"שישי 17:00","day":"friday","time":"17:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Fantasy","Romance"],"studios":["Ajia-do"],"producers":["Asatsu DK","Nippon Television Network","Japan Taps"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.26,"mal_scored_by":1710,"israel":null,"israel_scored_by":null,"rank":3458,"popularity":8881,"members":6488,"favorites":12},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/11/21213l.webp"},"trailer":null,"characters":[{"name":"Matsunaga, Mikage","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/14/452826.webp?s=f0146614f22ee10bdbe02b79f36b638e","voice_actors":[{"name":"Hidaka, Noriko","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/1/53079.jpg?s=69a4cc69cdc741036f3ef503c4038eee"}]},{"name":"Matsunaga, Tomomi","role":"ראשי