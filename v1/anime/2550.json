{"id":2550,"mal_id":2550,"anizone_id":2550,"url":"https://anizone.co.il/anime/2550/Broken-Down-Film","slug":"Broken-Down-Film","titles":{"hebrew":"ברוקן דאון פילם","english":"Broken Down Film","romaji":"Onboro Film","japanese":"おんぼろフィルム","synonyms":[],"community":[],"known":["Onboro Film","Broken Down Film","おんぼろフィルム","Una Película Estropeada"]},"synopsis_hebrew":"סצנה מתוך יצירה אנימטיבית אמריקאית בשם \"דאדלי דו רייט\" מציגה מלכה הקשורה לפסי רכבת בחבלים וצועקת, \"הצילו!\" דימוי זה שימש לעיתים קרובות בסרטי פעולה סדרתיים מתקופת הקומדיה האילמת. בסרט הקצר הזה, גיבור בסגנון מערבי נלחם בנבל ומציל אישה יפה באותו מצב. עם זאת, הסצנה הקלאסית הזו נפגמת, מטושטשת ומרוחה בגלל שהסרט עצמו מאוד ישן. לא רק שהגיבור צריך להילחם בנבל, אלא שהוא גם צריך להיאבק קשה נגד המצב הרע של הסרט.\n\n(מקור: AniDB)","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":5,"status":"הסתיים","aired_from":"1985-08-17","season":{"label":"קיץ 1985","year":1985,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"Parody","he":"פרודיה"}],"demographic":null,"genres":["Comedy"],"studios":["Tezuka Productions"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.35,"mal_scored_by":1911,"israel":null,"israel_scored_by":null,"rank":9073,"popularity":11214,"members":3310,"favorites":1},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/7/3258l.webp"},"trailer":null,"characters":[],"staff":[{"name":"Tezuka, Osamu","role":"במאי, יוצר מקורי, תכנון סדרה","roles":["במאי","יוצר מקורי","תכנון סדרה"],"image":"https://cdn.myanimelist.net/images/voiceactors/2/42193.jpg?s=e19aba71d22387a0086f64571fa047b2"}],"external_links":{"myanimelist":"https://myanimelist.net/anime/2550","other":["https://anidb.net/perl-bin/animedb.pl?show=anime&aid=3478","https://www.animenewsnetwork.com/encyclopedia/anime.php?id=3421"]},"attribution":{"source":"An