{"id":31631,"mal_id":31631,"anizone_id":31631,"url":"https://anizone.co.il/anime/31631/Monster-Hunter-Stories-Ride-On","slug":"Monster-Hunter-Stories-Ride-On","titles":{"hebrew":"מונסטר האנטר סטוריז: רייד און","english":"Monster Hunter Stories: Ride On","romaji":"Monster Hunter Stories: Ride On","japanese":"モンスターハンターストーリーズ RIDE ON","synonyms":[],"community":[],"known":["Monster Hunter Stories: Ride On","モンスターハンターストーリーズ RIDE ON","Monster Hunter Stories Ride On"]},"synopsis_hebrew":"בעולם הזה קיימים גם בני אדם וגם מפלצות. אלו שצדים את המפלצות נקראים ציידים. אך בפינה קטנה בעולם הציידים, ישנם אלו שנקראים ריידרים, אשר יוצרים קשר ומתקיימים יחד עם המפלצות. עם אבני הקיזונה שלהם (אבני הקשר) שמאפשרות להם לעורר את הכוח החבוי בתוך המפלצות, הריידרים חיים בסודיות יחד עם האוטומון שלהם, המפלצות איתן יצרו קשר.\n\nריוטו, נער צעיר המתגורר בכפר הריידרים האקום, חולם להיות הריידר הטוב ביותר בעולם. לאחר שמלאו לו 12 שנים, הוא יוצא למצוא את האוטומון שלו לפני הטקס שבו יקבל את אבן הקיזונה שלו. יחד עם חברו הטוב והנדיב שבל, חברתו הסקרנית ליליה, ושותפו נוויל, הוא יוצא עמוק אל תוך היער, וחווה מפגש מופלא עם רתאלוס.\n\nמקור: ANN, נערך","background_hebrew":null,"type":"TV","episodes":75,"duration_minutes":24,"status":"הסתיים","aired_from":"2016-10-02","season":{"label":"סתיו 2016","year":2016,"season":"fall"},"broadcast":{"label":"ראשון 08:30","day":"sunday","time":"08:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Fantasy"],"studios":["David Production"],"producers":["Dentsu","Fuji TV","Capcom","Fuji Creative"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.3,"mal_scored_by":3942,"israel":null,"israel_scored_by":null,"rank":9408,"popularity":6058,"members":16856,"favorites":49},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/7/76232l.webp"},"trailer":{"youtube_id":"EUkoNlm52b8","url":"https://www.youtube.com/watch?v=EUkoNlm52b8","embed_url":"https://www.youtub