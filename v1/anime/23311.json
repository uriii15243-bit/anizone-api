{"id":23311,"mal_id":23311,"anizone_id":23311,"url":"https://anizone.co.il/anime/23311/Garo-The-Animation","slug":"Garo-The-Animation","titles":{"hebrew":" גארו: להבה אלוהית","english":"Garo The Animation","romaji":"Garo: Honoo no Kokuin","japanese":"牙狼〈GARO〉-炎の刻印-","synonyms":["Garo Project"],"community":[],"known":["Garo: Honoo no Kokuin","Garo The Animation","牙狼〈GARO〉-炎の刻印-","Garo: The Animation","Garo Project"]},"synopsis_hebrew":"האנימה מתחילה כאשר יועציו של המלך מתחילים בציד מכשפות, ציד המכשות מסכן את אבירי וכוהנות המקאי (גיהנום), אשר אמורים להגן על האנושות. כוהנת מקאי אשר נידונה להישרף על המוקד יולדת ילד, ליאון לואיס. הילד חולץ על ידי אביו, אביר מקאי, אבל מעולם לא פגש את אימו. כאשר הוא יגדל הוא יירש את שיריון הזהב כצאצא ישיר של אבירי הזהב. בנתיים יועצו של המלך השתלט על המדינה כשהמלך נהפך לחולה, וכמו כן הנסיך אלפונסו גורש עם אמו. כדי להשיב את ממלכו הוא יוצא לחפש את אביר הזהב האגדי.","background_hebrew":"גארו: הונו נו קוקואין בהשראת גארו טוקוסאטסו והוא אחד מהפרנצ'ייזים הבודדים של טוקוסאטסו שעובדו ליצירה מונפשת.","type":"TV","episodes":24,"duration_minutes":24,"status":"הסתיים","aired_from":"2014-10-04","season":{"label":"סתיו 2014","year":2014,"season":"fall"},"broadcast":{"label":"שבת 01:23","day":"saturday","time":"01:23","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Action","Fantasy"],"studios":["MAPPA"],"producers":["Tohokushinsha Film Corporation"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.34,"mal_scored_by":53077,"israel":7.0,"israel_scored_by":null,"rank":2975,"popularity":1791,"members":153213,"favorites":447},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/5/63667l.webp"},"trailer":{"youtube_id":"TOXWJybZnco","url":"https://www.youtube.com/watch?v=TOXWJybZnco","embed_url":"https://www.youtube.com/embed/TOXWJybZnco"},"characters":[{"name":"Luis, Leon","role