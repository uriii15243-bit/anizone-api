{"id":812,"mal_id":812,"anizone_id":812,"url":"https://anizone.co.il/anime/812/Arjuna","slug":"Arjuna","titles":{"hebrew":"ארג'ונה","english":"Arjuna","romaji":"Chikyuu Shoujo Arjuna","japanese":"地球少女アルジュナ","synonyms":["Earth Maiden Arjuna","Earth Girl Arjuna","Earth Maiden Arjuna, Earth Girl Arjuna"],"community":[],"known":["Chikyuu Shoujo Arjuna","Arjuna","地球少女アルジュナ","Earth Maiden Arjuna","Earth Girl Arjuna"]},"synopsis_hebrew":"ג'ונה אריושי היא תלמידת בית ספר יפנית רגילה, בעלת סקרנות ילדותית והערצה חזקה לטבע. יום אחד, במהלך טיול עם החבר שלה, טוקיו אושימה, ג'ונה מתה בתאונת אופנוע. עם זאת, היא מקבלת הזדמנות לחיות על ידי אדם בשם כריס הוקן. הוא מציע לה כוחות שהופכים אותה לאווטאר של הזמן; בתמורה, היא חייבת להילחם כדי להגן על כדור הארץ מכוחות הרשע הנקראים ראאג'ה, שנולדים מתוך הזיהום הרעיל שגרמו בני האדם.\n\nהיא מגלה במהרה שזה לא משימה קלה. בזמן שהיא מנסה לשלוט בכוחותיה החדשים, היא גם חייבת לחפש תשובות לשאלות עמוקות על הדרכים שבהן המדע והטכנולוגיה לקחו מהאנושות את הקשרים הראשוניים והאינסטינקטיביים עם הטבע. בעזרת כריס, העוזרת שלו סינדי קליין, וארגון בינלאומי חזק בשם SEED, זה תלוי בג'ונה להתגבר על פחדיה ולמצוא דרך לעצור את הראאג'ה מלהשמיד את כל מה שהיא אוהבת ודואגת לו.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":26,"status":"הסתיים","aired_from":"2001-01-09","season":{"label":"חורף 2001","year":2001,"season":"winter"},"broadcast":{"label":"שלישי 18:00","day":"tuesday","time":"18:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Adventure","Drama","Sci-Fi"],"studios":["Satelight"],"producers":["Bandai Visual","Sotsu"],"licensors":["Bandai Entertainment"],"source":null,"rating":null,"scores":{"mal":6.78,"mal_scored_by":12071,"israel":null,"israel_scored_by":null,"rank":6221,"popularity":4290,"members":38455,"favorites":210},"community_reviews":null,"images":{"poster":"https://cd