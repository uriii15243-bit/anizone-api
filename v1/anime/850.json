{"id":850,"mal_id":850,"anizone_id":850,"url":"https://anizone.co.il/anime/850/Gakuen-Heaven","slug":"Gakuen-Heaven","titles":{"hebrew":"גאקואן הבן","english":"Gakuen Heaven","romaji":"Gakuen Heaven","japanese":"学園ヘヴン","synonyms":["Boy's Love Scramble"],"community":[],"known":["Gakuen Heaven","学園ヘヴン","Boy's Love Scramble"]},"synopsis_hebrew":"איתו קייטה, בחור ממוצע, נדהם כשהוא מוזמן ללמוד במוסד היוקרתי \"אקדמיית בל ליברטי\". מבולבל מהמסתורין, הוא מתמודד גם עם הדינמיקה החברתית של בית הספר. בים של צעירים מדהימים, קייטה נאבק לגלות מה הופך אותו לייחודי, וכיצד יוכל להיות ראוי ליחס שווה מצד הבנים של BL. ללא יכולת מיוחדת, מדוע בכלל התקבל איתו לעולם המיוחס של המוכשרים והיפים?\n\nבמהלך הדרך, הוא מפתח קשרים אינטנסיביים כמעט עם כל אחד בבית הספר, אך הוא נמשך במיוחד לחבר לכיתה הידידותי, הדואג יתר על המידה אך מאוד מסתורי, קזוקי אנדו.","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":26,"status":"הסתיים","aired_from":"2006-04-01","season":{"label":"אביב 2006","year":2006,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Boys Love","he":"אהבת בנים"},{"en":"Comedy","he":"קומדיה"},{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Reverse Harem","he":"הרמון (גברים)"},{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Boys Love","Comedy","Drama"],"studios":["Tokyo Kids"],"producers":["Visual Arts","Geneon Entertainment"],"licensors":["Media Blasters"],"source":null,"rating":null,"scores":{"mal":6.45,"mal_scored_by":33287,"israel":null,"israel_scored_by":null,"rank":8425,"popularity":3026,"members":72189,"favorites":177},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/12/70143l.webp"},"trailer":null,"characters":[{"name":"Itou, Keita","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/2/57288.webp?s=6d85db7d978fbfc0f3123d76de733a60","voice_actors":[{"name":"Fukuyama, Jun","language":"יפנית","image":"https://cdn.myanimelist.ne