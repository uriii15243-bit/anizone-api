{"id":19429,"mal_id":19429,"anizone_id":19429,"url":"https://anizone.co.il/anime/19429/Riddle-Story-of-Devil","slug":"Riddle-Story-of-Devil","titles":{"hebrew":"חידת השטן","english":"Riddle Story of Devil","romaji":"Akuma no Riddle","japanese":"悪魔のリドル","synonyms":["Akuma no Riddle"],"community":[],"known":["Akuma no Riddle","Riddle Story of Devil","悪魔のリドル"]},"synopsis_hebrew":"טוקאקו אזומה התקבלה לבית הספר היוקרתי לבנות בלבד \"מיוג'ו\", בשביל מטרה אחת:\nהיא ועוד 11 בנות איתה בכיתה צריכות להתנקש בחברת כיתתם המקסימה הארו איצ'ינוסה, כשהפרס על התנקשות מוצלחת הוא הגשמת התשוקה הכמוסה ביותר של המנצחת, לא משנה מה המחיר או הקושי. אולם - לכל מתנקשת יש רק הזדמנות אחת. כישלון משמעו גירוש מבית הספר.\nהעניינים מתחילים להשתבש כאשר טוקאקו מגלה שהיא מפתחת רגשות כלפי מטרת התנקשותה, ומוצאת את עצמה כנגד כל הכיתה נשבעת להגן על הארו מכל רע.","background_hebrew":"\"אקומה נו רידל\" מבוסס על סדרת המנגה של יון קוגה וסונאו מינאקאטה באותו שם. למרות שהאנימה הוקרנה בזמן שהמנגה הייתה עדיין בתהליך פרסום, היא מעבדת את הסיפור המלא של המנגה, עם כמה תוספות ושינויים.","type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2014-04-04","season":{"label":"אביב 2014","year":2014,"season":"spring"},"broadcast":{"label":"שישי 02:19","day":"friday","time":"02:19","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Girls Love","he":"אהבת בנות"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"High Stakes Game","he":"משחקי מזל"},{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Action","Girls Love","Suspense"],"studios":["Diomedéa"],"producers":["Mainichi Broadcasting System","Pony Canyon","DAX Production"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.59,"mal_scored_by":133682,"israel":7.33,"israel_scored_by":3,"rank":7500,"popularity":1016,"members":284277,"favorites":1082},"community_reviews":{"ratings":3,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/anime/6/60479l.webp"},"trailer":{"y