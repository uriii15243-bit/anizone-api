{"id":29803,"mal_id":29803,"anizone_id":29803,"url":"https://anizone.co.il/anime/29803/Overlord","slug":"Overlord","titles":{"hebrew":"שליט עליון","english":"Overlord","romaji":"Overlord","japanese":"オーバーロード","synonyms":[],"community":[],"known":["Overlord","オーバーロード"]},"synopsis_hebrew":"עלילת הסדרה סובבת סביב מומונגה, שם דמותו של מכור למשחקי מחשב מקוונים בכלל ול\"הגדראזל\" - משחק פעולה מסוגת ההרפתקאות - בפרט. יום בהיר אחד, הגדראזל הושבת בפתאומיות ויועד לרדת מהרשת. מומונגה החליט לצאת בהצהרות סמליות כנגד סגירת המשחק ונשאר בתוכו ללא הפסקה, על-אף שכבר היה בהליכי סגירה.\nללא כל התראה מוקדמת, נשאב השחקן אל תוך מסכו ומופיע בהגדראזל. עם כניסתו למשחק (פשוטו כמשמעו), השחקן, שלכוד כעת בדמותו של מומונגה, חש בשינויים סביב הדמות, שהחלו עם הפיכתו לסקלטרון (שלד-לוחם המצוי בהגדראזל) תחת הכותרת: \"הקוסם החזק במשחק\". והטירוף לא עצר שם. מדריכי המשחק הווירטואליים (NPC'S) נהפכו לבעלי רגשות וסממנים של שחקני רשת רגילים, עיצוב העולם השתנה באופן דרסטי וכל מערכותיו הקודמות קרסו בהדרגתיות.\nללא משפחתו, חבריו או מקום להשתייך אליו, מומונגה הולך לחקור את הגדראזל החדשה בניסיון לשלוט בה ביד רמה ולהפוך לטוב ביותר.","background_hebrew":"אוברלורד מעבד את כרכי הנובלה הקלה 1 עד 3.","type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2015-07-07","season":{"label":"קיץ 2015","year":2015,"season":"summer"},"broadcast":{"label":"שלישי 23:00","day":"tuesday","time":"23:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Isekai","he":"עולם אחר"}],"demographic":null,"genres":["Action","Adventure","Fantasy"],"studios":["Madhouse"],"producers":["AT-X","Grooove","Hakuhodo DY Music & Pictures","Kadokawa"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.89,"mal_scored_by":1053967,"israel":7.14,"israel_scored_by":7,"rank":974,"popularity":70,"members":1790499,"favorites":28826},"community_reviews":{"ratings":7,"written_reviews":0},"images":{"poster":"htt