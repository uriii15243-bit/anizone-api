{"id":33299,"mal_id":33299,"anizone_id":33299,"url":"https://anizone.co.il/anime/33299/Magic-Kyun-Renaissance","slug":"Magic-Kyun-Renaissance","titles":{"hebrew":"מג'יק-קיון! רנסנס","english":"Magic-Kyun! Renaissance","romaji":"Magic-Kyun! Renaissance","japanese":"マジきゅんっ！ルネッサンス","synonyms":["Maji-Kyun! Renaissance"],"community":[],"known":["Magic-Kyun! Renaissance","マジきゅんっ！ルネッサンス","Magic-kyun! Renaissance","Maji-Kyun! Renaissance"]},"synopsis_hebrew":"עולם שבו האמנות הופכת לקסם. בעולם הזה, אנשים שיכולים לעורר תשוקה באמצעות אמנויות הקסם שלהם נקראים ארטיסטות, והם מועסקים בתעשיית הבידור. בבית הספר התיכון לאמנויות קסם פרטיות הושינומורי, שבו מלמדים ארטיסטות, תלמידה חדשה ומוזרה בשם קוהנה אייגאסאקי עוברת לבית הספר.\n\nקוהנה מוצבת בוועדת התכנון של פסטיבל התרבות השנתי של בית הספר, הושינומורי סאמר פסטה. היא מבלה את חיי בית הספר הרומנטיים שלה עם שישה בנים נוספים ששואפים להיות אמנים בעתיד. כל אחד מהבנים מתמחה באמנות שלו ושואף להפוך את הושי פס להצלחה. בנוסף, הבנים גם שואפים להיבחר לצד קוהנה כנסיך ונסיכת הארטיסטה של בית הספר, שנבחרים רק פעם בשנה.\n\nמקור: האתר הרשמי","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2016-10-02","season":{"label":"סתיו 2016","year":2016,"season":"fall"},"broadcast":{"label":"ראשון 22:30","day":"sunday","time":"22:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Music","he":"מוזיקה"},{"en":"Reverse Harem","he":"הרמון (גברים)"},{"en":"School","he":"בית ספר"},{"en":"Visual Arts","he":"אומנות חזותית"}],"demographic":null,"genres":["Fantasy","Romance"],"studios":["Sunrise"],"producers":["Broccoli","Pony Canyon","Bandai Namco Live Creative","Sunrise Music","Bandai Namco Rights Marketing"],"licensors":["Ponycan USA"],"source":null,"rating":null,"scores":{"mal":7.0,"mal_scored_by":23540,"israel":null,"israel_scored_by":null,"rank":4951,"popularity":3291,"members":62409,"favorites":227},"community_reviews":null,"images":