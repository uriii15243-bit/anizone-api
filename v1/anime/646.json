{"id":646,"mal_id":646,"anizone_id":646,"url":"https://anizone.co.il/anime/646/Haunted-Junction","slug":"Haunted-Junction","titles":{"hebrew":"האנטד ג'נקשן","english":"Haunted Junction","romaji":"Haunted Junction","japanese":"HAUNTED じゃんくしょん","synonyms":[],"community":[],"known":["Haunted Junction","HAUNTED じゃんくしょん"]},"synopsis_hebrew":"תיכון סאיטו הוא בית ספר תיכון עם ישויות רוחניות ומנהל שתחביבו הוא איסוף פרפנליה של תורת הנסתר. בבית הספר יש את חברי מועצת התלמידים הקדושה שנבחרו על פי נבואה כדי להגן עליו. לתלמידים האלה יש בעיות משלהם; הארוטו הוג'ו, הנשיא, יודע לזמן רוחות, והיה מתפטר מתפקידו לחיים נורמליים אלמלא המנהל. קזומי ריודו, החבר הבא, טוב בלהיות אחוז ויש לו משהו כלפי ההאנאקו. החבר האחרון הוא מוצוקי אסאהינה, שהוא מאסטר בגירוש שדים ונמשך לילדים קטנים. למרבה הצער, שלושת אלה אחראים לשמור על הסדר בבית הספר ולהגן על העולם מישויות על-טבעיות, ומשימה זו מביאה אותם למצבים משעשעים.\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"1997-04-02","season":{"label":"אביב 1997","year":1997,"season":"spring"},"broadcast":{"label":"חמישי 01:45","day":"thursday","time":"01:45","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Comedy","Supernatural"],"studios":["Studio Deen"],"producers":["Omnibus Promotion"],"licensors":["Bandai Entertainment"],"source":null,"rating":null,"scores":{"mal":6.71,"mal_scored_by":1955,"israel":null,"israel_scored_by":null,"rank":6698,"popularity":9511,"members":5453,"favorites":13},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1163/94507l.webp"},"trailer":null,"characters":[{"name":"Houjo, Haruto","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/2/7251.webp?s=ee8f1e0e211b1067527f6bacc8dc295a","voice_actors":[{"name":"Oda, Yuusei","language":"יפנית","image":"https://c