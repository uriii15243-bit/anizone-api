{"id":114,"mal_id":114,"anizone_id":114,"url":"https://anizone.co.il/anime/114/Cromartie-High-School","slug":"Cromartie-High-School","titles":{"hebrew":"קרומרטי היי סקול","english":"Cromartie High School","romaji":"Sakigake!! Cromartie Koukou","japanese":"魁!! クロマティ高校","synonyms":["Sakigake!! Cromartie Koukou"],"community":[],"known":["Sakigake!! Cromartie Koukou","Cromartie High School","魁!! クロマティ高校"]},"synopsis_hebrew":"טקאשי קמיאמה הוא תלמיד תיכון טיפוסי ועדין—מנומס, מרוחק ופציפיסט, עם מנת משכל מעט מעל הממוצע. אבל האם תלמיד תיכון ממוצע באמת היה נרשם לבית הספר התיכון קרומרטי הידוע לשמצה, שמוכר כקרקע פורייה לעבריינים הקשוחים ביותר?\n\nכנראה שכן, כי זה בדיוק מה שטקאשי עושה, אם כי מסיבות שהוא מעדיף לא להזכיר. עם זאת, דבר אחד בטוח: \"הארנב הרך במאורת האריות הרעבים\" לעולם לא יחווה עוד יום משעמם. ואיך הוא יכול, עכשיו כשהוא מוקף בפאנקיסטים עם מוהוק, רובוטים מעצבנים ו... גורילות? והאם זה היה פרדי מרקורי שרוכב על סוס במסדרון? עקבו אחרי טקאשי כשהוא מקדיש בכנות את חייו החדשים בתיכון לשיפור המוניטין של בית הספר שלו, בעוד חבריו לכיתה נחושים להטיל הרס.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":11,"status":"הסתיים","aired_from":"2003-10-03","season":{"label":"סתיו 2003","year":2003,"season":"fall"},"broadcast":{"label":"שישי 01:00","day":"friday","time":"01:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"Delinquents","he":"עבריינות"},{"en":"Gag Humor","he":"קומדיה הומוריסטית"},{"en":"Parody","he":"פרודיה"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Comedy"],"studios":["Production I.G"],"producers":["TV Tokyo Music"],"licensors":["ADV Films","Sentai Filmworks","Discotek Media"],"source":null,"rating":null,"scores":{"mal":7.88,"mal_scored_by":59108,"israel":7.0,"israel_scored_by":null,"rank":1001,"popularity":1751,"members":158003,"favorites":1812},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimel