{"id":178,"mal_id":178,"anizone_id":178,"url":"https://anizone.co.il/anime/178/Ultra-Maniac","slug":"Ultra-Maniac","titles":{"hebrew":"אולטרה מניאק","english":"Ultra Maniac","romaji":"Ultra Maniac","japanese":"ウルトラマニアック","synonyms":[],"community":[],"known":["Ultra Maniac","ウルトラマニアック"]},"synopsis_hebrew":"פנטזיות וניסים מעולם לא עניינו את איו טאטאישי, תלמידת שנה שנייה פופולרית בבית הספר התיכון שלה. היא הייתה מרוצה מלשמור על התדמית שלה כקולית, רגועה ומאופקת—הכל כדי למשוך את תשומת ליבו של הקראש שלה, טטסושי קאדז'י. ימי הנעורים חסרי הדאגות של איו נקטעים עם הופעתה של נינה סאקורה, תלמידה חדשה שעוברת לבית הספר ומתבררת כמכשפה. כאדם היחיד שיודע על יכולתה של נינה להטיל כישופים באמצעות מיני-מחשב, איו נאלצת לעזור לנינה במשימתה למצוא את חמשת האבנים הקדושות, מה שיאפשר לה להתחתן עם הנסיך של ממלכת הקסם.\n\nלמרבה הצער, חוסר המיומנות של נינה בכישוף והרגל שלה להתערב בחייה האישיים של איו גורמים רק לצרות לשתיהן, בעוד איו מתאמצת לשמור על המוניטין הטוב שלה ונינה נאבקת להסתיר את סודה מעינו החדה של הירוקי צוג'יאי, חברו הטוב ביותר של טטסושי ומעריץ נלהב של מנגה. וכאשר החיפוש של נינה אחר חמשת האבנים הקדושות מביא בעלי ברית ואתגרים מממלכת הקסם, איו נגררת לעולם שהיא מעולם לא חלמה שהוא אפשרי.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":23,"status":"הסתיים","aired_from":"2003-05-20","season":{"label":"אביב 2003","year":2003,"season":"spring"},"broadcast":{"label":"שלישי 22:00","day":"tuesday","time":"22:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Comedy","Fantasy","Romance"],"studios":["Ashi Productions"],"producers":["WAO World"],"licensors":["Discotek Media","Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":7.19,"mal_scored_by":14780,"israel":null,"israel_scored_by":null,"rank":3904,"popularity":4356,"members":37434,"favorites":152},"c