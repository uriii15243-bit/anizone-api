{"id":152,"mal_id":152,"anizone_id":152,"url":"https://anizone.co.il/anime/152/Solty-Rei","slug":"Solty-Rei","titles":{"hebrew":"סולטי ריי","english":"Solty Rei","romaji":"Solty Rei","japanese":"ソルティレイ","synonyms":["SoltyRei"],"community":[],"known":["Solty Rei","ソルティレイ","SoltyRei"]},"synopsis_hebrew":"בעיר עתידנית מוכת אסונות עם פער עצום בין עשירים לעניים, קשה להבחין אילו בני אדם מסתובבים עם חלקי גוף סייברנטיים. זה הופך את עבודתו של רוי רוונט, צייד ראשים עצמאי ושומר ראש להשכרה, למאתגרת עוד יותר. כאשר נערה צעירה עם כוח בלתי יאמן מצילה אותו מפושע מסוכן במיוחד, רוי מבין שאולי אפשר למצוא עזרה במקומות הכי לא צפויים. יחד עם כמה אחרים, הם יוצאים לקרב כדי לגלות את האמת מאחורי התאגידים הענקיים שלכאורה משרתים את האנושות ומשפרים את החיים.\n\nסולטי, אנדרואידית שאיבדה את זיכרונה, נמלטה ונרדפת על ידי לשכת הביטחון של RUC. היא פוגשת את צייד הראשים רוי, והוא מאמץ אותה כבתו לאחר שנשכר לשמש כשומר ראש עבור מירנדה.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":24,"duration_minutes":23,"status":"הסתיים","aired_from":"2005-10-07","season":{"label":"סתיו 2005","year":2005,"season":"fall"},"broadcast":{"label":"שישי 02:40","day":"friday","time":"02:40","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":null,"genres":["Action","Sci-Fi"],"studios":["Gonzo","AIC"],"producers":["TV Asahi","Sotsu Music Publishing","Future Vision Music"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.29,"mal_scored_by":13466,"israel":null,"israel_scored_by":null,"rank":3283,"popularity":4590,"members":33410,"favorites":146},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/75582l.webp"},"trailer":{"youtube_id":"VsNf2QE7QZU","url":"https://www.youtube.com/watch?v=VsNf2QE7QZU","embed_url":"https://www.youtube.com/embed/VsNf2QE7QZU"},"characters":[{"name":"Revant, Solty","role":"ראשי","image":"https://cdn.myan