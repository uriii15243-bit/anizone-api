{"id":9330,"mal_id":9330,"anizone_id":9330,"url":"https://anizone.co.il/anime/9330/Dragon-Crisis","slug":"Dragon-Crisis","titles":{"hebrew":"דרגון קרייסיס!","english":"Dragon Crisis!","romaji":"Dragon Crisis!","japanese":"ドラゴンクライシス!","synonyms":["Dragon Crisis!"],"community":[],"known":["Dragon Crisis!","ドラゴンクライシス!"]},"synopsis_hebrew":"חייו השקטים של קיסאראגי ריוג'י, נער תיכון רגיל, הופכים להרפתקה עם חזרתה של בת דודתו השנייה, אריקו. ריוג'י ואריקו משתלטים על קופסת שרידים מסוחר שחור. בתוך הקופסה הם מוצאים נערת דרקון אדומה בשם רוז. כדי להגן על רוז מהארגון השחור, ריוג'י מחליט להילחם תוך שימוש בכוחו כמטפל בשרידים.","background_hebrew":"הפרק הראשון קיבל תצוגה מקדימה חינמית בשירות הסטרימינג המקוון GyaO! החל מיום חמישי, ה-16 בדצמבר 2010 ועד יום רביעי, ה-22 בדצמבר. 1000 משתתפים ברי מזל שהחזיקו בזיהוי Yahoo Japan קיבלו הזדמנות לצפות בו דרך הגרלה מקוונת. השידור הטלוויזיוני הרגיל התחיל ב-11 בינואר 2011.","type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2011-01-11","season":{"label":"חורף 2011","year":2011,"season":"winter"},"broadcast":{"label":"שני 01:30","day":"monday","time":"01:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Harem","he":"הרמון (נשים)"},{"en":"School","he":"בית ספר"},{"en":"Urban Fantasy","he":"פנטזיה אורבנית"}],"demographic":null,"genres":["Action","Fantasy","Romance"],"studios":["Studio Deen"],"producers":["Yomiuri Telecasting","Starchild Records","Kids Station","DAX Production","Shueisha"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.6,"mal_scored_by":90393,"israel":null,"israel_scored_by":null,"rank":7452,"popularity":1572,"members":181516,"favorites":295},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/8/50311l.webp"},"trailer":{"youtube_id":"pPUwVjekuxw","url":"https://www.youtube.com/watch?v=pPUwVjekuxw","embed_url":"https://www.youtube.com/embed/pPUwVjekux