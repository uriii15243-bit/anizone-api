{"id":54040,"mal_id":54040,"anizone_id":54040,"url":"https://anizone.co.il/anime/54040/Run-For-Money-The-Great-Mission","slug":"Run-For-Money-The-Great-Mission","titles":{"hebrew":"רוץ לכסף: המשימה הגדולה","english":"Run For Money: The Great Mission","romaji":"Tousouchuu: Great Mission","japanese":"逃走中 グレートミッション","synonyms":[],"community":[],"known":["Tousouchuu: Great Mission","Run For Money: The Great Mission","逃走中 グレートミッション"]},"synopsis_hebrew":"עקב משבר האקלים המחריף בכדור הארץ, האנושות פיתחה טכנולוגיה עתידנית כדי להגר לירח. טומורה סוייר עובד כשליח באזורים הגבוהים, וחוסך כסף עבור אחיו הקטן, הארו, שסובל ממחלת הירח המעושן - מחלה שנגרמת מהעשן והזיהום שבאזורים הנמוכים. שני האחים חולמים לעבור לאזורים הגבוהים והנקיים יותר כדי לטפל במחלה הזו.\n\nטומורה לוקח סיכון כדי לעשות את הבלתי אפשרי: להשתתף בתוכנית הטלוויזיה \"רוץ בשביל הכסף\" ולנצח את כל המתחרים האחרים, אפילו אם אין לו את צמיד הכרונו הנדרש לכך. מפיקה של התוכנית בשם הארווסט נראית מתעניינת בנחישותו של טומורה להשתתף, ולכן היא מעניקה לו את הצמיד ומאפשרת לו להשתתף. במשחק התופסת המפואר הזה, טומורה סוייר חייב להחזיק מעמד יותר מכל אחד אחר מבלי להיתפס על ידי האויבים במשחק הזה — הציידים.","background_hebrew":null,"type":"TV","episodes":97,"duration_minutes":23,"status":"הסתיים","aired_from":"2023-04-02","season":{"label":"אביב 2023","year":2023,"season":"spring"},"broadcast":{"label":"ראשון 09:00","day":"sunday","time":"09:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Sci-Fi","he":"מדע בדיוני"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"High Stakes Game","he":"משחקי מזל"}],"demographic":null,"genres":["Sci-Fi","Suspense"],"studios":["Toei Animation"],"producers":["Yomiko Advertising","Fuji TV"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.1,"mal_scored_by":966,"israel":null,"israel_scored_by":null,"rank":10587,"popularity":8670,"members":6909,"favorites":28},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1482/141904l.webp"},"trailer":{"youtube_id":"N