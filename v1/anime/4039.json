{"id":4039,"mal_id":4039,"anizone_id":4039,"url":"https://anizone.co.il/anime/4039/Golgo-13","slug":"Golgo-13","titles":{"hebrew":"גולגו 13","english":"Golgo 13","romaji":"Golgo 13 (TV)","japanese":"ゴルゴ13","synonyms":[],"community":[],"known":["Golgo 13 (TV)","Golgo 13","ゴルゴ13"]},"synopsis_hebrew":"גולגו 13 אינו שמו האמיתי. מצד שני, גם לא דיוק טוגו, טדאשי טוגו או כל אחד מהכינויים הרבים שהוא משתמש בהם. איש מסתורין, אפילו סוכנויות המודיעין הבולטות ביותר בעולם אינן יכולות לקבוע מי באמת גולגו, או מאיפה הוא הגיע. אך כולם מסכימים שכישוריו הם לא פחות מאגדיים.\n\nמצויד ב-M16 מותאם אישית, גולגו מוכן לקחת כל עבודה עבור כל סוכנות, מה-FBI ועד ה-KGB. הוא השלים כל חוזה שאי פעם לקח ויעבוד עבור כל מי שיכול לעמוד במחירו. הוא גם הנשק הגדול ביותר וגם האיום הגדול ביותר לכל אומה; אף אחד אינו בטוח ברגע שהוא נמצא במטרות של גולגו.","background_hebrew":null,"type":"TV","episodes":50,"duration_minutes":24,"status":"הסתיים","aired_from":"2008-04-12","season":{"label":"אביב 2008","year":2008,"season":"spring"},"broadcast":{"label":"שבת 01:23","day":"saturday","time":"01:23","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Adventure","Drama","Suspense"],"studios":["The Answer Studio"],"producers":["TV Tokyo","Sotsu","Half H.P Studio"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.55,"mal_scored_by":12641,"israel":6.0,"israel_scored_by":null,"rank":2000,"popularity":3817,"members":48020,"favorites":254},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/9/25423l.webp"},"trailer":{"youtube_id":"4CGrWhGGDJY","url":"https://www.youtube.com/watch?v=4CGrWhGGDJY","embed_url":"https://www.youtube.com/embed/4CGrWhGGDJY"},"characters":[{"name":"Togo, Duke","role":"ראשי","image":"https