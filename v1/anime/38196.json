{"id":38196,"mal_id":38196,"anizone_id":38196,"url":"https://anizone.co.il/anime/38196/Chouetsu-Sekai","slug":"Chouetsu-Sekai","titles":{"hebrew":"צ'ואטסו סקאי","english":"Chouetsu Sekai","romaji":"Chouetsu Sekai","japanese":"超越世界","synonyms":["Aum Shinrikyou no Anime"],"community":[],"known":["Chouetsu Sekai","超越世界","Aum Shinrikyou no Anime"]},"synopsis_hebrew":"אום שינריקיו הוא כת יום הדין יפנית שנוסדה על ידי שוקו אסהארה בשנת 1984. הכת ביצעה את מתקפת הסארין הקטלנית ברכבת התחתית של טוקיו בשנת 1995 ונמצאה אחראית למתקפת סארין קטנה נוספת בשנה הקודמת.\n\nהכת יצרה אולפן משלה בשם MAT (מנגה, אנימציה וצוות) בשנת 1991 במטרה הבלעדית לגייס אוטאקו לכת שלהם. סדרת ה-OVA בת 10 הפרקים מתמקדת בעיקר באסהארה עצמו כמשיח. כל 10 הפרקים נמכרו בנפרד במהלך ההפצה הראשונית, אך אוסף זמין בערוץ היוטיוב הרשמי של הכת.","background_hebrew":"אסהארה הוצא להורג ב-6 ביולי 2018 יחד עם חברים נוספים בגין רצח וטרור.","type":"OVA","episodes":10,"duration_minutes":6,"status":"הסתיים","aired_from":"1991-01-01","season":{"label":"לא צויין","year":null,"season":null},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Fantasy"],"studios":["MAT"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":4.41,"mal_scored_by":553,"israel":null,"israel_scored_by":null,"rank":15202,"popularity":13934,"members":1522,"favorites":8},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1392/93503l.webp"},"trailer":null,"characters":[{"name":"Asahara, Shoukou","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/13/480889.webp?s=97f20823920b533794018c32d90c68ff","voice_actors":[]}],"staff":[],"external_links":{"myanimelist":"https://myanimelist.net/anime/38196","other":["https://www.youtube.com/watch?v=2hH547DGhVk","https://anidb.net/perl-bin/animedb.pl?show=anime&aid=14510","https://ja.wikipedia.org/wiki/%E3%82%AA%E3%82%A6%E3%83%