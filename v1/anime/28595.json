{"id":28595,"mal_id":28595,"anizone_id":28595,"url":"https://anizone.co.il/anime/28595/Pac-World","slug":"Pac-World","titles":{"hebrew":"פק-וורלד","english":"Pac-World","romaji":"Pac-World","japanese":"パックワールド","synonyms":["PAC-MAN and the Ghostly Adventures"],"community":[],"known":["Pac-World","パックワールド","Pac-Man und die Geisterabenteuer - Das Abenteuer beginnt, Teil 1 + 2","PAC-MAN and the Ghostly Adventures"]},"synopsis_hebrew":"אנחנו עוקבים אחר האירועים היומיומיים של פאק כשהוא מציל את פאק-וורלד. יחד עם חבריו סיילי וספירל, פאק וחבריו מתמודדים עם הבעיות של להיות בני נוער תוך כדי הגנה על פאק-וורלד מצבא רוחות רפאים בהנהגת הרשע בטריוס. תושבי פאק-וורלד לא רוצים שבטריוס ומשרתיו הרפאים יחזרו מעולם התחתון ויזרעו הרס. לכן, הנשיא ספרוס מלמד את פאק וחבריו את האגדה המנבאת על תושב פאק-וורלד עגול וצהוב שיציל את הכוכב. פאק, האזרח העגול והצהוב היחיד, הוא האיש למשימה. כל הרפתקה עוקבת אחר פאק וחבריו כשהם מנסים להחזיר את הרוחות לעולם התחתון, ובכך להציל את פאק-וורלד.\n\n(מקור: AniDB)","background_hebrew":null,"type":"TV","episodes":52,"duration_minutes":25,"status":"הסתיים","aired_from":"2014-04-05","season":{"label":"אביב 2014","year":2014,"season":"spring"},"broadcast":{"label":"שבת 18:30","day":"saturday","time":"18:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Adventure","Comedy","Sci-Fi"],"studios":["OLM Digital","Sprite Animation Studios"],"producers":["Bandai Namco Entertainment"],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.62,"mal_scored_by":1680,"israel":null,"israel_scored_by":null,"rank":13084,"popularity":10950,"members":3551,"favorites":8},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/7/75298l.webp"},"trailer":null,"characters":[{"name":"Pac-Man","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/16/390963.webp?s=f35c68980cb37eb935f570e4d5d3f529","v