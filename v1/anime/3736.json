{"id":3736,"mal_id":3736,"anizone_id":3736,"url":"https://anizone.co.il/anime/3736/Parappa-the-Rapper","slug":"Parappa-the-Rapper","titles":{"hebrew":"פאראפה דה ראפר","english":"Parappa the Rapper","romaji":"Parappa the Rapper","japanese":"パラッパラッパー","synonyms":["PaRappa the Rapper"],"community":[],"known":["Parappa the Rapper","パラッパラッパー","PaRappa the Rapper"]},"synopsis_hebrew":"פאראפה הוא סתם כלב מדבר רגיל; הוא נהנה לבלות עם חבריו, להאזין למוזיקה ולצאת להרפתקאות. יחד עם חבריו, פאראפה נקלע להרבה מצבים מוזרים, תוך כדי שהוא לומד לנווט בחיים, להסתדר עם חבריו ולחלום על הנערה של חלומותיו, סאני פאני.\n\nמבוסס על משחק קצב מוזר באותה מידה, \"פאראפה הראפר\" מתהדר בסגנון שטוח ייחודי, פרצי צבע ודמויות מוזרות אך מקסימות. בין חבריו של פאראפה נמצאים חתול כחול מואנש, כבש ואפילו פרח.\n\nההרפתקאות של פאראפה נעות מהרגיל ועד לביזארי. הוא נתקל בנבלים שובבים, עוזר לפתור שאלות של חברות ואהבה, ואפילו יוצא למסעות בזמן עצמו. שום דבר לא יכול לשנות את הגישה החיובית של פאראפה לחיים.","background_hebrew":null,"type":"TV","episodes":30,"duration_minutes":23,"status":"הסתיים","aired_from":"2001-04-14","season":{"label":"אביב 2001","year":2001,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Comedy","Fantasy"],"studios":["J.C.Staff","Production I.G"],"producers":["Aniplex","SME Visual Works","Fuji TV"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.54,"mal_scored_by":1766,"israel":null,"israel_scored_by":null,"rank":7875,"popularity":9306,"members":5776,"favorites":52},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1833/143171l.webp"},"trailer":null,"characters":[{"name":"PaRappa","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/14/484941.webp?s=682b85ce9b9d498bae086b44141c8bf2","voice_actors":[{"name":"Irino, Miyu","language":"יפנית","image":"https: