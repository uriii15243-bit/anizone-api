{"id":4999,"mal_id":4999,"anizone_id":4999,"url":"https://anizone.co.il/anime/4999/Samurai-Harem","slug":"Samurai-Harem","titles":{"hebrew":"הארם סמוראי","english":"Samurai Harem","romaji":"Asu no Yoichi!","japanese":"明日のよいち！","synonyms":["Ashita no Yoichi!"],"community":[],"known":["Asu no Yoichi!","Samurai Harem","明日のよいち！","High School Samurai","Ashita no Yoichi!"]},"synopsis_hebrew":"יואיצ'י קאראסומה בילה את כל חייו בהרים, מתאמן בסגנון החרבות \"רוח מרחפת, רוח אלוהית\". בהדרכת אביו, הוא מצליח לשלוט בטכניקה בגיל 17. כשאין לו עוד מה ללמוד, יואיצ'י נשלח לדוג'ו חדש בעיר כדי להמשיך להתאמן ולהבין את החברה המודרנית.\n\nלמרבה הצער, ליואיצ'י אין מושג איך להתנהג או לדבר עם אנשים בימינו, והוא מתנהג כמו סמוראי, כולל דיבור מוזר ולבוש מסורתי. כשהוא עובר לגור עם האחיות איקארוגה בדוג'ו, יואיצ'י, שאינו יודע איך לתקשר עם אחרים, נקלע כל הזמן לאי הבנות מצחיקות. \"אסו נו יואיצ'י!\" עוקב אחרי יואיצ'י כשהוא מנסה לנווט את חייו החדשים וללמוד איך לחיות בעולם המודרני עם משפחתו החדשה.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2009-01-09","season":{"label":"חורף 2009","year":2009,"season":"winter"},"broadcast":{"label":"שישי 01:29","day":"friday","time":"01:29","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Harem","he":"הרמון (נשים)"},{"en":"Martial Arts","he":"אומנויות לחימה"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Comedy","Romance","Ecchi"],"studios":["AIC"],"producers":["Lantis","TBS","Movic"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":6.67,"mal_scored_by":113940,"israel":null,"israel_scored_by":null,"rank":6970,"popularity":1330,"members":218320,"favorites":372},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/6/20621l.webp"},"trailer":{"youtube_id":"Nw3K2Frc8nU","url":"https://