{"id":42249,"mal_id":42249,"anizone_id":42249,"url":"https://anizone.co.il/anime/42249/Tokyo-Revengers","slug":"Tokyo-Revengers","titles":{"hebrew":"הנוקמים מטוקיו","english":"Tokyo Revengers","romaji":"Tokyo Revengers","japanese":"東京リベンジャーズ","synonyms":[],"community":["טוקיו ריוונג'רס","נוקמי טוקיו"],"known":["Tokyo Revengers","東京リベンジャーズ"]},"synopsis_hebrew":"גיבורנו, האנגאקי טאקמיצ'י, מגלה שהינאטה טצ’יבאנה, חברתו לשעבר, נרצחה לא מזמן בידי כנופיה הידועה לשמצה, \"כנופית טוקיו מאנג'י\". טאקמיצ'י, שגם ככה נמצא במצב לא פשוט בחייו הפרטיים, מתחיל לתהות בדרכו מהעבודה היכן הכל השתבש. אלא שאז, בזמן ההמתנה לרכבת, הוא נדחף אל המסילה ומוצא את עצמו אל מול הקטר המתקרב. הדבר היחיד שבו נזכר ברגעיו האחרונים הוא בהינאטה, ומשם המחשבות שלו עוברות אל חייו המופלאים מהזמן שעוד היה תלמיד חטיבה.\nמסתבר, למרבה הפלא, שאלו לא היו רק מחשבות. טאקמיצ'י מגלה שחזר בזמן 12 שנים לאחור אל התקופה הזוהרת של חייו, אל התקופה שבה הוא עוד היה במערכת יחסים עם הינאטה. מתוך הבנה שיש לו הזדמנות להציל אותה, טאקמיצ’י מחליט להיכנס לכנופית טוקיו מאנג'י ולטפס בסולם הדרגות כדי לשכתב את העתיד ועל ידי כך להציל את הינאטה מגורלה הטרגי.","background_hebrew":null,"type":"TV","episodes":24,"duration_minutes":23,"status":"הסתיים","aired_from":"2021-04-11","season":{"label":"אביב 2021","year":2021,"season":"spring"},"broadcast":{"label":"ראשון 02:08","day":"sunday","time":"02:08","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Delinquents","he":"עבריינות"},{"en":"Time Travel","he":"מסע בזמן"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Drama"],"studios":["LIDENFILMS"],"producers":["Mainichi Broadcasting System","Pony Canyon","Kodansha","AT-X","Ultra Super Pictures","Studio Mausu","Sammy"],"licensors":["VIZ Media"],"source":null,"rating":null,"scores":{"mal":7.8,"mal_scored_by":797540,"israel":7.25,"israel_scored_by":8,"rank":1199,"popularity":107,"members":1439400,"favorites":25440},"community_reviews":{"ratings":8,"written_reviews":2},