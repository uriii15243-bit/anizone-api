{"id":35983,"mal_id":35983,"anizone_id":35983,"url":"https://anizone.co.il/anime/35983/Harukana-Receive","slug":"Harukana-Receive","titles":{"hebrew":"הרוקנה רסיב","english":"Harukana Receive","romaji":"Harukana Receive","japanese":"はるかなレシーブ","synonyms":[],"community":[],"known":["Harukana Receive","はるかなレシーブ"]},"synopsis_hebrew":"בכדורעף חופים אין מקום לאסים. כדי להשיג ניצחון, כל שחקן חייב למצוא את השותף האחד והיחיד שאפשר לסמוך עליו במגרש החול. לפחות, זה מה שהארוקה אוזורה לומדת ביום הראשון שלה באוקינאווה לאחר שעברה לגור עם סבתה ועם בת דודתה קאנאטה היגה. במהלך סיור בחוף סמוך, הארוקה נתקלת בכמה בנות שמתאמנות בכדורעף חופים ומוזמנת במהירות להצטרף. משחק האימון הידידותי הזה הופך לפתע למשחק תחרותי כאשר אחת הבנות, נארומי טואי, מבחינה בקאנאטה מתקרבת למגרש.\n\nלמרות שהשתיים סופגות תבוסה קשה, הארוקה סוף סוף מבינה את הסיבה להתנהגות השקטה והמרוחקת של בת דודתה. קאנאטה ונארומי היו פעם צמד מוכשר במיוחד בכדורעף חופים, עד שקאנאטה פרשה בגלל גובהה הנמוך שגרם לבעיות עבור נארומי. כעת, עם טורניר הנוער שמתקיים בעוד כמה שבועות, הארוקה חייבת ללמוד את המורכבויות של כדורעף חופים תחרותי ולעזור לקאנאטה להתגבר על החרדה המשתקת שלה כלפי הספורט שהיא פעם אהבה.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2018-07-06","season":{"label":"קיץ 2018","year":2018,"season":"summer"},"broadcast":{"label":"שישי 21:00","day":"friday","time":"21:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Sports","he":"ספורט"}],"subcategories":[{"en":"Team Sports","he":"ספורט קבוצתי"}],"demographic":null,"genres":["Sports"],"studios":["C2C"],"producers":["AT-X","Houbunsha","Docomo Anime Store","Kadokawa Media House","Kadokawa"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.66,"mal_scored_by":44733,"israel":null,"israel_scored_by":null,"rank":7055,"popularity":2163,"members":120735,"favorites":186},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1924/95212l.webp"},"trailer":{