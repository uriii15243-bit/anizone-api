{"id":33047,"mal_id":33047,"anizone_id":33047,"url":"https://anizone.co.il/anime/33047/FateExtra-Last-Encore","slug":"FateExtra-Last-Encore","titles":{"hebrew":"פייט/אקסטרה: ההדרן האחרון - התיאוריה ההליוצנטרית הנשכחת","english":"Fate/Extra: Last Encore","romaji":"Fate/Extra: Last Encore","japanese":"Fate/EXTRA Last Encore","synonyms":[],"community":[],"known":["Fate/Extra: Last Encore","Fate/EXTRA Last Encore"]},"synopsis_hebrew":"אקדמיית צוקימיהארה, גיהנום טכנולוגי המתחזה לגן עדן, היא תיכון מלאכותי המשמש כזירה למלחמת הגביע הקדוש הבאה. בית הספר נוצר על ידי מחשב ה-Moon Cell ומאוכלס בנשמות המוקרנות מכדור הארץ, שיש להן אפילו את הכישרון הקל ביותר להיות \"מאסטר\". מתוך 256 הנשמות הללו, 128 ייבחרו לטורניר המרכזי ויוענק להן משרת. עם בחירת כל המאסטרים, האקדמיה מפעילה טיהור, המכוון לחיסול שאר היצורים החיים.\n\nמתעורר בבריכה של דמו שלו, האקונו קישינאמי מסרב למות. מונע על ידי רגשות שנאה לא ידועים, הוא נשבע להילחם על הישרדותו. בעודו נאבק להימלט מרודף בלתי פוסק, הוא מוצא להב ארגמן נעוץ באדמה; ובמשיכתו החוצה, האקונו מזמן את המשרת שלו, סייבר, שמיד משמיד את רודפו במערבולת של עלי ורדים. עם כוחו החדש, האקונו חייב כעת להתחיל את מסעו אל ליבת ה-Moon Cell, כלוב אנג'ליקה. שם, הוא יחשוף את הסיבה לעולם המלאכותי הזה ואת סודות עברו המוכתם בדם.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":10,"duration_minutes":24,"status":"הסתיים","aired_from":"2018-01-28","season":{"label":"חורף 2018","year":2018,"season":"winter"},"broadcast":{"label":"ראשון 00:00","day":"sunday","time":"00:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Action","Fantasy"],"studios":["Shaft"],"producers":["Aniplex","Marvelous Entertainment","Rakuonsha","Notes"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.31,"mal_scored_by":108352,"israel":6.0,"israel_scored_by":2,"rank":9323,"popularity":1219,"members":239733,"favorites":506},"community_reviews":{"ratings":2,"written_reviews":0