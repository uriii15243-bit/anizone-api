{"id":9479,"mal_id":9479,"anizone_id":9479,"url":"https://anizone.co.il/anime/9479/Coppelion","slug":"Coppelion","titles":{"hebrew":"קופליון","english":"Coppelion","romaji":"Coppelion","japanese":"コッペリオン","synonyms":[],"community":[],"known":["Coppelion","コッペリオン"]},"synopsis_hebrew":"בשנת 2016 קריסה של תחנת כוח רדיואקטיבית גורמת לכאוס\nגדול בטוקיו. 20 שנים לאחר מכן, העיר הפכה לעיר רפאים בעקבות\nרמות הקרינה הגבוהות שיש בה, שלא מאפשרות לבני אדם לחיות בה.\n\"כוחות ההגנה העצמית\" של יפן שולחות אל העיר שלוש בנות מן היחידה\nהמיוחדת \"קופליון\", כדי לחפש אחר ניצולים בעיר. אבל מה שמיוחד בבנות\nהאלו מעבר למשימתם, זה העובדה שהן לא צריכות חליפה נגד קרינה כדי\nלהסתובב בעיר, בניגוד לכל בן אדם אחר.","background_hebrew":"קופליון הוכרז לראשונה כמי שיקבל עיבוד לאנימה בשנת 2010, אך הפרויקט הוקפא לאחר הצונאמי של 2011 שפגע בצפון-מזרח יפן וגרם לכשל בתחנת כוח גרעינית בפוקושימה.","type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2013-10-02","season":{"label":"סתיו 2013","year":2013,"season":"fall"},"broadcast":{"label":"רביעי 21:00","day":"wednesday","time":"21:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Military","he":"צבאי"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Drama","Sci-Fi"],"studios":["GoHands"],"producers":["Starchild Records"],"licensors":["VIZ Media"],"source":null,"rating":null,"scores":{"mal":6.48,"mal_scored_by":55354,"israel":null,"israel_scored_by":null,"rank":8223,"popularity":2059,"members":128583,"favorites":245},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/75543l.webp"},"trailer":{"youtube_id":"-vGytBT04l0","url":"https://www.youtube.com/watch?v=-vGytBT04l0","embed_url":"https://www.youtube.com/embed/-vGytBT04l0"},"characters":[{"name":"Naruse, Ibara","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/2/221629.webp?s=50234d9bd5481bb89f207