{"id":3366,"mal_id":3366,"anizone_id":3366,"url":"https://anizone.co.il/anime/3366/Persona-Trinity-Soul","slug":"Persona-Trinity-Soul","titles":{"hebrew":"פרסונה: טריניטי סול","english":"Persona: Trinity Soul","romaji":"Persona: Trinity Soul","japanese":"ペルソナ 〜トリニティ・ソウル〜","synonyms":[],"community":[],"known":["Persona: Trinity Soul","ペルソナ 〜トリニティ・ソウル〜"]},"synopsis_hebrew":"הבמה היא עיר אייאנגי, עיר ליד ים יפן. זו עיר עתידנית שנבנתה כדי לבצע את ההתאוששות מהאסון שנגרם על ידי \"תסמונת האדישות\" לפני עשר שנים. תלמיד התיכון שין קנזאטו ואחיו הקטן ג'ון נפגשים שוב עם אחיהם הבכור ריו, שהוא ראש משטרת עיר אייאנגי, לאחר עשר שנים. באותו זמן, סדרה של תקריות מוזרות מתרחשת בעיר אייאנגי, כמו צוות צוללת שנעלם פתאום בזמן שהם בצוללת שלהם, או תסמין חסר רוח שמפריע לעולם לאחר עשר שנים, או המקרה של הגופה ההפוכה שבה תלמיד קיבל מראה אכזרי. ריו עוקב אחרי הארגון שעומד מאחורי שרשרת התקריות, וכאשר שין מעורב בתקריות, הוא מעיר את ה\"פרסונה\".\n\nמקור: ויקיפדיה","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":23,"status":"הסתיים","aired_from":"2008-01-05","season":{"label":"חורף 2008","year":2008,"season":"winter"},"broadcast":{"label":"שבת 22:30","day":"saturday","time":"22:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Mystery","he":"מסתורין"},{"en":"Sci-Fi","he":"מדע בדיוני"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":null,"genres":["Action","Mystery","Sci-Fi","Supernatural"],"studios":["A-1 Pictures"],"producers":["Aniplex"],"licensors":["NIS America"],"source":null,"rating":null,"scores":{"mal":6.49,"mal_scored_by":27223,"israel":6.0,"israel_scored_by":null,"rank":8191,"popularity":2672,"members":88421,"favorites":168},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1231/97049l.webp"},"trailer":{"youtube_id":"qGD3Wlb47Xg","url":"https://www.youtube.com/watch?v=qGD3Wlb47Xg","embed_url":"https://www.youtube