{"id":16251,"mal_id":16251,"anizone_id":16251,"url":"https://anizone.co.il/anime/16251/Shinkai-no-Kantai-Submarine-707","slug":"Shinkai-no-Kantai-Submarine-707","titles":{"hebrew":"שינקאי נו קנטאי: סובמרין 707","english":"Shinkai no Kantai: Submarine 707","romaji":"Shinkai no Kantai: Submarine 707","japanese":"深海の艦隊 サブマリン707","synonyms":["Undersea Fleet Submarine 707F"],"community":[],"known":["Shinkai no Kantai: Submarine 707","深海の艦隊 サブマリン707","Undersea Fleet Submarine 707F"]},"synopsis_hebrew":"חפץ מסתורי תוקף ומשמיד כל ספינה או צוללת. לצוללת 707 יש משימה לחפש את החפץ המסתורי הזה, כאשר היא מוזמנת על ידי לוויתן לעקוב אחריו. הלוויתן מוביל אותם לעולם של מו. אבל בדרכם הם פוגשים את החפץ המסתורי. הם מגלים שזהו המפקד רד סילבר, שתקף את עולם מו כדי להשיג את מקורות המאגמה של מו. הצוללת יוצאת לקרב כדי להביס את רד סילבר ולהציל את מו, ואת העולם כולו לצורך העניין.\n\nמקור: ANN","background_hebrew":null,"type":"OVA","episodes":1,"duration_minutes":46,"status":"הסתיים","aired_from":"1997-01-10","season":{"label":"חורף 1997","year":1997,"season":"winter"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Military","he":"צבאי"}],"demographic":null,"genres":["Action","Adventure","Sci-Fi"],"studios":["Knack Productions"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.61,"mal_scored_by":430,"israel":null,"israel_scored_by":null,"rank":13135,"popularity":14570,"members":1307,"favorites":0},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/6/43741l.webp"},"trailer":null,"characters":[{"name":"Chaika","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/3/191682.webp?s=b80565e87b6aaf02270b623e371d41e7","voice_actors":[{"name":"Katsuki, Masako","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/3/49816.jpg?s=14226f12ed7e76