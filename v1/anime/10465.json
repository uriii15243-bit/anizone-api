{"id":10465,"mal_id":10465,"anizone_id":10465,"url":"https://anizone.co.il/anime/10465/Manyu-Scroll","slug":"Manyu-Scroll","titles":{"hebrew":"חרב סודית של חזה קסום","english":"Manyu Scroll","romaji":"Manyuu Hikenchou","japanese":"魔乳秘剣帖","synonyms":["Magic Breast Secret Sword Scroll"],"community":[],"known":["Manyuu Hikenchou","Manyu Scroll","魔乳秘剣帖","Magic Breast Secret Sword Scroll"]},"synopsis_hebrew":"בתקופת אדו ביפן עלה שבט לוחמים עם כישרון קסום ומיוחד. השבט היה ידוע בשם מאניו, והכישרון היה היכולת להנחית מכה בחרב שיכולה להקטין את גודל החזה של אישה. זה אולי לא נראה כמו יכולת שיכולה להפעיל כוח על ארץ, אבל ב\"מאניו היקנצ'ו\", חזה גדול מסמל מעמד, עושר, תהילה והשפעה.\n\nדאגה חמורה התעוררה בשבט מאניו בעקבות מעשיה של היורשת הנבחרת שלהם, צ'יפוסה. נגעלת מהחברה האובססיבית לחזה שהמאניו יצרו והמשיכו לקיים, צ'יפוסה לא רק נטשה את השבט, אלא גם גנבה את המגילה הקדושה שמפרטת את הטכניקות שלהם לגידול וניתוק חזה.\n\nלמרבה המזל, צ'יפוסה לא לגמרי לבד. הלוחמת חברתה, קאדה, מזדהה עם מטרתה; הזדהות שיכולה לסכן אותה מאוד. כעת, כשהיא מבוקשת על ידי השבט שגידל אותה, צ'יפוסה חייבת להגן על חייה ועל חיי קאדה בזמן שהיא מנסה לתקן את הנזק שגרמו אחיה לארץ. לאורך הדרך, צ'יפוסה תגלה שהיא נושאת כוח שעולה בהרבה על היקף האימונים שלה, כוח שיכול לעזור לעצב ולשנות את הארץ שהיא מבקשת להביא לה שוויון.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2011-07-11","season":{"label":"קיץ 2011","year":2011,"season":"summer"},"broadcast":{"label":"שני 01:00","day":"monday","time":"01:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Samurai","he":"סמוראי"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Comedy","Ecchi"],"studios":["Hoods Entertainment"],"producers":["TV Tokyo","Lantis","Enterbrain","Memory-Tech","Happinet Pictures"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.19,"mal_score