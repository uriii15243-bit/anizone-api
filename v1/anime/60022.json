{"id":60022,"mal_id":60022,"anizone_id":60022,"url":"https://anizone.co.il/anime/60022/One-Piece-Fan-Letter","slug":"One-Piece-Fan-Letter","titles":{"hebrew":"וואן פיס: מכתב הערצה","english":"One Piece Fan Letter","romaji":"One Piece Fan Letter","japanese":"ONE PIECE FAN LETTER","synonyms":[],"community":["וואן פיס מכתב מעריצים"],"known":["One Piece Fan Letter","ONE PIECE FAN LETTER"]},"synopsis_hebrew":"למרות שתקופת הזהב של הפיראטים עומדת להגיע לשיאים חדשים, רוב האנשים אינם מחפשים את התהילה שבמציאת ה-One Piece החמקמק—אוצר המסמל כובש חדש של כל הימים, שהיה פעם בידי מלך הפיראטים האגדי, גול די. רוג'ר. עם זאת, גם אם האזרחים בדרך כלל מתעבים פיראטים, הם בסתר מעודדים לפחות אחד מהם.\n\nנערה אדומת שיער מהארכיפלג סבאודי אינה יוצאת דופן: היא מעריצה את נאמי, הנווטת המבריקה של צוות כובע הקש של מונקי די. לופי. נחושה למסור מכתב מעריץ לאלילתה, הילדה מסבאודי מוכנה לאתגר את כוחות הסמכות שמנסים למנוע מלופי וחבריו לצאת ליעדם הבא: העולם החדש. אך כדי להצליח, ייתכן שמעריצת נאמי תצטרך לסכן את חייה ולהתערב בתוכניות של חיל הים, מה שעלול לגרום להשלכות הרסניות לעולם הרחב.\n\nמקור: MAL Rewrite","background_hebrew":"היצירה הזו נועדה לציין את יום השנה ה-25 לאנימה של וואן פיס.","type":"TV Special","episodes":1,"duration_minutes":24,"status":"הסתיים","aired_from":"2024-10-20","season":{"label":"סתיו 2024","year":2024,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Fantasy"],"studios":["Toei Animation"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":8.99,"mal_scored_by":121722,"israel":8.0,"israel_scored_by":7,"rank":14,"popularity":1655,"members":170338,"favorites":2687},"community_reviews":{"ratings":7,"written_reviews":3},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1455/146229l.webp"},"trailer":{"youtube_id