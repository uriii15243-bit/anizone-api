{"id":60571,"mal_id":60571,"anizone_id":60571,"url":"https://anizone.co.il/anime/60571/Ever-Night","slug":"Ever-Night","titles":{"hebrew":"ג'יאנג יה","english":"Ever Night","romaji":"Jiang Ye","japanese":"将夜","synonyms":[],"community":[],"known":["Jiang Ye","Ever Night","将夜"]},"synopsis_hebrew":"הגיבור נינג צ'ו נוסע לעולם שנראה כמו שושלת טאנג האמיתית, רק כדי לגלות שזהו עולם מסוכן של טיפוח. בתחילה הוא חשב שיוכל לחיות חיים של מותרות ולהפוך לעליון, אך מגלה שאין לו כישרון לטיפוח. בנוסף, הוא היה עד לטבח של כל משפחתו בגיל ארבע ונרדף במשך אלפי קילומטרים. בזמן שנמלט ממוות, הוא מצא מטרייה שחורה בים של דם וגופות ומצא את התינוקת סאנגסאנג. בייאושו, הוא מצא את המוטיבציה לחיות. לא מוכן להיכנע לגורל, הוא לוקח את המטרייה השחורה הגדולה ואת סאנגסאנג, ומתחיל במתקפת נגד מרתקת.\n\n(מקור: Bilibili, תורגם)","background_hebrew":"עיבוד לרומן הרשת בעל אותו השם מאת מאו ני (猫腻).","type":"ONA","episodes":19,"duration_minutes":21,"status":"הסתיים","aired_from":"2026-04-23","season":{"label":"אביב 2026","year":2026,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Drama","he":"דרמה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Historical","he":"היסטורי"}],"demographic":null,"genres":["Action","Drama","Fantasy"],"studios":["Wonder Cat Animation"],"producers":["bilibili"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.41,"mal_scored_by":306,"israel":null,"israel_scored_by":null,"rank":2631,"popularity":15386,"members":1075,"favorites":5},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1021/156293l.webp"},"trailer":{"youtube_id":"LrwxfFLsjOk","url":"https://www.youtube.com/watch?v=LrwxfFLsjOk","embed_url":"https://www.youtube.com/embed/LrwxfFLsjOk"},"characters":[{"name":"Ning, Que","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/5/630099.webp?s=6e775edf2917cae451d7c7a2ba53175e","voice_actors":[{"name":"Yang, Tianxi