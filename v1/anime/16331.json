{"id":16331,"mal_id":16331,"anizone_id":16331,"url":"https://anizone.co.il/anime/16331/Next-A-Class","slug":"Next-A-Class","titles":{"hebrew":"נקסט איי-קלאס","english":"Next A-Class","romaji":"Next A-Class","japanese":"NEXT A-Class","synonyms":[],"community":[],"known":["Next A-Class","NEXT A-Class"]},"synopsis_hebrew":"בעתיד הלא כל כך רחוק, כדי להתמודד עם פקקי התנועה והוורטיקליזציה שנגרמו מהגידול באוכלוסייה, העיר טוקיו נבנתה מחדש תחת הנושא של שיתוף עירוני, שבו אנשים חולקים את המרחב העירוני על ידי שינוי הכבישים ומבנה העיר לפי שעות היום. אישה בשם ניקו מטיילת בעיר. זהו יום החופש המיוחל שלה; עם זאת, היא לא יודעת מה לעשות ועם מי לבלות. היא מקווה שיקרה משהו מרגש פתאום.\n\nואז, משאית עוברת ממש מול עיניה. המוזיקה הרועשת והקישוטים הבולטים של הרכב מזכירים לניקו את המכונית שכולם מדברים עליה באינטרנט. ברגע שניקו רואה אותה, היא רצה אחריה, ואז נתקלת בגאטסו ומאקיטו. ניקו נכנסת ל-A-Class החדשה שלהם והם רודפים אחרי המשאית, נוסעים דרך העיר שמשנה את צורתה במהירות.\n\nמקור: AniDB","background_hebrew":null,"type":"CM","episodes":1,"duration_minutes":6,"status":"הסתיים","aired_from":"2012-11-17","season":{"label":"סתיו 2012","year":2012,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Racing","he":"מרוצים"}],"demographic":null,"genres":["Action","Sci-Fi"],"studios":["Production I.G"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.36,"mal_scored_by":4918,"israel":null,"israel_scored_by":null,"rank":null,"popularity":7776,"members":9082,"favorites":10},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/44099l.webp"},"trailer":null,"characters":[{"name":"Kai, Kuniko","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/10/195611.webp?s=e58d898b999693372e9a523d3d3015ce","voice_actors":[{"name":"Sawashiro, Miyuki","language":"יפנית","image":"https://cdn.myanimelist