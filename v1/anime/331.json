{"id":331,"mal_id":331,"anizone_id":331,"url":"https://anizone.co.il/anime/331/Magical-Circle-Guru-Guru","slug":"Magical-Circle-Guru-Guru","titles":{"hebrew":"מעגל הקסם גורו גורו","english":"Magical Circle Guru Guru","romaji":"Mahoujin Guruguru","japanese":"魔法陣グルグル","synonyms":[],"community":[],"known":["Mahoujin Guruguru","Magical Circle Guru Guru","魔法陣グルグル","Magical Circle Guru-Guru"]},"synopsis_hebrew":"יש כפר קטן בשם ג'ימונה ביבשת ג'אמו ג'אמו. בכפר הזה גרה ילדה בשם קוקורי. היא הצאצאית האחרונה של שבט המיגו מיגו. היא גדלה אצל מכשפה זקנה שמלמדת אותה את הקסם הסודי של השבט, אבל קוקורי לא תלמידה טובה.\n\nבאותו כפר גר גם ילד בשם נייק. הוא גדל אצל הורים מאוד קפדניים. הם מחנכים את בנם להפוך לגיבור אמיץ של הכפר. נייק עצמו לא רוצה להיות גיבור בכלל, אבל הוא גדל והופך לנער חזק.\n\nיום אחד, מלך הכפר, קודאי, מגייס חיילים להילחם נגד שליט החושך, גירי. קוקורי ונייק מתקבלים. שני הילדים, הגיבור החזק אך הלא-רוצה נייק, והמכשפה הקטנה והנלהבת אך חסרת המיומנות קוקורי, יוצאים למסע נפלא מלא בהרפתקאות וחברות.\n\nמקור: Nippon Animation","background_hebrew":null,"type":"TV","episodes":45,"duration_minutes":23,"status":"הסתיים","aired_from":"1994-10-13","season":{"label":"סתיו 1994","year":1994,"season":"fall"},"broadcast":{"label":"חמישי 19:30","day":"thursday","time":"19:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Adventure","Comedy","Fantasy"],"studios":["Nippon Animation"],"producers":["Dentsu","Asahi Broadcasting"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.62,"mal_scored_by":3920,"israel":null,"israel_scored_by":null,"rank":1734,"popularity":6839,"members":12475,"favorites":83},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/2/75814l.webp"},"trailer":null,"characters":[{"name":"Kukuri","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/11/334494.web