{"id":8,"mal_id":8,"anizone_id":8,"url":"https://anizone.co.il/anime/8/Beet-the-Vandel-Buster","slug":"Beet-the-Vandel-Buster","titles":{"hebrew":"ביט הלוכד ונדל","english":"Beet the Vandel Buster","romaji":"Bouken Ou Beet","japanese":"冒険王ビィト","synonyms":["Adventure King Beet"],"community":[],"known":["Bouken Ou Beet","Beet the Vandel Buster","冒険王ビィト","Adventure King Beet"]},"synopsis_hebrew":"זהו המאה האפלה והאנשים סובלים תחת שלטונו של השד, ונדל, שמסוגל לשלוט במפלצות. הוונדל באסטרס הם קבוצה של אנשים שצדים את השדים הללו, וביניהם, צוות זנון ידוע כחזקים ביותר ביבשת. נער צעיר בשם ביט חולם להצטרף לצוות זנון. אולם, יום אחד, כתוצאה מטעות של ביט, צוות זנון הובס על ידי השד, בלטוז. חמשת הבאסטרים הגוססים הקריבו את כוח חייהם לתוך חמשת נשקיהם, סייגה. לאחר שהעבירו את נשקיהם לביט, הם נפטרו. שנים חלפו מאז והוונדל באסטר הצעיר, ביט, מתחיל את הרפתקתו לממש את רצון צוות זנון לשים קץ למאה האפלה.","background_hebrew":null,"type":"TV","episodes":52,"duration_minutes":23,"status":"הסתיים","aired_from":"2004-09-30","season":{"label":"סתיו 2004","year":2004,"season":"fall"},"broadcast":{"label":"חמישי 18:30","day":"thursday","time":"18:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Fantasy"],"studios":["Toei Animation"],"producers":["TV Tokyo","Dentsu"],"licensors":["Illumitoon Entertainment"],"source":null,"rating":null,"scores":{"mal":6.98,"mal_scored_by":6992,"israel":null,"israel_scored_by":null,"rank":5023,"popularity":6060,"members":16847,"favorites":19},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/7/21569l.webp"},"trailer":null,"characters":[{"name":"Beet","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/4/123155.webp?s=71a949a12df96189b1203bfcbbda625a","voice_actors":[{"name":"Grant, Tiffany","language":"אנגלית","image":"https://cdn.myanimelis