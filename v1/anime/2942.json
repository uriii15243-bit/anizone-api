{"id":2942,"mal_id":2942,"anizone_id":2942,"url":"https://anizone.co.il/anime/2942/Sketchbook-full-colors","slug":"Sketchbook-full-colors","titles":{"hebrew":"סקצ'בוק ~צבע מלא~","english":"Sketchbook ~full color's~","romaji":"Sketchbook: Full Color's","japanese":"スケッチブック ～full color's～","synonyms":[],"community":[],"known":["Sketchbook: Full Color's","Sketchbook ~full color's~","スケッチブック ～full color's～"]},"synopsis_hebrew":"לסורה קאג'יווארה, העולם מלא בדברים נפלאים וחמודים שהיא רוצה לצייר—חתולים הם אובייקט פופולרי של חיבתה. למרות שיש דברים שלא ניתן ללכוד בעזרת עיפרון ונייר, היא עדיין לוקחת את מחברת הסקיצות שלה לכל מקום שהיא הולכת. אהבתה לציור מובילה אותה בסופו של דבר להצטרף למועדון האמנות של בית הספר שלה, למרות אישיותה הביישנית והילדותית.\n\nכמו סורה, גם לכל חברי מועדון האמנות יש דמיון עשיר ואישיות תואמת. דרך האינטראקציות שלה עם שאר חברי המועדון, סורה מתחילה לצאת מהקונכייה שלה ולראות יותר מהעולם סביבה, תוך שהיא מנצלת כל הזדמנות לסקץ' כל מה שעולה על דעתה או בליבה.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2007-10-02","season":{"label":"סתיו 2007","year":2007,"season":"fall"},"broadcast":{"label":"שלישי 02:00","day":"tuesday","time":"02:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Slice of Life","he":"חלק מהחיים"}],"subcategories":[{"en":"CGDCT","he":"בנות חמודות"},{"en":"Iyashikei","he":"מצב ריפוי"},{"en":"Visual Arts","he":"אומנות חזותית"}],"demographic":null,"genres":["Slice of Life"],"studios":["HAL Film Maker"],"producers":["Media Factory","Shochiku","AT-X","TV Tokyo Music","TYO","Mag Garden"],"licensors":["Nozomi Entertainment","AnimEigo"],"source":null,"rating":null,"scores":{"mal":7.43,"mal_scored_by":10409,"israel":null,"israel_scored_by":null,"rank":2566,"popularity":4454,"members":35607,"favorites":223},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1763/137274l.webp"},"trailer":null,"characters":[{"name":"Kajiwara, Sora","role":"ר