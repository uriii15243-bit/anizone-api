{"id":36164,"mal_id":36164,"anizone_id":36164,"url":"https://anizone.co.il/anime/36164/Gun-Girls","slug":"Gun-Girls","titles":{"hebrew":"גאן גירלס","english":"Gun Girls","romaji":"Qiang Niang","japanese":"銃娘 [ガンガール]","synonyms":[],"community":[],"known":["Qiang Niang","Gun Girls","銃娘 [ガンガール]"]},"synopsis_hebrew":"צ'יאנג ניאנג מספרת בעיקר על הגיבורה קארי, שאיבדה את זיכרונות הקרב שלה, בחיפוש אחר עצמה וסיפור ה\"התעוררות\" הסופית שלה. בשנים שבין 2025 ל-2030, מלחמת עולם שכוללת את כל העולם הביאה למותם של חצי מאוכלוסיית העולם, והאנושות כבר איבדה שליטה על הכיוון שאליו תלך המלחמה. כדי להשיג ניצחון מוחלט, המלחמה הפכה בהדרגה לקרב ללא אנשים, דומה למשחק. המלחמה כבר הפכה להיות על לייזרים לווייניים, רחפני פצצות, בינה מלאכותית חכמה, שדה קרב בין צריחי ירי וטנקים ללא אנשים... ואז, יש גם קבוצה של נערות צעירות שמשתמשות בנשק מיושן כדי להילחם — הבנות עם הרובים.","background_hebrew":null,"type":"ONA","episodes":12,"duration_minutes":14,"status":"הסתיים","aired_from":"2017-08-18","season":{"label":"קיץ 2017","year":2017,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Military","he":"צבאי"},{"en":"Space","he":"חלל"}],"demographic":null,"genres":["Action","Comedy","Sci-Fi"],"studios":["Hoods Entertainment"],"producers":["Tencent Animation & Comics","Tencent Video","AHAVERSE"],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.4,"mal_scored_by":235,"israel":null,"israel_scored_by":null,"rank":13861,"popularity":13837,"members":1564,"favorites":1},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/87374l.webp"},"trailer":null,"characters":[{"name":"Aida","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/6/555442.webp?s=edba910ac2783a03cfcff882f3ac8197","voice_actors":[{"name":"Yuzuki, Shouko","language":"יפנית","image":"https://cdn.myanimelist.net/im