{"id":6941,"mal_id":6941,"anizone_id":6941,"url":"https://anizone.co.il/anime/6941/Toriko-Jump-Super-Anime-Tour-2009-Special","slug":"Toriko-Jump-Super-Anime-Tour-2009-Special","titles":{"hebrew":"טוריקו: ג'אמפ סופר אנימה טור 2009 ספיישל","english":"Toriko: Jump Super Anime Tour 2009 Special","romaji":"Toriko: Jump Super Anime Tour 2009 Special","japanese":"トリコ","synonyms":["Toriko: Jump Festa 2009 Special"],"community":[],"known":["Toriko: Jump Super Anime Tour 2009 Special","トリコ","Toriko: Jump Festa 2009 Special"]},"synopsis_hebrew":"הוקרן באופן מיוחד בסיור האנימה של ג'אמפ סופר בשנת 2009.\n\nבעולם שבו הטעם והמרקם של האוכל הם בעלי חשיבות עליונה, קיימים אנשים המכונים בישוקו-יה (ספקי מזון יוקרתיים) המתמחים בהשגת מרכיבים ובעלי חיים נדירים. טוריקו הוא אחד מהציידים הללו וחלומו הוא למצוא את המאכלים היקרים ביותר בעולם וליצור את ארוחת הערב האולטימטיבית. כאחד מהציידים המיומנים ביותר בעולם, הוא נשכר באופן קבוע על ידי מסעדות ועשירים כדי לחפש מרכיבים חדשים ובעלי חיים נדירים.\n\nאדם בעל יכולות על-אנושיות, הוא מנצל את כוחו העצום ואת הידע שלו בממלכת החיות כדי ללכוד חיות פראיות, חמקמקות ונדירות במטרה לקדם את מטרתו הסופית - ארוחת הערב האולטימטיבית המורכבת מהמאכלים הטעימים ביותר בעולם. כיום הוא מלווה על ידי שף חלש וביישן, אשר בהשראת שאיפותיו של טוריקו, נוסע איתו כדי לשפר את כישוריו הקולינריים ולמצוא מרכיבים נדירים.","background_hebrew":null,"type":"Special","episodes":1,"duration_minutes":27,"status":"הסתיים","aired_from":"2009-10-12","season":{"label":"סתיו 2009","year":2009,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Gourmet","he":"בישול"}],"subcategories":[{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Comedy","Gourmet"],"studios":["ufotable"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.96,"mal_scored_by":4168,"