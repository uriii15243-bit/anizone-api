{"id":1494,"mal_id":1494,"anizone_id":1494,"url":"https://anizone.co.il/anime/1494/Darkside-Blues","slug":"Darkside-Blues","titles":{"hebrew":"דארקסייד בלוז","english":"Darkside Blues","romaji":"Darkside Blues","japanese":"ダークサイド・ブルース","synonyms":[],"community":[],"known":["Darkside Blues","ダークサイド・ブルース"]},"synopsis_hebrew":"תאגיד פרסונה סנצ'ורי רכש כמעט כל חלקת אדמה על פני כדור הארץ. אי הסכמה אינה נסבלת בגבולות התאגיד, ואלו שמתנגדים לפרסונה מטופלים במהירות. אחד המקומות הבודדים שעדיין לא נמצאים תחת שליטת פרסונה הוא העיירה החופשית קבוקי-צ'ו, הידועה גם כ\"צד האפל של טוקיו\". בתוך העיירה, תחת הנהגתה של אישה בשם מאי, פועלת קבוצת התנגדות קטנה בשם מסיה. אל העולם הזה נכנס אדם שלוקח את הכינוי של קבוקי-צ'ו: דארקסייד. לפני שמונה עשרה שנה, נסגר דארקסייד בממד אחר על ידי פרסונה סנצ'ורי, וכעת הוא חוזר כדי לסייע למסיה באמצעות כוחו המיסטי הייחודי של התחדשות.\n\n(מקור: ANN)","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":83,"status":"הסתיים","aired_from":"1994-10-08","season":{"label":"סתיו 1994","year":1994,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Horror","he":"אימה"},{"en":"Mystery","he":"מסתורין"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Psychological","he":"פסיכולוגיה"}],"demographic":null,"genres":["Horror","Mystery","Sci-Fi"],"studios":["J.C.Staff"],"producers":["Akita Shoten"],"licensors":["ADV Films","Central Park Media"],"source":null,"rating":null,"scores":{"mal":5.98,"mal_scored_by":5063,"israel":null,"israel_scored_by":null,"rank":11207,"popularity":6599,"members":13495,"favorites":33},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1582/95393l.webp"},"trailer":null,"characters":[{"name":"Darkside","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/6/116029.webp?s=0168349c7490a3bbf8c747270f3651f8","voice_actors":[{"name":"Ou, Natsuki","language":"יפנית","image":"https://cdn.myanimelist.net/image