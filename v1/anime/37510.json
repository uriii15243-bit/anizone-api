{"id":37510,"mal_id":37510,"anizone_id":37510,"url":"https://anizone.co.il/anime/37510/Mob-Psycho-100-II","slug":"Mob-Psycho-100-II","titles":{"hebrew":"מוב פסיכו 100 עונה 2","english":"Mob Psycho 100 II","romaji":"Mob Psycho 100 II","japanese":"モブサイコ100 II","synonyms":["Mob Psycho 100 2nd Season","Mob Psycho Hyaku","Mob Psycho One Hundred","Mob Psycho 100 2nd Season, Mob Psycho Hyaku, Mob Psycho One Hundred"],"community":[],"known":["Mob Psycho 100 II","モブサイコ100 II","Mob Psycho 100 2nd Season","Mob Psycho Hyaku","Mob Psycho One Hundred"]},"synopsis_hebrew":"שיגאו “מוב” קאגיאמה מתחיל להתבגר ולהבין את התפקיד שלו כמדיום עם כוח שמסוגל להשפיע על חייהם של האנשים סביבו. הוא ורייגן ארטקה, המנטור שלו, ממשיכים לקבל בקשות לעזרה בנוגע לדברים על טבעיים, בין אם הבקשה היא לגרש רוח רעה ובין אם היא לאתר אגדות אורבניות שרודפות את האזרחים.\nאמנם סביבת העבודה שלו נשארת זהה, אך מוב כבר לא הולך אחרי רייגן. עם כל החוויות שעבר עם הכוחות שלו ועם מדיומים אחרים, להרפתקאות העל טבעיות של מוב יש הרבה יותר מטען רגשי.\nהעניינים הולכים ונהיים אפלים יותר, כאשר הסיכונים שמוב ורייגן יתמודדו איתם הופכים למפחידים יותר מאי פעם.","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2019-01-07","season":{"label":"חורף 2019","year":2019,"season":"winter"},"broadcast":{"label":"שני 23:00","day":"monday","time":"23:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[],"demographic":null,"genres":["Action","Comedy","Supernatural"],"studios":["Bones"],"producers":["Warner Bros. Japan","KlockWorx","BS Fuji","Hakuhodo DY Music & Pictures","Shogakukan"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":8.78,"mal_scored_by":1115940,"israel":8.63,"israel_scored_by":8,"rank":44,"popularity":73,"members":1768199,"favorites":34134},"community_reviews":{"ratings":8,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/a