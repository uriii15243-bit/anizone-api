{"id":6512,"mal_id":6512,"anizone_id":6512,"url":"https://anizone.co.il/anime/6512/Nyan-Koi","slug":"Nyan-Koi","titles":{"hebrew":"אהבה חתולית!","english":"Nyan Koi!","romaji":"Nyan Koi!","japanese":"にゃんこい！","synonyms":["Nyankoi"],"community":[],"known":["Nyan Koi!","にゃんこい！","Nyankoi"]},"synopsis_hebrew":"ג'ונפיי קוסאקה הוא תלמיד שנה שניה בתיכון. הוא סובל מאלרגיה לחתולים, ועל כן מתעב אותם. יום אחד, בדרכו חזרה הביתה, הבחין ג'ונפיי בפחית ריקה על המדרכה וניסה לבעוט בה לתוך פח האשפה. לרוע מזלו, הפחית פגעה בחתול הג'יזו (האפוטרופוס של החתולים) והפילה את ראשו. מאותו הרגע, הוטלה על קוסאקה קללה איומה - עליו לסייע למאה חתולים להגשים את בקשתם או שיהפוך לחתול בעצמו! אם לא די בכך, ג'ונפיי מתחיל להבין את שפת החתולים ומגלה שאם אדם אחר מלבדו ילמד על הקללה שהוטלה עליו, היא תחמיר ואף תפגע באותו אדם.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2009-10-02","season":{"label":"סתיו 2009","year":2009,"season":"fall"},"broadcast":{"label":"שישי 01:59","day":"friday","time":"01:59","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Harem","he":"הרמון (נשים)"},{"en":"Pets","he":"חיות"}],"demographic":null,"genres":["Comedy","Romance","Supernatural"],"studios":["AIC"],"producers":["Pony Canyon","TBS","Movic","Flex Comix"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.11,"mal_scored_by":141531,"israel":null,"israel_scored_by":null,"rank":4366,"popularity":1018,"members":283758,"favorites":616},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/10/18299l.webp"},"trailer":null,"characters":[{"name":"Nabeshin","role":"משני","image":"https://cdn.myanimelist.net/images/characters/14/78675.webp?s=1b537de201c4cfdaf2169f31c041e28d","voice_actors":[{"name":"Watanabe, Shinichi","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/2/953.jpg?s=3