{"id":6992,"mal_id":6992,"anizone_id":6992,"url":"https://anizone.co.il/anime/6992/Hoshi-ni-Negai-wo-Fantastic-Cat","slug":"Hoshi-ni-Negai-wo-Fantastic-Cat","titles":{"hebrew":"הושי ני נגאי וו: פנטסטיק קאט","english":"Hoshi ni Negai wo: Fantastic Cat","romaji":"Hoshi ni Negai wo: Fantastic Cat","japanese":"星に願いを Fantastic Cat","synonyms":[],"community":[],"known":["Hoshi ni Negai wo: Fantastic Cat","星に願いを Fantastic Cat"]},"synopsis_hebrew":"אגדת חלל מהעתיד הרחוק...\n\nכוכב הלכת מגרסיה הוא מרכז מסחרי עם תנועה חללית ערה. נערה בשם לילי מסתקרנת מנערה מסתורית חדשה בבית הספר שלה. היא באותו גיל כמו לילי, אך בוגרת יותר בהשוואה לתלמידים האחרים בכיתתה. היא נחשבת מרוחקת, ועדיין לא יצרה חברויות, כך נראה. שמה הוא היקארי.\n\nלילי יכולה רק לצפות בה מרחוק, בתקווה להזדמנות לדבר איתה. ואז, יום אחד, יצור מוזר דמוי חתול מופיע בכיתה, ומשנה את חייהם הרגילים.","background_hebrew":null,"type":"ONA","episodes":1,"duration_minutes":39,"status":"הסתיים","aired_from":"2009-08-03","season":{"label":"קיץ 2009","year":2009,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Adventure","Sci-Fi"],"studios":["Barnum Studio"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.01,"mal_scored_by":857,"israel":null,"israel_scored_by":null,"rank":11062,"popularity":12612,"members":2241,"favorites":1},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/13/67063l.webp"},"trailer":null,"characters":[{"name":"Hikari","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/16/103892.webp?s=44feca4f40ef7df2c8d993db117b1af5","voice_actors":[{"name":"Sawashiro, Miyuki","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/2/65500.jpg?s=c0e43b2f775c10f86ffd20076d978651"}]},{"name":"Lily","role":"ראשי","image":"https://cdn.myanimelist.net/ima