{"id":13585,"mal_id":13585,"anizone_id":13585,"url":"https://anizone.co.il/anime/13585/Natsuyuki-Rendezvous","slug":"Natsuyuki-Rendezvous","titles":{"hebrew":"נאצויוקי רנדבו","english":"Natsuyuki Rendezvous","romaji":"Natsuyuki Rendezvous","japanese":"夏雪ランデブー","synonyms":["A Summer Snow Rendezvous"],"community":[],"known":["Natsuyuki Rendezvous","夏雪ランデブー","A Summer Snow Rendezvous"]},"synopsis_hebrew":"ריוסוקה הזוקי הוא צעיר שלבו נשבה, והוא עובר מדי יום בחנות הפרחים המקומית כדי לזכות במבט על רוקה שימאו היפה, בעלת החנות. בתקווה להתקרב אליה, הוא מחליט לעבוד בחנות במשרה חלקית, אך לפני שהוא מצליח לעשות את הצעד, הוא נתקל במכשול גדול: בדירתה שוכן רוח רפאים שטוען שהוא בעלה המנוח של רוקה.\n\nאצושי שימאו צפה בשקט באשתו האלמנה מאז שנפטר לפני שלוש שנים. עם זאת, הזוקי הוא האדם הראשון שהבחין בו אי פעם, והשניים מוצאים את עצמם במהרה בעימות: שימאו הקנאי מנסה לסכל את ניסיונות החיזור של הזוקי ולשלוט בגופו, בעוד שהזוקי פשוט רוצה שהרוח תעבור הלאה, כדי לאפשר לרוקה להמשיך הלאה מהעבר ולהיות איתו, האהוב שלה. כאשר שני הגברים מסרבים לוותר על רצונותיהם, נוצר קשר יוצא דופן בין אישה מוטרדת, רוח רפאים עקשנית וגבר מאוהב עקשן.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":11,"duration_minutes":23,"status":"הסתיים","aired_from":"2012-07-06","season":{"label":"קיץ 2012","year":2012,"season":"summer"},"broadcast":{"label":"שישי 01:15","day":"friday","time":"01:15","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"}],"demographic":{"en":"Josei","he":"נשים"},"genres":["Drama","Romance","Supernatural"],"studios":["Doga Kobo"],"producers":["Dentsu","Fuji TV","TOHO","Sony Music Entertainment","Shodensha"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.26,"mal_scored_by":34598,"israel":null,"israel_scored_by":null,"rank":3461,"popularity":2647,"members":89722,"favorites":276},"community_reviews":null,"images":{"