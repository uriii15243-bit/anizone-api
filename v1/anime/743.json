{"id":743,"mal_id":743,"anizone_id":743,"url":"https://anizone.co.il/anime/743/The-Ocean-Waves","slug":"The-Ocean-Waves","titles":{"hebrew":"הגלים של האוקיינוס","english":"The Ocean Waves","romaji":"Umi ga Kikoeru","japanese":"海がきこえる","synonyms":["I Can Hear the Sea"],"community":[],"known":["Umi ga Kikoeru","The Ocean Waves","海がきこえる","Flüstern des Meeres","Puedo escuchar el mar","I Can Hear the Sea"]},"synopsis_hebrew":"בעיר קוצ'י, תלמיד התיכון טאקו מוריסאקי עסוק בעבודתו כאשר חברו יוטאקה מצונו מתקשר ומבקש ממנו להגיע לבית הספר שלהם בהקדם האפשרי. טאקו מגיע, ומצונו מציג בפניו את ריקאקו מוטו, נערה יפה מטוקיו שהועברה לאחרונה לבית ספרם. למרות שריקאקו מוכשרת בלימודים ובספורט, הגישה הכללית הלא נעימה שלה משאירה אותה כמעט ללא חברים מחוץ למצונו ונערה נוספת מכיתתה.\n\nלאחר מפגש מקרי במהלך טיול הכיתה שלהם, טאקו מוצא את עצמו מעורב יותר בחייה האישיים של ריקאקו, למורת רוחו של מצונו. בעודו נאבק לאזן בין החברות שלו עם מצונו לבין ההתאהבות המתפתחת שלו בריקאקו, טאקו חייב להתמודד עם רגשותיו ולהבין כיצד נערה עם עבר בעייתי משפיעה כל כך על חייו.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV Special","episodes":1,"duration_minutes":72,"status":"הסתיים","aired_from":"1993-05-05","season":{"label":"אביב 1993","year":1993,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Love Polygon","he":"אהבה יותר מאישה אחת"},{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Drama","Romance"],"studios":["Studio Ghibli"],"producers":["Tokuma Shoten","Nippon Television Network"],"licensors":["GKIDS"],"source":null,"rating":null,"scores":{"mal":6.54,"mal_scored_by":85855,"israel":5.0,"israel_scored_by":null,"rank":7891,"popularity":1783,"members":154276,"favorites":618},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1498/131411l.webp"},"trailer":{"youtube_id":"tfkHiHjrqa8","