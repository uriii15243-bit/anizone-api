{"id":1485,"mal_id":1485,"anizone_id":1485,"url":"https://anizone.co.il/anime/1485/Baby-and-Me","slug":"Baby-and-Me","titles":{"hebrew":"בייבי ואני","english":"Baby and Me","romaji":"Akachan to Boku","japanese":"赤ちゃんと僕","synonyms":["Aka-chan to Boku","Baby & I","Aka-chan to Boku, Baby & I"],"community":[],"known":["Akachan to Boku","Baby and Me","赤ちゃんと僕","Aka-chan to Boku","Baby & I"]},"synopsis_hebrew":"טקויה אנוקי חי חיים קשים עבור תלמיד כיתה ה'. אמו נפטרה בתאונת דרכים טרגית לפני כמה חודשים, מה שאילץ אותו לקחת על עצמו את האחריות ולדאוג לאחיו התינוק, מינורו, בזמן שאביו עובד שעות ארוכות כנהוג אצל עובדי משרד יפניים.\n\nהוא יצטרך להקריב את ילדותו כדי לענות על הצרכים של אחיו הקטן. בישול, ניקיון, דאגה וניסיון לחנך את מינורו הם חלק מהמשימות שטקויה יצטרך להתמודד איתן, וכל זאת בזמן ששכניהם מאשימים אותו בבכי המתמיד של מינורו. בינתיים, הוא יצפה בחבריו שחיים את חייהם חסרי הדאגות, נהנים מזמנם הפנוי. זה לא יהיה קל ויהיו הרבה מכשולים בדרך, אבל ייתכן שבמהלך הדרך הוא ילמד את המשמעות האמיתית של משפחה.","background_hebrew":null,"type":"TV","episodes":35,"duration_minutes":25,"status":"הסתיים","aired_from":"1996-07-11","season":{"label":"קיץ 1996","year":1996,"season":"summer"},"broadcast":{"label":"רביעי 18:00","day":"wednesday","time":"18:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Childcare","he":"טיפול בילדים"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Comedy","Drama"],"studios":["Studio Pierrot"],"producers":["TV Tokyo","Yomiko Advertising","Youmex"],"licensors":["AnimEigo"],"source":null,"rating":null,"scores":{"mal":7.85,"mal_scored_by":20941,"israel":null,"israel_scored_by":null,"rank":1053,"popularity":4299,"members":38218,"favorites":174},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1011/134392l.webp"},"trailer":null,"characters":[{"name":"Enoki, Minoru","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/8/100948.webp?s=