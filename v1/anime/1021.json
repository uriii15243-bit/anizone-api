{"id":1021,"mal_id":1021,"anizone_id":1021,"url":"https://anizone.co.il/anime/1021/Kaikan-Phrase","slug":"Kaikan-Phrase","titles":{"hebrew":"קאיקן פרייז","english":"Kaikan Phrase","romaji":"Kaikan Phrase","japanese":"快感 フレーズ","synonyms":["Sensual Phrase"],"community":[],"known":["Kaikan Phrase","快感 フレーズ","Sensual Phrase"]},"synopsis_hebrew":"לאחר פירוק הלהקה הישנה שלהם, הגיטריסט יוקי והמתופף סנטה מחליטים להקים להקה חדשה. הם מגייסים את נגן הבס טואה, את הגיטריסט הצעיר אצורו, ולאחר שכנועים רבים, את הזמר סאקויה. יחד הם מקימים את לוסיפר ונאבקים להצליח בתעשיית המוזיקה וגם להישאר יחד. בנוסף, הם צריכים להתמודד עם בעיות אישיות, כמו התנגדות הורית ולראות את הלהקות הישנות שלהם מצליחות לפניהם. סאקויה הוא החבר הכי מוטרד בלהקה, שכן עליו להתמודד עם עברו הטראגי ועם מערכת היחסים שלו עם כותבת המילים הצעירה אאינה.","background_hebrew":null,"type":"TV","episodes":44,"duration_minutes":24,"status":"הסתיים","aired_from":"1999-04-20","season":{"label":"אביב 1999","year":1999,"season":"spring"},"broadcast":{"label":"ראשון 00:20","day":"sunday","time":"00:20","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Music","he":"מוזיקה"},{"en":"Showbiz","he":"תעשיית הבידור"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Drama","Romance"],"studios":["Studio Hibari"],"producers":["TV Tokyo","Shogakukan Productions"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.36,"mal_scored_by":4418,"israel":null,"israel_scored_by":null,"rank":2869,"popularity":6271,"members":15307,"favorites":112},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1625/114978l.webp"},"trailer":null,"characters":[{"name":"Ookouchi, Sakuya","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/7/121948.webp?s=f4433674aac2b4a979f0d039ee9d4565","voice_actors":[{"name":"Matsukaze, Masaya","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/3/61072.jpg?s=544fa6d47b9d8256