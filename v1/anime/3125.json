{"id":3125,"mal_id":3125,"anizone_id":3125,"url":"https://anizone.co.il/anime/3125/Tokimeki-Tonight","slug":"Tokimeki-Tonight","titles":{"hebrew":"טוקימקי טונייט","english":"Tokimeki Tonight","romaji":"Tokimeki Tonight","japanese":"ときめきトゥナイト","synonyms":["Heart-Thumping Tonight"],"community":[],"known":["Tokimeki Tonight","ときめきトゥナイト","Heart-Thumping Tonight"]},"synopsis_hebrew":"רנזה אטו, בת חמש-עשרה, חיה חיים רגילים לכל נערה בגילה—למעט העובדה שהיא מתגוררת בטירה עם אב ערפד ואם אישה-זאב, שדואגים כל הזמן על חוסר הכוחות שלה.\n\nביום הראשון שלה בבית הספר החדש, רנזה פוגשת את שון מקאבה היפהפה ומתאהבת בו עד מעל הראש. בעוד שהוא נשאר חסר מודעות לכך, זה לא מונע מיוקו קמיה, בתו של בוס יאקוזה, לקנא. בנוסף, הוריה של רנזה מתעבים את הרעיון שהיא תצא עם בן אנוש. מעבר לכל זה, רנזה צריכה להתמודד עם הופעת כוח חדש—היכולת לשנות צורה לכל דבר שהיא נושכת!\n\nמקור: MAL Rewrite","background_hebrew":"מאחר שהסדרה הטלוויזיונית הסתיימה שנים לפני המנגה, הכותבים היו חופשיים לכתוב סיום מקורי לאנימה.","type":"TV","episodes":34,"duration_minutes":24,"status":"הסתיים","aired_from":"1982-10-07","season":{"label":"סתיו 1982","year":1982,"season":"fall"},"broadcast":{"label":"חמישי 19:00","day":"thursday","time":"19:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Vampire","he":"ערפדים"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Comedy","Fantasy","Romance"],"studios":["Group TAC"],"producers":["TOHO"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.28,"mal_scored_by":3082,"israel":null,"israel_scored_by":null,"rank":3339,"popularity":6936,"members":12025,"favorites":61},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1272/104468l.webp"},"trailer":null,"characters":[{"name":"Etou, Ranze","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/6/108509.webp?s=076499c159d94efb3eff6f1da0656764","voice_actors":[{"name":"Marg