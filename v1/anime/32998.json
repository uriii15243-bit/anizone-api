{"id":32998,"mal_id":32998,"anizone_id":32998,"url":"https://anizone.co.il/anime/32998/91-Days","slug":"91-Days","titles":{"hebrew":"91 ימים","english":"91 Days","romaji":"91 Days","japanese":"91Days","synonyms":[],"community":[],"known":["91 Days","91Days"]},"synopsis_hebrew":"בתקופת היובש, החוק לא קיים כוח ומאפיה שולטים בעיר. הסיפור מתרחש ב לולס, עיירה משגשגת על מכירות בשוק השחור של ליקר חלוט שלא כדין. אביליו חוזר לולס אחרי קצת זמן לבד, בעקבות רצח משפחתו עם סכסוך של המאפיה ששם  יום אחד, אביליו מקבל מכתב משולח מסתורי, מה שגרם לו לחזור לולס לנקמה. לאחר מכן הוא מתחלחל לתוך משפחת ונאטי, אלה אחראים למותה של משפחתו, וערכות על התיידדות עם הבן של הדון, נרו, מגדיר את הנקמה שלו “כפעילה”.  הרג מביא הרג, ונקמה מולידה יותר נקמה. איך סיפור 91-היום של האנשים האלה בהדרכה למבוי גורל טרגי?","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2016-07-09","season":{"label":"קיץ 2016","year":2016,"season":"summer"},"broadcast":{"label":"שבת 01:55","day":"saturday","time":"01:55","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Drama","he":"דרמה"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Historical","he":"היסטורי"},{"en":"Organized Crime","he":"פשע מאורגן"}],"demographic":null,"genres":["Action","Drama","Suspense"],"studios":["Shuka"],"producers":["Shochiku","Mainichi Broadcasting System","Shochiku Music Publishing"],"licensors":["Funimation","Crunchyroll"],"source":null,"rating":null,"scores":{"mal":7.82,"mal_scored_by":365396,"israel":7.0,"israel_scored_by":7,"rank":1123,"popularity":296,"members":807723,"favorites":8742},"community_reviews":{"ratings":7,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/anime/13/80515l.webp"},"trailer":{"youtube_id":"m5XGnMPR-0o","url":"https://www.youtube.com/watch?v=m5XGnMPR-0o","embed_url":"https://www.youtube.com/embed/m5XGnMPR-0o"},"characters":[{"name":"Lagusa, Angelo","role":"ראשי","image"