{"id":1177,"mal_id":1177,"anizone_id":1177,"url":"https://anizone.co.il/anime/1177/Alien-9","slug":"Alien-9","titles":{"hebrew":"חייזר 9","english":"Alien 9","romaji":"Alien 9","japanese":"エイリアン9","synonyms":["Alien Nine"],"community":[],"known":["Alien 9","エイリアン9","Alien Nine"]},"synopsis_hebrew":"זמן קצר לאחר שהחלה את חטיבת הביניים, יורי אוטאני נאלצת להצטרף ל\"מפלגת החייזרים\", קבוצה חדורת מטרה אחת: ללכוד כל חייזר שמנסה להיכנס לשטח בית הספר. אוטאני, שפוחדת מחייזרים כל חייה, לא מתלהבת כלל, ולמרבה הצער, הערכה שלה כוללת \"בורג\"—יצור דמוי חייזר שתפקידו להבטיח את בטחונה. למרות זאת, היא מוצאת נחמה בשתי שותפותיה: קומי קוואמורה העצמאית והאמינה, וקאסומי טומינה החכמה והאנרגטית.\n\nכאשר מפלגת החייזרים פועלת להדוף איומים חוצניים, האם גלגיליות המהירות ומקלות הלקרוס שלהן יספיקו כדי להתגבר על האתגרים הקשים שמצפים להן, או שהן ייכנעו לפחד ויסבלו מההשלכות הקשות של תבוסה?\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"OVA","episodes":4,"duration_minutes":28,"status":"הסתיים","aired_from":"2001-06-25","season":{"label":"אביב 2001","year":2001,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Horror","he":"אימה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Psychological","he":"פסיכולוגיה"},{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Horror","Sci-Fi"],"studios":["J.C.Staff","Genco"],"producers":["Bandai Visual","MediaNet","AT-X","Nippon Columbia"],"licensors":["Central Park Media","AnimEigo"],"source":null,"rating":null,"scores":{"mal":6.83,"mal_scored_by":20157,"israel":null,"israel_scored_by":null,"rank":5884,"popularity":3748,"members":49579,"favorites":723},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/7/2607l.webp"},"trailer":{"youtube_id":"OHnGMc1PVvM","url":"https://www.youtube.com/watch?v=OHnGMc1PVvM","embed_url":"https://www.youtube.com/embed/OHnGMc1PVvM"},"characters":[{"name":"Otani, Yuri","role":"ראשי","image":"https://cdn.m