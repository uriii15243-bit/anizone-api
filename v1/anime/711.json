{"id":711,"mal_id":711,"anizone_id":711,"url":"https://anizone.co.il/anime/711/Space-Battleship-Yamato","slug":"Space-Battleship-Yamato","titles":{"hebrew":"ספייס באטלשיפ ימאטו","english":"Space Battleship Yamato","romaji":"Uchuu Senkan Yamato (Movie)","japanese":"宇宙戦艦ヤマト","synonyms":[],"community":[],"known":["Uchuu Senkan Yamato (Movie)","Space Battleship Yamato","宇宙戦艦ヤマト"]},"synopsis_hebrew":"בשנת 2199, גזע הגמילון מכריז מלחמה על בני האדם, מתוך כוונה להשתלט על כדור הארץ. הלוחמים על כדור הארץ עושים כל שביכולתם לשמור על יציבות הכוכב, אך הטכנולוגיה החייזרית מתגלה כמתקדמת מדי, וההרס שנגרם הופך את פני השטח של כדור הארץ לבלתי ראויים למגורים. גם המקלטים התת-קרקעיים מתחילים להיחלש, ואם לא יחול שינוי, בני האדם ייכחדו בתוך פחות משנה.\n\nאך בדיוק כשנראה שהכול אבוד, המלכה סטארשה מכוכב איסקנדר מציעה עזרה. המפתח לניצחון טמון ב\"קוסמו-קלינר D\", שיכול לחסל את הקרינה שממנה סובל כדור הארץ. עם זאת, הדרך היחידה להשיג את המכשיר המציל חיים הזה היא אם מישהו מכדור הארץ ייסע לאיסקנדר—148,000 שנות אור משם—כדי להביא אותו. הבעיה היא שיש להם פחות משנה לפני שהזמן ייגמר.\n\nגורל כל המין האנושי נמצא בידיהם של צוות ספינת הקרב החללית ימאטו, שנבנתה מחדש מכלי שיט ממלחמת העולם השנייה.","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":135,"status":"הסתיים","aired_from":"1977-08-06","season":{"label":"קיץ 1977","year":1977,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Military","he":"צבאי"},{"en":"Space","he":"חלל"}],"demographic":null,"genres":["Drama","Sci-Fi"],"studios":["Office Academy"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.73,"mal_scored_by":2058,"israel":null,"israel_scored_by":null,"rank":6597,"popularity":8798,"members":6655,"favorites":5},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1708/142310l.webp"},"t