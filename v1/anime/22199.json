{"id":22199,"mal_id":22199,"anizone_id":22199,"url":"https://anizone.co.il/anime/22199/Akame-ga-Kill","slug":"Akame-ga-Kill","titles":{"hebrew":"אקמה גה קיל","english":"Akame ga Kill!","romaji":"Akame ga Kill!","japanese":"アカメが斬る！","synonyms":["Akame ga Kiru!","AgK","Akame ga Kiru!, AgK"],"community":[],"known":["Akame ga Kill!","アカメが斬る！","Red Eyes Sword - Akame ga Kill!","Akame ga Kiru!","AgK"]},"synopsis_hebrew":"בעולם בדיוני ומלא בפנטזיות, טאטסומי וחבריו יוצאים אל האימפריה, המקום הנחשק והמדובר ביותר במדינתם, וזאת על-מנת שיוכלו לעבוד במקום, ובכך להציל את הכפר הגווע שלהם מהכחדה. ","background_hebrew":"!Akame ga Kill הוא עיבוד האנימה למנגת השונן של טקהירו באותו שם, שאוירה על ידי טטסויה טאשירו ופורסמה בסדרת גנגאן ג'וקר של סקוור אניקס מאפריל 2010 עד דצמבר 2016. האנימה עוקבת אחרי חומר המקור דרך שמונה הכרכים הראשונים של המנגה, ומשלבת אירועים מגיליונות מאוחרים יותר, לפני שהיא מסיימת עם קו עלילה מקורי שמתרחק מהמנגה.","type":"TV","episodes":24,"duration_minutes":23,"status":"הסתיים","aired_from":"2014-07-07","season":{"label":"קיץ 2014","year":2014,"season":"summer"},"broadcast":{"label":"שני 00:00","day":"monday","time":"00:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Gore","he":"גור"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Fantasy"],"studios":["White Fox"],"producers":["Nihon Ad Systems","Sony Music Entertainment","TOHO animation","Q-Tec","Fields","Jinnan Studio","REAL-T"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.49,"mal_scored_by":1432893,"israel":7.25,"israel_scored_by":12,"rank":2253,"popularity":31,"members":2310033,"favorites":31384},"community_reviews":{"ratings":12,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1429/95946l.webp"},"trailer":{"youtube_id":"HOB4GZ1S1Wo","url":"https://www.youtube.com/watch?v=HOB4GZ1S1Wo","embed_url":"https://www.youtube.com/embed/HOB4GZ1S1Wo"},"character