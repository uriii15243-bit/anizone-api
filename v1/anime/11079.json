{"id":11079,"mal_id":11079,"anizone_id":11079,"url":"https://anizone.co.il/anime/11079/Kill-Me-Baby","slug":"Kill-Me-Baby","titles":{"hebrew":"קיל מי בייבי","english":"Kill Me Baby","romaji":"Kill Me Baby","japanese":"キルミーベイベー","synonyms":["Baby, Please Kill Me."],"community":[],"known":["Kill Me Baby","キルミーベイベー","Baby, Please Kill Me."]},"synopsis_hebrew":"קיל מי בייבי הוא הסיפור המרגש של יאסונה, נערה רגילה (?) בתיכון, וסוניה, החברה הכי טובה שלה, שהיא במקרה גם מתנקשת. למרבה הצער, האינסטינקטים של סוניה הקטנה, שאומנה כמתנקשת, לעיתים קרובות פועלים נגדה ונגד אחרים בחיי היומיום שלה בתיכון, כפי שיכול להעיד פרק כף היד השבור של יאסונה. היא רק רצתה חיבוק, אבל סיימה עם צוואר שבור. זה לא עצוב? לא, זה מצחיק.\n\nאפילו האימונים האינטנסיביים של יאסונה כנינג'ה לא יכולים להכין אותה להרפתקאות המרגשות בעיבוד המנגה הזה המורכב מארבעה פאנלים.","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2012-01-06","season":{"label":"חורף 2012","year":2012,"season":"winter"},"broadcast":{"label":"שישי 01:25","day":"friday","time":"01:25","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"Gag Humor","he":"קומדיה הומוריסטית"},{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Comedy"],"studios":["J.C.Staff"],"producers":["Pony Canyon","TBS","Magic Capsule"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":6.89,"mal_scored_by":54276,"israel":null,"israel_scored_by":null,"rank":5534,"popularity":2002,"members":133318,"favorites":645},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/9/87197l.webp"},"trailer":{"youtube_id":"QCJowuoBTMY","url":"https://www.youtube.com/watch?v=QCJowuoBTMY","embed_url":"https://www.youtube.com/embed/QCJowuoBTMY"},"characters":[{"name":"Goshiki, Agiri","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/13/173323.webp?s=efeeb3342b28f2ac4ae8ad0ec476d079","voice_actors":[{"name":"Curt