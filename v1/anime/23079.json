{"id":23079,"mal_id":23079,"anizone_id":23079,"url":"https://anizone.co.il/anime/23079/Glasslip","slug":"Glasslip","titles":{"hebrew":"גלאסליפ","english":"Glasslip","romaji":"Glasslip","japanese":"グラスリップ","synonyms":[],"community":[],"known":["Glasslip","グラスリップ"]},"synopsis_hebrew":"מה אם הייתה לך היכולת לשמוע קולות או לראות קטעי תמונות מהעתיד? האם זה היה דבר טוב או רע? \"Glasslip\" עוקב אחר חייה של טוקו פוקאמי, אמנית זכוכית שאפתנית שנולדה למשפחת אומני זכוכית. היא נהנית מחייה חסרי הדאגות בפוקוי, למעט קטעי התמונות שהיא רואה מדי פעם.\n\nבקיץ ה-18 שלה, היא פוגשת את התלמיד החדש קקרו אוקיקורה בבית הספר שלה, ושוב בבית הקפה האהוב עליה שנקרא \"Kazemichi\" יחד עם ארבעת חבריה. הקולות מהעתיד מובילים את קקרו לטוקו, והגעתו משבשת את קיומה הבינוני. כל ששת החברים חייבים להתמודד עם הקיץ הבלתי נשכח ביותר שלהם, מלא תקווה, חיבה ושברון לב.","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2014-07-03","season":{"label":"קיץ 2014","year":2014,"season":"summer"},"broadcast":{"label":"חמישי 22:30","day":"thursday","time":"22:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Romance","he":"רומנטיקה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Love Polygon","he":"אהבה יותר מאישה אחת"},{"en":"Visual Arts","he":"אומנות חזותית"}],"demographic":null,"genres":["Romance","Supernatural"],"studios":["P.A. Works"],"producers":["Sotsu","Lantis","Pony Canyon","Magic Capsule","Showgate","Infinite"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":5.42,"mal_scored_by":83700,"israel":5.0,"israel_scored_by":null,"rank":13778,"popularity":1632,"members":173805,"favorites":233},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/12/64265l.webp"},"trailer":{"youtube_id":"sTY1pAAGQ28","url":"https://www.youtube.com/watch?v=sTY1pAAGQ28","embed_url":"https://www.youtube.com/embed/sTY1pAAGQ28"},"characters":[{"name":"Fukami, Touko","role":"ראשי","imag