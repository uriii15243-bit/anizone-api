{"id":61196,"mal_id":61196,"anizone_id":61196,"url":"https://anizone.co.il/anime/61196/Dead-Account","slug":"Dead-Account","titles":{"hebrew":"חשבון מת","english":"Dead Account","romaji":"Dead Account","japanese":"デッドアカウント","synonyms":[],"community":[],"known":["Dead Account","デッドアカウント"]},"synopsis_hebrew":"תמיד מוכן לקרב! הרס לשם ההרס! הסטרימר המקוון אאורינגו הוא טרול, יוצר את התוכן הגרוע ביותר של פרובוקציות ומרוויח מהצופים השונאים. אולי תחשבו שהוא לא יותר מאשר טפיל חברתי, אבל במציאות, הוא תלמיד תיכון שנשר בשם סוג'י אנישירו, אח גדול אכפתי עם חיבה למתוקים שאוהב יותר מכל את אחותו הקטנה. הסרטונים הוויראליים שלו? רק דרך לשלם את חשבונות הרפואה של אחותו. וגם אם כל האנושות שונאת אותו, לא אכפת לו, כל עוד אחותו הקטנה תבריא. אבל אז, משהו מאוד מוזר מתחיל לקרות... אל תפספסו את הבכורה של מנגת הקרב האוקולטית המודרנית הזו!","background_hebrew":"חשבון מת שודרה במסגרת IMAnimation של TV Asahi.","type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2026-01-10","season":{"label":"חורף 2026","year":2026,"season":"winter"},"broadcast":{"label":"שבת 23:30","day":"saturday","time":"23:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Supernatural"],"studios":["SynergySP"],"producers":["TV Asahi","Kodansha","Nippon Columbia","Studio Mausu","Sammy","Crunchyroll","Bushiroad Move"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.67,"mal_scored_by":17602,"israel":null,"israel_scored_by":null,"rank":6976,"popularity":3608,"members":52998,"favorites":132},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1622/154192l.webp"},"trailer":{"youtube_id":"orVDfox9Ggc","url":"https://www.youtube.com/watch?v=orVDfox9Ggc","embed_url":"https://www.youtube.com/embed/orVDfox9Ggc"},"characters":[{"name":"Kasubata, Kukuru","role":"ראשי","image":"https://cdn.myanimel