{"id":669,"mal_id":669,"anizone_id":669,"url":"https://anizone.co.il/anime/669/Kujibiki-Unbalance","slug":"Kujibiki-Unbalance","titles":{"hebrew":"קוג'יביקי אנבלאנס","english":"Kujibiki Unbalance","romaji":"Kujibiki Unbalance","japanese":"くじびきアンバランス","synonyms":[],"community":[],"known":["Kujibiki Unbalance","くじびきアンバランス"]},"synopsis_hebrew":"צ'יהירו אנומוטו הוא תלמיד שנה א' שהגיע זה עתה לבית ספר חדש בשם תיכון ריקיואין. הוא איבד את הוריו בתאונת דרכים כשהיה בן 10. מאז הוא חי רק עם אחותו הגדולה שינובו. הוא טוב בבישול וניקיון, ועושה את כל עבודות הבית. הוא התאהב בטוקינו ממבט ראשון כשפגש אותה בספריית בית הספר ביום הראשון ללימודים. נערה נוספת בשם ריצוקו, חברה ילדות של צ'יהירו ויושבת ראש מועצת התלמידים, מתאהבת בו מיד לאחר המפגש המחודש הזה שחיכתה לו זמן רב. אך היא לא היחידה שמאוהבת בו. זהו סיפור על קמפיין שנתי בין המועמדים להנהגת מועצת התלמידים הבאה, שנבחרים גם בהגרלה (קוג'יביקי), במטרה לזכות בתפקיד.\n\n(מקור: ANN)","background_hebrew":null,"type":"OVA","episodes":3,"duration_minutes":25,"status":"הסתיים","aired_from":"2004-12-22","season":{"label":"סתיו 2004","year":2004,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Comedy","Romance"],"studios":["Palm Studio"],"producers":["Genco","Lantis","Kids Station","Toshiba Entertainment"],"licensors":["Media Blasters"],"source":null,"rating":null,"scores":{"mal":6.08,"mal_scored_by":5989,"israel":null,"israel_scored_by":null,"rank":10681,"popularity":6556,"members":13721,"favorites":6},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1063/147270l.webp"},"trailer":null,"characters":[{"name":"Kettenkrad, Ritsuko Kübel","role":"משני","image":"https://cdn.myanimelist.net/images/characters/7/83765.webp?s=7422e74bdf969dd936674728b8235a50","voice_actors":[{"name":"Chiba, Saeko","language":"יפנית","im