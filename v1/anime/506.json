{"id":506,"mal_id":506,"anizone_id":506,"url":"https://anizone.co.il/anime/506/Glass-no-Kamen","slug":"Glass-no-Kamen","titles":{"hebrew":"זכוכית המסכה","english":"Glass no Kamen","romaji":"Glass no Kamen","japanese":"ガラスの仮面","synonyms":["Glass Mask"],"community":[],"known":["Glass no Kamen","ガラスの仮面","Glass Mask"]},"synopsis_hebrew":"קיטאג'ימה מאיה, ילדה בת 13 עם כישרון למשחק, התגלתה על ידי השחקנית המתבודדת צוקיקאגה. הסיפור עוקב אחר התבגרותה של מאיה, האימונים האינטנסיביים שלה, התגברות על אתגרים והתפתחותה לשחקנית המובילה של דורה (היא בערך בת 20 עד כה). היריבה הגדולה ביותר של מאיה היא הימקאוה איומי, בתם היפה של זוג קולנוענים מפורסם. הן מתחרות בסופו של דבר על התפקיד הנחשק ביותר - \"האלה הארגמנית\". עלילת משנה חשובה לא פחות היא מערכת היחסים של מאיה עם המפיק הנאה והאכזרי הייאמי מסומי, שהפך בסתר למעריץ מספר אחת שלה, אך אי הבנות ותזמון גרוע הפריעו לרומן שלהם...\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":23,"duration_minutes":24,"status":"הסתיים","aired_from":"1984-04-09","season":{"label":"אביב 1984","year":1984,"season":"spring"},"broadcast":{"label":"שני 19:00","day":"monday","time":"19:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Performing Arts","he":"אמנות במה"},{"en":"Showbiz","he":"תעשיית הבידור"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Drama","Romance"],"studios":["Eiken"],"producers":[],"licensors":["Maiden Japan"],"source":null,"rating":null,"scores":{"mal":7.36,"mal_scored_by":3042,"israel":null,"israel_scored_by":null,"rank":2862,"popularity":7247,"members":10808,"favorites":49},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/6/39571l.webp"},"trailer":null,"characters":[{"name":"Kitajima, Maya","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/2/173385.webp?s=dc83a9e7ab31701d8105eb7ecb2dbf3c","voice_actors":[{"name":"Katsuki, Masako","language":"יפנית","image":"https://cdn.myanimelist.net/