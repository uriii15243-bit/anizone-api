{"id":198,"mal_id":198,"anizone_id":198,"url":"https://anizone.co.il/anime/198/Speed-Grapher","slug":"Speed-Grapher","titles":{"hebrew":"ספיד גרפר","english":"Speed Grapher","romaji":"Speed Grapher","japanese":"スピードグラファー","synonyms":[],"community":[],"known":["Speed Grapher","スピードグラファー"]},"synopsis_hebrew":"עשר שנים לאחר מלחמת הבועה, הפער בין העשירים לעניים בעולם הופך לבולט יותר, ויפן אינה יוצאת דופן. העשירים מחפשים לספק את רצונותיהם ולהפיק הנאה לעצמם, וטוקיו הפכה לעיר כזו כתוצאה מכך. סאיגה, שהיה בעבר צלם מלחמה, עובד עבור היברה גינזה במדינה הקפיטליסטית של טוקיו. הוא חודר למועדון רופונגי, בסיס סודי הממוקם באזור האורות האדומים של העיר, כדי לאסוף מידע עליהם. עם זאת, הוא נתפס בתהליך והובא לפני נערה בשם קאגורה שהייתה בעיצומו של טקס. המגע שלו עם קאגורה מעורר את היכולת המיוחדת שלו: הכוח לגרום לדברים להתפוצץ כשהם מצולמים. כדי לפענח את המסתורין מאחורי מועדון רופונגי וקאגורה, סאיגה מתחיל את הקרב הבודד שלו.","background_hebrew":null,"type":"TV","episodes":24,"duration_minutes":23,"status":"הסתיים","aired_from":"2005-04-08","season":{"label":"אביב 2005","year":2005,"season":"spring"},"broadcast":{"label":"שישי 02:40","day":"friday","time":"02:40","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Mystery","he":"מסתורין"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Gore","he":"גור"},{"en":"Organized Crime","he":"פשע מאורגן"},{"en":"Psychological","he":"פסיכולוגיה"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":null,"genres":["Action","Mystery","Suspense"],"studios":["Gonzo"],"producers":["TV Asahi","Rakuonsha","WAO World","TAP","Future Vision Music"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.3,"mal_scored_by":43927,"israel":6.5,"israel_scored_by":2,"rank":3223,"popularity":2040,"members":129702,"favorites":682},"community_reviews":{"ratings":2,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/13/12343l.webp"},"trailer":{"youtube_id":"gxlu