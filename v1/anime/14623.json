{"id":14623,"mal_id":14623,"anizone_id":14623,"url":"https://anizone.co.il/anime/14623/Do-it-Kororin-Earth-SOS","slug":"Do-it-Kororin-Earth-SOS","titles":{"hebrew":"דו איט קורורין ארץ ס.או.ס","english":"Do it Kororin Earth SOS","romaji":"Chikyuu SOS Sore Ike Kororin","japanese":"地球SOSそれいけコロリン","synonyms":[],"community":[],"known":["Chikyuu SOS Sore Ike Kororin","Do it Kororin Earth SOS","地球SOSそれいけコロリン"]},"synopsis_hebrew":"ג'יאנג הגיע למקום הצפייה בפריחת הדובדבן של המשפחה הישנה. אבל האזור מסביב היה מלא בזבל. הוא יושב שם לאכול ארוחת צהריים בחוסר רצון כשלפתע יצור מוזר נופל מהשמיים!\n\nקורורין הוא שמו. הוא מגיע מכוכב אואזיס ונמצא כאן כדי ללמד את החשיבות של מודעות סביבתית בעזרת כוחות ה-ESP שלו.\n\nג'יאנג, אחותו וקורורין חייבים להילחם בסינדרום, החייזר המרושע שמתכנן את השמדת כדור הארץ. הניסיון להשמדה מתבצע בדרך כלל דרך בעיה סביבתית כלשהי כמו קריעת חור באוזון, שינוי מזג האוויר, שימוש יתר בחשמל, וכדומה.","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":25,"status":"הסתיים","aired_from":"1992-04-08","season":{"label":"אביב 1992","year":1992,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":{"en":"Kids","he":"Kids"},"genres":["Action","Comedy","Sci-Fi"],"studios":["Gallop"],"producers":["NHK","Gakken"],"licensors":[],"source":null,"rating":null,"scores":{"mal":0.0,"mal_scored_by":94,"israel":null,"israel_scored_by":null,"rank":16267,"popularity":19267,"members":491,"favorites":1},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/5/39807l.webp"},"trailer":null,"characters":[{"name":"Kororin","role":"ראשי","image":null,"voice_actors":[{"name":"Koyama, Mami","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/2/76941.jpg?s=e08b668481d9e9fd345ee50529e4f108"}]},{"name":"Eko, Midoriko","role":"משני","image":null,"