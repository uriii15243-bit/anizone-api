{"id":33352,"mal_id":33352,"anizone_id":33352,"url":"https://anizone.co.il/anime/33352/Violet-Evergarden","slug":"Violet-Evergarden","titles":{"hebrew":"ויולט אברגרדן","english":"Violet Evergarden","romaji":"Violet Evergarden","japanese":"ヴァイオレット・エヴァーガーデン","synonyms":[],"community":[],"known":["Violet Evergarden","ヴァイオレット・エヴァーガーデン"]},"synopsis_hebrew":"המלחמה הגדולה הגיעה סוף סוף לסיומה לאחר ארבע שנים ארוכות של סכסוך; היבשת טלסיס, שחולקה לשניים, החלה לאט לאט לפרוח מחדש. בתוך שפיכות הדמים הייתה ויולט אברגרדן, נערה צעירה שגודלה למטרה אחת בלבד - להשמיד את קווי האויב. היא אושפזה ונפצעה בקרב עקוב מדם במהלך השלב האחרון של המלחמה, ונשארה עם מילים בלבד מאדם שהיה היקר לה ביותר, אך ללא הבנה של משמעותן.\n\nבזמן שהיא מחלימה מפצעיה, ויולט מתחילה חיים חדשים בעבודה בשירותי הדואר CH לאחר סכסוך עם משפחת האפוטרופוס החדשה שלה. שם, היא עדה במקרה לעבודתה של \"בובת זיכרון אוטומטית\", כותבות שמתרגמות את מחשבות ורגשות האנשים למילים על נייר. נרגשת מהרעיון, ויולט מתחילה לעבוד כבובת זיכרון אוטומטית, מקצוע שייקח אותה להרפתקה שתשנה את חיי לקוחותיה וייתכן שגם תוביל לגילוי עצמי.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2018-01-11","season":{"label":"חורף 2018","year":2018,"season":"winter"},"broadcast":{"label":"חמישי 00:00","day":"thursday","time":"00:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[],"demographic":null,"genres":["Drama"],"studios":["Kyoto Animation"],"producers":["Lantis","Pony Canyon","Rakuonsha","ABC Animation"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":8.7,"mal_scored_by":1115727,"israel":8.25,"israel_scored_by":8,"rank":68,"popularity":47,"members":2044544,"favorites":70916},"community_reviews":{"ratings":8,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1795/95088l.webp"},"trailer":{"youtube_id":"g5xWqjFglsk","url":"https://www.youtube.com/watch?v=g5xWqjFglsk","embed_url":"https://www.you