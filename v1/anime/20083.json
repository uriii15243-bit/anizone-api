{"id":20083,"mal_id":20083,"anizone_id":20083,"url":"https://anizone.co.il/anime/20083/Doteraman","slug":"Doteraman","titles":{"hebrew":"דוטראמן","english":"Doteraman","romaji":"Doteraman","japanese":"ドテラマン","synonyms":[],"community":[],"known":["Doteraman","ドテラマン"]},"synopsis_hebrew":"בעיירה קטנה בטוקיו חי אדם בגיל העמידה בשם סוזוקי, שמבלה את ימיו בניהול עסק קטן. הוא שואף להפוך לסלבריטי עד כדי כך שיופיע על שער של מגזין פופולרי.\n\nיום אחד הוא מגלה במקרה כניסה מסתורית שמובילה לחלל חייזרי. דרכה הוא מגיע לעולם של גובלינים ומחבר אליהם מכשירי שליטה כדי לגרום להם לפעול לפי פקודתו החופשית. תוך ניצול הזומבים הללו, הוא הופך לשערורייתי ומתחיל לעסוק במעשים רעים. בינתיים, שני תלמידים שנונים, האג'ימה וחברתו מריקו, נתקלים בבלש חייזרי מוזר שמעניק להם תלבושות דוטרמן. כשהם לובשים את התלבושות הללו, הם הופכים לדוטרמן ודוטרפינק עם כוחות על-טבעיים. אז הם מאתגרים את השליט המרושע ומשחררים בהצלחה את הגובלינים המסכנים. הם ממשיכים להילחם למען הצדק, יוצרים התרגשות ובידור מלאי הנאה.\n\nמקור: AniDB","background_hebrew":null,"type":"TV","episodes":20,"duration_minutes":25,"status":"הסתיים","aired_from":"1986-10-14","season":{"label":"סתיו 1986","year":1986,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Comedy","Sci-Fi"],"studios":["Tatsunoko Production"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.84,"mal_scored_by":132,"israel":null,"israel_scored_by":null,"rank":11969,"popularity":17098,"members":720,"favorites":0},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/2/53523l.webp"},"trailer":null,"characters":[{"name":"Doteraman","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/7/216797.webp?s=5c4cfaf582f9ca23c328d19b634b5c16","voice_actors":[{"name":"Tsukase, Noriko","language":"יפנית","image":"https://cdn.myanimelist.net/images