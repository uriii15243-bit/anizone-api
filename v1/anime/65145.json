{"id":65145,"mal_id":65145,"anizone_id":65145,"url":"https://anizone.co.il/anime/65145/The-Remarried-Empress","slug":"The-Remarried-Empress","titles":{"hebrew":"הקיסרית שנישאה מחדש","english":"The Remarried Empress","romaji":"Saikon Shounin wo Youkyuu Shimasu","japanese":"再婚承認を要求します","synonyms":["재혼 황후","Jaehon Hwanghu","재혼 황후, Jaehon Hwanghu"],"community":[],"known":["Saikon Shounin wo Youkyuu Shimasu","The Remarried Empress","再婚承認を要求します","재혼 황후","Jaehon Hwanghu"]},"synopsis_hebrew":"נאבייר אלי טרובי, קיסרית האומה המזרחית, ניצבת בפסגת נשות האצולה בכבוד ובחן. אף שהיא ובעלה, הקיסר סוביישו, אינם קרובים כפי שזוגות אחרים קרובים זה לזה, אמונתם ההדדית נבנתה לאורך שנים של ידידות. אך אז, מתוך רצון למשהו נוסף, הוא מביא פילגש — שפחה לשעבר בשם ראשטה — ואז הכול מתחיל להתפרק.\n\nחודשים לאחר מכן מגיע היום הגורלי; סוביישו מצהיר על כוונתו להתגרש מנאבייר ולהעניק את כסאה לראשטה. אולם, בניגוד לכל הציפיות, נאבייר אינה נדחקת לפינה, והיא מצהירה על כוונתה להינשא לגבר אחר — היינרי — שמראהו האצילי מזעזע את כל הנוכחים בחדר.\n\nמי בדיוק הוא היינרי, וכיצד הגיעה נאבייר להסדר הנישואים החדש הזה? האומה המזרחית ניצבת על סף תהום, ונקרעת לגזרים בידי מזימות, שקרים — ומעל לכול — אהבה.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":null,"type":"TV","episodes":null,"duration_minutes":0,"status":"עדיין לא שודר","aired_from":"2027-01-01","season":{"label":"לא צויין","year":null,"season":null},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[],"demographic":null,"genres":["Drama","Fantasy","Romance"],"studios":["TROYCA"],"producers":["Hayate"],"licensors":[],"source":null,"rating":null,"scores":{"mal":null,"mal_scored_by":null,"israel":null,"israel_scored_by":null,"rank":null,"popularity":12112,"members":2592,"favorites":6},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1778/160467l.webp"},"trailer":{"youtube_id":"