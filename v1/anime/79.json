{"id":79,"mal_id":79,"anizone_id":79,"url":"https://anizone.co.il/anime/79/Shuffle","slug":"Shuffle","titles":{"hebrew":"שאפל!","english":"Shuffle!","romaji":"Shuffle!","japanese":"SHUFFLE! (シャッフル!)","synonyms":[],"community":[],"known":["Shuffle!","SHUFFLE! (シャッフル!)"]},"synopsis_hebrew":"בעידן הנוכחי, אלים ושדים חיים יחד עם בני אדם לאחר שהדלת בין העולמות הללו נפתחה. צוצ'ימי רין הוא תלמיד תיכון רגיל הלומד באקדמיית ורבנה, ומבלה את ימיו בשלווה עם חברתו מילדות קאדה. באופן בלתי צפוי, יום אחד מלך האלים, מלך השדים ומשפחותיהם עוברים לגור ליד רין. מסתבר שבתו של מלך האלים, סיה, ובתו של מלך השדים, נרינה, שתיהן מאוהבות ברין לאחר שפגשו אותו בעבר. יחד עם חברותו השובבה עם תלמידת הכיתה הבוגרת אסה ומפגשו עם פרימולה השקטה אך החמודה, יש לרין הרבה להתמודד עם רגשותיהן של כל אחת מהבנות הללו. מבוסס על משחק הארוגה של נבל.","background_hebrew":null,"type":"TV","episodes":24,"duration_minutes":24,"status":"הסתיים","aired_from":"2005-07-08","season":{"label":"קיץ 2005","year":2005,"season":"summer"},"broadcast":{"label":"שישי 00:30","day":"friday","time":"00:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Harem","he":"הרמון (נשים)"},{"en":"School","he":"בית ספר"},{"en":"Urban Fantasy","he":"פנטזיה אורבנית"}],"demographic":null,"genres":["Comedy","Fantasy","Romance","Ecchi"],"studios":["asread."],"producers":["Xebec","Lantis","Kadokawa Shoten","KlockWorx","Memory-Tech"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.0,"mal_scored_by":140201,"israel":6.0,"israel_scored_by":null,"rank":4961,"popularity":970,"members":296858,"favorites":1522},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1290/133860l.webp"},"trailer":{"youtube_id":"icC2xhab2XE","url":"https://www.youtube.com/watch?v=icC2xhab2XE","embed_url":"https://www.youtube.com/embed/icC2xhab2XE"},"charac