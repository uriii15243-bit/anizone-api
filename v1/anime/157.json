{"id":157,"mal_id":157,"anizone_id":157,"url":"https://anizone.co.il/anime/157/Negima","slug":"Negima","titles":{"hebrew":"נגימה!","english":"Negima!","romaji":"Mahou Sensei Negima!","japanese":"魔法先生 ネギま！","synonyms":["Magister Negi Magi"],"community":[],"known":["Mahou Sensei Negima!","Negima!","魔法先生 ネギま！","Magister Negi Magi Negima!","Negima! le Maître Magicien","Magister Negi Magi"]},"synopsis_hebrew":"נגי ספרינגפילד בן ה-10 הוא קוסם מתלמד, וזקוק רק לעבור מבחן אחד נוסף כדי להפוך לקוסם מאסטר. למרבה הצער, המשימה האחרונה שלו היא מוזרה במיוחד—להפוך למורה לאנגלית בפנימייה לבנות בלבד. מיד כשהוא מגיע, הוא מביך לחלוטין את אחת התלמידות שלו, אסונה קגורזאקה, ומחליף את המורה שהיא אוהבת, מה שגורם לה לשנוא אותו. כדי להחמיר את המצב, אסונה מגלה שנגי הוא קוסם, ומבטיחה לגלות את סודו אלא אם כן הוא יעזור לה. אך למרבה הצער, הנסיבות מכריחות אותם לעבוד יחד כדי לעשות דברים רבים, החל מללחום בקוסמים רעים ועד לעזור לכיתה לעבור את המבחן הסופי שלהם, עם הרבה הומור, קסם ורומנטיקה בדרך.\n\nמקור: ANN, נערך","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":23,"status":"הסתיים","aired_from":"2005-01-06","season":{"label":"חורף 2005","year":2005,"season":"winter"},"broadcast":{"label":"חמישי 01:00","day":"thursday","time":"01:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Harem","he":"הרמון (נשים)"},{"en":"School","he":"בית ספר"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Comedy","Fantasy","Romance","Ecchi"],"studios":["Xebec"],"producers":["Starchild Records"],"licensors":["Funimation","Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":6.92,"mal_scored_by":66640,"israel":8.0,"israel_scored_by":null,"rank":5347,"popularity":1827,"members":150010,"favorites":511},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"h