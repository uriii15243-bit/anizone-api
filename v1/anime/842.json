{"id":842,"mal_id":842,"anizone_id":842,"url":"https://anizone.co.il/anime/842/Ushio-and-Tora","slug":"Ushio-and-Tora","titles":{"hebrew":"אושיו וטורה","english":"Ushio and Tora","romaji":"Ushio to Tora","japanese":"うしおととら","synonyms":["Ushio & Tora"],"community":[],"known":["Ushio to Tora","Ushio and Tora","うしおととら","Ushio & Tora"]},"synopsis_hebrew":"אושיו האוטסקי הוא תלמיד עקשן בחטיבת ביניים ובן של כומר משונה שלא דואג לטענות של אביו למפלצות שלא מהעולם הזה המכונות יוקאי. עם זאת, שהוא נצרך לשמור על המקדש בזמן שאביו יצא לסידורים, המטלות שלו הובילה אותו לגילוי מזעזע – במרתף הוא מוצא יוקאי מאיים משופד על ידי “חנית החיה”.\n\nהחיה הזאת קוראים לה טורה, נודע לשמצה בשל כוחו ההרסני, שמנסה לשכנע את אושיו לשחרר אותו מהחותם שחותם אותו לחמש מאות שנה, אושיו לא מאמין לדבריו ומסרב לשחרר אותו לחופשי. אבל כאשר התפרצות יוקאי פתאומית מאיימת לפגוע בקרובים אליו, לא נשאר לו ברירה אלא לסמוך על טורה, הבטחון היחיד שיש לו זה החנית הישנה אם הוא יצא מכלל שליטה\n\nהאנימה עוקבת אחרי הסיפור של שניהם.","background_hebrew":null,"type":"OVA","episodes":10,"duration_minutes":30,"status":"הסתיים","aired_from":"1992-09-11","season":{"label":"קיץ 1992","year":1992,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Mythology","he":"מיתולוגיה"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Supernatural"],"studios":["Pastel"],"producers":["OB Planning","Toshiba EMI","TOHO","Shogakukan"],"licensors":["ADV Films"],"source":null,"rating":null,"scores":{"mal":7.2,"mal_scored_by":5305,"israel":null,"israel_scored_by":null,"rank":3853,"popularity":6124,"members":16348,"favorites":41},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1582/127097l.webp"},"trailer":null,"characters":[{"name":"Tora","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/12/300057.webp?s=a37d897a3cbb2408d8fb158270ad