{"id":55911,"mal_id":55911,"anizone_id":55911,"url":"https://anizone.co.il/anime/55911/The-Fable","slug":"The-Fable","titles":{"hebrew":"הפאבל","english":"The Fable","romaji":"The Fable","japanese":"ザ・ファブル","synonyms":[],"community":["פבל האגדה"],"known":["The Fable","ザ・ファブル"]},"synopsis_hebrew":"פאבל הוא רוצח מבצעי אגדי שהשלים עבודות רבות עבור מגוון לקוחות. לאחר שסיים את משימתו האחרונה, מספר האנשים שהרג לאחרונה הופך גבוה מדי, ופאבל מצווה על ידי הבוס שלו להוריד פרופיל למשך שנה. הוא מציע כי הצורך להסתגל לחיים כאזרח מן השורה עשוי להוות ניסיון רב ערך לעבודתו העתידית.\n\nפאבל אמור להיות מלווה על ידי האישה שמתפקדת כנהגת שלו, והשניים יקבלו זהויות חדשות כאחים. עם זאת, הבוס שלהם מזהיר אותם ששניהם יעמדו בפני עונש קטלני אם פאבל יהרוג מישהו במהלך החופש שלו. כך מתחילה שנת השבתון המשותפת של אקירה ויוקו סאטו מהעולם התחתון.","background_hebrew":null,"type":"TV","episodes":25,"duration_minutes":22,"status":"הסתיים","aired_from":"2024-04-07","season":{"label":"אביב 2024","year":2024,"season":"spring"},"broadcast":{"label":"ראשון 00:55","day":"sunday","time":"00:55","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Organized Crime","he":"פשע מאורגן"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Comedy","Suspense"],"studios":["Tezuka Productions"],"producers":["VAP","Kodansha","Nippon Television Network","Audio Planning U"],"licensors":[],"source":null,"rating":null,"scores":{"mal":8.15,"mal_scored_by":44511,"israel":10.0,"israel_scored_by":null,"rank":536,"popularity":2191,"members":118868,"favorites":923},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1254/141155l.webp"},"trailer":{"youtube_id":"q9aY2YL6luU","url":"https://www.youtube.com/watch?v=q9aY2YL6luU","embed_url":"https://www.youtube.com/embed/q9aY2YL6luU"},"characters":[{"name":"Satou, Akira","role":"ראשי","image":"https://cdn.myanimelist