{"id":37587,"mal_id":37587,"anizone_id":37587,"url":"https://anizone.co.il/anime/37587/Lapis-ReLiGHTs","slug":"Lapis-ReLiGHTs","titles":{"hebrew":"לאפיס רה:לייטס","english":"Lapis Re:LiGHTs","romaji":"Lapis Re:LiGHTs","japanese":"ラピスリライツ","synonyms":[],"community":[],"known":["Lapis Re:LiGHTs","ラピスリライツ"]},"synopsis_hebrew":"טיארה, נסיכה מממלכת ווללנד, נוסעת לעיר ממקסטל כדי ללמוד באקדמיה יוקרתית לאלו שמתרגלים קסם כמוה. לאחר שהיא עוברת מבחן להוכחת זכאותה, טיארה מתאחדת עם חברתה מילדות רוזטה, שגם היא תלמידה שם. היא מצטרפת ומכירה את קבוצתה של רוזטה: לאבי האתלטית, אשלי האמינה ולינט החובבת ספרים—כולם הופכים במהרה לחבריה הקרובים של טיארה.\n\nבמוסד זה, התלמידים מחולקים לשלוש דרגות על פי ציוני המבחן שלהם: קבוצת נואר היא הגבוהה ביותר, ואחריה רוז' ולפיס. קבוצתה של טיארה מדורגת לפיס, ואם זה לא מספיק, אלו שנכשלים בדרגת לפיס עלולים להיות מסולקים. כשהיא מבינה את המצב הקשה, טיארה מעודדת את כולם להתחיל לקחת את הפעילויות שלהם ברצינות רבה יותר.\n\nבנוסף לכך, יש לטיארה מטרה נוספת להצטיין באקדמיה: להפוך לדומה יותר לאחותה הבכורה, שהיא זמרת מוכשרת מאוד. אך כדי להגיע לבמה שהיא שואפת אליה, היא תצטרך להתגבר על אתגרים רבים, יחד עם חבריה, כשהיא ממשיכה במסע הקסום שלה.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2020-07-04","season":{"label":"קיץ 2020","year":2020,"season":"summer"},"broadcast":{"label":"שבת 22:00","day":"saturday","time":"22:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Idols (Female)","he":"מפורסמת"},{"en":"Music","he":"מוזיקה"},{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Fantasy"],"studios":["Yokohama Animation Lab"],"producers":["Studio Mausu","NBCUniversal Entertainment Japan","Kadokawa","JY Animation","KLab","Legs"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.68,"mal_scored_by":17872,"israel":null,"israel_scored_by":null,"rank":6929,"popularity":3614,"members":52897,"favorites":150}