{"id":2746,"mal_id":2746,"anizone_id":2746,"url":"https://anizone.co.il/anime/2746/Vexille","slug":"Vexille","titles":{"hebrew":"וקסיל","english":"Vexille","romaji":"Vexille: 2077 Nihon Sakoku","japanese":"ベクシル 2077日本鎖国","synonyms":["Vexille: 2077 Nippon Sakoku","Vexille: 2077 Japan National Isolation","Vexille: 2077 Nippon Sakoku, Vexille: 2077 Japan National Isolation"],"community":[],"known":["Vexille: 2077 Nihon Sakoku","Vexille","ベクシル 2077日本鎖国","Vexille 2077","Vexille: 2077 Nippon Sakoku","Vexille: 2077 Japan National Isolation"]},"synopsis_hebrew":"במאה ה-21 האלטרנטיבית, תעשיית הרובוטיקה עוברת תקופה של התקדמות מהירה ברחבי העולם. עד שנת 2050, יפן מבססת את עצמה כמובילה בטכנולוגיה וייצור רובוטים עם תעשיות דאיוה הכבדות. ככל שהטכנולוגיה מתפתחת לכלול שיפורים רובוטיים לגוף האנושי, הטשטוש בין אדם למכונה מעורר שינוי פתאומי בדעת הקהל העולמית. בתגובה, האו\"ם מעביר איסור חד-צדדי על מחקר ופיתוח נוסף בתחום הרובוטיקה בשנת 2067. יפן מתנגדת בתוקף לאיסור זה, אך אינה מצליחה למנוע את העברתו. במחאה, יפן פורשת מהפוליטיקה הבינלאומית ובוחרת במדיניות של בידוד לאומי טכנולוגי מתקדם. בעוד שרק המסחר נמשך, יפן נעלמת מהזירה העולמית.\n\nעשר שנים לאחר מכן, סדרת תקריות מוזרות מובילה את סוכנות המשטרה הטכנולוגית האמריקאית SWORD להאמין שיפן הסתירה פיתוח נרחב של טכנולוגיות אסורות באמצעות רשת RACE. SWORD שולחת יחידת סוכנים מיוחדים לחדור ליפן ולאסוף מודיעין על המדינה. וקסיל, סוכנת ותיקה בקבוצה, חושפת את האמת המחרידה מאחורי עשר שנות הבידוד.","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":109,"status":"הסתיים","aired_from":"2007-08-18","season":{"label":"קיץ 2007","year":2007,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Military","he":"צבאי"}],"demographic":null,"genres":["Action","Sci-Fi"],"studios":["Oxybot"],"producers":["Avex Entertainment","Shochiku","TBS","Yahoo! Japan","Shogakukan","Shogakukan Productions"],"licen