{"id":24833,"mal_id":24833,"anizone_id":24833,"url":"https://anizone.co.il/anime/24833/Assassination-Classroom","slug":"Assassination-Classroom","titles":{"hebrew":"כיתת ההתנקשות ","english":"Assassination Classroom","romaji":"Ansatsu Kyoushitsu","japanese":"暗殺教室","synonyms":[],"community":[],"known":["Ansatsu Kyoushitsu","Assassination Classroom","暗殺教室"]},"synopsis_hebrew":"ביום בהיר אחד הרימו יושבי כדור הארץ את ראשם לשמיים וגילו תופעה מוזרה – כ-70% מהירח המוכר לנו הושמד!\nהאחראי למעשה הקונדס הקטן הזה הוא ככל הנראה יצור מסתורי דמוי תמנון שכנראה החליט שלפוצץ את הירח הוא רעיון נחמד, והוא מתכוון לעשות את אותו הדבר גם לכדור הארץ במרץ הבא. הפתרון המתבקש למשבר הוא לחסל את היצור, אבל מסתבר שיש בעיה קטנה עם התכנית – התמנון נע במהירות של מאך 20 (פי 20 ממהירות הקול).\nכשתושבי כדור הארץ מתחילים לאבד תקווה, היצור החלקלק מציע הצעה מעניינת – הוא מתעקש להיות המורה של כיתת הכשלונות E-3 בחטיבת הביניים היוקרתית קונוגיגאוקה, ובכך לתת לילדים החמודים את ההזדמנות לעשות את מה שכל משאבי הממשלה לא הצליחו – להתנקש בו עד מרץ הקרוב.","background_hebrew":null,"type":"TV","episodes":22,"duration_minutes":23,"status":"הסתיים","aired_from":"2015-01-10","season":{"label":"חורף 2015","year":2015,"season":"winter"},"broadcast":{"label":"שבת 00:55","day":"saturday","time":"00:55","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Comedy"],"studios":["Lerche"],"producers":["Dentsu","Studio Hibari","Fuji TV","DAX Production","BS Fuji","Avex Pictures","Shueisha"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":8.06,"mal_scored_by":1328643,"israel":7.83,"israel_scored_by":12,"rank":665,"popularity":33,"members":2259997,"favorites":31939},"community_reviews":{"ratings":12,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/5/75639l.webp"},"trailer":{"youtube_id":"kgNkGohA20k","url":"https://www