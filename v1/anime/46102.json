{"id":46102,"mal_id":46102,"anizone_id":46102,"url":"https://anizone.co.il/anime/46102/Odd-Taxi","slug":"Odd-Taxi","titles":{"hebrew":"המונית המוזרה","english":"Odd Taxi","romaji":"Odd Taxi","japanese":"オッドタクシー","synonyms":[],"community":[],"known":["Odd Taxi","オッドタクシー"]},"synopsis_hebrew":"אודוקאווה הירושי הוא סוס ים ונהג מונית. הוא גר לבד מאז שהוריו נהרגו בתאונת דרכים.\nבמהלך נסיעותיו הוא מסתבך עם בבון מבוקש, חתול מסתורי שרוצה להרוג אותו, שועל מסוכנות הכשרונות הצעירים ושוטר כלבלב מושחת; חבריו מסתבכים עם גניבת תרופות והונאות של בחורות באינטרנט,\nובנוסף לכל - כולם מחפשים אחר תלמידת תיכון אחת, שעדיין נעדרת.\nאיך כל העניינים קשורים זה לזה? ומה כבר יכול נהג מונית עגלגל אחד לעשות מול עולם הפשע? גלו זאת במונית המוזרה!","background_hebrew":"זוכה בפרס הפנים החדשות בפסטיבל האמנויות המדיה היפני ה-25.","type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2021-04-06","season":{"label":"אביב 2021","year":2021,"season":"spring"},"broadcast":{"label":"שלישי 02:00","day":"tuesday","time":"02:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Award Winning","he":"זוכה פרס"},{"en":"Drama","he":"דרמה"},{"en":"Mystery","he":"מסתורין"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Anthropomorphic","he":"האנשה"},{"en":"Organized Crime","he":"פשע מאורגן"}],"demographic":null,"genres":["Award Winning","Drama","Mystery","Suspense"],"studios":["OLM","P.I.C.S."],"producers":["TV Tokyo","Dentsu","Pony Canyon","AT-X","Crunchyroll","Pony Canyon Enterprises","Mimoid","Yoshimoto Kogyo"],"licensors":[],"source":null,"rating":null,"scores":{"mal":8.62,"mal_scored_by":258757,"israel":6.5,"israel_scored_by":2,"rank":106,"popularity":502,"members":528101,"favorites":9361},"community_reviews":{"ratings":2,"written_reviews":2},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1981/113348l.webp"},"trailer":{"youtube_id":"rS228HesD9g","url":"https://www.youtube.com/watch?v=rS228HesD9g","embed_url":"https://www.youtube.com/emb