{"id":6975,"mal_id":6975,"anizone_id":6975,"url":"https://anizone.co.il/anime/6975/Koros-Big-Day-Out","slug":"Koros-Big-Day-Out","titles":{"hebrew":"היום הגדול של קורו","english":"Koro's Big Day Out","romaji":"Koro no Dai Sanpo","japanese":"コロの大さんぽ","synonyms":["Koro's big walk"],"community":[],"known":["Koro no Dai Sanpo","Koro's Big Day Out","コロの大さんぽ","Koro's big walk"]},"synopsis_hebrew":"זהו סרט קצר באורך של כ-15 דקות, שהוקרן לזמן מוגבל בלבד במוזיאון ג'יבלי. קורו הוא גור כלבים בבעלות ילדה קטנה בעיירה קטנה. יום אחד היא משאירה את שער הכניסה פתוח כשהיא הולכת לבית הספר. קורו מחליק החוצה ומשוטט ברחובות העיירה. הוא נאסף על ידי ילדה שרוכבת על אופניים, אך מחליק שוב במעבר הרכבת. הוא פוגש כלב זקן ידידותי ואת בעליו האדיבים, בעוד בעלת הבית שלו ואביה נוסעים ברחבי העיירה ותולים שלטים של \"אבד\" על עמודי החשמל. בסופו של דבר קורו נרדם מתחת לרכב משלוחים, והנהג נותן לו טרמפ. כשהוא מתקרב הביתה, קורו מריח את השכונה המוכרת וקופץ מתוך המשאית לזרועותיה של בעלת הבית המאושרת שלו.","background_hebrew":null,"type":"Special","episodes":1,"duration_minutes":14,"status":"הסתיים","aired_from":"2001-10-01","season":{"label":"סתיו 2001","year":2001,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"}],"subcategories":[{"en":"Pets","he":"חיות"}],"demographic":null,"genres":["Adventure"],"studios":["Studio Ghibli"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.59,"mal_scored_by":532,"israel":null,"israel_scored_by":null,"rank":7531,"popularity":10724,"members":3774,"favorites":1},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1624/159181l.webp"},"trailer":null,"characters":[{"name":"Koro","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/5/511502.webp?s=ac488265ca2c603209575855a7a3a515","voice_actors":[]},{"name":"Sawako","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/8/511513.webp?s=db7ecab612ef6