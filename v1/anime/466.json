{"id":466,"mal_id":466,"anizone_id":466,"url":"https://anizone.co.il/anime/466/One-Piece-Defeat-the-Pirate-Ganzack","slug":"One-Piece-Defeat-the-Pirate-Ganzack","titles":{"hebrew":"וואן פיס: להביס את הפיראט גאנזאק!","english":"One Piece: Defeat the Pirate Ganzack!","romaji":"One Piece: Taose! Kaizoku Ganzack","japanese":"ワンピース 倒せ！海賊ギャンザック","synonyms":[],"community":[],"known":["One Piece: Taose! Kaizoku Ganzack","One Piece: Defeat the Pirate Ganzack!","ワンピース 倒せ！海賊ギャンザック"]},"synopsis_hebrew":"בזמן שלופי והצוות שלו, זורו ונאמי, רעבים על הסירה הקטנה שלהם, הם מותקפים על ידי מפלצת גדולה. נאמי נלקחת, בעוד שלופי וזורו נסחפים לחוף. שם הם פוגשים ילדה צעירה בשם מדקה ולומדים על ההיסטוריה העצובה של האי. הפיראט הרשע גנזאק לקח את כל הגברים בכפר ושיעבד אותם, כולל אביה של מדקה. כעת על לופי, זורו ומדקה לחדור לבסיס של גנזאק כדי להציל את תושבי הכפר ואת נאמי.\n\n(מקור: ANN)","background_hebrew":"וואן פיס: טאוסה! קאיזוקו גאנזאק הוצג ב-Jump Super Anime Tour בשנת 1998 לצד הפיילוט של האנטר x האנטר.","type":"OVA","episodes":1,"duration_minutes":28,"status":"הסתיים","aired_from":"1998-07-26","season":{"label":"קיץ 1998","year":1998,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Fantasy"],"studios":["Production I.G"],"producers":["Shueisha"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.69,"mal_scored_by":24886,"israel":10.0,"israel_scored_by":null,"rank":6884,"popularity":3875,"members":46926,"favorites":18},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1365/154275l.webp"},"trailer":null,"characters":[{"name":"Monkey D., Luffy","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/9/310307.webp?s=3a27ab33bee665febfba970f24f203ba","voice_actors":