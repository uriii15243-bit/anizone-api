{"id":23273,"mal_id":23273,"anizone_id":23273,"url":"https://anizone.co.il/anime/23273/Your-Lie-in-April","slug":"Your-Lie-in-April","titles":{"hebrew":"השקר שלך באפריל ","english":"Your Lie in April","romaji":"Shigatsu wa Kimi no Uso","japanese":"四月は君の嘘","synonyms":["Kimiuso"],"community":[],"known":["Shigatsu wa Kimi no Uso","Your Lie in April","四月は君の嘘","Shigatsu Wa Kimi No Uso - Sekunden in Moll","Kimiuso"]},"synopsis_hebrew":"ארימה קוסאי, הילד הגאון, מכונה אנושית, פסנתרן אגדי. לאחר שאמו, שהיתה גם המורה שלו, הלכה לעולמה, הוא חווה התמוטטות נפשית וכתוצאה מכך הוא לא מסוגל לשמוע את הצליל של הפסנתר.\nשנתיים חלפו, וקוסאי לא נגע בפסנתר. הוא ממשיך לראות את העולם באופן מונוטוני, בלי שום ברק או צבע, על אף שהיה תמיד עם חבריו, ווטארי וטסובאקי. אך יום אחד, ילדה אחת שינתה את הכל.\nמיאזונו קאורי היא כנרית יפהפיה, משוחררת ומעוררת השראה, והנגינה שלה משקפת את אישיותה. קאורי עוזרת לקוסאי לחזור לעולם המוזיקה ומראה לו את הדרך להחלמה ולקבלה מחדש את עצמו ואת עולם המוזיקה.","background_hebrew":"זוכה בקטגוריית האנימה בפרסי Sugoi Japan® לשנת 2016.","type":"TV","episodes":22,"duration_minutes":22,"status":"הסתיים","aired_from":"2014-10-10","season":{"label":"סתיו 2014","year":2014,"season":"fall"},"broadcast":{"label":"שישי 01:20","day":"friday","time":"01:20","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Love Polygon","he":"אהבה יותר מאישה אחת"},{"en":"Music","he":"מוזיקה"},{"en":"Performing Arts","he":"אמנות במה"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Drama","Romance"],"studios":["A-1 Pictures"],"producers":["Aniplex","Dentsu","Kodansha","Fuji TV","Lawson HMV Entertainment","Kyoraku Industrial Holdings","Kansai TV"],"licensors":["Aniplex of America"],"source":null,"rating":null,"scores":{"mal":8.64,"mal_scored_by":1499333,"israel":8.14,"israel_scored_by":7,"rank":93,"popularity":24,"members":2473637,"favorites":91273},"community_reviews":{"ratings":7,"written_r