{"id":30782,"mal_id":30782,"anizone_id":30782,"url":"https://anizone.co.il/anime/30782/Bikini-Warriors","slug":"Bikini-Warriors","titles":{"hebrew":"ביקיני ווריורס","english":"Bikini Warriors","romaji":"Bikini Warriors","japanese":"ビキニ・ウォリアーズ","synonyms":[],"community":[],"known":["Bikini Warriors","ビキニ・ウォリアーズ"]},"synopsis_hebrew":"כאשר החושך מאיים על העולם, ארבע גיבורות מחזיקות את התקווה היחידה לגאולה—אם הן בכלל יצליחו לצאת מהעיר הראשונה, זאת אומרת. \"לוחמות ביקיני\" עוקב אחר חבורת הרפתקניות יפיפיות בשריון חושפני: לוחמת אמיצה, פלדין מפוזרת, קוסמת ביישנית ואלפית אפלה מפתה. אבל האם אפשר באמת להיות הרפתקנית אם לא יוצאים להרפתקה?\n\nהגיבורות שלנו תמיד חסרות כסף, בלתי נסבלות בגאוותן, ולעיתים קרובות נחותות מול הסכנות שבעולמן. בין בריחה ממבוכים ושוד איכרים, הגיבורות הבלתי סבירות יצטרכו ללמוד לחיות זו עם זו לפני שיוכלו לשרוד קרב מול הרוע האולטימטיבי!","background_hebrew":"פרויקט אנימה טלוויזיוני המבוסס על שיתוף פעולה בין הובי יפן ומגההאוס ליצירת דמויות.","type":"TV","episodes":12,"duration_minutes":4,"status":"הסתיים","aired_from":"2015-07-08","season":{"label":"קיץ 2015","year":2015,"season":"summer"},"broadcast":{"label":"רביעי 01:35","day":"wednesday","time":"01:35","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Parody","he":"פרודיה"}],"demographic":null,"genres":["Comedy","Fantasy","Ecchi"],"studios":["feel.","PRA"],"producers":["Hobby Japan"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":5.14,"mal_scored_by":45706,"israel":1.0,"israel_scored_by":null,"rank":14470,"popularity":2435,"members":102542,"favorites":211},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1670/112160l.webp"},"trailer":{"youtube_id":"QGer2FxObbk","url":"https://www.youtube.com/watch?v=QGer2FxObbk","embed_url":"https://www.youtube.com/embed/QGer2FxObbk"},"characters":[{"name":"Mage","role":"ראשי","image