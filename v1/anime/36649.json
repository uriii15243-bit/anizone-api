{"id":36649,"mal_id":36649,"anizone_id":36649,"url":"https://anizone.co.il/anime/36649/Banana-Fish","slug":"Banana-Fish","titles":{"hebrew":"בננה פיש","english":"Banana Fish","romaji":"Banana Fish","japanese":"BANANA FISH","synonyms":[],"community":[],"known":["Banana Fish","BANANA FISH"]},"synopsis_hebrew":"אשלן ג'ייד קלנריס, הידוע כאש לינקס, היה נער שברח מהרחובות של ניו יורק וגודל על ידי הסנדק הידוע לשמצה של המאפיה, דינו גולזין. כעת, בגיל 17, כשהוא הבוס של כנופיה משלו, אש מתחיל לחקור את ה\"באנה פיש\" המסתורי - אותן שתי מילים שאחיו הגדול, גריפין, מלמל מאז שחזר ממלחמת עיראק. עם זאת, חקירותיו נתקעות כאשר דינו שולח את אנשיו אחרי אש בבר מחתרתי שהוא משתמש בו כמקום מסתור.\n\nבבר, סקיפ, חברו של אש, מציג בפניו את שוניצ'י איבה ועוזרו, אייג'י אוקומורה, שהם צלמים יפנים המדווחים על כנופיות רחוב אמריקאיות. עם זאת, השיחה שלהם נקטעת כאשר שורטר וונג, אחד מבעלי בריתו של אש, מתקשר להזהיר אותו לגבי דינו. במהרה, אנשיו של דינו פורצים לבר, ובכאוס שנוצר חוטפים את סקיפ ואייג'י. כעת, אש חייב למצוא דרך להציל אותם ולהמשיך בחקירתו על באנה פיש, אך האם ההיסטוריה שלו עם המאפיה תמנע ממנו להצליח?\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":"האנימה הוכרזה כחלק מפרויקט ההנצחה לציון 40 שנה לאקימי יושידה באוקטובר 2017.","type":"TV","episodes":24,"duration_minutes":22,"status":"הסתיים","aired_from":"2018-07-06","season":{"label":"קיץ 2018","year":2018,"season":"summer"},"broadcast":{"label":"שישי 00:55","day":"friday","time":"00:55","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Drama","he":"דרמה"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Delinquents","he":"עבריינות"},{"en":"Organized Crime","he":"פשע מאורגן"},{"en":"Psychological","he":"פסיכולוגיה"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Action","Adventure","Drama","Suspense"],"studios":["MAPPA"],"producers":["Aniplex","Dentsu","Movic","Fuji TV","Shogakukan"],"licensors":["Anime Limited"],"source":null,"rating":null,"scores":{"mal":8.45,"mal_scored_by":