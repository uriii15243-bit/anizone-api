{"id":1285,"mal_id":1285,"anizone_id":1285,"url":"https://anizone.co.il/anime/1285/MD-Geist","slug":"MD-Geist","titles":{"hebrew":"מ.ד. גייסט","english":"M.D. Geist","romaji":"Soukihei MD Geist","japanese":"装鬼兵ＭＤガイスト","synonyms":["Most Dangerous Geist"],"community":[],"known":["Soukihei MD Geist","M.D. Geist","装鬼兵ＭＤガイスト","Most Dangerous Geist"]},"synopsis_hebrew":"בעתיד הרחוק, האנושות יישבה כוכבי לכת אחרים ביקום. בעוד שכוכבים רבים חיו בשלום, כוכב הלכת ג'רה נחרב בעשורים של מלחמה. גייסט הוא חייל M.D.S. (החייל המסוכן ביותר), אדם משופר עם יכולות קרב שאין להן תחרות ותשוקה בלתי ניתנת לריסון לקרב. בשל טבעו הבלתי נשלט, גייסט מוקפא קריוגנית וננעל בלוויין. מספר שנים לאחר מכן, הלוויין מתרסק וגייסט מתעורר משנתו כדי להשתתף במלחמה נוספת. הפעם, כדי לעזור לצבא לעצור את המחשב המרכזי של הכוכב מלהפעיל מכשיר יום הדין שיביא להשמדה מוחלטת של כל החיים על ג'רה.\n\nמקור: ANN","background_hebrew":"גרסת הבמאי של Soukihei MD Geist יצאה לאור בשנת 1996 עם פרולוג ואפילוג חדשים באנימציה של סטודיו Zero-G Room.","type":"OVA","episodes":1,"duration_minutes":44,"status":"הסתיים","aired_from":"1986-05-21","season":{"label":"אביב 1986","year":1986,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Gore","he":"גור"},{"en":"Mecha","he":"רובוטים"},{"en":"Military","he":"צבאי"}],"demographic":null,"genres":["Sci-Fi"],"studios":["Zero-G Room","Production Wave"],"producers":["Nippon Columbia"],"licensors":["ADV Films","Central Park Media"],"source":null,"rating":null,"scores":{"mal":5.37,"mal_scored_by":8883,"israel":null,"israel_scored_by":null,"rank":13966,"popularity":5714,"members":19736,"favorites":91},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/21433l.webp"},"trailer":null,"characters":[{"name":"Geist","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/2/55115.webp?s=fd821740be4a41d283952