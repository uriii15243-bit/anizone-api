{"id":44055,"mal_id":44055,"anizone_id":44055,"url":"https://anizone.co.il/anime/44055/Sasaki-and-Miyano","slug":"Sasaki-and-Miyano","titles":{"hebrew":"סאסאקי ומיאנו","english":"Sasaki and Miyano","romaji":"Sasaki to Miyano","japanese":"佐々木と宮野","synonyms":["Sasamiya"],"community":[],"known":["Sasaki to Miyano","Sasaki and Miyano","佐々木と宮野","Sasamiya"]},"synopsis_hebrew":"הצרות של יושיקאזו מיאנו מתחילות ביום קיץ חם אחד כאשר שומיי סאסאקי נכנס לחייו. סאסאקי מציל את חברו לכיתה של מיאנו מקבוצת בריונים, ולאחר מכן, נראה שמיאנו לא מצליח להתנער מהמעמד הגבוה האקסצנטרי שלו. ההערצה השקטה שלו לסאסאקי זורמת בהדרגה למטרד בכל פעם שהעבריין כביכול מסרב לעזוב אותו לנפשו. כל הזמן נקרא על ידי כינויים חמודים ויש להם את הגבולות שלו התעלם, מיאנו תוהה למה סאסאקי רוצה להתקרב אליו. מיאנו הביישן והמבולבל בקלות מסתיר סוד מביך - הוא \"פודנשי\", ילד שאוהב את אהבת הבנים (BL) מאנגה. הדבר האחרון שהוא רוצה זה שתלמידים אחרים יגלו, אבל דרך לשון קלה, הוא מגלה את האמת לסאסאקי. מסוקרן, ססאקי חסר מושג מבקש לשאול ספר לקרוא, אשר הוא נתון באי רצון רב.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2022-01-10","season":{"label":"חורף 2022","year":2022,"season":"winter"},"broadcast":{"label":"שני 00:30","day":"monday","time":"00:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Boys Love","he":"אהבת בנים"}],"subcategories":[{"en":"Otaku Culture","he":"תרבות האוטקו"},{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Boys Love"],"studios":["Studio Deen"],"producers":["Frontier Works","Movic","Nippon Columbia","Sound Team Don Juan","TV Aichi","Kadokawa Media House","U-NEXT","BS NTV","Kadokawa"],"licensors":[],"source":null,"rating":null,"scores":{"mal":8.18,"mal_scored_by":113012,"israel":2.0,"israel_scored_by":null,"rank":498,"popularity":1184,"members":247010,"favorites":5837},"community_reviews":{"ratings":1,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1182/119308l.webp"},"trailer":{"youtube_id":"LaRN