{"id":33489,"mal_id":33489,"anizone_id":33489,"url":"https://anizone.co.il/anime/33489/Little-Witch-Academia","slug":"Little-Witch-Academia","titles":{"hebrew":"האקדמיה למכשפות קטנות","english":"Little Witch Academia","romaji":"Little Witch Academia (TV)","japanese":"リトルウィッチアカデミア","synonyms":[],"community":[],"known":["Little Witch Academia (TV)","Little Witch Academia","リトルウィッチアカデミア","L'école des petites sorcières"]},"synopsis_hebrew":"בעולם בו מתרחשת האנימה מכשפות חיות לצידם של בני אדם,\nובנוסף להתקדמות הטכנולוגית יש בעולם גם קסמים. יש רק בעיה\nאחת, הקסם מתחיל לאט לאט להעלם מהעולם ולהפוך לחסר תועלת.\nקאגארי אטסוקו הייתה רק ילדה קטנה כשראתה את מופע הקסמים של\nהמכשפה שאריוט. מופע זה הדהים אותה עד כדי כך, שהיא החליטה להפוך\nלהיות מכשפה כשהיא תהיה גדולה. וככה הגיעה אטסוקו ללמוד בלונה נובה,\nהאקדמיה המפורסמת למכשפות, למרות שהיא רק נערה רגילה.\nלמרות כל הקשיים בהם היא נתקלת, ולמרות חוסר הכישרון שלה בקסמים,\nאטסוקו לא מוכנה לוותר על חלומה הגדול להיות כמו שאריוט.","background_hebrew":null,"type":"TV","episodes":25,"duration_minutes":24,"status":"הסתיים","aired_from":"2017-01-09","season":{"label":"חורף 2017","year":2017,"season":"winter"},"broadcast":{"label":"שני 00:00","day":"monday","time":"00:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Adventure","Comedy","Fantasy"],"studios":["Trigger"],"producers":["Ultra Super Pictures","TOHO animation","Good Smile Company"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.81,"mal_scored_by":360606,"israel":7.43,"israel_scored_by":7,"rank":1162,"popularity":336,"members":723610,"favorites":8265},"community_reviews":{"ratings":7,"written_reviews":1},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1520/147248l.webp"},"trailer":{"youtube_id":"S3jFdqs4jUQ","url":"https://www.youtube.com/watch?v=S3jFdqs4jUQ","embed_url":"https://www.you