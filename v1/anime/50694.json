{"id":50694,"mal_id":50694,"anizone_id":50694,"url":"https://anizone.co.il/anime/50694/Summer-Pockets","slug":"Summer-Pockets","titles":{"hebrew":"כיסי קיץ","english":"Summer Pockets","romaji":"Summer Pockets","japanese":"Summer Pockets","synonyms":["SumPock"],"community":[],"known":["Summer Pockets","SumPock"]},"synopsis_hebrew":"סאמר פוקטס מתרחש על אי מבודד, כפרי ושליו בים הפנימי סטו, בשם טורישירוג'ימה, שבו מתגוררים כ-2,000 תושבים. הגיבור, היירי טקהארה, גדל בסביבה עירונית, אך לאחר תקרית לא נעימה, הוא משתמש במותה האחרון של סבתו כתירוץ להגיע לאי כדי לטפל במכירת הנכסים שלה.\n\nברגע שהוא מגיע לשם, הוא מכיר ארבע בנות, שהן במרכז הסיפור: שירוהה נארוסה, ששכחה את חופשת הקיץ שלה; או סורקאדו, שרודפת אחרי האגדות של האי; קאמומה קושימה, נערה ממעמד גבוה שמחפשת ספינת פיראטים; וצומוגי ונדרס, נערה צעירה יותר שמנסה למצוא את עצמה.\n\n(מקור: ויקיפדיה דרך VNDB, נערך)","background_hebrew":"כיסי קיץ הוא עיבוד לרומן החזותי בעל אותו השם משנת 2018, שפותח על ידי Key.","type":"TV","episodes":26,"duration_minutes":23,"status":"הסתיים","aired_from":"2025-04-07","season":{"label":"אביב 2025","year":2025,"season":"spring"},"broadcast":{"label":"שני 23:30","day":"monday","time":"23:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[],"demographic":null,"genres":["Drama","Romance"],"studios":["feel."],"producers":["Shogakukan-Shueisha Productions","Mainichi Broadcasting System","Visual Arts","Studio Mausu","Bushiroad","Tokyo MX","BS11","JR East Marketing & Communications","FuRyu","Marui Group"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.4,"mal_scored_by":24266,"israel":null,"israel_scored_by":null,"rank":2700,"popularity":2662,"members":88904,"favorites":761},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1691/148602l.webp"},"trailer":{"youtube_id":"HuOLlioGHa0","url":"https://www.youtube.com/watch?v=HuOLlioGHa0","embed_url":"https://www.youtube.com/embed/HuOLlioGHa0"},"cha