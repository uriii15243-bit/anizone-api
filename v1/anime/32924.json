{"id":32924,"mal_id":32924,"anizone_id":32924,"url":"https://anizone.co.il/anime/32924/Urara-Meirocho","slug":"Urara-Meirocho","titles":{"hebrew":"אורארה מיירוצ'ו","english":"Urara Meirocho","romaji":"Urara Meirochou","japanese":"うらら迷路帖","synonyms":[],"community":[],"known":["Urara Meirochou","Urara Meirocho","うらら迷路帖"]},"synopsis_hebrew":"עיר המבוך היא עיר אגדית המורכבת מעשרה מחוזות, בית למכשפות ונביאות כאחד. במחוז החיצוני ביותר של המבוך הזה, רבות מהנערות הצעירות מתחילות את הכשרתן כדי להצטרף לשורות ה\"אוררה\", קבוצה של נשים הידועות ברחבי העולם ביכולתן לנבא את התשובות לשאלות הקשות ביותר בעולם. צ'יה, נערה פראית שגדלה בין החיות בהרים, מוזמנת לקחת את מקומה הראוי כאוררה מדרגה ראשונה. בהצטרפותה אליהן, היא מקווה לנבא את מיקומה של אמה האבודה מזה זמן רב.\n\nצ'יה במהרה יוצרת שלוש חברות: קון טאצומי החרוצה, המכשפה השואפת קומה יוקימי, ונונו נאצומה השתקנית. חמושות רק בתושייתן ובקשר מעורפל לאלים, הן מתחילות את מסען בדרך האוררה.\n\nנכתב על ידי MAL Rewrite.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2017-01-06","season":{"label":"חורף 2017","year":2017,"season":"winter"},"broadcast":{"label":"שישי 01:58","day":"friday","time":"01:58","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"CGDCT","he":"בנות חמודות"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Comedy","Fantasy"],"studios":["J.C.Staff"],"producers":["TBS","Magic Capsule","Houbunsha","NBCUniversal Entertainment Japan","Nichion"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.11,"mal_scored_by":44033,"israel":null,"israel_scored_by":null,"rank":4379,"popularity":1945,"members":138811,"favorites":429},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/6/84119l.webp"},"trailer":{"youtube_id":"Pigjvmkklyk","url":"https://www.youtube.com/watch?v=Pigjvmkklyk","embed_url":"https://www.youtube.com/embed/Pigjvmkklyk"