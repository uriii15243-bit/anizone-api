{"id":1180,"mal_id":1180,"anizone_id":1180,"url":"https://anizone.co.il/anime/1180/Hyper-Police","slug":"Hyper-Police","titles":{"hebrew":"הייפר פוליס","english":"Hyper Police","romaji":"Hyper Police","japanese":"はいぱーぽりす","synonyms":[],"community":[],"known":["Hyper Police","はいぱーぽりす"]},"synopsis_hebrew":"סאסהארה נאצוקי היא ציידת ראשים ענייה בעולם שבו מפלצות ובני אדם חיים יחד. רוב המקרים שלה כוללים מפלצות המפרות את זכויותיהם של בני האדם, המוגנים על ידי החוק מפני שכניהם החזקים יותר בדרך כלל. בהיותה חצי אדם וחצי חיית-חתול, נאצוקי נעה בין שתי החברות ומנסה להבין ולכבד את שתיהן תוך כדי אכיפת החוק. היא נעזרת באיש זאב בשם בטאנן, שחושש להודות שהוא אוהב אותה; איש זאב נוסף בשם טומי; ושד שועל קיובי בשם סאקורה שיש לה תוכניות משלה—שכוללות לאכול את נאצוקי כדי להשלים את תשעת הזנבות שלה ובכך את כוחותיה הקסומים.\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":25,"duration_minutes":24,"status":"הסתיים","aired_from":"1997-04-04","season":{"label":"אביב 1997","year":1997,"season":"spring"},"broadcast":{"label":"שישי 01:15","day":"friday","time":"01:15","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Action","Comedy","Fantasy","Romance","Sci-Fi"],"studios":["Studio Pierrot"],"producers":["Kadokawa Shoten","Marubeni","Nippon Columbia"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.1,"mal_scored_by":3653,"israel":null,"israel_scored_by":null,"rank":4400,"popularity":6558,"members":13717,"favorites":63},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1401/119360l.webp"},"trailer":null,"characters":[{"name":"Sasahara, Natsuki","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/5/184379.webp?s=978a0990f3a1e1473c351377d51e989a","voice_actors":[{"name":"Miyamura, Yuko","language":"יפנית","image":"https://cdn.myanime