{"id":1123,"mal_id":1123,"anizone_id":1123,"url":"https://anizone.co.il/anime/1123/Beet-the-Vandel-Buster-Excellion","slug":"Beet-the-Vandel-Buster-Excellion","titles":{"hebrew":"ביט הוונדל באסטר אקסליון","english":"Beet the Vandel Buster Excellion","romaji":"Bouken Ou Beet Excellion","japanese":"冒険王ビィト エクセリオン","synonyms":["Adventure King Beet Excellion"],"community":[],"known":["Bouken Ou Beet Excellion","Beet the Vandel Buster Excellion","冒険王ビィト エクセリオン","Adventure King Beet Excellion"]},"synopsis_hebrew":"זהו המאה האפלה והאנשים סובלים תחת שלטונו של השד, ונדל, שמסוגל לשלוט במפלצות. הוונדל באסטרס הם קבוצה של אנשים שצדים את השדים הללו, וביניהם, צוות זנון ידוע כחזקים ביותר ביבשת. נער צעיר בשם ביט חולם להצטרף לצוות זנון. אולם, יום אחד, כתוצאה מטעות של ביט, צוות זנון הובס על ידי השד, בלטוז. חמשת הבאסטרים הגוססים הקריבו את כוח חייהם לתוך חמשת נשקיהם, סייגה. לאחר שהעבירו את נשקיהם לביט, הם נפטרו. שנים חלפו מאז והוונדל באסטר הצעיר, ביט, מתחיל את הרפתקתו לממש את רצון צוות זנון לשים קץ למאה האפלה.","background_hebrew":null,"type":"TV","episodes":25,"duration_minutes":24,"status":"הסתיים","aired_from":"2005-10-06","season":{"label":"סתיו 2005","year":2005,"season":"fall"},"broadcast":{"label":"חמישי 18:30","day":"thursday","time":"18:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Adventure","Fantasy"],"studios":["Toei Animation"],"producers":["TV Tokyo","Dentsu"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.79,"mal_scored_by":3919,"israel":null,"israel_scored_by":null,"rank":6161,"popularity":7862,"members":8836,"favorites":7},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/21570l.webp"},"trailer":null,"characters":[{"name":"Beet","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/4/123155.webp?s=71a949a12df96189b1203bfcbbda625a","voi