{"id":2213,"mal_id":2213,"anizone_id":2213,"url":"https://anizone.co.il/anime/2213/Black-Jack-TV","slug":"Black-Jack-TV","titles":{"hebrew":"בלאק ג'ק (טלוויזיה)","english":"Black Jack (TV)","romaji":"Black Jack (TV)","japanese":"ブラックジャック","synonyms":["Black Jack 2004"],"community":[],"known":["Black Jack (TV)","ブラックジャック","Black Jack","Black Jack 2004"]},"synopsis_hebrew":"בלאק ג'ק הוא רופא \"לא רשום\" עם עבר מעורפל ומסתורי. הוא עובד עם העוזרת הקטנה שלו, פינוקו (שמאוהבת בו עד מעל הראש), ומתמודד עם מקרים רפואיים שאינם ידועים במיוחד, שיכולים להיות מוזרים, מסוכנים או לא ידועים כלל. אבל הוא גאון, ויכול להציל כמעט כל אחד מהמטופלים שלו (כל עוד יש להם את הכסף לכך, כמובן), והוא ידוע לרבים ברחבי העולם, במיוחד לאלו שבתחום הרפואה והמדע. הוא עצמו איש מדע, ולא מאמין בהרבה עד שהוא רואה זאת בעצמו, אך פעמים רבות הוא מופתע מאהבה וטבע שמתגברים על המדע שעליו הוא מבסס את חייו.\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":61,"duration_minutes":25,"status":"הסתיים","aired_from":"2004-10-11","season":{"label":"סתיו 2004","year":2004,"season":"fall"},"broadcast":{"label":"שני 19:00","day":"monday","time":"19:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Medical","he":"רפואה"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Drama"],"studios":["Tezuka Productions"],"producers":["Yomiuri Telecasting"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.63,"mal_scored_by":13838,"israel":null,"israel_scored_by":null,"rank":1686,"popularity":4118,"members":42071,"favorites":236},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1588/133791l.webp"},"trailer":null,"characters":[{"name":"Hazama, Kuroo","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/7/302564.webp?s=d9ccc0fe85b620df1c9bc267ba0e5a4c","voice_actors":[{"name":"Ootsuka, Akio","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/1/58117.jpg?s=8168f341db3e6d45e2f06e8dbe4a1477"