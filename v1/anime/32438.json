{"id":32438,"mal_id":32438,"anizone_id":32438,"url":"https://anizone.co.il/anime/32438/The-Lost-Village","slug":"The-Lost-Village","titles":{"hebrew":"הכפר האבוד","english":"The Lost Village","romaji":"Mayoiga","japanese":"迷家-マヨイガ-","synonyms":[],"community":[],"known":["Mayoiga","The Lost Village","迷家-マヨイガ-","The Lost Village -Mayoiga-"]},"synopsis_hebrew":"שלושים אנשים יוצאים יחד למסע אל מבעד ל\"עולם האמיתי\" - לכפר נאנאקי, מקום בו אנשים יכולים לקיים אורח חיים אוטופי, ללא כל מכשולים… או כך לפחות השמועה מספרת. לכל אחד מהמשתתפים במסע יש את הסיבות שלו לנסיון עזיבת העולם האמיתי, והם מקווים שבכפר האבוד והמסתורי יוכלו למצוא חיים חדשים, שלוים ומלאי הקלה.\nמה יקרה כאשר יגיעו לכפר שמלבד שמועות בודדות לא ידוע עליו דבר? איך תצליח החבורה להשתלב בחיי הכפר? ומהו בדיוק הסוד של כפר נאנאקי שהופך אותו למסתורי כל-כך? כל זאת ועוד תגלו ב\"מאיואיגה\".","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2016-04-01","season":{"label":"אביב 2016","year":2016,"season":"spring"},"broadcast":{"label":"שישי 22:30","day":"friday","time":"22:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Horror","he":"אימה"},{"en":"Mystery","he":"מסתורין"},{"en":"Suspense","he":"מתח"}],"subcategories":[{"en":"Psychological","he":"פסיכולוגיה"},{"en":"Survival","he":"הישרדות"}],"demographic":null,"genres":["Drama","Horror","Mystery","Suspense"],"studios":["Diomedéa"],"producers":["WOWOW","Mainichi Broadcasting System","Pony Canyon","KlockWorx","Studio Mausu","Azumaker","Shogakukan"],"licensors":["Ponycan USA"],"source":null,"rating":null,"scores":{"mal":5.5,"mal_scored_by":114110,"israel":6.0,"israel_scored_by":2,"rank":13529,"popularity":1278,"members":227358,"favorites":317},"community_reviews":{"ratings":2,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/79413l.webp"},"trailer":{"youtube_id":"4o29kFnF0yg","url":"https://www.youtube.com/watch?v=4o29kFnF0yg","embed_url":"https://www.youtube.com/