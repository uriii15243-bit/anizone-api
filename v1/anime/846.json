{"id":846,"mal_id":846,"anizone_id":846,"url":"https://anizone.co.il/anime/846/School-Rumble-2nd-Semester","slug":"School-Rumble-2nd-Semester","titles":{"hebrew":"סקול ראמבל: סמסטר שני","english":"School Rumble: 2nd Semester","romaji":"School Rumble Ni Gakki","japanese":"スクールランブル 二学期","synonyms":[],"community":[],"known":["School Rumble Ni Gakki","School Rumble: 2nd Semester","スクールランブル 二学期","School Rumble Saison 2"]},"synopsis_hebrew":"אנחנו עדיין לא יודעים מה באמת קורה עם התוכנית הזו, מעבר לעובדה שהמוזרויות רק נערמות!\n\nקרי-פינד קראסמה נשאר חסר מודעות לרגשות של טנמה, והארימה עדיין לא הודה ברגשותיו האמיתיים כלפי טנמה. אבל היי, יש לו תירוץ כי הוא עסוק בקריירת הקומיקס שלו וטובע בשלל דד-ליינים! בינתיים, משולשי האהבה ממשיכים להשתנות בזכות קופידונים חובבים וכלות בורחות.\n\nגם כשמוסיפים קצת אהבת סייבורג, ספינה טרופה ופנדה אדום נמלט – ברצינות, זה אפילו לא מתחיל לגרד את פני השטח. אתם מוזמנים לגרד את החזיר, הוא אוהב את זה! ומשהו רועם בפרק הלפני אחרון, לא משנה מה אני אגיד עכשיו.\n\nסקול ראמבל – התוכנית הכי מצחיקה שתראו אי פעם שלא עוסקת בשום דבר שרועם... אי פעם!\n\nמקור: Funimation","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":24,"status":"הסתיים","aired_from":"2006-04-03","season":{"label":"אביב 2006","year":2006,"season":"spring"},"broadcast":{"label":"שני 01:30","day":"monday","time":"01:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Gag Humor","he":"קומדיה הומוריסטית"},{"en":"Love Polygon","he":"אהבה יותר מאישה אחת"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Comedy","Romance"],"studios":["Studio Comet"],"producers":["Sotsu","Marvelous Entertainment"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":7.97,"mal_scored_by":96361,"israel":null,"israel_scored_by":null,"rank":823,"popularity":1629,"members":173943,"favorites":850},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/i