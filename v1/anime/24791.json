{"id":24791,"mal_id":24791,"anizone_id":24791,"url":"https://anizone.co.il/anime/24791/Boku-wa-Ousama","slug":"Boku-wa-Ousama","titles":{"hebrew":"בוקו ואוסאמה","english":"Boku wa Ousama","romaji":"Boku wa Ousama","japanese":"ぼくは王さま","synonyms":[],"community":[],"known":["Boku wa Ousama","ぼくは王さま"]},"synopsis_hebrew":"\"בוקו ואו-סאמה\" הוא סדרה המבוססת על סדרת ספרים מאת טראו טאראמורה ושיזוקו וואקאיאמה. הספר הראשון יצא לאור בשנת 1959 ו-49 כרכים נוספים יצאו בעקבותיו, מה שהפך אותה לאחת מסדרות הספרים הפופולריות ביותר לילדים ביפן.\n\nהספרים והאנימה עוקבים אחר ההרפתקאות המשעשעות של או-סאמה, מלך טיפש, גרגרן, עצלן אך בסך הכל חביב וחמוד מאוד, כשהוא מחפש ביצי פילים (הן מכינות את החביתות הגדולות ביותר, המנה האהובה עליו!), מחביא צעצועים ביער רק כדי למתוח את שלושת יועציו החכמים, או רוכב על האופניים סביב הטירה.","background_hebrew":null,"type":"OVA","episodes":4,"duration_minutes":10,"status":"הסתיים","aired_from":"1996-07-21","season":{"label":"קיץ 1996","year":1996,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[],"subcategories":[],"demographic":{"en":"Kids","he":"Kids"},"genres":[],"studios":["Nippon Animation"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":0.0,"mal_scored_by":63,"israel":null,"israel_scored_by":null,"rank":15959,"popularity":21167,"members":352,"favorites":0},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/63739l.webp"},"trailer":null,"characters":[],"staff":[{"name":"Takagi, Jun","role":"במאי","roles":["במאי"],"image":"https://cdn.myanimelist.net/images/voiceactors/2/84245.jpg?s=41876a45d6b5eed409e0d0bb518ba7e3"}],"external_links":{"myanimelist":"https://myanimelist.net/anime/24791","other":["http://www.toei-video.co.jp/vkids/king/#dvd","https://anidb.net/perl-bin/animedb.pl?show=anime&aid=9696","http://ja.wikipedia.org/wiki/%E3%81%BC%E3%81%8F%E3%81%AF%E7%8E%8B%E3%81%95%E3%81%BE#.E3.82.A2.E3.83.8B.E3.83.A1"]},"attribution":{"so