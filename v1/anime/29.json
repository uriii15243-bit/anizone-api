{"id":29,"mal_id":29,"anizone_id":29,"url":"https://anizone.co.il/anime/29/Zipang","slug":"Zipang","titles":{"hebrew":"זיפאנג","english":"Zipang","romaji":"Zipang","japanese":"ジパング","synonyms":[],"community":[],"known":["Zipang","ジパング"]},"synopsis_hebrew":"גל בזמן משנה את מהלך הקריטי של מלחמת העולם השנייה.\n\nמתוכננים לתרגילים צבאיים שגרתיים, המפקד קאדומאטסו וצוות הספינה החדשה והמודרנית ביותר של יפן, המיראי, מוכנים לבדוק את מערכת האייגיס המתקדמת של הספינה. במקום זאת, הם מוצאים את עצמם מועברים חזרה ל-4 ביוני 1942—תאריך הקרב הקריטי במידוויי, שבו הצי היפני ספג מכה קשה. כאשר קאדומאטסו הנלהב מציל את אחד מקורבנות הקרב, קוסאקה, ממטוס זירו טובע, גורלה של המיראי נחתם. הצוות מתחייב לא לעשות דבר שישנה את העבר עוד יותר. עם זאת, הם נאלצים כעת להילחם בצוללת אמריקאית בקרב שלא היה אמור להתרחש. כך מתחילה שרשרת אירועים שעשויה לשנות לנצח את מהלך ההיסטוריה!\n\nמקור: Geneon Entertainment USA, נערך","background_hebrew":null,"type":"TV","episodes":26,"duration_minutes":24,"status":"הסתיים","aired_from":"2004-10-08","season":{"label":"סתיו 2004","year":2004,"season":"fall"},"broadcast":{"label":"שישי 01:25","day":"friday","time":"01:25","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Historical","he":"היסטורי"},{"en":"Military","he":"צבאי"},{"en":"Time Travel","he":"מסע בזמן"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Drama","Sci-Fi"],"studios":["Studio Deen"],"producers":["Marvelous Entertainment","Animax","Pony Canyon","TBS"],"licensors":["Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":7.54,"mal_scored_by":8656,"israel":null,"israel_scored_by":null,"rank":2081,"popularity":5112,"members":25839,"favorites":214},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/13/75740l.webp"},"trailer":null,"characters":[{"name":"Kusaka, Takumi","role":"ראשי","image":"https://cdn