{"id":624,"mal_id":624,"anizone_id":624,"url":"https://anizone.co.il/anime/624/Mouse","slug":"Mouse","titles":{"hebrew":"עכבר","english":"Mouse","romaji":"Mouse","japanese":"マウス","synonyms":["MØUSE"],"community":[],"known":["Mouse","マウス","MØUSE"]},"synopsis_hebrew":"המורה סוראטה מואון ממשיך את המסורת המשפחתית בת מאות השנים להיות הגנב המאסטר מאוס, שיכול לגנוב כל דבר לאחר שהוא מודיע לרשויות על כוונותיו כך שיוכלו להיות שם אך לא יצליחו לעצור אותו. הוא נעזר בשלוש עוזרות צעירות שמתחזות למורות, ובסגנון האופייני לסאטורו אקהורי, מעדיפות ללבוש בגדים צמודים/חושפניים/בונדג' על גופן השופע, כשהן רודפות אחרי סוראטה הרבה יותר ממה שהוא רודף אחריהן, אם כי הבנות זוכות לתשומת לב מסוימת מהמאסטר שלהן. לא רק שהמאוס נרדף על ידי הבנות והרשויות המקומיות, יש גם חברה סודית להגנת אמנות שמעסיקה את שירותיו של בעל ברית לשעבר של סוראטה, שמנסה לתפוס אותו, וכל זה בפרקים של 15 דקות.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":13,"status":"הסתיים","aired_from":"2003-01-06","season":{"label":"חורף 2003","year":2003,"season":"winter"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Harem","he":"הרמון (נשים)"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Action","Comedy","Ecchi"],"studios":["Studio Deen"],"producers":["Media Factory","Broccoli","Hakusensha"],"licensors":["Media Blasters"],"source":null,"rating":null,"scores":{"mal":5.99,"mal_scored_by":9967,"israel":null,"israel_scored_by":null,"rank":11167,"popularity":5212,"members":24680,"favorites":43},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/5/75507l.webp"},"trailer":null,"characters":[{"name":"Muon, Sorata","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/5/542907.webp?s=08c047b2851b3910c3f60c972698fafc","voice_actors":[{"name":"Yamaguchi, Kappei","language":"יפנית","image":"https://cdn.myanim