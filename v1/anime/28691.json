{"id":28691,"mal_id":28691,"anizone_id":28691,"url":"https://anizone.co.il/anime/28691/A-Story-of-Cigarettes","slug":"A-Story-of-Cigarettes","titles":{"hebrew":"סיפור של סיגריות","english":"A Story of Cigarettes","romaji":"Kemurigusa Monogatari","japanese":"煙り草物語","synonyms":["A Story of Tobacco"],"community":[],"known":["Kemurigusa Monogatari","A Story of Cigarettes","煙り草物語","A Story of Tobacco"]},"synopsis_hebrew":"הסרט העתיק ביותר שנמצא של נובורו אופוג'י שמשלב אנימציה של גזירי נייר עם צילומי לייב אקשן. מול נערה עם תסרוקת יפנית מסורתית, איש קטן על שולחן אומר, \"נשים ירדו מטבק.\" הנערה צוחקת עליו ולוכדת אותו תחת כוס זכוכית. האיש הכועס מעשן סיגריה במקטרת ונושף עשן לעבר הנערה. הנערה לוקחת את הסיגריה מהאיש ומניחה אותה מתחת לספר שלה. כשהאיש מאיים עליה באקדח, הנערה זורקת את הסיגריה לחצר. האיש מתרגז מאוד ומנסה לירות בה, אבל האקדח לא יורה. בסופו של דבר, האיש מתחיל לספר לה על תחילת הטבק.\n\n(מקור: animation.filmarchives.jp)","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":3,"status":"הסתיים","aired_from":"1926-01-01","season":{"label":"לא צויין","year":null,"season":null},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"}],"subcategories":[],"demographic":null,"genres":["Comedy"],"studios":[],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.06,"mal_scored_by":854,"israel":null,"israel_scored_by":null,"rank":14625,"popularity":13734,"members":1611,"favorites":2},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1926/107619l.webp"},"trailer":null,"characters":[],"staff":[{"name":"Oofuji, Noburou","role":"במאי","roles":["במאי"],"image":"https://cdn.myanimelist.net/images/voiceactors/3/72600.jpg?s=1640e23179d0bca9da4bd14ff3faf0d0"}],"external_links":{"myanimelist":"https://myanimelist.net/anime/28691","other":["https://anidb.net/perl-bin/animedb.pl?show=anime&aid=6845"]},"attribution":{"source":"AniZone","source_url":"h