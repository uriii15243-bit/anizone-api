{"id":55866,"mal_id":55866,"anizone_id":55866,"url":"https://anizone.co.il/anime/55866/A-Sign-of-Affection","slug":"A-Sign-of-Affection","titles":{"hebrew":"סימן של חיבה","english":"A Sign of Affection","romaji":"Yubisaki to Renren","japanese":"ゆびさきと恋々","synonyms":[],"community":[],"known":["Yubisaki to Renren","A Sign of Affection","ゆびさきと恋々"]},"synopsis_hebrew":"יוקי איטוזה היא סטודנטית לקוית שמיעה בעולמה שעטוף בשתיקה מאז שנולדה.\nהיא גרה באותו המקום לכל אורך חייה, ולעיתים נדירים מאוד היא מקיימת אינטרקצייה אנושית עם משהו אחר מלבד חברתה הטובה, רין פוג'ישירו.\nיום אחד, במהלך נסיעתה, היא פוגשת את איטסומי נאגי, כסוף השיער בעל הלשון החלקלקה, חבר משותף של רין.\nשלא כמו כולם, איטסומי אינו נרתע מהלקות של יוקי; ויחד עם חוויותיו בחו\"ל, הוא מתחיל לרתק ולגעת בנשמתה.\nלאחר פרידתם, חיבתה אליו מתחיל לגדול.\nעולם חדש ניגלה הן עבור יוקי והן עבור איטסומי כשהם מתחילים ללמוד על חייהם השונים אחד של השניה.","background_hebrew":"יוביסאקי טו רנרן יצא בבלו-ריי בארבעה כרכים מה-26 באפריל 2024 עד ה-26 ביולי 2024.","type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2024-01-06","season":{"label":"חורף 2024","year":2024,"season":"winter"},"broadcast":{"label":"שבת 22:30","day":"saturday","time":"22:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Romance"],"studios":["Ajia-do"],"producers":["Mainichi Broadcasting System","Kodansha","NBCUniversal Entertainment Japan","Tokyo MX","Crunchyroll","TO Books","Myrica Music","NetEase"],"licensors":[],"source":null,"rating":null,"scores":{"mal":8.18,"mal_scored_by":172232,"israel":6.67,"israel_scored_by":3,"rank":503,"popularity":765,"members":369491,"favorites":4868},"community_reviews":{"ratings":3,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1478/140828l.webp"},"trailer":{"youtube_id":"XDGIzU0D_Pg","url":"https://www.youtube.com/watch?v=XDGIzU0D_Pg","emb