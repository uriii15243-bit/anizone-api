{"id":32534,"mal_id":32534,"anizone_id":32534,"url":"https://anizone.co.il/anime/32534/Monkey-King-Hero-Is-Back","slug":"Monkey-King-Hero-Is-Back","titles":{"hebrew":"מלך הקופים: הגיבור חוזר","english":"Monkey King: Hero Is Back","romaji":"Xiyou Ji: Dasheng Guilai","japanese":"西游记之大圣归来","synonyms":["Xiyouji zhi Dasheng Guilai","CUG: King of Heroes","Xiyouji zhi Dasheng Guilai, CUG: King of Heroes"],"community":[],"known":["Xiyou Ji: Dasheng Guilai","Monkey King: Hero Is Back","西游记之大圣归来","Xiyouji zhi Dasheng Guilai","CUG: King of Heroes"]},"synopsis_hebrew":"האגדה מספרת על מלך הקופים הכל-יכול, שלא היה לו מתחרה בקרב, והלך בחופשיות בשמיים, בארץ ובגיהנום.\n\nלאחר שהפר כמה מהחוקים החשובים ביותר שנקבעו על ידי האלים, הוא נכלא בכלוב קרח מתחת להרים, קשור בכוחות היחידים שיכולים לשלוט בו.\n\nללא מלך הקופים הגדול, חושך נופל על סין. בעודו בורח מהמפלצות שתקפו את כפרו, ילד קטן מתחבא בהרים כמקום המפלט היחיד שלו, ומוצא עמוד קרח מוזר הקשור בשרשראות. הוא נוגע בקרח, שובר את הכישוף, ומתחיל את אירועי הסרט \"מלך הקופים: הגיבור חוזר\".","background_hebrew":"זוכה בפרס ההצטיינות בפסטיבל פרסי האנימה של טוקיו (TAAF) 2016.","type":"Movie","episodes":1,"duration_minutes":87,"status":"הסתיים","aired_from":"2015-07-10","season":{"label":"קיץ 2015","year":2015,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Martial Arts","he":"אומנויות לחימה"}],"demographic":null,"genres":["Action","Adventure","Fantasy"],"studios":["October Media","BIGBIGSUN"],"producers":["Bytehoo"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.7,"mal_scored_by":1104,"israel":null,"israel_scored_by":null,"rank":6834,"popularity":11162,"members":3354,"favorites":5},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/78103l.webp"},"trailer":{"youtube_id":"IwM_VTpK8f4"