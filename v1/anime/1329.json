{"id":1329,"mal_id":1329,"anizone_id":1329,"url":"https://anizone.co.il/anime/1329/Rail-of-the-Star-A-True-Story-of-Children","slug":"Rail-of-the-Star-A-True-Story-of-Children","titles":{"hebrew":"מסילת הכוכבים - הסרט","english":"Rail of the Star: A True Story of Children","romaji":"Ohoshi-sama no Rail","japanese":"お星さまのレール","synonyms":["O-Hoshisama no Rail","Ohoshi-sama no Rail","O-Hoshisama no Rail, Ohoshi-sama no Rail"],"community":[],"known":["Ohoshi-sama no Rail","Rail of the Star: A True Story of Children","お星さまのレール","O-Hoshisama no Rail"]},"synopsis_hebrew":"זהו הסיפור האוטוביוגרפי של קוביאשי צ'יטוסה, נערה יפנית צעירה שגדלה בצפון קוריאה הכבושה בידי היפנים. עם התקדמות מלחמת העולם השנייה, צ'יטוסה מתחילה להבין שמשפחתה לא תוכל להימלט מהשפעות הסכסוך. מהאכזבה הפשוטה של אי היכולת לקבל את סוג התרמיל שהיא רוצה לבית הספר, לגיוס של אביה כחייל, המלחמה מתחילה להשפיע על חייה באופן אמיתי מאוד. אבל סוף המלחמה לא אומר סוף לקשיים עבורה. הקוריאנים, שנמאס להם משנים של שלטון יפני ורדיפה, שילבו כוחות עם ממשלה קומוניסטית הנתמכת על ידי סין, ובאופן שיטתי הופכים את החיים לאימה חיה עבור השמאל היפני בצפון קוריאה.","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":75,"status":"הסתיים","aired_from":"1993-07-10","season":{"label":"קיץ 1993","year":1993,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Historical","he":"היסטורי"}],"demographic":null,"genres":["Drama"],"studios":["Madhouse"],"producers":["TV Tokyo"],"licensors":["ADV Films"],"source":null,"rating":null,"scores":{"mal":6.95,"mal_scored_by":1283,"israel":null,"israel_scored_by":null,"rank":5196,"popularity":10189,"members":4444,"favorites":4},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/4/85355l.webp"},"trailer":null,"characters":[{"name":"Kobayashi, Chitose","role":"ראשי","image":null,"voice_actors":[{"name":"Takamori, Yoshino","language":"יפנית","ima