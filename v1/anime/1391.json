{"id":1391,"mal_id":1391,"anizone_id":1391,"url":"https://anizone.co.il/anime/1391/Future-GPX-Cyber-Formula","slug":"Future-GPX-Cyber-Formula","titles":{"hebrew":"פוטור GPX סייבר פורמולה","english":"Future GPX Cyber Formula","romaji":"Future GPX Cyber Formula","japanese":"新世紀GPXサイバーフォーミュラ","synonyms":["Cyber Formula: Shinseiki-GPX"],"community":[],"known":["Future GPX Cyber Formula","新世紀GPXサイバーフォーミュラ","Cyber Formula: Shinseiki-GPX"]},"synopsis_hebrew":"קאזאמי היאטו בן ה-14 הוא הנהג הצעיר ביותר של סייבר פורמולה, גרנד פרי שבו כל רכב מצויד במחשבים המסייעים במרוץ. בעזרת אסורדה, מערכת הניווט הסייברית המתקדמת ביותר, וקבוצת סוגו, היאטו מתחרה כדי להפוך למנצח של הגרנד פרי העשירי של סייבר פורמולה. לאורך הדרך, היאטו יצטרך ללמוד מה באמת אומר להיות נהג מרוצים, ולהבין שניצחון לא מושג רק על ידי נהיגה במכונה הטובה ביותר. בנוסף, קאזאמי יצטרך לזכות בכבודם של נהגי המרוצים הוותיקים, לסכל את אלו שמנסים לגנוב את אסורדה, ולהשתתף במרוצים מחוץ לסייבר פורמולה.\n\n(מקור: ANN)","background_hebrew":"הסדרה זכתה בפרס הגרנד פרי של אנימאג' לאנימה בשנת 1991.","type":"TV","episodes":37,"duration_minutes":24,"status":"הסתיים","aired_from":"1991-03-15","season":{"label":"אביב 1991","year":1991,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Racing","he":"מרוצים"}],"demographic":null,"genres":["Adventure","Sci-Fi"],"studios":["Sunrise"],"producers":[],"licensors":["Bandai Entertainment"],"source":null,"rating":null,"scores":{"mal":7.46,"mal_scored_by":2805,"israel":null,"israel_scored_by":null,"rank":2383,"popularity":7004,"members":11745,"favorites":71},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1653/140355l.webp"},"trailer":{"youtube_id":"ioz9nOThPy4","url":"https://www.youtube.com/watch?v=ioz9nOThPy4","embed_url":"https://www.youtube.com/embed/ioz9nOThPy4"},"characters":[{"name":"Kaga, Joutarou","r