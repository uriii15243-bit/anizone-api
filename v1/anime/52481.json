{"id":52481,"mal_id":52481,"anizone_id":52481,"url":"https://anizone.co.il/anime/52481/Days-with-My-Stepsister","slug":"Days-with-My-Stepsister","titles":{"hebrew":"ימים עם אחותי החורגת","english":"Days with My Stepsister","romaji":"Gimai Seikatsu","japanese":"義妹生活","synonyms":[],"community":[],"known":["Gimai Seikatsu","Days with My Stepsister","義妹生活"]},"synopsis_hebrew":"יוטה אסאמורה מקבל אחות חורגת חדשה לאחר שאביו מתחתן מחדש, סאקי אייסה, שהיא במקרה הבחורה הכי יפה בשכבה. הם מבטיחים זה לזה לא להיות קרובים מדי, לא להיות מנוגדים מדי, ופשוט לשמור על מרחק מעורפל ונוח, לאחר שלמדו ערכים חשובים על מערכות יחסים בין גברים לנשים מהנישואים הקודמים של הוריהם.\n\nסאקי, שעבדה לבד למען משפחתה, לא יודעת איך להסתמך כראוי על אחרים, בעוד שיוטה לא בטוח איך באמת להתייחס אליה. כשהם עומדים על קרקע שווה למדי, השניים הללו לומדים בהדרגה את הנוחות שבחיים משותפים.\n\nמערכת היחסים שלהם מתקדמת מזרים לחברים ככל שהימים חולפים. זהו סיפור שעשוי יום אחד להוביל לאהבה.\n\nמקור: MAL News","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2024-07-04","season":{"label":"קיץ 2024","year":2024,"season":"summer"},"broadcast":{"label":"חמישי 21:00","day":"thursday","time":"21:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Romance","he":"רומנטיקה"}],"subcategories":[],"demographic":null,"genres":["Romance"],"studios":["Studio Deen"],"producers":["Movic","AT-X","Nippon Columbia","Kansai TV","Kadokawa","Pia","100studio","One Cushion"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.3,"mal_scored_by":95678,"israel":null,"israel_scored_by":null,"rank":3184,"popularity":1315,"members":221555,"favorites":1667},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1420/143707l.webp"},"trailer":{"youtube_id":"RRwt3t98bUA","url":"https://www.youtube.com/watch?v=RRwt3t98bUA","embed_url":"https://www.youtube.com/embed/RRwt3t98bUA"},"characters":[{"name":"Ayase, Saki","role":"ראשי","image":"https://cdn.myanimelist.net/i