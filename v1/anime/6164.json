{"id":6164,"mal_id":6164,"anizone_id":6164,"url":"https://anizone.co.il/anime/6164/Sweet-Blue-Flowers","slug":"Sweet-Blue-Flowers","titles":{"hebrew":"פרחי כחול מתוק","english":"Sweet Blue Flowers","romaji":"Aoi Hana","japanese":"青い花","synonyms":["Aoihana","Blue Flower","Aoihana, Blue Flower"],"community":[],"known":["Aoi Hana","Sweet Blue Flowers","青い花","Aoihana","Blue Flower"]},"synopsis_hebrew":"פומי מנג'ומה הביישנית והשקטה ואקירה אוקודאירה הישירה והאכפתית היו חברות הכי טובות בבית הספר היסודי, אך זה השתנה כאשר פומי ומשפחתה עברו דירה. שנים לאחר מכן, פומי חוזרת לעיר הולדתה לאחר שהתקבלה לתיכון הבנות מאטסואוקה. היא סוף סוף מתאחדת עם אקירה, שהולכת ללמוד באקדמיית הבנות פוג'יגאטאני. למרות האיחוד שלהן, הקשר ביניהן אינו כפי שהיה לפני שנים.\n\nברגע שפומי מתחילה ללמוד בבית הספר, התלמידה הפופולרית יאסוקו סוגימוטו שמה לב אליה ומחמיאה לה יותר מכל תלמידה אחרת. לאחר שפנתה לאקירה לעזרה כל כך הרבה פעמים בעבר, פומי חייבת לגלות מי היא כאדם במקום לעמוד בצל של מישהו אחר. עם זאת, זה לא מונע מאקירה לרצות שהחברות שלה עם פומי תהיה כפי שהייתה פעם. האם הבנות יצליחו להתגבר על שלב ההתבגרות בתיכון לפני שזה יפריד ביניהן?\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":11,"duration_minutes":22,"status":"הסתיים","aired_from":"2009-07-02","season":{"label":"קיץ 2009","year":2009,"season":"summer"},"broadcast":{"label":"חמישי 02:08","day":"thursday","time":"02:08","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Girls Love","he":"אהבת בנות"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Drama","Girls Love"],"studios":["J.C.Staff"],"producers":["Fuji TV","Fujipacific Music"],"licensors":["Nozomi Entertainment"],"source":null,"rating":null,"scores":{"mal":7.09,"mal_scored_by":39036,"israel":null,"israel_scored_by":null,"rank":4454,"popularity":2338,"members":108476,"favorites":423},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/3/80255l.webp"},"trailer":{"youtube_id":"MsQgOXM-TxA