{"id":38276,"mal_id":38276,"anizone_id":38276,"url":"https://anizone.co.il/anime/38276/After-School-Dice-Club","slug":"After-School-Dice-Club","titles":{"hebrew":"מועדון הקוביות אחרי בית הספר","english":"After School Dice Club","romaji":"Houkago Saikoro Club","japanese":"放課後さいころ倶楽部","synonyms":["Houkago Saikoro Kurabu"],"community":[],"known":["Houkago Saikoro Club","After School Dice Club","放課後さいころ倶楽部","Houkago Saikoro Kurabu"]},"synopsis_hebrew":"מיקי טאקקסה היא תלמידת תיכון מופנמת שאינה מתחברת עם חברי כיתתה. עם זאת, היא רוצה לדעת מה זה באמת \"כיף\", ומחכה למישהו שיוכל לעזור לה להבין את המשמעות האמיתית שלו. יום אחד אחרי הלימודים, היא פוגשת את חברתה לכיתה, איה טאקאיאשיקי, שלוקחת אותה להרפתקה קטנה. מיקי מגלה פלאים שמעולם לא ראתה קודם, ופותחת דרך לשנות את חייה המופנמים.\n\nבדרכן הביתה, מיקי ואיה רואות את נציגת הכיתה שלהן, מידורי אונו, נכנסת ל\"סאיקורו קלאב\", חנות המתמחה במשחקי לוח. לאחר שניסתה משחק לוח גרמני, מיקי מבינה במהרה את סוג הכיף שחיפשה: לשחק במשחקים שונים אחרי הלימודים יחד עם החברים והמכרים שהיא יוצרת מההנאה החדשה שמצאה.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2019-10-03","season":{"label":"סתיו 2019","year":2019,"season":"fall"},"broadcast":{"label":"חמישי 01:15","day":"thursday","time":"01:15","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"CGDCT","he":"בנות חמודות"},{"en":"School","he":"בית ספר"},{"en":"Strategy Game","he":"משחק אסטרטגיה"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Comedy"],"studios":["LIDENFILMS"],"producers":["Genco","MediaNet","Nippon Columbia","Ai Addiction","Shogakukan","ABC Animation","Happinet","HOBBY BASE Yellow Submarine"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.72,"mal_scored_by":23067,"israel":null,"israel_scored_by":null,"rank":6636,"popularity":3504,"members":55595,"favorites":98},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.ne