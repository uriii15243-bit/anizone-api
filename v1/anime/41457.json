{"id":41457,"mal_id":41457,"anizone_id":41457,"url":"https://anizone.co.il/anime/41457/86-Eighty-Six","slug":"86-Eighty-Six","titles":{"hebrew":"86","english":"86 Eighty-Six","romaji":"86","japanese":"86―エイティシックス―","synonyms":["Eighty Six"],"community":[],"known":["86","86 Eighty-Six","86―エイティシックス―","Eighty Six"]},"synopsis_hebrew":"על פי הרפובליקה של סן מגנוליה, למלחמתם המתמשכת נגד האימפריה הגיאדיאנית אין נפגעים - עם זאת, זוהי רק תעמולה. בעוד שהאלבה הכסופה של שמונים וחמישה המגזרים של הרפובליקה חיה בבטחה מאחורי חומות מגן, אלה של הופעות שונות נכלאו בסיעה סודית שמונים ושישה. הם ידועים בצבא כ-86, ונאלצים להילחם נגד הלגיון האוטונומי של האימפריה תחת פיקודו של \"המפעילים\" הרפובליקני. ולאדילנה מיליזה מוצבת בטייסת חוד החנית כדי להחליף את הנדלר הקודם שלה. מנודה על ידי חבריה על היותה תומכת שמונים ושש, היא ממשיכה להילחם נגד האפליה הלא אנושית שלהם. שיניי נוזן הוא הקפטן של טייסת חוד החנית. ידוע לשמצה בשל היותו הניצול היחיד של כל טייסת בה היה, הוא מתעקש לשאת על כתפיו את שמותיהם ומשאלותיהם של חבריו שנפלו.","background_hebrew":null,"type":"TV","episodes":11,"duration_minutes":23,"status":"הסתיים","aired_from":"2021-04-11","season":{"label":"אביב 2021","year":2021,"season":"spring"},"broadcast":{"label":"ראשון 00:00","day":"sunday","time":"00:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mecha","he":"רובוטים"},{"en":"Military","he":"צבאי"}],"demographic":null,"genres":["Drama","Sci-Fi"],"studios":["A-1 Pictures"],"producers":["Aniplex","Kadokawa","Bandai Spirits"],"licensors":[],"source":null,"rating":null,"scores":{"mal":8.36,"mal_scored_by":534280,"israel":8.5,"israel_scored_by":4,"rank":270,"popularity":192,"members":1019851,"favorites":28956},"community_reviews":{"ratings":4,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1987/117507l.webp"},"trailer":{"youtube_id":"WVegRUOgkPM","url":"https://www.youtube.com/watch?v=WVegRUOgkPM","embed_url":"https://www.yout