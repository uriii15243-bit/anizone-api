{"id":3035,"mal_id":3035,"anizone_id":3035,"url":"https://anizone.co.il/anime/3035/Sonic-Soldier-Borgman","slug":"Sonic-Soldier-Borgman","titles":{"hebrew":"חייל הקול סוניק בורגמן","english":"Sonic Soldier Borgman","romaji":"Chouon Senshi Borgman","japanese":"超音戦士ボーグマン","synonyms":[],"community":[],"known":["Chouon Senshi Borgman","Sonic Soldier Borgman","超音戦士ボーグマン","Borgman"]},"synopsis_hebrew":"סוניק סולג'ר בורגמן הוא מדע בדיוני שמשלב סופר סנטאי עם נון-גאטאי. הסדרה מציגה צוות של שלושה חברים בסגנון סנטאי שנלחמים בארגון הידוע בשם יומה. הצוות כולל שלוש דמויות בצבעי ריינג'ר בסיסיים: ורוד, כחול וירוק. שלושת הדמויות המרכזיות הן צ'אק, ריו ואניס, כאשר ריו הוא המנהיג, וצ'אק ואניס הם מורים בבית ספר ציבורי. לפעמים, התלמידים עוזרים או מפריעים לבורגמן בדרך כלשהי, וחלקם אף מכירים את זהויותיהם הסודיות של הבורגמן. לריו יש אופנוע כחול \"מודרני\" מדבר שיכול לשדרג את עצמו. קוד ההמרה הוא \"בורג. גט און\". לכל חבר בצוות יש תותח אישי בצבע השריון שלו, שמופיע רק כדי לסיים את המפלצת שהם נלחמים בה.","background_hebrew":null,"type":"TV","episodes":35,"duration_minutes":24,"status":"הסתיים","aired_from":"1988-04-13","season":{"label":"אביב 1988","year":1988,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mythology","he":"מיתולוגיה"}],"demographic":null,"genres":["Action","Fantasy","Sci-Fi"],"studios":["Ashi Productions"],"producers":["Yomiko Advertising","TOHO","Nippon Television Network"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.67,"mal_scored_by":796,"israel":null,"israel_scored_by":null,"rank":6974,"popularity":10074,"members":4606,"favorites":7},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/11/23045l.webp"},"trailer":null,"characters":[{"name":"Jead, Dust","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/15/400866.webp?s=98f6