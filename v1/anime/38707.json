{"id":38707,"mal_id":38707,"anizone_id":38707,"url":"https://anizone.co.il/anime/38707/RobiHachi","slug":"RobiHachi","titles":{"hebrew":"רובי האצ'י","english":"RobiHachi","romaji":"RobiHachi","japanese":"ロビハチ","synonyms":[],"community":[],"known":["RobiHachi","ロビハチ"]},"synopsis_hebrew":"מאז שפגשו חייזרים על הירח, הטכנולוגיה של האנושות התפתחה בקפיצות גדולות. חצי מאה לאחר מכן, למרות שרוב האנשים חיים בנוחות, רובי יאדז'י והאצ'י קיטה לא מצליחים למצוא את מקומם בחברה המתקדמת הזו. רובי, אדם שמזלו הרע רודף אותו תמיד, חייב סכומי כסף גדולים לגובי חובות בגלל השקעות כושלות בתוכניות מפוקפקות להתעשרות מהירה, והאצ'י מתקשה להתגבר על השעמום שבחייו השגרתיים.\n\nהשניים מוצאים את עצמם בהרפתקה של חייהם כאשר יאנג, הבוס של גובי החובות, שולח את האצ'י לגבות את הכסף שרובי חייב. במקום לשלם, רובי ממריא לחלל ופונה לאיסקנדר, כוכב לכת שלכאורה מביא אושר לכל מי שמבקר בו. האצ'י, שרואה בכך הזדמנות למעט ריגוש נחוץ, מצטרף לרובי במסע הזה המלא במפגשים עם חייזרים, קרבות רובוטים ענקיים וכל מיני צרות—תוך כדי שהם נמנעים מיאנג ואנשיו שמחפשים אותם נואשות ברחבי היקום.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2019-04-08","season":{"label":"אביב 2019","year":2019,"season":"spring"},"broadcast":{"label":"שני 23:30","day":"monday","time":"23:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Space","he":"חלל"}],"demographic":null,"genres":["Adventure","Comedy","Sci-Fi"],"studios":["Studio Comet"],"producers":["Sotsu","Pony Canyon","Cygames"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.57,"mal_scored_by":11787,"israel":null,"israel_scored_by":null,"rank":7691,"popularity":4398,"members":36619,"favorites":92},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1555/100447l.webp"},"trailer":{"youtube_id":"-TBGQdFgXIg","url":"https://www.youtube.com/watch?v=-T