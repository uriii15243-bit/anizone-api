{"id":54875,"mal_id":54875,"anizone_id":54875,"url":"https://anizone.co.il/anime/54875/My-Heroic-Husband","slug":"My-Heroic-Husband","titles":{"hebrew":"בעלי הגיבורי","english":"My Heroic Husband","romaji":"Zhui Xu","japanese":"赘婿","synonyms":[],"community":[],"known":["Zhui Xu","My Heroic Husband","赘婿"]},"synopsis_hebrew":"האליטה העסקית—יי נינג נסע לשושלת וו בהיסטוריה חלופית, והפך לחתן עם מעמד נמוך—שם משפחה נינג, שם פרטי יי, ושם חיבה ליהנג. מכיוון שיי נינג חלם על אמנויות לחימה מאז ילדותו, הוא פשוט הסתיר את כישוריו העסקיים המוכרים כבר בחיים השניים, ושאף להפוך לדור של גיבורים. באופן בלתי צפוי, המוסר של העולם אינו פשוט כפי שחשב. לאחר שהפך לנינג יי, לא רק שהוא היה מעורב במקרים חשובים בבית המשפט, אלא שמשפחת סו שאליה הצטרף גם הייתה מאוימת על ידי אויבים חזקים...\n\nמקור: ביליבילי, תורגם על ידי גוגל וערוך.","background_hebrew":null,"type":"ONA","episodes":12,"duration_minutes":26,"status":"הסתיים","aired_from":"2023-04-23","season":{"label":"אביב 2023","year":2023,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Martial Arts","he":"אומנויות לחימה"}],"demographic":null,"genres":["Action","Comedy"],"studios":["Oriental Creative Color"],"producers":["bilibili"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.35,"mal_scored_by":639,"israel":null,"israel_scored_by":null,"rank":2965,"popularity":13112,"members":1925,"favorites":8},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1657/153549l.webp"},"trailer":{"youtube_id":"2QR9gBgjihQ","url":"https://www.youtube.com/watch?v=2QR9gBgjihQ","embed_url":"https://www.youtube.com/embed/2QR9gBgjihQ"},"characters":[{"name":"Ning, Yi","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/11/614373.webp?s=7571c9ce7e517c17f05345cc5f437179","voice_actors":[]},{"name":"Su, Taner","role":"ראשי","image