{"id":5162,"mal_id":5162,"anizone_id":5162,"url":"https://anizone.co.il/anime/5162/Minami-ke-Okaeri","slug":"Minami-ke-Okaeri","titles":{"hebrew":"מינאמי-קה אוקאירי","english":"Minami-ke Okaeri","romaji":"Minami-ke Okaeri","japanese":"みなみけ おかえり","synonyms":[],"community":[],"known":["Minami-ke Okaeri","みなみけ おかえり"]},"synopsis_hebrew":"שנה עברה מאז שאוקווארי ושלוש האחיות גדלו. ההעדפות והמצבי רוח שלהן כמעט ולא השתנו. הארוקה, האחות הבכורה, היא כמו אם אוהבת לאחיות הצעירות ומקפידה על משמעת. קאנה, האמצעית, משאירה הכל לרגע האחרון ותמיד גורמת לצרות לשלישייה. צ'יאקי, הקטנה, היא המחושבת והמניפולטיבית; היא אוהבת להיות מוערצת ואהובה על ידי הארוקה ותמיד גורמת לצרות לקאנה הפחות מבורכת. למרות שהן משפחה לא מאוזנת, הן אוהבות אחת את השנייה מכל הלב. חיי היומיום של המשפחה מצחיקים כתמיד; צרות ואהבה תמיד נוכחות. עכשיו הגיע הזמן לראות אם הן ישרדו את שינוי הגיל הזה, שכן הארוקה היא כעת צעירה בוגרת; יש לה אפילו יותר אחריות, כשהיא צריכה להשגיח על הצעירות תוך כדי השתלבות בחיים הבוגרים.\n\nמקור: ANN","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":24,"status":"הסתיים","aired_from":"2009-01-05","season":{"label":"חורף 2009","year":2009,"season":"winter"},"broadcast":{"label":"שני 01:30","day":"monday","time":"01:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"}],"subcategories":[{"en":"CGDCT","he":"בנות חמודות"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Comedy"],"studios":["asread."],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.55,"mal_scored_by":37052,"israel":7.0,"israel_scored_by":null,"rank":2013,"popularity":3047,"members":71331,"favorites":56},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/10/11458l.webp"},"trailer":{"youtube_id":"2iZa79sclmo","url":"https://www.youtube.com/watch?v=2iZa79sclmo","embed_url":"https://www.youtube.com/embed/2iZa79sclmo"},"characters":[{"name":"Minami, Kana","role":"ראשי","im