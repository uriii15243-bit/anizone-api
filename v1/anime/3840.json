{"id":3840,"mal_id":3840,"anizone_id":3840,"url":"https://anizone.co.il/anime/3840/Glass-Maiden","slug":"Glass-Maiden","titles":{"hebrew":"מיידן מזכוכית","english":"Glass Maiden","romaji":"Crystal Blaze","japanese":"クリスタル ブレイズ","synonyms":[],"community":[],"known":["Crystal Blaze","Glass Maiden","クリスタル ブレイズ"]},"synopsis_hebrew":"רגס טאון היא המזבלה של יפן. המקום אליו אנשים שרוצים לשכוח את עברם בורחים. בעיירה הזו, שבה החוקים אוסרים בתוקף לשאול על העבר או להכיר אנשים, ישנה סוכנות בילוש קטנה בשם S&A דטקטיבס.\n\nהסיפור מתמקד באיאמנה, הצמד הבלתי נפרד של בלשים חובבים, בתיק שמאנאמי לוקחת על עצמה מתוך דחף, ובצרות שנובעות מכך. במהלך החקירה הם מוצאים אישה שהיא חמה בצורה חריגה, ונרדפת על ידי חבורת נשים חמושות. לאחר שמכנים אותה בשם סארה, הבלשים מנסים להבין מה בדיוק קורה איתה. במקביל, בכל רחבי העיירה נערות מתבגרות מתחממות והופכות לזכוכית. הממשלה מסתירה את הכל, אבל הבלשים, כמו גם עיתונאי חטטן והמשטרה המקומית, נחושים לגלות מה מתרחש.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":24,"status":"הסתיים","aired_from":"2008-04-09","season":{"label":"אביב 2008","year":2008,"season":"spring"},"broadcast":{"label":"רביעי 01:15","day":"wednesday","time":"01:15","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Mystery","he":"מסתורין"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Detective","he":"בלשות"}],"demographic":null,"genres":["Action","Mystery","Sci-Fi"],"studios":["Studio Fantasia"],"producers":["Happinet Pictures","BIGLOBE"],"licensors":["Maiden Japan"],"source":null,"rating":null,"scores":{"mal":6.12,"mal_scored_by":5646,"israel":null,"israel_scored_by":null,"rank":10430,"popularity":5943,"members":17856,"favorites":13},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/12/21159l.webp"},"trailer":null,"characters":[{"name":"Ayaka","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/5/57768.webp?s=c40201b3ab59735b31bb793d1e3f3d48","voice_actors":[{"name":"Takahashi,