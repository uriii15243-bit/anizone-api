{"id":36726,"mal_id":36726,"anizone_id":36726,"url":"https://anizone.co.il/anime/36726/Yuuna-and-the-Haunted-Hot-Springs","slug":"Yuuna-and-the-Haunted-Hot-Springs","titles":{"hebrew":"יונה-סאן מאחוזת יוראגי","english":"Yuuna and the Haunted Hot Springs","romaji":"Yuragi-sou no Yuuna-san","japanese":"ゆらぎ荘の幽奈さん","synonyms":["Yuuna of Yuragi Manor"],"community":[],"known":["Yuragi-sou no Yuuna-san","Yuuna and the Haunted Hot Springs","ゆらぎ荘の幽奈さん","Yuuna of Yuragi Manor"]},"synopsis_hebrew":"פויוזורה קוגראשי הוא נער עני, הומלס, ששואף לחיות חיי תיכון נורמלים. בנוסף, לקוגראשי יש את היכולת לראות רוחות, והוא יודע זאת עקב הרוחות שרודפות אותו מאז ילדותו. בעודו מחפש בית להתגורר בו, הוא נתקל בבית-הבראה זול המאוכלס בנערות יפות, שהיה ידוע בעבר במעיינות החמים שלו. קוגראשי מחליט להשאר שם לזמן מה, אך ישנה בעיה – בחדרו מתגוררת רוח של נערה בת 16 בשם יונה. קוגראשי מחליט לעזור לה לפתור את העניינים הלא-גמורים שלה בעולם החיים, שאותם היא לא זוכרת כלל, על-מנת שתוכל לעבור לעולם הבא בצורה טובה כמה שיותר.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2018-07-14","season":{"label":"קיץ 2018","year":2018,"season":"summer"},"broadcast":{"label":"שבת 23:30","day":"saturday","time":"23:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Supernatural","he":"על טבעי"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Harem","he":"הרמון (נשים)"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Comedy","Romance","Supernatural","Ecchi"],"studios":["Xebec"],"producers":["Aniplex","Shueisha","BS11"],"licensors":["Aniplex of America"],"source":null,"rating":null,"scores":{"mal":6.96,"mal_scored_by":138511,"israel":null,"israel_scored_by":null,"rank":5169,"popularity":872,"members":332537,"favorites":844},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1462/98802l.webp"},"trailer":{"youtube_id":"OfzdwmG3Vks","url":"https://www.youtube.com/