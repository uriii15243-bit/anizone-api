{"id":344,"mal_id":344,"anizone_id":344,"url":"https://anizone.co.il/anime/344/Twin-Spica","slug":"Twin-Spica","titles":{"hebrew":"טווין ספיקה","english":"Twin Spica","romaji":"Futatsu no Spica","japanese":"ふたつのスピカ","synonyms":[],"community":[],"known":["Futatsu no Spica","Twin Spica","ふたつのスピカ"]},"synopsis_hebrew":"כשהייתה קאמוגאווה אסומי תינוקת, אמה נפצעה קשה כאשר רקטה התרסקה על הקרקע. חמש שנים לאחר מכן, לאחר שהייתה בתרדמת כל הזמן הזה, אמה של אסומי נפטרה, והילדה הקטנה נאבקת להשלים עם מותה של אם שהיא כמעט ולא זוכרת. בעיצומו של המאבק שלה, היא פוגשת את \"ליון-סאן\", דמות מוזרה הלובשת מסכת אריה וטוענת להיות רוח רפאים. ליון-סאן עוזר לאסומי לקבור את אפר אמה, ולבסוף, אסומי מגיעה להחלטה משלה: \"כשאגדל, אני אהיה טייסת רקטות.\"\n\n(מקור: ANN)","background_hebrew":null,"type":"TV","episodes":20,"duration_minutes":25,"status":"הסתיים","aired_from":"2003-11-01","season":{"label":"סתיו 2003","year":2003,"season":"fall"},"broadcast":{"label":"שבת 09:00","day":"saturday","time":"09:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"},{"en":"Sci-Fi","he":"מדע בדיוני"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Drama","Sci-Fi","Supernatural"],"studios":["Group TAC"],"producers":["NHK"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.44,"mal_scored_by":4305,"israel":null,"israel_scored_by":null,"rank":2495,"popularity":6933,"members":12034,"favorites":77},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/12/73986l.webp"},"trailer":null,"characters":[{"name":"Kamogawa, Asumi","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/12/345845.webp?s=c9c398675dd2ec62d1474146e579016f","voice_actors":[{"name":"Uechi, Aki","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/1/33521.jpg?s=f91f0b5f04823cdb4e8b7cb731d7c8a7"}]},{"name":"Lion-san","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/15/