{"id":32979,"mal_id":32979,"anizone_id":32979,"url":"https://anizone.co.il/anime/32979/Flip-Flappers","slug":"Flip-Flappers","titles":{"hebrew":"פליפ פלאפרס","english":"Flip Flappers","romaji":"Flip Flappers","japanese":"フリップフラッパーズ","synonyms":[],"community":[],"known":["Flip Flappers","フリップフラッパーズ"]},"synopsis_hebrew":"קוקונה היא תלמידת חטיבת ביניים ממוצעת שחיה עם סבתה. היא עדיין לא החליטה על מטרה לשאוף אליה, וכך היא פוגשת נערה מוזרה בשם פפיקה שמזמינה אותה לארגון בשם פליפ פלאפ.\n\nנגררת על ידי הזרה האנרגטית, קוקונה מוצאת את עצמה בעולם של אשליה טהורה—ממד חלופי מוזר—שם היא עוזרת לפפיקה לחפש רסיסי קריסטל. לאחר שהן משלימות את משימתן, פפיקה וקוקונה נשלחות לעוד עולם באשליה טהורה. כאשר יצור מסוכן תוקף אותן, הבנות משתמשות בקריסטלים שלהן כדי להפוך לבנות קסם: קוקונה הופכת ל-Pure Blade ופפיקה ל-Pure Barrier. אך כאשר הן מנסות להביס את היצור שמולן, שלושה אחרים עם כוחות מארגון יריב נכנסים לקרב ומחסלים את היצור, לוקחים איתם רסיס שנשאר מגופו. לאחר מכן, הבנות מבינות שכדי לעמוד מול יריביהן והיצורים באשליה טהורה, הן חייבות ללמוד לעבוד יחד ולסנכרן את רגשותיהן כדי להפוך בצורה יעילה יותר.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2016-10-06","season":{"label":"סתיו 2016","year":2016,"season":"fall"},"broadcast":{"label":"חמישי 21:00","day":"thursday","time":"21:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mahou Shoujo","he":"ילדות קסומות"}],"demographic":null,"genres":["Adventure","Comedy","Sci-Fi"],"studios":["Studio 3Hz"],"producers":["Sotsu","Lantis","AT-X","GAGA","Happinet Pictures","BS Fuji","Tokyo MX","Hakuhodo DY Music & Pictures","Medicos Entertainment","Infinite","Ray"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.62,"mal_scored_by":76407,"israel":null,"israel_scored_by":null,"rank":1724,"popularity":1392,"members":207192,"favorites":2224},"c