{"id":31610,"mal_id":31610,"anizone_id":31610,"url":"https://anizone.co.il/anime/31610/RIN-NE-Season-2","slug":"RIN-NE-Season-2","titles":{"hebrew":"רין-נה עונה 2","english":"RIN-NE Season 2","romaji":"Kyoukai no Rinne 2nd Season","japanese":"境界のRINNE","synonyms":[],"community":[],"known":["Kyoukai no Rinne 2nd Season","RIN-NE Season 2","境界のRINNE","RIN-NE Staffel 2","RIN-NE: Temporada 2","RIN-NE Saison 2"]},"synopsis_hebrew":"תלמידת התיכון סאקורה מאמיה ואל המוות העני ריננה רוקודו ממשיכים להתמודד עם העל-טבעי. נמשכים לבעיות של מכריהם המוזרים, השניים שוב מוצאים את עצמם שקועים בצרות.\n\nהחתול השחור של אגאהה, אובורו, מחפש נקמה על התעללות לכאורה ודורש מאגאהה לבטל את החוזה ביניהם. כשהיא מסרבת לעשות זאת, פורץ ביניהם ריב מר. בינתיים, חברת דמאשיגאמי הערמומית לא מראה סימנים של עצירה במעשיה הרעים, והשד דמוי העטלף מסאטו ממשיך לבצע מעשים ערמומיים כדי לרדוף את נקמתו המיוחלת בריננה.\n\nעבור סאקורה וריננה, הסיבוכים העל-טבעיים הללו לעולם לא נראים כנגמרים. ככל שהסאגה שלהם ממשיכה להתפתח, הם חייבים להתמודד עם הנסיבות המוזרות הללו כשהן מופיעות, וכל זאת תוך כדי התמודדות עם בעיותיהם האישיות.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":25,"duration_minutes":24,"status":"הסתיים","aired_from":"2016-04-09","season":{"label":"אביב 2016","year":2016,"season":"spring"},"broadcast":{"label":"שבת 17:30","day":"saturday","time":"17:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Mythology","he":"מיתולוגיה"},{"en":"School","he":"בית ספר"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Comedy","Supernatural"],"studios":["Brain's Base"],"producers":["Shogakukan-Shueisha Productions","NHK","Shogakukan"],"licensors":["Sentai Filmworks"],"source":null,"rating":null,"scores":{"mal":7.15,"mal_scored_by":14499,"israel":null,"israel_scored_by":null,"rank":4128,"popularity":4373,"members":37120,"favorites":35},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/ani