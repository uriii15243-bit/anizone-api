{"id":173,"mal_id":173,"anizone_id":173,"url":"https://anizone.co.il/anime/173/Tactics","slug":"Tactics","titles":{"hebrew":"טקטיקות","english":"Tactics","romaji":"Tactics","japanese":"タクティクス","synonyms":[],"community":[],"known":["Tactics","タクティクス"]},"synopsis_hebrew":"איצ'ינומיה קנטארו גדל עם היכולת לראות שדים, אך היה מבודד וסבל מבריונות מצד אחרים שלא חלקו את אותה מתנה. במקום זאת, הוא הפך לחבר של השדים, ופיתח קשר חזק לקיומם. יום אחד, קנטארו שמע על השד החזק ביותר, זה הידוע כטנגו האוכל שדים. נדהם מהחדשות על כוחו, קנטארו נשבע למצוא את השד הזה שהיה חזק יותר מכל אחד אחר, והחליט לקרוא לו הארוקה כאשר ימצא אותו. מאז, קנטארו חיפש בכל מקום את טנגו האוכל שדים ללא הצלחה, והתפרנס בכך שהפך לסופר פולקלור ולצייד שדים. בעבודה מסוימת, קנטארו סוף סוף מצא חדשות על מקדש קרוב שלכאורה היה המקום שבו טנגו האוכל שדים היה חותם.","background_hebrew":null,"type":"TV","episodes":25,"duration_minutes":24,"status":"הסתיים","aired_from":"2004-10-06","season":{"label":"סתיו 2004","year":2004,"season":"fall"},"broadcast":{"label":"רביעי 01:30","day":"wednesday","time":"01:30","timezone":"Asia/Jerusalem"},"categories":[{"en":"Mystery","he":"מסתורין"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Mythology","he":"מיתולוגיה"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Mystery","Supernatural"],"studios":["Studio Deen"],"producers":["MediaNet"],"licensors":["Manga Entertainment"],"source":null,"rating":null,"scores":{"mal":7.2,"mal_scored_by":14823,"israel":null,"israel_scored_by":null,"rank":3846,"popularity":4029,"members":43816,"favorites":172},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/8/37549l.webp"},"trailer":{"youtube_id":"yHPRax5FhlI","url":"https://www.youtube.com/watch?v=yHPRax5FhlI","embed_url":"https://www.youtube.com/embed/yHPRax5FhlI"},"characters":[{"name":"Ichinomiya, Kantarou","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/12/55504.webp?s=0c07c07a813bcec6e223e41