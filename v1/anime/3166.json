{"id":3166,"mal_id":3166,"anizone_id":3166,"url":"https://anizone.co.il/anime/3166/Ayakashi","slug":"Ayakashi","titles":{"hebrew":"איאקאשי","english":"Ayakashi","romaji":"Ayakashi","japanese":"アヤカシ","synonyms":[],"community":[],"known":["Ayakashi","アヤカシ"]},"synopsis_hebrew":"כילד, יו קוסאקה נשבע על כוכב נופל שהוא יעמוד בצד הצדק ויגן על החלשים. עם זאת, מותו של אחד מחבריו גוזל ממנו את הרצון לקיים את השבועה הזו, והוא עוצם עין לסבלם של אחרים, תוך שהוא משתמש בכוח המסתורי שיש לו כאמצעי להרוויח כסף במקום לעזור לנזקקים. ימיו של חיים רק למען עצמו נמשכים, עד שהוא נאלץ להילחם על חייו מול תלמיד אחר עם כוחות דומים לשלו. הוא ניצל על ידי נערה מסתורית בשם איימו יואקה, שגם לה יש כוחות מוזרים.\n\nאיימו מגלה שכוחותיו נובעים מיצור הידוע כאיאקאשי, ישות טפילית שמעניקה למשתמש יכולות מיוחדות במחיר של שאיבת החיים מהמאחסן. היא עוזרת לו להעיר את כוחותיו במלואם. כעת, כשהוא מודע לאיאקאשי שהוא מחזיק, יו חייב לעמוד בשבועת ילדותו, להשתמש באיאקאשי שלו ולהדוף את אלו שישתמשו בכוחותיהם לרעה, תוך כדי שהוא פותר את המסתורין מאחורי מותו של חברו.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2007-12-12","season":{"label":"חורף 2008","year":2008,"season":"winter"},"broadcast":{"label":"רביעי 11:00","day":"wednesday","time":"11:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Horror","he":"אימה"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Gore","he":"גור"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":null,"genres":["Action","Fantasy","Horror","Sci-Fi"],"studios":["Tokyo Kids"],"producers":["Media Factory","AT-X","Enoki Films","5pb."],"licensors":["Discotek Media"],"source":null,"rating":null,"scores":{"mal":6.31,"mal_scored_by":12940,"israel":null,"israel_scored_by":null,"rank":9308,"popularity":4745,"members":31045,"favorites":25},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/5/20942l.webp"},"trailer":{"youtube_id":"A2