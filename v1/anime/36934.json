{"id":36934,"mal_id":36934,"anizone_id":36934,"url":"https://anizone.co.il/anime/36934/Captain-Tsubasa-2018","slug":"Captain-Tsubasa-2018","titles":{"hebrew":"קפטן טסובאסה (2018)","english":"Captain Tsubasa (2018)","romaji":"Captain Tsubasa (2018)","japanese":"キャプテン翼","synonyms":[],"community":[],"known":["Captain Tsubasa (2018)","キャプテン翼","Captain Tsubasa"]},"synopsis_hebrew":"קפטן טסובאסה הוא סיפור מרגש על תלמיד בית ספר יסודי שמחשבותיו וחלומותיו סובבים כמעט לחלוטין סביב אהבת הכדורגל. טסובאסה אוזורה בן ה-11 התחיל לשחק כדורגל בגיל צעיר מאוד, ובעוד שזה היה בעיקר ספורט פנאי עבור חבריו, עבורו זה התפתח למעין אובססיה.\n\nכדי לרדוף אחרי חלומו במלוא יכולותיו של תלמיד בית ספר יסודי, טסובאסה עובר עם אמו לעיר ננקאטסו, הידועה בקבוצות הכדורגל המצוינות של בתי הספר היסודיים שלה. אך למרות שהיה בקלות הטוב ביותר בעיירתו הישנה, בננקאטסו יש הרבה יותר תחרות, והוא יזדקק לכל כישוריו וכשרונו כדי להתבלט בקהל החדש הזה.\n\nהוא פוגש לא רק יריבים, אלא גם חברים חדשים כמו הנערה היפה סאנאה נקאזאווה והשוער המוכשר גנזו וואקאביאשי, שחולק את אותה תשוקה כמו טסובאסה, ויוכיח להיות חבר יקר שיעזור לו לדחוף לעבר חלומותיו. לייצג את יפן בגביע העולם של פיפ\"א הוא החלום האולטימטיבי של טסובאסה, אך יידרש הרבה יותר מכשרון כדי להגיע אליו.","background_hebrew":null,"type":"TV","episodes":52,"duration_minutes":22,"status":"הסתיים","aired_from":"2018-04-03","season":{"label":"אביב 2018","year":2018,"season":"spring"},"broadcast":{"label":"שלישי 01:35","day":"tuesday","time":"01:35","timezone":"Asia/Jerusalem"},"categories":[{"en":"Sports","he":"ספורט"}],"subcategories":[{"en":"Team Sports","he":"ספורט קבוצתי"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Sports"],"studios":["David Production"],"producers":["TV Tokyo","Nihon Ad Systems","Warner Bros. Japan","Shueisha"],"licensors":["VIZ Media"],"source":null,"rating":null,"scores":{"mal":7.44,"mal_scored_by":38984,"israel":4.0,"israel_scored_by":null,"rank":2485,"popularity":2729,"members":85868,"favorites":427},"community_reviews":{"ratings":1,"written_review