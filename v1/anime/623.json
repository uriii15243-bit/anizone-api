{"id":623,"mal_id":623,"anizone_id":623,"url":"https://anizone.co.il/anime/623/Shichinin-no-Nana","slug":"Shichinin-no-Nana","titles":{"hebrew":"שיצ'ינין נו ננה","english":"Shichinin no Nana","romaji":"Shichinin no Nana","japanese":"七人のナナ","synonyms":["Nana 7 of 7","Nana Seven of Seven","Nana 7 of 7, Nana Seven of Seven"],"community":[],"known":["Shichinin no Nana","七人のナナ","Nana 7 of 7","Nana Seven of Seven"]},"synopsis_hebrew":"ביום האהבה האחרון לפני מבחני הכניסה לתיכון, נאנה סוזוקי מנסה לאזור אומץ ולהתוודות בפני המושא אהבתה מזה זמן רב. אך כאשר השוקולדים שלה נהרסים בטעות, היא ממהרת לחזור לביתה כדי להכין עוד—מבלי לדעת שסבה הפך את המיקרוגל להמצאה מוזרה. לפתע מופיעות שש עותקים נוספים של נאנה, כל אחת עם אישיות קיצונית משלה וקריסטל שמעניק לה כוחות קסם!\n\nעם תוכניותיה שנהרסו, נאנה נשבעת להתוודות בפני המושא אהבתה בשנה הראשונה שלה בתיכון. הבעיה היחידה היא שהמושא שלה הוא התלמיד המצטיין יואיצ'י קמיצ'יקה, ולעקוב אחריו לתיכון היוקרתי שלו אומר שהיא תצטרך לשקוד על הלימודים. עם שישה בעלי ברית חדשים שיעזרו לה, נאנה מתחילה להתכונן לכל מה שעונת המבחנים עשויה להשליך עליה.\n\nמקור: MAL Rewrite","background_hebrew":"שיצ'ינין נו ננה יצא על גבי DVD על ידי מדיה בלאסטרס בשישה כרכים מה-27 ביולי 2004 עד ה-31 במאי 2005. החברה הוציאה מחדש את האנימה כאוסף בלו-ריי מלא ב-8 ביוני 2021.","type":"TV","episodes":25,"duration_minutes":24,"status":"הסתיים","aired_from":"2002-01-10","season":{"label":"חורף 2002","year":2002,"season":"winter"},"broadcast":{"label":"חמישי 18:00","day":"thursday","time":"18:00","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Adventure","Comedy","Romance"],"studios":["A.C.G.T."],"producers":["TV Tokyo","HAL Film Maker","Genco","Asatsu DK","d-rights","AT-X"],"licensors":["Media Blasters","NYAV Post"],"source":null,"rating":null,"scores":{"mal":6.88,"mal_scored_by":2074,"israel":null,"israel_scored_by":null,"