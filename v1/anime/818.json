{"id":818,"mal_id":818,"anizone_id":818,"url":"https://anizone.co.il/anime/818/Sakura-Diaries","slug":"Sakura-Diaries","titles":{"hebrew":"יומני סאקורה","english":"Sakura Diaries","romaji":"Sakura Tsuushin","japanese":"桜通信","synonyms":["Sakura Mail"],"community":[],"known":["Sakura Tsuushin","Sakura Diaries","桜通信","Sakura Mail"]},"synopsis_hebrew":"מועמד לבחינות באוניברסיטת קיאו (אחת משלוש האוניברסיטאות המובילות ביפן), טומה אינאבה, מופרע כאשר נערה חמודה בשם אוררה קאסוגה מגיעה לדלת חדר המלון שלו. מאוחר יותר מתברר שהיא בת דודתו, שהוא בקושי זוכר מילדותו. אוררה, שהרגישה משהו מיוחד כלפיו (אהבה שאינה רק משפחתית), מזמינה את טומה לגור איתה מכיוון שאין לו מקום אחר לשהות בו מלבד חדר המלון. לפני שהוא ניגש למבחן, טומה פוגש את מייקו יוטסובה, אישה יפה ומעודנת שגם היא מנסה להתקבל לקיאו. מייקו מתקבלת לקיאו, אך טומה לא, בגלל הצטננות שאוררה הדביקה אותו בה זמן קצר לפני כן. למרות שהוא לא התקבל, הוא מעמיד פנים שכן כדי לזכות בכבוד של מייקו. טומה מוצא את עצמו במשולש אהבה עם אוררה ומייקו, בעודו נאבק לשמור על האמונה של מייקו שהוא באמת סטודנט בקיאו ולהיות שם עבור אוררה בו זמנית.\n\nמקור: ANN","background_hebrew":null,"type":"OVA","episodes":12,"duration_minutes":21,"status":"הסתיים","aired_from":"1997-05-21","season":{"label":"אביב 1997","year":1997,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Drama","he":"דרמה"},{"en":"Romance","he":"רומנטיקה"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Adult Cast","he":"קהל בוגר"},{"en":"Love Polygon","he":"אהבה יותר מאישה אחת"}],"demographic":{"en":"Seinen","he":"מתבגרים"},"genres":["Comedy","Drama","Romance","Ecchi"],"studios":["Shaft"],"producers":["Kitty Films","Studio Tulip","Arts Pro"],"licensors":["ADV Films"],"source":null,"rating":null,"scores":{"mal":6.14,"mal_scored_by":6195,"israel":null,"israel_scored_by":null,"rank":10347,"popularity":5958,"members":17710,"favorites":23},"community_reviews":null,"images":{"poster":"https://cdn.my