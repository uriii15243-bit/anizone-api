{"id":3359,"mal_id":3359,"anizone_id":3359,"url":"https://anizone.co.il/anime/3359/Amatsuki","slug":"Amatsuki","titles":{"hebrew":"אמאצוקי","english":"Amatsuki","romaji":"Amatsuki","japanese":"あまつき","synonyms":[],"community":[],"known":["Amatsuki","あまつき"]},"synopsis_hebrew":"טוקידוקי ריקוגו הוא תלמיד ששונא היסטוריה ונכשל בקורס ההיסטוריה היפנית שלו; בית הספר התיכון שלו מכריח אותו לפצות על הציון הנכשל על ידי השתתפות בהרצאה מיוחדת במוזיאון. התערוכה המרכזית, שחזור עצום של תקופת אדו, מבטיחה לשפר את ציוניו הגרועים של התלמיד הסורר עם סימולציה מורכבת של שוגונות טוקוגאווה: סיור והצגת אדו באקומאטסו.\n\nכמעט ללא ידע על תרבות הסמוראים או התקופה שאליה נכנס, הוא מופתע לגלות את האופי האמונתי של יפן במהלך המאה ה-17. לאחר שהוא ממהר לדחות את קיומם של אלים ושדים, הוא נדהם כאשר שד תוקף אותו על גשר. ניצל על ידי סייף מסתורי בשם קוצ'יהה, הוא מגלה שאינו יכול עוד לברוח מהסימולציה במוזיאון ההיסטוריה.\n\nבפוגשו סייף נוסף בשם קון שינונומה, הוא מגלה על בן זמנו שנלכד בסימולציה לפניו. במהירות מתרגל לביתו החדש, טוקידוקי חייב כעת לעזור להגן על הכפר מפני שדים, תוך כדי חשיפת המסתורין של הסימולציה והחברה שיצרה אותה.\n\nמקור: MAL Rewrite","background_hebrew":null,"type":"TV","episodes":13,"duration_minutes":23,"status":"הסתיים","aired_from":"2008-04-05","season":{"label":"אביב 2008","year":2008,"season":"spring"},"broadcast":{"label":"שבת 02:30","day":"saturday","time":"02:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Supernatural","he":"על טבעי"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Mythology","he":"מיתולוגיה"},{"en":"Time Travel","he":"מסע בזמן"}],"demographic":{"en":"Josei","he":"נשים"},"genres":["Action","Supernatural"],"studios":["Studio Deen"],"producers":["Frontier Works","Sotsu"],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.86,"mal_scored_by":26687,"israel":5.0,"israel_scored_by":null,"rank":5703,"popularity":3364,"members":59696,"favorites":123},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https