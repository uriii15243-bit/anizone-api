{"id":54850,"mal_id":54850,"anizone_id":54850,"url":"https://anizone.co.il/anime/54850/Ooku-The-Inner-Chambers","slug":"Ooku-The-Inner-Chambers","titles":{"hebrew":"אואוקו: החדרים הפנימיים","english":"Ōoku: The Inner Chambers","romaji":"Oooku","japanese":"大奥","synonyms":[],"community":[],"known":["Oooku","Ōoku: The Inner Chambers","大奥"]},"synopsis_hebrew":"יפן בתקופת אדו עומדת חזקה וגאה, עשורים לאחר שנבואת חורבנה הקרוב ניתנה. השוגון החדש, יושימונה \"נובו\" טוקוגאווה, נתקלת במגוון מסורות שלדעתה המודרנית נראות חסרות היגיון. מגפה משתוללת באופן בלעדי בקרב גברים, וכתוצאה מכך גברים מהווים רק חמישית מהאוכלוסייה. ובכל זאת, שלושת אלפים גברים צעירים, זריזים ויפים משרתים באוקו—החדרים הפנימיים של השוגון.\n\nכדי לחשוף את מקורות ההיררכיה הקיימת שבה נשים עומדות בראש משפחותיהן ומנהלות את האומה, נובו בוחנת את הכרוניקות של המחלה המוזרה. מנהגים ומסורות השתנו כדי להתאים למגפה; חוקים חדשים אלו מכתיבים את התרבות הנוכחית ומשקפים את הסיפור האכזרי של השוגון הנשית הראשונה, יאמיצו טוקוגאווה. באופן בולט, נראה כי מנהגים אלו מובילים לרגע שבו נזיר צעיר, אריקוטו מדנוקוג'י, נאלץ לנטוש את אורח חייו ולהקדיש את ימיו הנותרים לשוגון ולחדרי האוקו שלה.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":"אוקו יצא בבלו-ריי כסט של שני דיסקים על ידי נטפליקס ב-20 ביולי 2023. האנימה מעבדת את 15 הפרקים הראשונים של המנגה.","type":"ONA","episodes":10,"duration_minutes":31,"status":"הסתיים","aired_from":"2023-06-29","season":{"label":"אביב 2023","year":2023,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Drama","he":"דרמה"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Samurai","he":"סמוראי"}],"demographic":{"en":"Shoujo","he":"נערה"},"genres":["Drama"],"studios":["Studio Deen"],"producers":["Netflix","Aube"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.41,"mal_scored_by":15747,"israel":null,"israel_scored_by":null,"rank":2646,"popularity":4483,"members":35140,"favorites":195},"community_reviews":null,"images":{