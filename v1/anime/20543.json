{"id":20543,"mal_id":20543,"anizone_id":20543,"url":"https://anizone.co.il/anime/20543/Bayonetta-Bloody-Fate","slug":"Bayonetta-Bloody-Fate","titles":{"hebrew":"באיונטה: גורל עקוב מדם","english":"Bayonetta: Bloody Fate","romaji":"Bayonetta: Bloody Fate","japanese":"ベヨネッタ ブラッディフェイト","synonyms":["BAYONETTA BLOODYFATE"],"community":[],"known":["Bayonetta: Bloody Fate","ベヨネッタ ブラッディフェイト","Beyonetta: Bloody Fate","BAYONETTA BLOODYFATE"]},"synopsis_hebrew":"במטרה לשחזר את זיכרונותיה לאחר שהתעוררה בארון קבורה בתחתית אגם לפני 20 שנה, ביון נטה צדה את כוחות השמיים יום ולילה בחיפוש אחר רמזים לעברה הנשכח, ולשמור על הברית שלה עם הכוחות הדמוניים מהם היא שואבת את כוחותיה כמכשפת אומברה. היא חמושה ומונחית על ידי הברמן והנשק המסתורי, רודין, ובעקבותיה בכל צעד נמצא העיתונאי הנועז, לוקה רדגרייב, שמאמין שיש לה קשר למות אביו ולא יעצור עד שיגלה את האמת. המסע שלה מקבל תפנית מבטיחה כשהיא פוגשת ילדה קטנה בשם סרזה, אך עומדת בדרכה מכשפת אומברה יריבה בשם ג'אן, שעובדת עבור הכוחות שהיא אמורה להתנגד להם.\n\nביון נטה: גורל עקוב מדם הוא סרט אנימה מלא אקשן שחוקר את הקשר בין כל הדמויות ועובד לחשוף כיצד הן לכאורה שזורות בקונספירציה שמאפילה על כולן.","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":90,"status":"הסתיים","aired_from":"2013-11-23","season":{"label":"סתיו 2013","year":2013,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Mythology","he":"מיתולוגיה"},{"en":"Super Power","he":"כוחות מיוחדים"}],"demographic":null,"genres":["Action","Fantasy"],"studios":["Gonzo"],"producers":["Toei Animation","Avex Entertainment","Pony Canyon","Sega","Showgate","Q-Tec"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.66,"mal_scored_by":27312,"israel":7.0,"israel_scored_by":null,"rank":7041,"popularity":3350,"members":60126,"favorites":133},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cd