{"id":3061,"mal_id":3061,"anizone_id":3061,"url":"https://anizone.co.il/anime/3061/Kishin-Corps","slug":"Kishin-Corps","titles":{"hebrew":"קישין קורפס","english":"Kishin Corps","romaji":"Kishin Heidan","japanese":"機神兵団","synonyms":["Alien Defender Geo-Armor - Kishin Corps","Machine-God Corps","Panzer Robot","Alien Defender Geo-Armor - Kishin Corps, Machine-God Corps, Panzer Robot"],"community":[],"known":["Kishin Heidan","Kishin Corps","機神兵団","Alien Defender Geo-Armor - Kishin Corps","Machine-God Corps","Panzer Robot"]},"synopsis_hebrew":"אוקטובר 1941, כאשר מלחמת העולם השנייה מאיימת להרוס את העולם המתורבת, סיבוך בלתי צפוי מתרחש פתאום. פלישה חייזרית! למרות הופעתם הפתאומית של התוקפים החוצנים הללו, מדינות הציר ובעלות הברית ממשיכות את הסכסוך ההרסני שלהן. רק יחידת קישין והרובוטים הענקיים שלהם, ג'יאו-ארמור (המכונים: קישין), שפותחו מרובוט חייזרי שנשבה, עומדים בין כדור הארץ להשמדה מוחלטת!\n\nנער בשם טאישי מוצא את עצמו לפתע במרכז מאבק סביב מזוודה שחורה מסתורית שהופקדה בידיו על ידי אביו, פרופסור טוקאמורה. המזוודה מכילה את מנגנון השליטה לאחד מהרובוטים הענקיים ג'יאו-ארמור, וצבא קנטו היפני, הפולשים החייזרים ויחידת קישין כולם רוצים להשיג את המכשיר! בין המרגלים, הצבאות, החייזרים והרובוטים הענקיים, טאישי עומד בפני הרפתקה אפית—אם יצליח לשרוד אותה!\n\nמקור: AnimeNfo","background_hebrew":null,"type":"OVA","episodes":7,"duration_minutes":33,"status":"הסתיים","aired_from":"1993-03-25","season":{"label":"חורף 1993","year":1993,"season":"winter"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Mecha","he":"רובוטים"}],"demographic":null,"genres":["Adventure","Sci-Fi"],"studios":["AIC"],"producers":["Pioneer LDC"],"licensors":["Geneon Entertainment USA"],"source":null,"rating":null,"scores":{"mal":6.54,"mal_scored_by":970,"israel":null,"israel_scored_by":null,"rank":7853,"popularity":11169,"members":3347,"favorites