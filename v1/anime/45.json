{"id":45,"mal_id":45,"anizone_id":45,"url":"https://anizone.co.il/anime/45/Rurouni-Kenshin","slug":"Rurouni-Kenshin","titles":{"hebrew":"רורוני קנשין (1996)","english":"Rurouni Kenshin","romaji":"Rurouni Kenshin: Meiji Kenkaku Romantan","japanese":"るろうに剣心 -明治剣客浪漫譚-","synonyms":["Samurai X","Wandering Kenshin: Romantic Tales from the Meiji Era","Samurai X, Wandering Kenshin: Romantic Tales from the Meiji Era"],"community":[],"known":["Rurouni Kenshin: Meiji Kenkaku Romantan","Rurouni Kenshin","るろうに剣心 -明治剣客浪漫譚-","Kenshin, el Guerrero Samurai","Kenshin le Vagabond","Samurai X","Wandering Kenshin: Romantic Tales from the Meiji Era"]},"synopsis_hebrew":"בשנים האחרונות של תקופת באקומטסו חי מתנקש אגדי הידוע בשם היטוקירי באטוסאי. הוא היה חסר רחמים, אך נעלם באופן מסתורי בשיאה של המהפכה היפנית. עברו עשר שנים של שלום מאז, אבל עצם אזכור באטוסאי עדיין פוגע בליבם של ותיקי המלחמה. ללא ידיעתם, באטוסאי נטש את אורח חייו המוכתם בדם בניסיון להתחרט על חטאיו, וכעת הוא חי כקנשין הימורה, סייף נודד עם גישה עליזה ורצון חזק. קנשין נשבע לעולם לא להרוג שוב, ומקדיש את עצמו להגנה על החלשים. יום אחד, הוא נתקל בקאורו קאמייה בדוג'ו הקנדו שלה, שמאיים עליו מתחזה הטוען שהוא באטוסאי.","background_hebrew":null,"type":"TV","episodes":94,"duration_minutes":25,"status":"הסתיים","aired_from":"1996-01-10","season":{"label":"חורף 1996","year":1996,"season":"winter"},"broadcast":{"label":"רביעי 19:30","day":"wednesday","time":"19:30","timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"},{"en":"Romance","he":"רומנטיקה"}],"subcategories":[{"en":"Historical","he":"היסטורי"},{"en":"Samurai","he":"סמוראי"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Comedy","Romance"],"studios":["Gallop","Studio Deen"],"producers":["Aniplex","SME Visual Works","Fuji TV"],"licensors":["Media Blasters","Aniplex of America"],"source":null,"rating":null,"scores":{"mal":8.27,"mal_scored_by":249744,"israel":8.0,"israel_scored_by":2,"rank":367,"popularity":499,"members":530709,"