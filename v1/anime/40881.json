{"id":40881,"mal_id":40881,"anizone_id":40881,"url":"https://anizone.co.il/anime/40881/Pokemon-the-Movie-Secrets-of-the-Jungle","slug":"Pokemon-the-Movie-Secrets-of-the-Jungle","titles":{"hebrew":"פוקימון הסרט: סודות הג","english":"Pokémon the Movie: Secrets of the Jungle","romaji":"Pokemon Movie 23: Koko","japanese":"劇場版ポケットモンスター ココ","synonyms":[],"community":[],"known":["Pokemon Movie 23: Koko","Pokémon the Movie: Secrets of the Jungle","劇場版ポケットモンスター ココ","Pokémon Film 23: Geheimnisse des Dschungels","Pokémon Película 23: Los Secretos de la Selva","Pokémon Film 23: Les Secrets de la Jungle"]},"synopsis_hebrew":"עמוק בתוך יער אוקויה, חיים הפוקימונים המיתולוגיים זארודה בקבוצה ושומרים על חוק נוקשה שאוסר על זרים להיכנס לשטחם. במקום אחר בג'ונגל חי קוקו, ילד אנושי שגודל על ידי זארודה בודד שעזב את הקבוצה. קוקו גדל מבלי להטיל ספק בכך שהוא זארודה. אך יום אחד, מפגש מקרי עם סאטושי ופיקאצ'ו משאיר את קוקו עם חבר אנושי ראשון. האם הוא באמת פוקימון? או שמא הוא למעשה בן אדם? כאשר סכנה מאיימת על הג'ונגל, הקשרים בין פוקימון לאדם—והאהבה בין הורה לילד—יועמדו במבחן.\n\n(מקור: האתר הרשמי)","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":99,"status":"הסתיים","aired_from":"2020-12-25","season":{"label":"סתיו 2020","year":2020,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Comedy","he":"קומדיה"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Strategy Game","he":"משחק אסטרטגיה"}],"demographic":{"en":"Kids","he":"Kids"},"genres":["Action","Adventure","Comedy","Fantasy"],"studios":["OLM"],"producers":["TV Tokyo","Shogakukan-Shueisha Productions","JR East Marketing & Communications"],"licensors":["VIZ Media","The Pokemon Company International"],"source":null,"rating":null,"scores":{"mal":7.27,"mal_scored_by":14770,"israel":null,"israel_scored_by":null,"rank":3391,"popularity":4665,"members":32206,"favorites":37},"community_rev