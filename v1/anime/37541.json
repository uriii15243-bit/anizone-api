{"id":37541,"mal_id":37541,"anizone_id":37541,"url":"https://anizone.co.il/anime/37541/Kimi-no-Iru-Basho","slug":"Kimi-no-Iru-Basho","titles":{"hebrew":"קימי נו אירו באשו","english":"Kimi no Iru Basho","romaji":"Kimi no Iru Basho","japanese":"君のいる場所","synonyms":["Chronicle"],"community":[],"known":["Kimi no Iru Basho","君のいる場所","Chronicle"]},"synopsis_hebrew":"פרויקט וידאו קליפ של קבוצת האמנים Chronicle. האמן הוויזואלי הוא loundraw, יוצר הסאונד הוא Hideya Kojima, והשיר בשם Kimi no Iru Basho מבוצע על ידי T.B.A.\n\nבעתיד הרחוק, נערה שימשה לשחזור עיר אבודה במרחב הווירטואלי. בשל אשפוזה עקב מחלה חשוכת מרפא, סאצ'י הופכת בודדה אך עדיין מתאהבת בנער, ריו, שהולך לבית הספר בזמן שהיא צופה בו מחלון בית החולים שלה. היא מבולבלת מרגש חדש ומצמרר, והגבולות בין המציאות מתחילים להיטשטש כשהיא מנסה באופן תת-מודע למשוך אותו לעולם הדיגיטלי.","background_hebrew":null,"type":"Music","episodes":1,"duration_minutes":1,"status":"הסתיים","aired_from":"2017-09-26","season":{"label":"קיץ 2017","year":2017,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Music","he":"מוזיקה"}],"demographic":null,"genres":["Sci-Fi"],"studios":[],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":6.05,"mal_scored_by":400,"israel":null,"israel_scored_by":null,"rank":null,"popularity":16444,"members":827,"favorites":0},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1046/91245l.webp"},"trailer":null,"characters":[],"staff":[{"name":"loundraw","role":"במאי","roles":["במאי"],"image":"https://cdn.myanimelist.net/images/voiceactors/3/71823.jpg?s=6f5c9fe8e0592277004f350d4e1b3cba"}],"external_links":{"myanimelist":"https://myanimelist.net/anime/37541","other":["http://www.chronicle.city/","https://ja.wikipedia.org/wiki/Loundraw#%E6%A5%BD%E6%9B%B2%E9%96%A2%E9%80%A3"]},"attribution":{"source":"AniZone","source_url":"https://anizone.co.il","note":"