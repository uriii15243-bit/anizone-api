{"id":7786,"mal_id":7786,"anizone_id":7786,"url":"https://anizone.co.il/anime/7786/Arabian-Nights-Sinbads-Adventures","slug":"Arabian-Nights-Sinbads-Adventures","titles":{"hebrew":"לילות ערב: הרפתקאות סינבד","english":"Arabian Nights: Sinbad's Adventures","romaji":"Arabian Night: Sindbad no Bouken","japanese":"アラビアンナイト シンドバッドの冒険","synonyms":[],"community":[],"known":["Arabian Night: Sindbad no Bouken","Arabian Nights: Sinbad's Adventures","アラビアンナイト シンドバッドの冒険","Simbad el Marino"]},"synopsis_hebrew":"זהו יצירה של חברת Toei Animation Co., Ltd. עם תסריט מאת טזוקה אוסאמו בשיתוף פעולה עם הסופר קיטה מוריו. סינבד וילד בשם עלי הם נוסעים סמויים על ספינת המטען \"בולדר\", אך הם זוכים למקומות ראויים על הספינה לאחר שהם מצליחים לזכות בחסדיו של הקפטן. \n\nאז הנסיכה היפהפייה סמיר קופצת על הסיפון כדי להימלט משר מרושע שרוצה להתחתן איתה, וסינבד עובר סדרת הרפתקאות כדי להגן על הנסיכה.\n\nהסיפור מתפתח עם עליות ומורדות, מלא בפרקים דרמטיים מהסיפור המקורי כמו קרב סוער עם ציפור מוזרה ששומרת על יהלומים.","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":81,"status":"הסתיים","aired_from":"1962-06-16","season":{"label":"אביב 1962","year":1962,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[],"demographic":null,"genres":["Action","Adventure","Fantasy"],"studios":["Toei Animation"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.42,"mal_scored_by":898,"israel":null,"israel_scored_by":null,"rank":13774,"popularity":12246,"members":2501,"favorites":2},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1600/158191l.webp"},"trailer":{"youtube_id":"lOj-juHGfkQ","url":"https://www.youtube.com/watch?v=lOj-juHGfkQ","embed_url":"https://www.youtube.com/embed/lOj-juHGfkQ"},"characters":[{"name":"Abdullah","role":"משני","image":"https://cdn.myanimelis