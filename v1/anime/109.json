{"id":109,"mal_id":109,"anizone_id":109,"url":"https://anizone.co.il/anime/109/Burst-Angel","slug":"Burst-Angel","titles":{"hebrew":"ברסט אנג'ל","english":"Burst Angel","romaji":"Bakuretsu Tenshi","japanese":"爆裂天使","synonyms":["Bakuretsu Tenshi"],"community":[],"known":["Bakuretsu Tenshi","Burst Angel","爆裂天使"]},"synopsis_hebrew":"בעתיד הלא רחוק של יפן, הפשע הפך לכל כך נפוץ שהממשלה התירה לאזרחים לשאת נשק חם לשם הגנה עצמית. כדי להילחם בגל החדש של הפשיעה, הוקמה משטרת טוקיו החמושה לאחרונה, בתקווה לצוד פושעים בכוח קטלני.\n\nקיוהיי טאצ'יבאנה הוא סטודנט מוכשר לקולינריה שחולם לחסוך מספיק כסף כדי להפוך לשף קונדיטור בצרפת. כאשר ארבעה שכירי חרב צעירים מבקשים ממנו להיות הטבח שלהם, הוא נאלץ לקבל החלטה קשה. בעוד ג'ו, מג, סיי ואיימי לוקחים על עצמם את המשימות המדממות ביותר בעיר הכאוטית של טוקיו, קיוהיי מקבל את הירידה הבלתי נמנעת לעולם הפשע—והוא יעשה הרבה יותר מאשר רק לבשל!","background_hebrew":null,"type":"TV","episodes":24,"duration_minutes":23,"status":"הסתיים","aired_from":"2004-04-07","season":{"label":"אביב 2004","year":2004,"season":"spring"},"broadcast":{"label":"שלישי 02:12","day":"tuesday","time":"02:12","timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Mecha","he":"רובוטים"}],"demographic":null,"genres":["Adventure","Sci-Fi"],"studios":["Gonzo"],"producers":["GDH","TV Asahi","Imagica"],"licensors":["Funimation"],"source":null,"rating":null,"scores":{"mal":6.79,"mal_scored_by":32704,"israel":null,"israel_scored_by":null,"rank":6157,"popularity":2892,"members":77589,"favorites":242},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/10/22647l.webp"},"trailer":{"youtube_id":"sJPAdfcB8ck","url":"https://www.youtube.com/watch?v=sJPAdfcB8ck","embed_url":"https://www.youtube.com/embed/sJPAdfcB8ck"},"characters":[{"name":"Jo","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/11/31028.webp?s=d1a62ba71e598a4336cab37b22b56dd0","voice_actors":[{"nam