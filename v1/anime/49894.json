{"id":49894,"mal_id":49894,"anizone_id":49894,"url":"https://anizone.co.il/anime/49894/Classroom-for-Heroes","slug":"Classroom-for-Heroes","titles":{"hebrew":"כיתה לגיבורים","english":"Classroom for Heroes","romaji":"Eiyuu Kyoushitsu","japanese":"英雄教室","synonyms":["Class Room✿For Heroes","Hero Classroom","Class Room✿For Heroes, Hero Classroom"],"community":[],"known":["Eiyuu Kyoushitsu","Classroom for Heroes","英雄教室","Class Room✿For Heroes","Hero Classroom"]},"synopsis_hebrew":"לפני זמן רב, היה קיים אדון שדים שהטיל אימה בכל העולם, עד שגיבור עלה לאור הזרקורים ואיתגר את אדון השדים,\n\nובסופו של דבר הביס אותו וסיים את שלטונו.\n\nאותו הגיבור יצר אז את אקדמיית רוסווד, אקדמיה שנועדה לעזור לגיבורים צעירים להתחזק ולעזור להגן על העולם בעת הצורך,\n\nאקדמיה אשר מקבלת רק את הטובים שבטובים.\n\n\"ארנסט פלאמינג\" נכנסה לאקדמיה, נערה בעלת תחושת מחוייבות גבוהה והסטודנטית הבכירה באקדמיה,\n\nוקיבלה את הכינוי \"קיסרית הלהבות\".\n\nיום אחד היא נתקלת בתלמיד החדש, התוסס וחסר הדאגות \"בלייד\",\n\nנער שהיה נראה שמשתווה לה בכוח, משהו שממש עיצבן אותה.\n\nהמלך ביקש מארנסט באופן אישי לפקח ולהראות לבלייד את רחבי האקדמיה במהלך שהותו.\n\nהסיפור עוקב אחר ההתמודדויות של הסטודנטים במסע שלהם להפוך לגיבורים.","background_hebrew":null,"type":"TV","episodes":12,"duration_minutes":23,"status":"הסתיים","aired_from":"2023-07-09","season":{"label":"קיץ 2023","year":2023,"season":"summer"},"broadcast":{"label":"ראשון 23:00","day":"sunday","time":"23:00","timezone":"Asia/Jerusalem"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Fantasy","he":"פנטזיה"},{"en":"Ecchi","he":"Ecchi"}],"subcategories":[{"en":"Harem","he":"הרמון (נשים)"},{"en":"School","he":"בית ספר"}],"demographic":null,"genres":["Action","Fantasy","Ecchi"],"studios":["Actas"],"producers":["Square Enix","Lantis","Movic","Shueisha","Jinnan Studio","Tencent Japan","Bandai Namco Filmworks","Bandai Namco Music Live"],"licensors":["Crunchyroll"],"source":null,"rating":null,"scores":{"mal":6.04,"mal_scored_by":57434,"israel":6.4,"israel_scored_by":5,"ra