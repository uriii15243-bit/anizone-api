{"id":4176,"mal_id":4176,"anizone_id":4176,"url":"https://anizone.co.il/anime/4176/Wanna-Bes","slug":"Wanna-Bes","titles":{"hebrew":"וואנה-ביז","english":"Wanna-Be's","romaji":"Wanna-Be's","japanese":"ウォナビーズ","synonyms":["Wannabes"],"community":[],"known":["Wanna-Be's","ウォナビーズ","Wannabes"]},"synopsis_hebrew":"ה-OVA הזה מתחיל בקרב זוגות בין הבנות האלגנטיות של קבוצת \"דרים טים\" לבין הנשים עם האיפור הכבד של \"פוקסי ליידיז\". כמובן, קבוצת \"דרים טים\" חוטפת מכות רציניות, אבל לא לפני שאחת מהן עושה ניסיון חזק להרים את האישה מ\"פוקסי ליידיז\" ששוקלת 250 פאונד מעל ראשה. אלו שמחליפות אותן הן ארי ומיקי מקבוצת \"וואנה-בי'ס\". מיקי וארי הן פשוט בנות שאוהבות ליהנות, אבל ברגע שהן מתחילות את האימונים החדשים שלהן עם תאגיד קידו המסתורי, אותו תאגיד שאימן את \"דרים טים\", הן מגלות שיש משהו עמוק יותר מאחורי האימונים שלהן.","background_hebrew":null,"type":"OVA","episodes":1,"duration_minutes":45,"status":"הסתיים","aired_from":"1986-12-25","season":{"label":"סתיו 1986","year":1986,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Comedy","he":"קומדיה"},{"en":"Sports","he":"ספורט"}],"subcategories":[{"en":"Combat Sports","he":"קרבות ספורט"}],"demographic":null,"genres":["Comedy","Sports"],"studios":["AIC","Artmic","animate Film"],"producers":["Movic","Sony Music Entertainment"],"licensors":["Central Park Media"],"source":null,"rating":null,"scores":{"mal":5.36,"mal_scored_by":1649,"israel":null,"israel_scored_by":null,"rank":14005,"popularity":10479,"members":4098,"favorites":3},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1540/93055l.webp"},"trailer":null,"characters":[{"name":"Kazama, Eri","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters/6/104697.webp?s=46fde8ccca1e04022aa6007f18c52722","voice_actors":[{"name":"Takahashi, Miki","language":"יפנית","image":"https://cdn.myanimelist.net/images/voiceactors/2/55256.jpg?s=d1c5bb92b96bdcefece8266a9f321b3a"}]},{"name"