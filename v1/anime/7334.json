{"id":7334,"mal_id":7334,"anizone_id":7334,"url":"https://anizone.co.il/anime/7334/Bakugan-Gundalian-Invaders","slug":"Bakugan-Gundalian-Invaders","titles":{"hebrew":"בקוגן: פולשים גנדליאנים","english":"Bakugan: Gundalian Invaders","romaji":"Bakugan Battle Brawlers: Gundalian Invaders","japanese":"爆丸バトルブローラーズ Gundalian Invaders","synonyms":[],"community":[],"known":["Bakugan Battle Brawlers: Gundalian Invaders","Bakugan: Gundalian Invaders","爆丸バトルブローラーズ Gundalian Invaders","Bakugan: Invasores de Gundalia"]},"synopsis_hebrew":"בקאוגן אינטרספייס הוא מערכת מציאות מדומה, שבה שחקנים יכולים להילחם זה בזה ולהשתתף בטורנירים. המערכת תוכננה במקור כדי לעזור לשפר ולתרגל את כישורי הבקאוגן, אך במהרה הפכה למקום מפגש עבור חובבים רבים. במהלך אחד הקרבות של דנמה קוסו, המערכת קורסת והוא מתעלף. לפני שהוא מתעורר, הוא חווה חזון של בקאוגן הנלחמים זה בזה שוב.\n\nהפיצוץ האנרגטי שליווה את הקרב של דנמה וגרם לקריסת המערכת שולח גלי הלם ברחבי הגלקסיה, ומושך את תשומת הלב של \"שנים עשר הסדרים\", ארגון גונדליאני. הם חודרים לבקאוגן אינטרספייס, מחפשים לוחמים חזקים שיצטרפו אליהם במלחמה הקרובה עם גזע חייזרי אחר, הניאטיאנים.\n\nדנמה וחבריו—שון קאזאמי וצ'וג'י מארוקורה—מוצאים את עצמם במהרה מעורבים במלחמה חוצנית. אך למרות שהסכסוך נראה רחוק, הוא מאיים על הריבונות של כדור הארץ ועל עתיד גזע הבקאוגן כולו.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":null,"type":"TV","episodes":39,"duration_minutes":24,"status":"הסתיים","aired_from":"2011-04-03","season":{"label":"אביב 2011","year":2011,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Fantasy","he":"פנטזיה"}],"subcategories":[{"en":"Strategy Game","he":"משחק אסטרטגיה"}],"demographic":null,"genres":["Action","Adventure","Fantasy"],"studios":["TMS Entertainment","Maxpire Entertainment"],"producers":["Sega"],"licensors":["Nelvana"],"source":null,"rating":null,"scores":{"mal":6.4,"mal_scored_by":32575,"israel":10.0,"israel_scored