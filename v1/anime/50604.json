{"id":50604,"mal_id":50604,"anizone_id":50604,"url":"https://anizone.co.il/anime/50604/Fantasy-Hunter","slug":"Fantasy-Hunter","titles":{"hebrew":"חואן יו ליירן","english":"Fantasy Hunter","romaji":"Huan You Lieren","japanese":"幻游猎人","synonyms":["Huan You Lie Ren","Fantasy x Hunter","Phantom Hunter","Huan You Lie Ren, Fantasy x Hunter, Phantom Hunter"],"community":[],"known":["Huan You Lieren","Fantasy Hunter","幻游猎人","Huan You Lie Ren","Fantasy x Hunter","Phantom Hunter"]},"synopsis_hebrew":"בשנת 2079, הולדת מכשיר גלי המוח BrainStation חוללה את המהפכה התעשייתית הרביעית. האנושות נכנסה לעידן חדש לגמרי - \"עידן הסייבר הווירטואלי\". באמצעות השימוש ב-BrainStation, אנשים יכולים להתחבר לעולם סייבר מקיף. העולם הווירטואלי הזה בנוי כמו רשת עצבית וכל המערכת נשלטת ומנוהלת על ידי מוח העל ווטסון.\n\nעם זאת, עם הזמן מתחילות לצוץ בעיות: אנשים רבים לא מצליחים להבחין בין הווירטואלי למציאות, מה שמוביל לפסיכוזה ולהתמכרות ארוכת טווח לעולם הווירטואלי.\n\n(מקור: QQ, תורגם, נערך)","background_hebrew":"עיבוד לרומן הרשת בעל אותו השם מאת ג'י מינג (纪茗).","type":"ONA","episodes":12,"duration_minutes":20,"status":"הסתיים","aired_from":"2021-12-25","season":{"label":"סתיו 2021","year":2021,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Adventure","Sci-Fi"],"studios":["Colored Pencil Animation"],"producers":["Tencent Video","China Literature Limited","Colored Pencil Animation Japan"],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.89,"mal_scored_by":274,"israel":null,"israel_scored_by":null,"rank":11701,"popularity":12894,"members":2063,"favorites":6},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/1620/120376l.webp"},"trailer":{"youtube_id":"I03QmIwYlXk","url":"https://www.youtube.com/watch?v=I03QmIwYlXk","embed_url":"https://www.youtube.com/embed/I03QmIwYlXk"},"char