{"id":6989,"mal_id":6989,"anizone_id":6989,"url":"https://anizone.co.il/anime/6989/Space-Ace","slug":"Space-Ace","titles":{"hebrew":"ספייס אייס","english":"Space Ace","romaji":"Uchuu Ace","japanese":"宇宙エース","synonyms":["Uchu Ace","Uchuu Eesu","Uchu Esu","Uchu Ace, Uchuu Eesu, Uchu Esu"],"community":[],"known":["Uchuu Ace","Space Ace","宇宙エース","Uchu Ace","Uchuu Eesu","Uchu Esu"]},"synopsis_hebrew":"ד\"ר טאטסונוקו ממרכז המחקר טאטסונוקו יוצא למסע תת-ימי בליווי בתו אסארי כדי לחקור קרינה מסתורית, ומגלה שם צדפה ענקית. מתברר שהקרינה נובעת מכדור המונח בתוך הצדפה. אז אסארי מוצאת חפץ בצורת קומפקט עם מסר בתוכו. המסר אומר שחייזר מכוכב פרלום, שנמצא על סף הכחדה, שוכב בתוך הכדור. לפתע מופיע מתוך הכדור נער במראה מוזר והולך להשתולל. הוא בדיוק האדם שהוזכר במסר ושמו אייס. מקור האנרגיה שלו לכוחות העל-אנושיים הוא מה שנקרא מזון חלל, והוא יכול לעוף בעזרת טבעת כסף שנוצרת מאנרגיה שנאספת מידית בסביבה האווירית. בנוסף, הוא יכול להשתמש בה כנשק להילחם באויב. בתמיכת חבריו, כולל אסארי, איבו הכלב הרובוטי, והכתב סרטן הנזיר, הוא יוצא לפעולה באומץ כדי לפתור קשיים שונים שנגרמים על ידי רובוטים מיסטיים ופולשים אכזריים מהחלל.","background_hebrew":null,"type":"TV","episodes":52,"duration_minutes":25,"status":"הסתיים","aired_from":"1965-05-08","season":{"label":"אביב 1965","year":1965,"season":"spring"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[],"demographic":null,"genres":["Action","Adventure","Sci-Fi"],"studios":["Tatsunoko Production"],"producers":[],"licensors":[],"source":null,"rating":null,"scores":{"mal":5.85,"mal_scored_by":263,"israel":null,"israel_scored_by":null,"rank":11955,"popularity":14825,"members":1232,"favorites":2},"community_reviews":null,"images":{"poster":"https://cdn.myanimelist.net/images/anime/2/83908l.webp"},"trailer":null,"characters":[{"name":"Ace","role":"ראשי","image":"https://cdn.myanimelist.net/images/characters