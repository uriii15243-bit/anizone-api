{"id":19759,"mal_id":19759,"anizone_id":19759,"url":"https://anizone.co.il/anime/19759/Assassination-Classroom-Jump-Festa-2013-Special","slug":"Assassination-Classroom-Jump-Festa-2013-Special","titles":{"hebrew":"כיתת ההתנקשות: ג'אמפ פסטה 2013 ספיישל","english":"Assassination Classroom: Jump Festa 2013 Special","romaji":"Ansatsu Kyoushitsu: Jump Festa 2013 Special","japanese":"暗殺教室","synonyms":["Ansatsu Kyoushitsu Jump Super Anime Tour Special","Assassination Classroom","Ansatsu Kyoushitsu: Jump Festa 2013 Special","Ansatsu Kyoushitsu Jump Super Anime Tour Special, Assassination Classroom, Ansatsu Kyoushitsu: Jump Festa 2013 Special"],"community":[],"known":["Ansatsu Kyoushitsu: Jump Festa 2013 Special","Assassination Classroom: Jump Festa 2013 Special","暗殺教室","Ansatsu Kyoushitsu Jump Super Anime Tour Special","Assassination Classroom"]},"synopsis_hebrew":"כיתה 3-א מתכוננת לטיול הכיתתי שלהם לקיוטו, וקורו-סנסיי נרגש מתמיד! נגיסה נמצא בקבוצה עם קאדה, קרמה, טומוהיטו, מאנמי והאיידולית של הכיתה יוקיקו קנזאקי. התלמידים מודעים לכך שזו הזדמנות מצוינת להתנקש בקורו-סנסיי, אך הם לא יכולים שלא ליהנות איתו. עם זאת, הטיול הופך למרגש ומסוכן יותר כאשר הם מותקפים על ידי חבורת עבריינים שחוטפת את הבנות. כאילו זה לא מספיק, יש צלף שכיר בשם רד איי שמסתובב בסביבה, מוכן להיות זה שיתנקש בקורו-סנסיי ויזכה בפרס. האם תלמידי כיתה 3-א יכולים לסמוך על קורו-סנסיי גם עכשיו?","background_hebrew":null,"type":"Special","episodes":1,"duration_minutes":31,"status":"הסתיים","aired_from":"2013-10-06","season":{"label":"סתיו 2013","year":2013,"season":"fall"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Tokyo"},"categories":[{"en":"Action","he":"אקשן"},{"en":"Comedy","he":"קומדיה"}],"subcategories":[],"demographic":{"en":"Shounen","he":"נער"},"genres":["Action","Comedy"],"studios":["Brain's Base"],"producers":["Kansai TV"],"licensors":[],"source":null,"rating":null,"scores":{"mal":7.17,"mal_scored_by":38755,"israel":null,"israel_scored_by":null,"rank":3974,"popularity":2753,"memb