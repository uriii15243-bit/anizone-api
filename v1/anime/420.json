{"id":420,"mal_id":420,"anizone_id":420,"url":"https://anizone.co.il/anime/420/Spriggan","slug":"Spriggan","titles":{"hebrew":"ספריגן","english":"Spriggan","romaji":"Spriggan","japanese":"スプリガン","synonyms":[],"community":[],"known":["Spriggan","スプリガン"]},"synopsis_hebrew":"הרבה לפני עידן האדם הפרהיסטורי, מין חייזרי מתקדם התגורר בכדור הארץ. מתוך חוסר זהירות בכוח שהיה בידיהם, גרמו היצורים הללו בסופו של דבר להכחדתם. עם זאת, החייזרים השאירו אזהרה לציוויליזציות העתידיות על לוחות בלתי ניתנים להשמדה: להשמיד כל שריד של הטכנולוגיה ההרסנית שנוצרה על ידם.\n\nבעידן המודרני, תאגיד ARCAM ויחידת הפרה-צבאית שלהם—הספריגנים—שואפים לאטום את השרידים ולמנוע משחקנים סוררים לנצל את כוחותיהם. בעקבות גילויו האחרון של ARCAM בהרי אררט של מה שמאמינים שהוא תיבת נוח המיתית, נשלח ספריגן יו אומינאה לחקור.\n\nעם זאת, האתר מותקף על ידי חיל המכונות האמריקאי—פלג רדיקלי של מחלקת ההגנה בראשות קולונל מקדוגל. בהוראת הפנטגון, מקדוגל מבקש לאבטח את המדען הראשי של ARCAM ולהשתלט על הממצא. יחד עם הספריגן ג'ין ז'אקמונדו, יו חייב לעצור את מקדוגל וחיילי העילית של חיל המכונות מלהתקדם לעבר התיבה לפני שיהיה מאוחר מדי.\n\n[נכתב על ידי MAL Rewrite]","background_hebrew":null,"type":"Movie","episodes":1,"duration_minutes":90,"status":"הסתיים","aired_from":"1998-09-05","season":{"label":"קיץ 1998","year":1998,"season":"summer"},"broadcast":{"label":"לא צויין","day":null,"time":null,"timezone":"Asia/Jerusalem"},"categories":[{"en":"Adventure","he":"הרפתקאות"},{"en":"Sci-Fi","he":"מדע בדיוני"}],"subcategories":[{"en":"Military","he":"צבאי"}],"demographic":{"en":"Shounen","he":"נער"},"genres":["Adventure","Sci-Fi"],"studios":["Studio 4°C"],"producers":["Bandai Visual","TBS","TOHO","Nichion","TOHO Music"],"licensors":["ADV Films"],"source":null,"rating":null,"scores":{"mal":6.72,"mal_scored_by":15937,"israel":7.0,"israel_scored_by":null,"rank":6667,"popularity":4057,"members":43343,"favorites":83},"community_reviews":{"ratings":1,"written_reviews":0},"images":{"poster":"https://cdn.myanimelist.net/images/anime/1549/134328l.web